})
degradeMenu.Parent = fondMenu

local colonne = Instance.new("Frame")
colonne.Name = "Colonne"
colonne.Size = UDim2.new(0, 470, 1, 0)
colonne.Position = UDim2.new(0, 46, 0, 0)
colonne.BackgroundTransparency = 1
colonne.ZIndex = 21
