function Config.TexteCadeau(c): string
	local morceaux = {}
	if c.Pieces then
		table.insert(morceaux, ("%d 💰"):format(c.Pieces))
	end
	if c.Tours then
		table.insert(morceaux, ("%d tour%s 🎡"):format(c.Tours, if c.Tours > 1 then "s" else ""))
	end
	return table.concat(morceaux, " + ")
end

