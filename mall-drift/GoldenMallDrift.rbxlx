-- COMMUNICATION CLIENT ↔ SERVEUR
---------------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "MallDriftRemotes"
local ObtenirProfil = Instance.new("RemoteFunction")
ObtenirProfil.Name = "ObtenirProfil"
ObtenirProfil.Parent = remotes
local ProfilMisAJour = Instance.new("RemoteEvent")
ProfilMisAJour.Name = "ProfilMisAJour"
ProfilMisAJour.Parent = remotes
local Personnaliser = Instance.new("RemoteEvent")
Personnaliser.Name = "Personnaliser"
Personnaliser.Parent = remotes
local SortirKart = Instance.new("RemoteEvent")
SortirKart.Name = "SortirKart"
SortirKart.Parent = remotes
local DriftTermine = Instance.new("RemoteEvent")
DriftTermine.Name = "DriftTermine"
DriftTermine.Parent = remotes
local Alerte = Instance.new("RemoteEvent") -- utilisé par le script de la sécurité
Alerte.Name = "Alerte"
Alerte.Parent = remotes
local TutoTermine = Instance.new("RemoteEvent") -- le joueur a fini (ou passé) le tuto du début
TutoTermine.Name = "TutoTermine"
TutoTermine.Parent = remotes
local DebutTuto = Instance.new("RemoteEvent") -- le tuto commence : on donne un kart, même au lobby
DebutTuto.Name = "DebutTuto"
DebutTuto.Parent = remotes

-- Les autres scripts serveur (la sécurité) peuvent donner de l'XP avec cet événement
local AjouterXP = Instance.new("BindableEvent")
AjouterXP.Name = "AjouterXP"
AjouterXP.Parent = game:GetService("ServerStorage")
-- Chaque drift validé est signalé au script des manches (classements, Drift Battle)
local DriftEnregistre = Instance.new("BindableEvent")
DriftEnregistre.Name = "DriftEnregistre"
DriftEnregistre.Parent = game:GetService("ServerStorage")

-- Groupes de collision : les gardes ne se font pas renverser par les karts
local PhysicsService = game:GetService("PhysicsService")
for _, groupe in ipairs({ "Karts", "Gardes", "KartsManche", "BarriereManche" }) do
	if not PhysicsService:IsCollisionGroupRegistered(groupe) then
		PhysicsService:RegisterCollisionGroup(groupe)
	end
end
PhysicsService:CollisionGroupSetCollidable("Karts", "Gardes", false)
PhysicsService:CollisionGroupSetCollidable("KartsManche", "Gardes", false)
-- La barrière de l'entrée (pendant une manche) ne bloque QUE les karts de la manche :
-- les joueurs en entraînement passent librement
PhysicsService:CollisionGroupSetCollidable("BarriereManche", "Default", false)
PhysicsService:CollisionGroupSetCollidable("BarriereManche", "Karts", false)
PhysicsService:CollisionGroupSetCollidable("BarriereManche", "Gardes", false)
PhysicsService:CollisionGroupSetCollidable("BarriereManche", "KartsManche", true)
do
	local barriere = carte:FindFirstChild("BarriereManche", true)
	if barriere then
		(barriere :: BasePart).CollisionGroup = "BarriereManche"
	end
end
remotes.Parent = ReplicatedStorage

---------------------------------------------------------------------
-- SAUVEGARDE DES JOUEURS (XP, record, kart personnalisé)
-- Pour que ça marche dans Studio : Paramètres du jeu > Sécurité >
-- « Autoriser l'accès Studio aux services API ». Sinon le jeu marche
-- quand même, mais la progression n'est pas gardée entre deux parties.
---------------------------------------------------------------------
local okStore, magasin = pcall(function()
	return DataStoreService:GetDataStore("GoldenMallDrift_v1")
end)
if not okStore then
	warn("[Golden Mall] Sauvegarde indisponible (normal dans Studio si l'accès API est désactivé).")
	magasin = nil
end

type Profil = {
	XP: number,
	Record: number,
	Perso: { [string]: any },
	Charge: boolean,
	Pieces: number, -- la monnaie du jeu 💰
	Possessions: { Couleurs: { [string]: boolean }, Premium: { [string]: boolean }, Produits: { [string]: boolean }, Karts: { [string]: boolean }, Trainees: { [string]: boolean } },
	TutoFait: boolean, -- le tuto du début a déjà été vu
	ToursRoue: number, -- tours de roue achetés (ou offerts) pas encore joués
	DernierJourRoue: number, -- dernier jour (UTC) où le tour gratuit a été joué
	ToursGratuitsJour: number, -- tours gratuits déjà joués ce jour-là
	SerieJours: number, -- série de connexion (1 à 7)
	DernierJourConnexion: number,
	JourSeriePris: number, -- jour où le cadeau de la série a été pris
}
local profils: { [Player]: Profil } = {}
local kartsJoueurs: { [Player]: Model } = {}
local derniereAction: { [Player]: { [string]: number } } = {}

local dossierKarts = Instance.new("Folder")
dossierKarts.Name = "KartsJoueurs"
dossierKarts.Parent = workspace

local function niveauDe(profil: Profil): number
	return (Config.NiveauDepuisXP(profil.XP))
end

-- La roue du jour : 1 tour gratuit par jour (2 avec le Pass VIP)
local function jourActuel(): number
	return os.time() // 86400
end
local function toursGratuitsRestants(profil: Profil): number
	local parJour = if profil.Possessions.Produits.PassVIP then 2 else 1
	if profil.DernierJourRoue ~= jourActuel() then
		return parJour
	end
	return math.max(parJour - profil.ToursGratuitsJour, 0)
end
-- Pass VIP : pièces x2
local function multiplicateurPieces(profil: Profil): number
	return if profil.Possessions.Produits.PassVIP then 2 else 1
end

local function versionPublique(profil: Profil)
	local niveau, xpDansNiveau, xpRequis = Config.NiveauDepuisXP(profil.XP)
	return {
		XP = profil.XP,
		Niveau = niveau,
		XPDansNiveau = xpDansNiveau,
		XPRequis = xpRequis,
		Record = profil.Record,
		Perso = profil.Perso,
		Pieces = profil.Pieces,
		Possessions = profil.Possessions,
		TutoFait = profil.TutoFait,
		VIP = profil.Possessions.Produits.PassVIP == true,
		ToursRoue = profil.ToursRoue,
		ToursGratuitsRestants = toursGratuitsRestants(profil),
		ProchainTourGratuit = 86400 - os.time() % 86400, -- secondes avant minuit (UTC)
	}
end

local function tropRapide(joueur: Player, action: string, delai: number): boolean
	local t = derniereAction[joueur]
	if not t then
		t = {}
		derniereAction[joueur] = t
	end
	local maintenant = os.clock()
	if t[action] and maintenant - t[action] < delai then
		return true
	end
	t[action] = maintenant
	return false
end

local function majClassement(joueur: Player, profil: Profil)
	local stats = joueur:FindFirstChild("leaderstats")
	if stats then
		(stats:FindFirstChild("Niveau") :: IntValue).Value = niveauDe(profil);
		(stats:FindFirstChild("Record") :: IntValue).Value = profil.Record
	end
end

local function sauvegarder(joueur: Player)
	local profil = profils[joueur]
	if not profil or not profil.Charge or not magasin then
		return
	end
	local donnees = { XP = profil.XP, Record = profil.Record, Perso = profil.Perso, Pieces = profil.Pieces, Possessions = profil.Possessions, TutoFait = profil.TutoFait,
		ToursRoue = profil.ToursRoue, DernierJourRoue = profil.DernierJourRoue, ToursGratuitsJour = profil.ToursGratuitsJour,
		SerieJours = profil.SerieJours, DernierJourConnexion = profil.DernierJourConnexion, JourSeriePris = profil.JourSeriePris }
	local ok, err = pcall(function()
		magasin:SetAsync("joueur_" .. joueur.UserId, donnees)
	end)
	if not ok then
		warn("[Golden Mall] Échec de sauvegarde pour " .. joueur.Name .. " : " .. tostring(err))
	end
end

local function chargerProfil(joueur: Player)
	local profil: Profil = {
		XP = 0,
		Record = 0,
		Perso = table.clone(Config.PersoParDefaut),
		Charge = magasin == nil,
		Pieces = 0,
		Possessions = { Couleurs = {}, Premium = {}, Produits = {}, Karts = {}, Trainees = {} },
		TutoFait = false,
		ToursRoue = 0,
		DernierJourRoue = 0,
		ToursGratuitsJour = 0,
		SerieJours = 0,
		DernierJourConnexion = 0,
		JourSeriePris = 0,
	}
	if magasin then
		local ok, donnees = pcall(function()
			return magasin:GetAsync("joueur_" .. joueur.UserId)
		end)
		if ok then
			profil.Charge = true
			if type(donnees) == "table" then
				profil.XP = type(donnees.XP) == "number" and math.max(0, math.floor(donnees.XP)) or 0
				profil.Record = type(donnees.Record) == "number" and math.max(0, math.floor(donnees.Record)) or 0
				profil.Pieces = type(donnees.Pieces) == "number" and math.max(0, math.floor(donnees.Pieces)) or 0
				profil.TutoFait = donnees.TutoFait == true
				profil.ToursRoue = type(donnees.ToursRoue) == "number" and math.clamp(math.floor(donnees.ToursRoue), 0, 9999) or 0
				profil.DernierJourRoue = type(donnees.DernierJourRoue) == "number" and donnees.DernierJourRoue or 0
				profil.ToursGratuitsJour = type(donnees.ToursGratuitsJour) == "number" and donnees.ToursGratuitsJour or 0
				profil.SerieJours = type(donnees.SerieJours) == "number" and donnees.SerieJours or 0
				profil.DernierJourConnexion = type(donnees.DernierJourConnexion) == "number" and donnees.DernierJourConnexion or 0
				profil.JourSeriePris = type(donnees.JourSeriePris) == "number" and donnees.JourSeriePris or 0
				if type(donnees.Possessions) == "table" then
					for _, liste in ipairs({ "Couleurs", "Premium", "Produits", "Karts", "Trainees" }) do
						if type(donnees.Possessions[liste]) == "table" then
							for nom, possede in pairs(donnees.Possessions[liste]) do
								if type(nom) == "string" and possede == true then
									profil.Possessions[liste][nom] = true
								end
							end
						end
					end
				end
				profil.Perso = KartBuilder.Nettoyer(donnees.Perso, (Config.NiveauDepuisXP(profil.XP)), profil.Possessions)
			end
		else
			-- On ne sauvegardera pas ce joueur, pour ne pas écraser ses vraies données
			warn("[Golden Mall] Chargement impossible pour " .. joueur.Name .. " : " .. tostring(donnees))
		end
	end
	profils[joueur] = profil

	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local niv = Instance.new("IntValue")
	niv.Name = "Niveau"
	niv.Parent = stats
	local rec = Instance.new("IntValue")
	rec.Name = "Record"
	rec.Parent = stats
	stats.Parent = joueur
	majClassement(joueur, profil)
end

---------------------------------------------------------------------
-- LES KARTS DES JOUEURS
---------------------------------------------------------------------
-- Assoit le joueur dans son kart (plusieurs essais si le premier rate).
-- On téléporte d'abord le personnage à côté du kart : sinon l'ordinateur du joueur
-- peut garder son personnage là où il était… et y ramener le kart !
local function asseoir(joueur: Player, kart: Model)
	task.spawn(function()
		local siege = kart:FindFirstChild("Siege") :: Seat?
		local perso = joueur.Character
		if siege and perso and perso.Parent then
			perso:PivotTo(siege.CFrame * CFrame.new(0, 3, 0))
			task.wait(0.2)
		end
		for _ = 1, 6 do
			local perso = joueur.Character
			local humanoide = perso and perso:FindFirstChildOfClass("Humanoid")
			if not siege or not siege.Parent or not humanoide or humanoide.Health <= 0 then
				return
			end
			if siege.Occupant == humanoide then
				return -- c'est bon, il est assis
			end
			if humanoide.SeatPart and humanoide.SeatPart ~= siege then
				humanoide.Sit = false
				task.wait(0.1)
			end
			if not siege.Occupant then
				siege:Sit(humanoide)
			end
			task.wait(0.25)
		end
	end)
end

-- CASQUE DE PILOTE : il apparaît quand on monte dans un kart (couleur du kart)
-- et disparaît quand on en descend. Soudé à la tête : marche en R6 et en R15.
local function mettreCasque(perso: Model, couleur: Color3)
	local tete = perso:FindFirstChild("Head") :: BasePart?
	if not tete or perso:FindFirstChild("CasquePilote") then
		return
	end
	local casque = Instance.new("Model")
	casque.Name = "CasquePilote"
	local function partie(nom: string, taille: Vector3, decalage: CFrame, c: Color3, matiere: Enum.Material, sphere: boolean): Part
		local p = Instance.new("Part")
		p.Name = nom
		p.Size = taille
		p.CFrame = tete.CFrame * decalage
		p.Color = c
		p.Material = matiere
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		if sphere then
			local m = Instance.new("SpecialMesh")
			m.MeshType = Enum.MeshType.Sphere
			m.Parent = p
		end
		local w = Instance.new("WeldConstraint")
		w.Part0 = tete
		w.Part1 = p
		w.Parent = p
		p.Parent = casque
		return p
	end
	partie("Coque", Vector3.new(1.55, 1.6, 1.65), CFrame.new(0, 0.12, 0.02), couleur, Enum.Material.SmoothPlastic, true).Reflectance = 0.15
	partie("Visiere", Vector3.new(1.15, 0.5, 0.5), CFrame.new(0, 0.08, -0.62), Color3.fromRGB(25, 30, 40), Enum.Material.Glass, true).Reflectance = 0.5
	partie("Bande", Vector3.new(0.28, 1.63, 1.68), CFrame.new(0, 0.12, 0.02), Color3.fromRGB(245, 245, 245), Enum.Material.SmoothPlastic, true)
	partie("Mentonniere", Vector3.new(1.2, 0.35, 0.7), CFrame.new(0, -0.48, -0.4), couleur:Lerp(Color3.new(0, 0, 0), 0.35), Enum.Material.SmoothPlastic, true)
	casque.Parent = perso
end

local function couleurDuKart(kart: Instance): Color3
	for _, d in ipairs(kart:GetDescendants()) do
		if d:IsA("BasePart") and d:GetAttribute("Peinture") == "Carrosserie" then
			return d.Color
		end
	end
	return Color3.fromRGB(215, 35, 40)
end

local function surveillerCasque(perso: Model)
	local humanoide = perso:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoide then
		return
	end
	humanoide:GetPropertyChangedSignal("SeatPart"):Connect(function()
		local siege = humanoide.SeatPart
		local kart = siege and siege.Parent
		if kart and kart:GetAttribute("KartType") then
			mettreCasque(perso, couleurDuKart(kart))
		else
			local ancien = perso:FindFirstChild("CasquePilote")
			if ancien then
				ancien:Destroy()
			end
		end
	end)
end
local function suivreJoueurCasque(j: Player)
	j.CharacterAdded:Connect(surveillerCasque)
	if j.Character then
		task.spawn(surveillerCasque, j.Character)
	end
end
Players.PlayerAdded:Connect(suivreJoueurCasque)
for _, j in ipairs(Players:GetPlayers()) do
	suivreJoueurCasque(j)
end

local function creerKart(joueur: Player, cf: CFrame, persoForce: { [string]: any }?): Model
	local profil = profils[joueur]
	local ancien = kartsJoueurs[joueur]
	if ancien then
		ancien:Destroy()
	end

	local kart = KartBuilder.Construire(persoForce or profil.Perso, cf, false)
	kart.Name = "Kart_" .. joueur.Name
	kart.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	kart:SetAttribute("Proprietaire", joueur.UserId)
	local chassis = kart.PrimaryPart :: BasePart
	local siege = kart:FindFirstChild("Siege") :: Seat

	local invite = Instance.new("ProximityPrompt")
	invite.ActionText = "Conduire"
	invite.ObjectText = "Kart de " .. joueur.DisplayName
	invite.HoldDuration = 0
	invite.MaxActivationDistance = 10
	invite.RequiresLineOfSight = false
	invite.Parent = siege
	invite.Triggered:Connect(function(qui: Player)
		if qui == joueur then
			asseoir(joueur, kart)
		end
	end)

	siege:GetPropertyChangedSignal("Occupant"):Connect(function()
		local humanoide = siege.Occupant
		if humanoide then
			local qui = Players:GetPlayerFromCharacter(humanoide.Parent)
			if qui ~= joueur then
				-- Seul le propriétaire peut conduire son kart
				local soudure = siege:FindFirstChild("SeatWeld")
				if soudure then
					soudure:Destroy()
				end
				return
			end
			invite.Enabled = false
			pcall(function()
				chassis:SetNetworkOwner(joueur)
			end)
		else
			invite.Enabled = true
			pcall(function()
				chassis:SetNetworkOwnershipAuto()
			end)
		end
	end)

	for _, p in ipairs(kart:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Karts"
		end
	end
	kart.Parent = dossierKarts
	kartsJoueurs[joueur] = kart
	return kart
end

-- F / « SORTIR MON KART » : le kart apparaît sur la ligne de départ dans le mall,
-- et le joueur est assis dedans automatiquement
-- Les places de départ :
--   • joueurs libres et FUGITIFS : la grille de départ, au SUD (24 places, face au nord)
--   • POLICIERS (mode en ligne) : au NORD, à l'opposé (18 places, face au sud)
local function placesDepart(role: string?): { CFrame }
	local liste = {}
	if role == "Police" then
		for _, z in ipairs({ -129, -136, -143 }) do
			for _, x in ipairs({ -5, 5, -15, 15, -25, 25 }) do
				local pos = Vector3.new(x, SOL + 0.6, z)
				table.insert(liste, CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))) -- face au sud
			end
		end
	else
		for _, dz in ipairs({ 7, 14, 21 }) do
			for _, x in ipairs({ -5, 5, -15, 15, -25, 25, -35, 35 }) do
				local pos = Vector3.new(x, SOL + 0.6, LIGNE_Z + dz)
				table.insert(liste, CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1))) -- face à la fontaine
			end
		end
	end
	return liste
end

local function placeLibre(role: string?): CFrame
	local liste = placesDepart(role)
	for _, cf in ipairs(liste) do
		local libre = true
		for _, k in pairs(kartsJoueurs) do
			if k.Parent and k.PrimaryPart and (k.PrimaryPart.Position - cf.Position).Magnitude < 7 then
				libre = false
			end
		end
		if libre then
			return cf
		end
	end
	return liste[math.random(1, #liste)] + Vector3.new(0, 3, 0)
end

-- Le kart du policier : la personnalisation du joueur, en blanc et bleu avec gyrophare
local function persoPolice(perso: { [string]: any }): { [string]: any }
	local p = table.clone(perso)
	p.Carrosserie = "Blanc"
	p.Finition = "Brillant"
	p.Bandes = "Bleu"
	p.BandesActives = true
	p.Neon = "Bleu"
	p.Police = true
	return p
end

-- Mettre le joueur au volant de son kart, sur la bonne place de départ.
-- avecDepart = true : survol de la map + feux 3, 2, 1, PARTEZ !
local function placerKart(joueur: Player, avecDepart: boolean, departCourt: boolean?): Model?
	local profil = profils[joueur]
	if not profil or joueur:GetAttribute("Arrete") then
		return nil -- (un fugitif arrêté attend la fin de la manche)
	end
	local perso = joueur.Character
	local racine = perso and perso:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoide = perso and perso:FindFirstChildOfClass("Humanoid")
	if not racine or not humanoide or humanoide.Health <= 0 then
		return nil
	end
	if humanoide.SeatPart then
		humanoide.Sit = false
	end
	local role = joueur:GetAttribute("Role")
	local cf = placeLibre(role)
	local kart = creerKart(joueur, cf, if role == "Police" then persoPolice(profil.Perso) else nil)
	if avecDepart then
		kart:SetAttribute("DepartHall", true)
		if departCourt then
			kart:SetAttribute("DepartCourt", true) -- juste 3, 2, 1 (sans le survol de la map)
		end
	end
	if role == nil then
		-- Mode libre : la police du mall laisse tranquille pendant le départ
		kart:SetAttribute("ProtegeJusqua", workspace:GetServerTimeNow() + 12)
	else
		-- Mode en ligne : les karts de la manche sont bloqués par la barrière de l'entrée
		for _, piece in ipairs(kart:GetDescendants()) do
			if piece:IsA("BasePart") then
				piece.CollisionGroup = "KartsManche"
			end
		end
		-- Mode en ligne : un repère au-dessus du kart (🚓 ou 🏃) pour reconnaître les équipes
		local repere = Instance.new("BillboardGui")
		repere.Name = "RepereEquipe"
		repere.Size = UDim2.new(0, 160, 0, 40)
		repere.StudsOffset = Vector3.new(0, 5, 0)
		repere.AlwaysOnTop = true
		repere.MaxDistance = 220
		repere.Parent = kart.PrimaryPart
		local etiquette = Instance.new("TextLabel")
		etiquette.Size = UDim2.fromScale(1, 1)
		etiquette.BackgroundTransparency = 1
		etiquette.TextScaled = true
		etiquette.Font = Enum.Font.GothamBlack
		etiquette.Text = (if role == "Police" then "🚓 " elseif role == "Battle" then "🔥 " else "🏃 ") .. joueur.DisplayName
		etiquette.TextColor3 = if role == "Police" then Color3.fromRGB(90, 150, 255) elseif role == "Battle" then Color3.fromRGB(255, 90, 170) else Color3.fromRGB(255, 150, 40)
		local contour = Instance.new("UIStroke")
		contour.Thickness = 2
		contour.Parent = etiquette
		etiquette.Parent = repere
	end
	asseoir(joueur, kart)
	-- Sécurité : on redonne le contrôle du kart au joueur (sinon il ne pourrait pas rouler)
	task.delay(1, function()
		local h = joueur.Character and joueur.Character:FindFirstChildOfClass("Humanoid")
		if kart.Parent and kart.PrimaryPart and h and h.SeatPart and h.SeatPart:IsDescendantOf(kart) then
			pcall(function()
				kart.PrimaryPart:SetNetworkOwner(joueur)
			end)
		end
	end)
	return kart
end

-- F / « SORTIR MON KART »
local function sortirKart(joueur: Player)
	if not profils[joueur] or tropRapide(joueur, "sortir", 1.5) then
		return
	end
	local humanoide = joueur.Character and joueur.Character:FindFirstChildOfClass("Humanoid")
	local ancien = kartsJoueurs[joueur]
	if ancien and humanoide and humanoide.SeatPart and humanoide.SeatPart:IsDescendantOf(ancien) then
		return -- déjà au volant
	end
	if joueur:GetAttribute("EnSalle") then
		return -- page d'attente : la manche va commencer
	end
	if TYPE == "Lobby" and not joueur:GetAttribute("EnTuto") then
		return -- dans le lobby, on ne roule pas (sauf pendant le tuto) : on choisit son mode dans le menu
	end
	-- Mode libre : départ avec le survol et les feux ; en manche : on repart tout de suite
	placerKart(joueur, joueur:GetAttribute("Role") == nil)
end

-- Pour le script des manches (ManchesServer)
local PlacerKart = Instance.new("BindableFunction")
PlacerKart.Name = "PlacerKart"
PlacerKart.OnInvoke = function(joueur: Player, avecDepart: boolean, departCourt: boolean?)
	return placerKart(joueur, avecDepart, departCourt)
end
PlacerKart.Parent = game:GetService("ServerStorage")
local RetirerKart = Instance.new("BindableFunction")
RetirerKart.Name = "RetirerKart"
RetirerKart.OnInvoke = function(joueur: Player)
	local humanoide = joueur.Character and joueur.Character:FindFirstChildOfClass("Humanoid")
	if humanoide and humanoide.SeatPart then
		humanoide.Sit = false
	end
	local kart = kartsJoueurs[joueur]
	if kart then
		kart:Destroy()
	end
	kartsJoueurs[joueur] = nil
	return true
end
RetirerKart.Parent = game:GetService("ServerStorage")

SortirKart.OnServerEvent:Connect(sortirKart)

-- Place Entraînement : en arrivant, le kart t'attend sur la ligne de départ
if TYPE == "Entrainement" then
	local function arrivee(joueur: Player)
		joueur.CharacterAdded:Connect(function()
			task.spawn(function()
				local debut = os.clock()
				while not profils[joueur] and os.clock() - debut < 15 do
					task.wait(0.3)
				end
				task.wait(1.5)
				if joueur.Parent and not kartsJoueurs[joueur] then
					placerKart(joueur, true)
				end
			end)
		end)
	end
	Players.PlayerAdded:Connect(arrivee)
	for _, j in ipairs(Players:GetPlayers()) do
		arrivee(j)
	end
end

-- Toutes les secondes : chaque joueur au volant doit avoir le contrôle physique
-- de son kart (sinon il ne peut pas avancer). On le lui redonne si besoin.
task.spawn(function()
	while true do
		task.wait(1)
		for joueur, kart in pairs(kartsJoueurs) do
			local chassis = kart.Parent and kart.PrimaryPart
			local h = joueur.Character and joueur.Character:FindFirstChildOfClass("Humanoid")
			if chassis and h and h.SeatPart and h.SeatPart:IsDescendantOf(kart) and not chassis.Anchored then
				local ok, proprietaire = pcall(function()
					return chassis:GetNetworkOwner()
				end)
				if ok and proprietaire ~= joueur then
					local reussi, erreur = pcall(function()
						chassis:SetNetworkOwner(joueur)
					end)
					if not reussi then
						warn(("[Golden Mall] Impossible de donner le kart à %s : %s"):format(joueur.Name, tostring(erreur)))
					end
				end
			end
		end
	end
end)

Personnaliser.OnServerEvent:Connect(function(joueur: Player, perso: any)
	local profil = profils[joueur]
	if not profil or tropRapide(joueur, "perso", 0.3) then
		return
	end
	local ancienType = profil.Perso.Kart
	profil.Perso = KartBuilder.Nettoyer(perso, niveauDe(profil), profil.Possessions)

	-- Met à jour le kart déjà sorti (sauf pendant une manche en ligne)
	local kart = kartsJoueurs[joueur]
	if kart and kart.Parent and joueur:GetAttribute("Role") == nil then
		if profil.Perso.Kart == ancienType then
			KartBuilder.Peindre(kart, profil.Perso)
		else
			local etaitAssis = (kart:FindFirstChild("Siege") :: Seat).Occupant ~= nil
			local nouveau = creerKart(joueur, (kart.PrimaryPart :: BasePart).CFrame + Vector3.new(0, 1, 0))
			if etaitAssis then
				asseoir(joueur, nouveau)
			end
		end
	end
	ProfilMisAJour:FireClient(joueur, versionPublique(profil))
end)

DriftTermine.OnServerEvent:Connect(function(joueur: Player, points: any)
	local profil = profils[joueur]
	if not profil or type(points) ~= "number" or points ~= points or tropRapide(joueur, "drift", 0.3) then
		return
	end
	-- Le joueur doit être assis dans SON kart
	local kart = kartsJoueurs[joueur]
	local humanoide = joueur.Character and joueur.Character:FindFirstChildOfClass("Humanoid")
	if not kart or not humanoide or not humanoide.SeatPart or not humanoide.SeatPart:IsDescendantOf(kart) then
		return
	end
	points = math.clamp(math.floor(points), 0, Config.Score.MaxParDrift)
	DriftEnregistre:Fire(joueur, points)

	local niveauAvant = niveauDe(profil)
	profil.XP += points
	profil.Pieces += math.floor(points / ((Config.Monnaie and Config.Monnaie.PointsParPiece) or 20)) * multiplicateurPieces(profil)
	if points > profil.Record then
		profil.Record = points
	end
	local niveauApres = niveauDe(profil)
	majClassement(joueur, profil)
	ProfilMisAJour:FireClient(joueur, versionPublique(profil), niveauApres > niveauAvant and niveauApres or nil)
end)

AjouterXP.Event:Connect(function(joueur: Player, quantite: number)
	local profil = profils[joueur]
	if not profil or type(quantite) ~= "number" then
		return
	end
	local niveauAvant = niveauDe(profil)
	profil.XP += math.max(0, math.floor(quantite))
	profil.Pieces += math.floor(math.max(0, quantite) / ((Config.Monnaie and Config.Monnaie.XPParPiece) or 10)) * multiplicateurPieces(profil)
	local niveauApres = niveauDe(profil)
	majClassement(joueur, profil)
	ProfilMisAJour:FireClient(joueur, versionPublique(profil), niveauApres > niveauAvant and niveauApres or nil)
end)

do
-- Donner des pièces depuis un autre script (récompenses du classement de la semaine…)
do
	local AjouterPieces = Instance.new("BindableEvent")
	AjouterPieces.Name = "AjouterPieces"
	AjouterPieces.Parent = game:GetService("ServerStorage")
	AjouterPieces.Event:Connect(function(joueur: Player, quantite: number, message: string?)
		local profil = profils[joueur]
		if not profil or type(quantite) ~= "number" or quantite <= 0 then
			return
		end
		profil.Pieces += math.floor(quantite)
		task.spawn(sauvegarder, joueur)
		ProfilMisAJour:FireClient(joueur, versionPublique(profil))
		if message then
			Alerte:FireClient(joueur, { etat = "message", texte = message })
		end
	end)
end

-- TITRES au-dessus des joueurs (donne envie de progresser… et d'avoir le VIP)
do
	local function titreDe(joueur: Player, profil: Profil): (string, Color3)
		if profil.Possessions.Produits.PassVIP then
			return "👑 VIP", Color3.fromRGB(255, 205, 60)
		elseif (joueur:GetAttribute("RecordBattle") or 0) >= 3000 then
			return "🔥 ROI DU DRIFT", Color3.fromRGB(255, 120, 60)
		elseif niveauDe(profil) >= 10 then
			return "⭐ PILOTE PRO", Color3.fromRGB(120, 200, 255)
		end
		return "PILOTE", Color3.fromRGB(220, 220, 230)
	end
	task.spawn(function()
		while true do
			for _, joueur in ipairs(Players:GetPlayers()) do
				local profil = profils[joueur]
				local tete = joueur.Character and joueur.Character:FindFirstChild("Head")
				if profil and tete then
					local panneau = tete:FindFirstChild("TitreJoueur") :: BillboardGui?
					if not panneau then
						local p = Instance.new("BillboardGui")
						p.Name = "TitreJoueur"
						p.Size = UDim2.fromOffset(160, 40)
						p.StudsOffset = Vector3.new(0, 3.2, 0)
						p.MaxDistance = 70
						p.LightInfluence = 0
						p.Parent = tete
						local titre = Instance.new("TextLabel")
						titre.Name = "Titre"
						titre.Size = UDim2.new(1, 0, 0.55, 0)
						titre.BackgroundTransparency = 1
						titre.Font = Enum.Font.FredokaOne
						titre.TextScaled = true
						titre.Parent = p
						local contour = Instance.new("UIStroke")
						contour.Thickness = 2
						contour.Parent = titre
						local niveau = Instance.new("TextLabel")
						niveau.Name = "Niveau"
						niveau.Size = UDim2.new(1, 0, 0.42, 0)
						niveau.Position = UDim2.fromScale(0, 0.58)
						niveau.BackgroundTransparency = 1
						niveau.Font = Enum.Font.FredokaOne
						niveau.TextScaled = true
						niveau.TextColor3 = Color3.new(1, 1, 1)
						niveau.Parent = p
						local contour2 = Instance.new("UIStroke")
						contour2.Thickness = 2
						contour2.Parent = niveau
						panneau = p
					end
					local p = panneau :: BillboardGui
					local texteTitre, couleur = titreDe(joueur, profil)
					local titre = p:FindFirstChild("Titre") :: TextLabel
					titre.Text = texteTitre
					titre.TextColor3 = couleur
					local etiquetteNiveau = p:FindFirstChild("Niveau") :: TextLabel
					etiquetteNiveau.Text = ("NIV. %d"):format(niveauDe(profil))
					-- (pendant une manche, c'est l'étiquette du kart qui compte)
					p.Enabled = joueur:GetAttribute("Role") == nil
				end
			end
			task.wait(3)
		end
	end)
end

---------------------------------------------------------------------
-- LES ACHATS
--   • couleurs : avec les pièces 💰 gagnées en jouant
--   • peintures premium + magasin : en Robux (produits pour développeurs).
--     Dans Studio, tant que ProduitId = 0, c'est gratuit (pour tester).
---------------------------------------------------------------------
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local Acheter = Instance.new("RemoteFunction")
Acheter.Name = "Acheter"
Acheter.Parent = remotes

local function accorderProduit(joueur: Player, profil: Profil, produit: { [string]: any })
	if produit.Pieces then
		profil.Pieces += produit.Pieces
	end
	if produit.Premium then
		profil.Possessions.Premium[produit.Premium] = true
	end
	for _, nom in ipairs(produit.Premiums or {}) do
		profil.Possessions.Premium[nom] = true
	end
	if produit.Trainee and Config.Trainee(produit.Trainee) then
		profil.Possessions.Trainees[produit.Trainee] = true
	end
	if produit.Tours then
		profil.ToursRoue += produit.Tours
	end
	if produit.Vengeance then
		-- ⚡ VENGEANCE (mode Police contre Fugitifs) : géré par ManchesServer
		local appliquer = game:GetService("ServerStorage"):FindFirstChild("AppliquerVengeance") :: BindableFunction?
		local ok = appliquer and appliquer:Invoke(joueur)
		if not ok then
			profil.Pieces += 250 -- (la manche était finie : on dédommage en pièces)
		end
	end
	if produit.Kart and Config.Karts[produit.Kart] and Config.Karts[produit.Kart].Exclusif then
		profil.Possessions.Karts[produit.Kart] = true -- kart exclusif débloqué
	end
	if produit.Id then
		profil.Possessions.Produits[produit.Id] = true
	end
	if produit.Nom and Config.PeinturePremium(produit.Nom) then
		profil.Possessions.Premium[produit.Nom] = true
	end
	ProfilMisAJour:FireClient(joueur, versionPublique(profil))
end

-- Retrouve ce qu'on vend à partir du numéro de produit Roblox
local function produitDepuisId(produitId: number): { [string]: any }?
	for _, peinture in ipairs(Config.PeinturesPremium or {}) do
		if peinture.ProduitId ~= 0 and peinture.ProduitId == produitId then
			return peinture
		end
	end
	for _, offre in ipairs(Config.Boutique or {}) do
		if offre.ProduitId ~= 0 and offre.ProduitId == produitId then
			return offre
		end
	end
	for _, k in pairs(Config.Karts) do
		if k.Exclusif and k.ProduitId ~= 0 and k.ProduitId == produitId then
			return k
		end
	end
	local vengeance = Config.Partie and Config.Partie.ProduitVengeance or 0
	if vengeance ~= 0 and vengeance == produitId then
		return { Vengeance = true, Nom = "Vengeance" }
	end
	return nil
end

Acheter.OnServerInvoke = function(joueur: Player, info: any)
	local profil = profils[joueur]
	if not profil or type(info) ~= "table" or tropRapide(joueur, "achat", 0.3) then
		return { ok = false, message = "Patiente un instant…" }
	end
	if info.type == "couleur" then
		local c = type(info.nom) == "string" and Config.Couleur(info.nom)
		if not c then
			return { ok = false, message = "Couleur inconnue." }
		end
		if (c.Prix or 0) == 0 or profil.Possessions.Couleurs[c.Nom] then
			return { ok = true, message = "Tu l'as déjà !", profil = versionPublique(profil) }
		end
		if profil.Pieces < c.Prix then
			return { ok = false, message = ("Il te manque %d 💰 : drifte pour en gagner !"):format(c.Prix - profil.Pieces) }
		end
		profil.Pieces -= c.Prix
		profil.Possessions.Couleurs[c.Nom] = true
		task.spawn(sauvegarder, joueur)
		return { ok = true, message = ("%s achetée ! -%d 💰"):format(c.Nom, c.Prix), profil = versionPublique(profil) }
	elseif info.type == "test" then
		-- Achat Robux pas encore configuré : gratuit dans Studio pour tester
		if not RunService:IsStudio() then
			return { ok = false, message = "Ce produit n'est pas encore en vente." }
		end
		local produit = type(info.nom) == "string" and (Config.PeinturePremium(info.nom) or nil)
		if not produit then
			for _, offre in ipairs(Config.Boutique or {}) do
				if offre.Id == info.nom then
					produit = offre
				end
			end
		end
		if not produit and type(info.nom) == "string" and Config.Karts[info.nom] and Config.Karts[info.nom].Exclusif then
			produit = Config.Karts[info.nom]
		end
		if not produit then
			return { ok = false, message = "Produit inconnu." }
		end
		accorderProduit(joueur, profil, produit)
		return { ok = true, message = "(Test Studio : gratuit) " .. tostring(produit.Nom) .. " débloqué !", profil = versionPublique(profil) }
	end
	return { ok = false, message = "Achat inconnu." }
end

-- 🎡 LA ROUE DU JOUR : c'est le SERVEUR qui tire le cadeau (impossible de tricher)
local RoueDuJour = Instance.new("RemoteFunction")
RoueDuJour.Name = "RoueDuJour"
RoueDuJour.Parent = remotes
local aleaRoue = Random.new()

local function tirerCase(): number
	local total = 0
	for _, case in ipairs(Config.Roue) do
		total += case.Poids
	end
	local tirage = aleaRoue:NextNumber(0, total)
	for i, case in ipairs(Config.Roue) do
		tirage -= case.Poids
		if tirage <= 0 then
			return i
		end
	end
	return 1
end

local function auHasard(liste: { string }): string?
	if #liste == 0 then
		return nil
	end
	return liste[aleaRoue:NextInteger(1, #liste)]
end

-- Donne le cadeau de la case ; renvoie le texte affiché au joueur
local function donnerCadeau(joueur: Player, profil: Profil, case: { [string]: any }): string
	local bonus = multiplicateurPieces(profil)
	local function pieces(n: number): string
		profil.Pieces += n * bonus
		return ("+%d 💰%s"):format(n * bonus, if bonus > 1 then " (VIP x2)" else "")
	end
	if case.Type == "Pieces" then
		return pieces(case.Valeur)
	elseif case.Type == "XP" then
		profil.XP += case.Valeur
		majClassement(joueur, profil)
		return ("+%d XP"):format(case.Valeur)
	elseif case.Type == "Couleur" then
		local possibles = {}
		for _, c in ipairs(Config.Couleurs) do
			if (c.Prix or 0) > 0 and not profil.Possessions.Couleurs[c.Nom] then
				table.insert(possibles, c.Nom)
			end
		end
		local nom = auHasard(possibles)
		if nom then
			profil.Possessions.Couleurs[nom] = true
			return ("Nouvelle couleur : %s 🎨"):format(nom)
		end
		return pieces(case.Valeur) .. " (tu as déjà toutes les couleurs)"
	elseif case.Type == "Trainee" then
		local possibles = {}
		for _, t in ipairs(Config.Trainees) do
			if t.Couleurs and not profil.Possessions.Trainees[t.Nom] then
				table.insert(possibles, t.Nom)
			end
		end
		local nom = auHasard(possibles)
		if nom then
			profil.Possessions.Trainees[nom] = true
			return ("Traînée %s débloquée ! ✨"):format(nom)
		end
		return pieces(case.Valeur) .. " (tu as déjà toutes les traînées)"
	elseif case.Type == "Kart" then
		if not profil.Possessions.Karts.Galaxie then
			profil.Possessions.Karts.Galaxie = true
			return "🦄 JACKPOT ! Le kart Licorne Galaxie est à toi !"
		end
		return "JACKPOT ! " .. pieces(case.Valeur)
	end
	return ""
end

RoueDuJour.OnServerInvoke = function(joueur: Player, action: any)
	local profil = profils[joueur]
	if not profil then
		return { ok = false, message = "Profil pas encore chargé…" }
	end
	if action ~= "lancer" then
		return { ok = true, profil = versionPublique(profil) }
	end
	if tropRapide(joueur, "roue", 4) then
		return { ok = false, message = "La roue tourne encore !" }
	end
	-- D'abord le tour gratuit du jour, sinon un tour acheté
	if toursGratuitsRestants(profil) > 0 then
		if profil.DernierJourRoue ~= jourActuel() then
			profil.DernierJourRoue = jourActuel()
			profil.ToursGratuitsJour = 0
		end
		profil.ToursGratuitsJour += 1
	elseif profil.ToursRoue > 0 then
		profil.ToursRoue -= 1
	else
		return { ok = false, message = "Plus de tour aujourd'hui : reviens demain, ou achète des tours au magasin !" }
	end
	local indice = tirerCase()
	local cadeau = donnerCadeau(joueur, profil, Config.Roue[indice])
	task.spawn(sauvegarder, joueur)
	-- (le joueur voit son profil à jour quand la roue s'arrête)
	task.delay(5.5, function()
		if profils[joueur] then
			ProfilMisAJour:FireClient(joueur, versionPublique(profil))
		end
	end)
	return { ok = true, indice = indice, message = cadeau, profil = versionPublique(profil) }
end

-- 🎁 CADEAUX GRATUITS : temps de jeu, série de connexion, amis, groupe
do
	local Cadeaux = Instance.new("RemoteFunction")
	Cadeaux.Name = "Cadeaux"
	Cadeaux.Parent = remotes
	local C = Config.Cadeaux or {}
	local debutSession: { [Player]: number } = {}
	local cadeauxPris: { [Player]: { [number]: boolean } } = {}
	local amisDejaRecompenses: { [string]: boolean } = {}

	local function donner(joueur: Player, profil: Profil, c: { [string]: any })
		if c.Pieces then
			profil.Pieces += c.Pieces
		end
		if c.Tours then
			profil.ToursRoue += c.Tours
		end
		task.spawn(sauvegarder, joueur)
		ProfilMisAJour:FireClient(joueur, versionPublique(profil))
	end

	-- Met à jour la série de connexion (appelé quand le joueur regarde ses cadeaux)
	local function majSerie(profil: Profil)
		local aujourdhui = jourActuel()
		if profil.DernierJourConnexion ~= aujourdhui then
			if profil.DernierJourConnexion == aujourdhui - 1 then
				profil.SerieJours = profil.SerieJours % #(C.Serie or { 1 }) + 1
			else
				profil.SerieJours = 1 -- (série cassée : on recommence au jour 1)
			end
			profil.DernierJourConnexion = aujourdhui
		end
	end

	local function etat(joueur: Player, profil: Profil)
		majSerie(profil)
		local minutes = (os.clock() - (debutSession[joueur] or os.clock())) / 60
		local temps = {}
		for i, c in ipairs(C.TempsDeJeu or {}) do
			temps[i] = {
				texte = Config.TexteCadeau(c),
				minutes = c.Minutes,
				pret = minutes >= c.Minutes and not (cadeauxPris[joueur] and cadeauxPris[joueur][i]),
				pris = cadeauxPris[joueur] ~= nil and cadeauxPris[joueur][i] == true,
				reste = math.max(0, math.ceil(c.Minutes * 60 - minutes * 60)),
			}
		end
		return {
			temps = temps,
			serieJour = profil.SerieJours,
			seriePrete = profil.JourSeriePris ~= jourActuel(),
			groupe = (C.GroupeId or 0) ~= 0 and not profil.Possessions.Produits.BonusGroupe,
		}
	end

	Cadeaux.OnServerInvoke = function(joueur: Player, action: any, indice: any)
		local profil = profils[joueur]
		if not profil then
			return nil
		end
		if tropRapide(joueur, "cadeau", 0.3) then
			return etat(joueur, profil)
		end
		if action == "temps" and type(indice) == "number" then
			local c = (C.TempsDeJeu or {})[indice]
			local minutes = (os.clock() - (debutSession[joueur] or os.clock())) / 60
			cadeauxPris[joueur] = cadeauxPris[joueur] or {}
			if c and minutes >= c.Minutes and not cadeauxPris[joueur][indice] then
				cadeauxPris[joueur][indice] = true
				donner(joueur, profil, c)
			end
		elseif action == "serie" then
			majSerie(profil)
			local c = (C.Serie or {})[profil.SerieJours]
			if c and profil.JourSeriePris ~= jourActuel() then
				profil.JourSeriePris = jourActuel()
				donner(joueur, profil, c)
			end
		elseif action == "groupe" and (C.GroupeId or 0) ~= 0 and not profil.Possessions.Produits.BonusGroupe then
			local ok, membre = pcall(function()
				return joueur:IsInGroup(C.GroupeId)
			end)
			if ok and membre then
				profil.Possessions.Produits.BonusGroupe = true
				donner(joueur, profil, { Pieces = C.BonusGroupe or 500 })
			end
		end
		return etat(joueur, profil)
	end

	-- Jouer avec un ami = bonus pour les deux
	local function arrivee(joueur: Player)
		debutSession[joueur] = os.clock()
		task.delay(8, function()
			for _, autre in ipairs(Players:GetPlayers()) do
				if autre ~= joueur and joueur.Parent then
					local cle = if joueur.UserId < autre.UserId then (joueur.UserId .. "_" .. autre.UserId) else (autre.UserId .. "_" .. joueur.UserId)
					local ok, amis = pcall(function()
						return joueur:IsFriendsWith(autre.UserId)
					end)
					if ok and amis and not amisDejaRecompenses[cle] then
						amisDejaRecompenses[cle] = true
						for _, j in ipairs({ joueur, autre }) do
							local p = profils[j]
							if p then
								donner(j, p, { Pieces = C.BonusAmi or 150 })
								Alerte:FireClient(j, { etat = "message", texte = ("👥 TU JOUES AVEC TON AMI ! +%d 💰"):format(C.BonusAmi or 150) })
							end
						end
					end
				end
			end
		end)
	end
	Players.PlayerAdded:Connect(arrivee)
	for _, j in ipairs(Players:GetPlayers()) do
		arrivee(j)
	end
	Players.PlayerRemoving:Connect(function(j)
		debutSession[j] = nil
		cadeauxPris[j] = nil
	end)
end

-- Les achats en Robux : Roblox appelle cette fonction quand un paiement a réussi
MarketplaceService.ProcessReceipt = function(recu)
	local joueur = Players:GetPlayerByUserId(recu.PlayerId)
	local profil = joueur and profils[joueur]
	local produit = produitDepuisId(recu.ProductId)
	if not joueur or not profil or not produit or not profil.Charge then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- Roblox réessaiera plus tard
	end
	local recus = profil.Possessions.Produits
	local cle = "recu_" .. tostring(recu.PurchaseId)
	if not recus[cle] then
		recus[cle] = true -- (pour ne jamais donner deux fois le même achat)
		accorderProduit(joueur, profil, produit)
	end
	local ok = pcall(sauvegarder, joueur)
	return if ok then Enum.ProductPurchaseDecision.PurchaseGranted else Enum.ProductPurchaseDecision.NotProcessedYet
end

ObtenirProfil.OnServerInvoke = function(joueur: Player)
	local debut = os.clock()
	while not profils[joueur] and os.clock() - debut < 15 do
		task.wait(0.2)
	end
	local profil = profils[joueur]
	return profil and versionPublique(profil) or nil
end

-- TUTO SUR LA PISTE : le joueur reçoit un kart sur la ligne de départ (3, 2, 1)
DebutTuto.OnServerEvent:Connect(function(joueur: Player)
	if not profils[joueur] or tropRapide(joueur, "tuto", 3) or joueur:GetAttribute("EnSalle") then
		return
	end
	joueur:SetAttribute("EnTuto", true)
	placerKart(joueur, false) -- directement sur la piste, sans décompte
end)

TutoTermine.OnServerEvent:Connect(function(joueur: Player)
	local profil = profils[joueur]
	if profil and not profil.TutoFait then
		profil.TutoFait = true
		task.spawn(sauvegarder, joueur)
	end
	if joueur:GetAttribute("EnTuto") then
		joueur:SetAttribute("EnTuto", nil)
		if TYPE == "Lobby" then
			-- Au lobby, on ne garde pas le kart : retour au garage pour choisir son mode
			local kart = kartsJoueurs[joueur]
			if kart then
				kart:Destroy()
				kartsJoueurs[joueur] = nil
			end
			task.wait(0.2)
			if joueur.Parent then
				joueur:LoadCharacter()
			end
		end
	end
end)

Players.PlayerAdded:Connect(chargerProfil)
for _, j in ipairs(Players:GetPlayers()) do
	task.spawn(chargerProfil, j)
end

Players.PlayerRemoving:Connect(function(joueur: Player)
	sauvegarder(joueur)
	if kartsJoueurs[joueur] then
		kartsJoueurs[joueur]:Destroy()
	end
	kartsJoueurs[joueur] = nil
	profils[joueur] = nil
	derniereAction[joueur] = nil
end)

game:BindToClose(function()
	for _, j in ipairs(Players:GetPlayers()) do
		sauvegarder(j)
	end
end)

-- Sauvegarde automatique toutes les 2 minutes
task.spawn(function()
	while true do
		task.wait(120)
		for _, j in ipairs(Players:GetPlayers()) do
			sauvegarder(j)
		end
	end
end)

print("[Golden Mall] Le Golden Mall de Dubaï est prêt ! Garage VIP ouvert.")

end -- (bloc : garde le nombre de variables du script sous la limite de Roblox)]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX4"><Properties><string name="Name">ManchesServer</string><ProtectedString name="Source"><![CDATA[--[[
	ManchesServer  (Script)
	À placer dans : ServerScriptService   — nom conseillé : ManchesServer

	LE MODE EN LIGNE « POLICE CONTRE FUGITIFS »
	  1. ATTENTE : en arrivant, on est LIBRE (garage, personnalisation, balade).
	     Les joueurs qui veulent jouer cliquent sur « LANCER UNE PARTIE » (ils sont
	     « prêts »). Il faut au moins Config.Partie.JoueursMin joueurs prêts
	     (s'il en manque, des BOTS DE TEST complètent : Config.Partie.BotsTest)
	  2. PAGE D'ATTENTE : les joueurs ne roulent pas, ils attendent sur une page
	     (caméra qui survole le mall) avec un compte à rebours
	  3. TIRAGE AU SORT : la moitié des participants devient POLICE, l'autre FUGITIFS
	  4. MANCHE : l'entrée du mall se ferme. Les fugitifs partent au SUD, la police
	     au NORD (à l'opposé). Feux 3, 2, 1, PARTEZ pour tout le monde, mais la
	     police reste bloquée quelques secondes de plus (l'avance des fugitifs).
	     Un policier qui colle un fugitif l'ARRÊTE.
	  5. FIN : la police gagne si tous les fugitifs sont arrêtés, sinon les
	     fugitifs gagnent à la fin du temps. XP pour tout le monde, bonus aux gagnants.
	Pendant une manche, la police du mall (ordinateur) se met en pause.
]]

local Players = game:GetService("Players")
local Teams = game:GetService("Teams")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local PathfindingService = game:GetService("PathfindingService")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
local remotes = ReplicatedStorage:WaitForChild("MallDriftRemotes")
local AjouterXP = ServerStorage:WaitForChild("AjouterXP") :: BindableEvent
local PlacerKart = ServerStorage:WaitForChild("PlacerKart") :: BindableFunction
local RetirerKart = ServerStorage:WaitForChild("RetirerKart") :: BindableFunction
local carte = workspace:WaitForChild("GoldenMall")
local dossierKarts = workspace:WaitForChild("KartsJoueurs")

local P = Config.Partie or {}
local TYPE = Config.TypeDePlace() -- "ToutEnUn", "Lobby", "PoliceFugitifs", "DriftBattle", "Entrainement"...
local TeleportService = game:GetService("TeleportService")

-- Renvoie des joueurs au lobby (expérience à plusieurs places), le menu s'y ouvrira
local function retourAuLobby(joueurs: { Player }): boolean
	if (Config.Places and Config.Places.Lobby or 0) == 0 or #joueurs == 0 then
		return false
	end
	local options = Instance.new("TeleportOptions")
	options:SetTeleportData({ ouvrirMenu = true })
	local ok, erreur = pcall(function()
		TeleportService:TeleportAsync(Config.Places.Lobby, joueurs, options)
	end)
	if not ok then
		warn("[Manches] Retour au lobby impossible : " .. tostring(erreur))
	end
	return ok
end
local JOUEURS_MIN = P.JoueursMin or 2
local INTERMISSION = P.Intermission or 20
local DUREE = P.DureeManche or 300
local AVANCE = P.AvanceFugitifs or 8
local DISTANCE_ARRESTATION = P.DistanceArrestation or 8
-- Bots de test : SEULEMENT dans Studio. Dans le jeu publié, les parties en ligne
-- se jouent uniquement entre vraies personnes.
local BOTS_TEST = if game:GetService("RunService"):IsStudio() then (P.BotsTest or 0) else 0
local SOL = 1
local HAUTEUR_ETAGE = SOL + 25

local Partie = Instance.new("RemoteEvent")
Partie.Name = "Partie"
Partie.Parent = remotes

local dossierBots = Instance.new("Folder")
dossierBots.Name = "BotsManche"
dossierBots.Parent = workspace

---------------------------------------------------------------------
-- Les équipes (visibles dans le tableau des joueurs)
---------------------------------------------------------------------
local function equipe(nom: string, couleur: BrickColor, auto: boolean): Team
	local t = Instance.new("Team")
	t.Name = nom
	t.TeamColor = couleur
	t.AutoAssignable = auto
	t.Parent = Teams
	return t
end
local EQUIPE_POLICE = equipe("Police", BrickColor.new("Bright blue"), false)
local EQUIPE_FUGITIFS = equipe("Fugitifs", BrickColor.new("Bright orange"), false)
local EQUIPE_VISITEURS = equipe("Visiteurs", BrickColor.new("Institutional white"), true)
local EQUIPE_BATTLE = equipe("Drift Battle", BrickColor.new("Hot pink"), false)

---------------------------------------------------------------------
-- LES SCORES DE DRIFT pendant une manche (classement de fin)
---------------------------------------------------------------------
type Score = { total: number, meilleur: number }
local scoresDrift: { [Player]: Score } = {}
local DriftEnregistre = ServerStorage:WaitForChild("DriftEnregistre") :: BindableEvent
DriftEnregistre.Event:Connect(function(joueur: Player, points: number)
	local sc = scoresDrift[joueur]
	if sc and workspace:GetAttribute("MancheEnCours") and joueur:GetAttribute("Role") ~= nil then
		sc.total += points
		if points > sc.meilleur then
			sc.meilleur = points
		end
	end
end)

-- Le classement des drifts : du plus grand total au plus petit
local function classementDrifts(): { { nom: string, total: number, meilleur: number } }
	local liste = {}
	for joueur, sc in pairs(scoresDrift) do
		if joueur.Parent then
			table.insert(liste, { nom = joueur.DisplayName, total = sc.total, meilleur = sc.meilleur, joueur = joueur })
		end
	end
	table.sort(liste, function(a, b)
		return a.total > b.total
	end)
	return liste
end

---------------------------------------------------------------------
-- Un participant = un vrai joueur OU un bot de test
---------------------------------------------------------------------
type Participant = {
	nom: string,
	joueur: Player?,
	bot: { [string]: any }?,
	role: string?,
	arrete: boolean, -- éliminé (plus de vies)
	vies: number?,
	attente: boolean?, -- vient de perdre une vie : choisit RÉAPPARAÎTRE ou VENGEANCE
	tueur: any?, -- le participant qui lui a fait perdre sa dernière vie
	protegeJusqua: number?,
}
local participantsManche: { Participant } = {} -- (la manche en cours)
local perdreVie: (Participant, Participant) -> ()

local function present(p: Participant): boolean
	if p.joueur then
		return p.joueur.Parent ~= nil
	end
	return p.bot ~= nil and p.bot.modele.Parent ~= nil
end

local function positionDe(p: Participant): Vector3?
	if p.joueur then
		local racine = p.joueur.Character and p.joueur.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		return racine and racine.Position or nil
	end
	return p.bot and p.bot.racine.Position or nil
end

-- Position du KART d'un participant (son centre), ou du personnage s'il est à pied.
-- C'est ce qu'on compare pour les arrestations : dès que les karts se touchent
-- (de face, par derrière ou de côté), c'est gagné.
local function positionKart(p: Participant): Vector3?
	if p.bot then
		local chassis = p.bot.modele:FindFirstChild("Chassis") :: BasePart?
		return if chassis then chassis.Position else p.bot.racine.Position
	end
	local j = p.joueur :: Player
	for _, kart in ipairs(dossierKarts:GetChildren()) do
		if kart:GetAttribute("Proprietaire") == j.UserId and (kart :: Model).PrimaryPart then
			local h = j.Character and j.Character:FindFirstChildOfClass("Humanoid")
			if h and h.SeatPart and h.SeatPart:IsDescendantOf(kart) then
				return ((kart :: Model).PrimaryPart :: BasePart).Position
			end
		end
	end
	return positionDe(p)
end

local function distanceAPlat(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

-- Un policier ne peut arrêter qu'au volant de son kart
local function auVolant(p: Participant): boolean
	if p.bot then
		return true
	end
	local j = p.joueur :: Player
	local humanoide = j.Character and j.Character:FindFirstChildOfClass("Humanoid")
	if not humanoide or not humanoide.SeatPart then
		return false
	end
	for _, kart in ipairs(dossierKarts:GetChildren()) do
		if kart:GetAttribute("Proprietaire") == j.UserId and humanoide.SeatPart:IsDescendantOf(kart) then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------
-- LES BOTS DE TEST (un personnage dans un kart, piloté par l'ordinateur)
---------------------------------------------------------------------
local NOMS_BOTS = { "Bot Max", "Bot Léa", "Bot Sam", "Bot Inès", "Bot Tom", "Bot Nina" }
local ANIM_ASSIS = "rbxassetid://2506281703"

-- Des points dans les allées du rez-de-chaussée (pour se balader / fuir)
local POINTS_FUITE = {}
for x = -190, 190, 40 do
	table.insert(POINTS_FUITE, Vector3.new(x, SOL + 3, -137))
	table.insert(POINTS_FUITE, Vector3.new(x, SOL + 3, 137))
	if math.abs(x) > 45 then
		table.insert(POINTS_FUITE, Vector3.new(x, SOL + 3, 0))
	end
end
for _, x in ipairs({ -173, -99, 99, 173 }) do
	for _, z in ipairs({ -90, -50, 50, 90 }) do
		table.insert(POINTS_FUITE, Vector3.new(x, SOL + 3, z))
	end
end
for _, z in ipairs({ -100, -60, 60 }) do
	table.insert(POINTS_FUITE, Vector3.new(0, SOL + 3, z))
end

local function souder(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

local function creerBot(nom: string, role: string, cf: CFrame)
	local police = role == "Police"
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = Color3.fromRGB(230, 185, 140)
	description.TorsoColor = if police then Color3.fromRGB(28, 42, 92) else Color3.fromRGB(240, 130, 30)
	description.LeftArmColor = description.TorsoColor
	description.RightArmColor = description.TorsoColor
	description.LeftLegColor = Color3.fromRGB(30, 30, 36)
	description.RightLegColor = Color3.fromRGB(30, 30, 36)
	local ok, modele = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not modele then
		return nil
	end
	modele.Name = nom
	local hum = modele:FindFirstChildOfClass("Humanoid") :: Humanoid
	local racine = modele:FindFirstChild("HumanoidRootPart") :: BasePart
	local animate = modele:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HipHeight = 0.7
	hum.WalkSpeed = if police then (P.VitesseBotPolice or 40) else (P.VitesseBotFugitif or 36)
	modele:PivotTo(cf + Vector3.new(0, 2.5, 0))

	-- Le kart sous le bot
	local base = racine.CFrame * CFrame.new(0, -(0.7 + racine.Size.Y / 2) + 0.45, 0.6)
	local function piece(n: string, taille: Vector3, decalage: CFrame, couleur: Color3, matiere: Enum.Material?, forme: Enum.PartType?)
		local p = Instance.new("Part")
		p.Name = n
		p.Size = taille
		p.CFrame = base * decalage
		p.Color = couleur
		p.Material = matiere or Enum.Material.SmoothPlastic
		p.Shape = forme or Enum.PartType.Block
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		souder(racine, p)
		p.Parent = modele
		return p
	end
	piece("Chassis", Vector3.new(4, 0.8, 6), CFrame.new(), if police then Color3.fromRGB(240, 242, 248) else Color3.fromRGB(255, 140, 30))
	for _, cote in ipairs({ -1, 1 }) do
		piece("Roue", Vector3.new(0.8, 1.6, 1.6), CFrame.new(cote * 2.2, 0.2, -2.3), Color3.fromRGB(20, 20, 20), nil, Enum.PartType.Cylinder)
		piece("Roue", Vector3.new(0.7, 1.3, 1.3), CFrame.new(cote * 2.1, 0.05, 2.4), Color3.fromRGB(20, 20, 20), nil, Enum.PartType.Cylinder)
	end
	if police then
		piece("BandeBleue", Vector3.new(4.05, 0.3, 5.6), CFrame.new(0, 0.1, 0), Color3.fromRGB(25, 60, 170))
		piece("MatGyrophare", Vector3.new(0.2, 1.8, 0.2), CFrame.new(0, 1.3, 2.7), Color3.fromRGB(40, 40, 45), Enum.Material.Metal)
		piece("Gyrophare", Vector3.new(2.2, 0.35, 0.6), CFrame.new(0, 2.25, 2.7), Color3.fromRGB(255, 40, 40), Enum.Material.Neon)
	end

	for _, p in ipairs(modele:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Gardes" -- ne bloque pas les karts des joueurs
		end
	end

	-- Repère au-dessus du bot
	local repere = Instance.new("BillboardGui")
	repere.Size = UDim2.new(0, 170, 0, 40)
	repere.StudsOffset = Vector3.new(0, 4, 0)
	repere.AlwaysOnTop = true
	repere.MaxDistance = 220
	repere.Parent = racine
	local etiquette = Instance.new("TextLabel")
	etiquette.Size = UDim2.fromScale(1, 1)
	etiquette.BackgroundTransparency = 1
	etiquette.TextScaled = true
	etiquette.Font = Enum.Font.GothamBlack
	etiquette.Text = (if police then "🤖🚓 " else "🤖🏃 ") .. nom
	etiquette.TextColor3 = if police then Color3.fromRGB(90, 150, 255) else Color3.fromRGB(255, 150, 40)
	local contour = Instance.new("UIStroke")
	contour.Thickness = 2
	contour.Parent = etiquette
	etiquette.Parent = repere

	modele.Parent = dossierBots
	pcall(function()
		racine:SetNetworkOwner(nil)
	end)
	-- Assis au volant
	local animateur = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animateur.Parent = hum
	local anim = Instance.new("Animation")
	anim.AnimationId = ANIM_ASSIS
	pcall(function()
		local piste = animateur:LoadAnimation(anim)
		piste.Looped = true
		piste:Play()
	end)
	return { modele = modele, hum = hum, racine = racine, chemin = nil, indexChemin = 1, prochainCalcul = 0, cible = nil }
end

local parametresVue = RaycastParams.new()
parametresVue.FilterType = Enum.RaycastFilterType.Exclude
parametresVue.RespectCanCollide = true

local function allerVers(bot, destination: Vector3)
	parametresVue.FilterDescendantsInstances = { dossierBots, dossierKarts }
	local depart = bot.racine.Position
	local direct = workspace:Raycast(depart, destination - depart, parametresVue)
	if direct == nil then
		bot.chemin = nil
		bot.hum:MoveTo(destination)
		return
	end
	if bot.chemin == nil or os.clock() > bot.prochainCalcul then
		bot.prochainCalcul = os.clock() + 0.8
		local chemin = PathfindingService:CreatePath({ AgentRadius = 2.5, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 6 })
		local ok = pcall(function()
			chemin:ComputeAsync(depart, destination)
		end)
		if ok and chemin.Status == Enum.PathStatus.Success then
			local points = {}
			for _, w in ipairs(chemin:GetWaypoints()) do
				table.insert(points, w.Position)
			end
			bot.chemin = points
			bot.indexChemin = math.min(2, #points)
		else
			bot.chemin = nil
			bot.hum:MoveTo(destination)
			return
		end
	end
	local points = bot.chemin
	if points and points[bot.indexChemin] then
		local p = points[bot.indexChemin]
		if Vector3.new(p.X - depart.X, 0, p.Z - depart.Z).Magnitude < 6 and bot.indexChemin < #points then
			bot.indexChemin += 1
		end
		bot.hum:MoveTo(points[bot.indexChemin])
	end
end

-- Le cerveau d'un bot pendant la manche
local function piloterBot(p: Participant, participants: { Participant })
	local bot = p.bot
	if not bot then
		return
	end
	local pointFuite = POINTS_FUITE[math.random(1, #POINTS_FUITE)]
	while present(p) and not p.arrete and workspace:GetAttribute("MancheEnCours") do
		task.wait(0.15)
		local maPosition = bot.racine.Position
		-- Gyrophare qui clignote
		local gyro = bot.modele:FindFirstChild("Gyrophare") :: BasePart?
		if gyro then
			gyro.Color = if math.floor(os.clock() * 5) % 2 == 0 then Color3.fromRGB(255, 40, 40) else Color3.fromRGB(40, 90, 255)
		end
		-- Le participant adverse le plus proche
		local plusProche, distance = nil, math.huge
		for _, autre in ipairs(participants) do
			if autre ~= p and autre.role ~= p.role and present(autre) and not autre.arrete and not autre.attente then
				local pos = positionDe(autre)
				if pos then
					local d = (pos - maPosition).Magnitude
					if d < distance then
						plusProche, distance = pos, d
					end
				end
			end
		end
		if p.role == "Police" then
			-- Il fonce sur le fugitif le plus proche
			if plusProche then
				allerVers(bot, plusProche)
			end
		else
			-- Le fugitif fuit le policier proche, sinon il se balade dans le mall
			if plusProche and distance < 70 then
				local fuite = maPosition + (maPosition - plusProche).Unit * 45
				fuite = Vector3.new(math.clamp(fuite.X, -190, 190), maPosition.Y, math.clamp(fuite.Z, -140, 140))
				-- on choisit le point des allées le plus proche de la direction de fuite
				local meilleur, meilleurScore = pointFuite, math.huge
				for _, pt in ipairs(POINTS_FUITE) do
					local score = (pt - fuite).Magnitude - (pt - plusProche).Magnitude * 0.5
					if score < meilleurScore then
						meilleur, meilleurScore = pt, score
					end
				end
				pointFuite = meilleur
			elseif (Vector3.new(pointFuite.X - maPosition.X, 0, pointFuite.Z - maPosition.Z)).Magnitude < 8 then
				pointFuite = POINTS_FUITE[math.random(1, #POINTS_FUITE)]
			end
			allerVers(bot, pointFuite)
		end
	end
end

---------------------------------------------------------------------
-- Outils de la manche
---------------------------------------------------------------------
local function apparitionGarage(): CFrame?
	local garage = carte:FindFirstChild("GarageVIP")
	local apparition = garage and garage:FindFirstChild("ApparitionGarage") :: BasePart?
	return apparition and (apparition.CFrame + Vector3.new(0, 4, 0)) or nil
end

local function fermerEntree(fermee: boolean)
	local barriere = carte:FindFirstChild("BarriereManche", true) :: BasePart?
	if barriere then
		barriere.CanCollide = fermee
		barriere.Transparency = if fermee then 0.35 else 1
		local etiquette = barriere:FindFirstChildWhichIsA("TextLabel", true)
		if etiquette then
			etiquette.TextTransparency = if fermee then 0 else 1
		end
	end
end

local function envoyerATous(info)
	Partie:FireAllClients(info)
end

-- La page d'attente : le joueur ne roule pas (le script PartieUI affiche la page)
local function mettreEnSalle(joueur: Player, enSalle: boolean)
	if (joueur:GetAttribute("EnSalle") == true) == enSalle then
		return
	end
	joueur:SetAttribute("EnSalle", enSalle)
	if enSalle then
		RetirerKart:Invoke(joueur)
	end
end

local function remettreAZero(joueur: Player)
	joueur:SetAttribute("Role", nil)
	joueur:SetAttribute("Arrete", nil)
	joueur:SetAttribute("Vies", nil)
	joueur.Team = EQUIPE_VISITEURS
end

-- Où faire partir un bot (comme les joueurs : grille de départ ou passerelle)
local placeBot = 0
local function departBot(role: string): CFrame
	placeBot += 1
	local x = ({ -45, 45, -55, 55 })[(placeBot - 1) % 4 + 1]
	if role == "Police" then
		local pos = Vector3.new(x, SOL + 0.6, -135) -- au nord, face au sud
		return CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))
	end
	local pos = Vector3.new(x, SOL + 0.6, 135) -- au sud, face au nord
	return CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1))
end

---------------------------------------------------------------------
-- ❤️ LES VIES, RÉAPPARAÎTRE ET ⚡ VENGEANCE
---------------------------------------------------------------------
local function participantDe(joueur: Player): Participant?
	for _, p in ipairs(participantsManche) do
		if p.joueur == joueur then
			return p
		end
	end
	return nil
end

-- Nom coloré au-dessus du kart (bleu = police, orange = fugitif) + rôle lisible par les clients (radar)
local function etiqueter(modele: Instance?, p: Participant)
	if not modele then
		return
	end
	modele:SetAttribute("Role", p.role)
	local support = (modele :: Model).PrimaryPart or modele:FindFirstChild("HumanoidRootPart") or modele:FindFirstChildWhichIsA("BasePart")
	-- (les karts des joueurs ont déjà leur étiquette « RepereEquipe » : pas de doublon)
	if not support or support:FindFirstChild("NomManche") or support:FindFirstChild("RepereEquipe") then
		return
	end
	local panneau = Instance.new("BillboardGui")
	panneau.Name = "NomManche"
	panneau.Size = UDim2.fromOffset(170, 30)
	panneau.StudsOffset = Vector3.new(0, 5.5, 0)
	panneau.AlwaysOnTop = true
	panneau.MaxDistance = 220
	panneau.LightInfluence = 0
	panneau.Parent = support
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = if p.role == "Police" then Color3.fromRGB(40, 90, 230) else Color3.fromRGB(240, 130, 30)
	t.BackgroundTransparency = 0.25
	t.TextColor3 = Color3.new(1, 1, 1)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = (if p.role == "Police" then "🚓 " else "🏃 ") .. p.nom
	t.Parent = panneau
	Instance.new("UICorner", t).CornerRadius = UDim.new(0, 8)
end

-- Effet « POUF » : celui qui perd une vie disparaît d'un coup dans un nuage d'étoiles
local function pouf(position: Vector3?)
	if not position then
		return
	end
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.one
	p.Position = position
	p.Parent = workspace
	local nuage = Instance.new("ParticleEmitter")
	nuage.Color = ColorSequence.new(Color3.fromRGB(240, 240, 250))
	nuage.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 5) })
	nuage.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	nuage.Lifetime = NumberRange.new(0.5, 0.9)
	nuage.Speed = NumberRange.new(8, 16)
	nuage.SpreadAngle = Vector2.new(180, 180)
	nuage.Enabled = false
	nuage.Parent = p
	local etoiles = Instance.new("ParticleEmitter")
	etoiles.LightEmission = 1
	etoiles.Color = ColorSequence.new(Color3.fromRGB(255, 220, 80), Color3.fromRGB(255, 90, 90))
	etoiles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 0) })
	etoiles.Lifetime = NumberRange.new(0.4, 0.8)
	etoiles.Speed = NumberRange.new(15, 28)
	etoiles.SpreadAngle = Vector2.new(180, 180)
	etoiles.Enabled = false
	etoiles.Parent = p
	nuage:Emit(30)
	etoiles:Emit(40)
	game:GetService("Debris"):AddItem(p, 2)
end

-- Revenir en jeu : kart sur sa grille de départ (police au nord, fugitifs au sud)
local function reapparaitre(p: Participant)
	if not p.attente or p.arrete or not workspace:GetAttribute("MancheEnCours") then
		return
	end
	p.attente = false
	p.protegeJusqua = os.clock() + (P.ProtectionReapparition or 3)
	if p.joueur and p.joueur.Parent then
		etiqueter(PlacerKart:Invoke(p.joueur, false), p)
		Partie:FireClient(p.joueur, { type = "reapparu", vies = p.vies })
	elseif p.bot and p.bot.modele.Parent then
		p.bot.modele:PivotTo(departBot(p.role :: string))
	end
end

-- Perdre une vie (arrêté par la police, ou victime d'une VENGEANCE)
perdreVie = function(p: Participant, parQui: Participant)
	if p.arrete or p.attente then
		return
	end
	pouf(positionKart(p)) -- (il disparaît tout de suite, dans un nuage)
	p.vies = math.max((p.vies or 1) - 1, 0)
	p.tueur = parQui
	local j = p.joueur
	if j then
		j:SetAttribute("Vies", p.vies)
	end
	if p.vies <= 0 then
		-- Plus de vies : éliminé jusqu'à la fin de la manche
		p.arrete = true
		if j then
			j:SetAttribute("Arrete", true)
			RetirerKart:Invoke(j)
			local cf = apparitionGarage()
			if cf then
				task.delay(0.15, function()
					if j.Character then
						j.Character:PivotTo(cf)
					end
				end)
			end
			Partie:FireClient(j, { type = "arrete", par = parQui.nom })
		elseif p.bot then
			p.bot.modele:Destroy()
		end
		envoyerATous({ type = "info", texte = ("💀 %s n'a plus de vies !"):format(p.nom) })
		return
	end
	-- Il reste des vies : le joueur choisit (réapparaître gratuitement, ou VENGEANCE)
	p.attente = true
	if j then
		RetirerKart:Invoke(j)
		local cf = apparitionGarage()
		if cf then
			task.delay(0.05, function()
				if j.Character then
					j.Character:PivotTo(cf)
				end
			end)
		end
		Partie:FireClient(j, {
			type = "perdu", par = parQui.nom, vies = p.vies, delai = P.DelaiChoix or 12,
			prix = P.PrixVengeance or "R$ 25", produit = P.ProduitVengeance or 0,
		})
		task.delay(P.DelaiChoix or 12, function()
			reapparaitre(p) -- (pas de choix à temps : on revient tout seul)
		end)
	else
		-- Un bot disparaît tout de suite (renvoyé sur sa grille) et repart au bout de 3 secondes
		if p.bot and p.bot.modele.Parent then
			p.bot.modele:PivotTo(departBot(p.role :: string))
		end
		task.delay(3, function()
			reapparaitre(p)
		end)
	end
end

-- ⚡ VENGEANCE : celui qui t'a fait perdre une vie en perd une à son tour, et tu reviens en jeu
local function vengeance(joueur: Player): boolean
	local p = participantDe(joueur)
	if not p or not p.attente or p.arrete then
		return false
	end
	local cible = p.tueur
	if cible and present(cible) and not cible.arrete and not cible.attente then
		envoyerATous({ type = "vengeance", par = p.nom, cible = cible.nom })
		perdreVie(cible, p)
	end
	reapparaitre(p)
	return true
end

-- Appelé par MallDriftServer quand l'achat Robux « Vengeance » est confirmé
local AppliquerVengeance = Instance.new("BindableFunction")
AppliquerVengeance.Name = "AppliquerVengeance"
AppliquerVengeance.OnInvoke = vengeance
AppliquerVengeance.Parent = ServerStorage

---------------------------------------------------------------------
-- Une manche
---------------------------------------------------------------------
local function jouerManche(participants: { Participant })
	-- 1) Tirage au sort
	for i = #participants, 2, -1 do
		local j = math.random(1, i)
		participants[i], participants[j] = participants[j], participants[i]
	end
	participantsManche = participants
	local nombrePolice = math.max(1, math.floor(#participants / 2))
	local police, fugitifs = {}, {}
	for i, p in ipairs(participants) do
		p.role = if i <= nombrePolice then "Police" else "Fugitif"
		p.arrete = false
		p.vies = P.Vies or 3
		p.attente = false
		p.tueur = nil
		p.protegeJusqua = nil
		table.insert(if p.role == "Police" then police else fugitifs, p)
		if p.joueur then
			p.joueur:SetAttribute("Role", p.role)
			p.joueur:SetAttribute("Arrete", nil)
			p.joueur:SetAttribute("Vies", p.vies)
			p.joueur.Team = if p.role == "Police" then EQUIPE_POLICE else EQUIPE_FUGITIFS
		end
	end
	scoresDrift = {}
	for _, p in ipairs(participants) do
		if p.joueur then
			scoresDrift[p.joueur] = { total = 0, meilleur = 0 }
			Partie:FireClient(p.joueur, { type = "tirage", equipe = p.role, nbPolice = #police, nbFugitifs = #fugitifs })
		end
	end
	task.wait(4) -- le temps de l'animation du tirage

	-- 2) Départ : l'entrée se ferme ; fugitifs au sud, police au nord.
	--    Tout le monde a les feux en même temps (~7 s : survol + 3, 2, 1, PARTEZ),
	--    mais la police reste bloquée AVANCE secondes de plus.
	workspace:SetAttribute("MancheEnCours", true)
	fermerEntree(true)
	local DUREE_DEPART = 7.5
	local debloquePolice = workspace:GetServerTimeNow() + DUREE_DEPART + AVANCE
	local function lancer(p: Participant)
		if p.joueur and p.joueur.Parent then
			mettreEnSalle(p.joueur, false)
			RetirerKart:Invoke(p.joueur)
			local kart = PlacerKart:Invoke(p.joueur, true)
			etiqueter(kart, p)
			if kart and p.role == "Police" then
				kart:SetAttribute("BloqueJusqua", debloquePolice)
			end
		elseif not p.joueur then
			p.bot = creerBot(p.nom, p.role :: string, departBot(p.role :: string))
			if p.bot then
				etiqueter(p.bot.modele, p)
				task.delay(if p.role == "Police" then DUREE_DEPART + AVANCE else DUREE_DEPART, function()
					piloterBot(p, participants)
				end)
			end
		end
	end
	for _, p in ipairs(participants) do
		lancer(p)
	end
	task.delay(DUREE_DEPART, function()
		envoyerATous({ type = "info", texte = ("🏃 Les fugitifs ont %d secondes d'avance !"):format(AVANCE) })
	end)
	task.delay(DUREE_DEPART + AVANCE, function()
		envoyerATous({ type = "info", texte = "🚓 La police est lancée !" })
	end)

	-- 3) La manche
	local fin = os.clock() + DUREE + DUREE_DEPART
	local gagnant = nil
	local prochainEnvoi = 0
	local prochainRadar = os.clock() + DUREE_DEPART + AVANCE + 20
	while not gagnant do
		task.wait(0.1)
		local maintenant = os.clock()

		-- Arrestations : un policier au volant tout près d'un fugitif libre
		for _, flic in ipairs(police) do
			local posFlic = present(flic) and not flic.arrete and not flic.attente and auVolant(flic) and positionKart(flic)
			if posFlic then
				for _, fugitif in ipairs(fugitifs) do
					local protege = fugitif.protegeJusqua and os.clock() < fugitif.protegeJusqua
					local posFugitif = present(fugitif) and not fugitif.arrete and not fugitif.attente and not protege and auVolant(fugitif) and positionKart(fugitif)
					if posFugitif and distanceAPlat(posFugitif, posFlic) < DISTANCE_ARRESTATION and math.abs(posFugitif.Y - posFlic.Y) < 6 then
						if flic.joueur then
							AjouterXP:Fire(flic.joueur, P.XPArrestation or 100)
						end
						envoyerATous({ type = "arrestation", policier = flic.nom, fugitif = fugitif.nom })
						perdreVie(fugitif, flic)
					end
				end
			end
		end

		-- 📡 RADAR : toutes les 20 s, la police voit les fugitifs à travers les murs (3 s)
		if os.clock() >= prochainRadar then
			prochainRadar = os.clock() + 20
			envoyerATous({ type = "radar", duree = 3 })
		end

		local restants, policeEnJeu = 0, 0
		for _, f in ipairs(fugitifs) do
			if present(f) and not f.arrete then
				restants += 1
			end
		end
		for _, f in ipairs(police) do
			if present(f) and not f.arrete then
				policeEnJeu += 1
			end
		end

		if restants == 0 then
			gagnant = "Police"
		elseif policeEnJeu == 0 or maintenant >= fin then
			gagnant = "Fugitifs"
		elseif maintenant >= prochainEnvoi then
			prochainEnvoi = maintenant + 1
			envoyerATous({ type = "etat", etat = "manche", temps = math.max(0, math.ceil(fin - maintenant)), restants = restants, total = #fugitifs })
		end
	end

	-- 4) Fin de la manche : résultats et XP
	participantsManche = {}
	local classement = classementDrifts()
	local roi = classement[1]
	if roi and roi.total > 0 then
		AjouterXP:Fire(roi.joueur, P.XPRoiDuDrift or 150)
	end
	local classementEnvoye = {}
	for i, ligne in ipairs(classement) do
		classementEnvoye[i] = { nom = ligne.nom, total = ligne.total, meilleur = ligne.meilleur }
	end
	envoyerATous({ type = "fin", gagnant = gagnant, xp = P.XPVictoire or 300, classement = classementEnvoye, roi = if roi and roi.total > 0 then roi.nom else nil })
	for _, p in ipairs(participants) do
		if p.joueur and p.joueur.Parent then
			AjouterXP:Fire(p.joueur, P.XPParticipation or 50)
			if p.role == (if gagnant == "Police" then "Police" else "Fugitif") then
				AjouterXP:Fire(p.joueur, P.XPVictoire or 300)
			end
		end
	end
	task.wait(6)

	-- 5) Retour au garage (ou au lobby, dans la place Police contre Fugitifs)
	if TYPE == "PoliceFugitifs" then
		local tous = {}
		for _, p in ipairs(participants) do
			if p.joueur and p.joueur.Parent then
				table.insert(tous, p.joueur)
			end
		end
		retourAuLobby(tous)
	end
	workspace:SetAttribute("MancheEnCours", false)
	fermerEntree(false)
	dossierBots:ClearAllChildren()
	for _, p in ipairs(participants) do
		if p.joueur and p.joueur.Parent then
			local j = p.joueur
			RetirerKart:Invoke(j)
			remettreAZero(j)
			j:SetAttribute("EnSalle", nil)
			j:SetAttribute("Pret", false) -- pour rejouer, on reclique sur « LANCER UNE PARTIE »
			task.spawn(function()
				j:LoadCharacter() -- réapparition au garage
			end)
		end
	end
end

---------------------------------------------------------------------
-- La boucle de la partie : attente → intermission → manche → ...
---------------------------------------------------------------------
Players.PlayerAdded:Connect(function(joueur)
	joueur.Team = EQUIPE_VISITEURS
end)
for _, joueur in ipairs(Players:GetPlayers()) do
	joueur.Team = EQUIPE_VISITEURS
end
workspace:SetAttribute("MancheEnCours", false)

-- Le bouton « LANCER UNE PARTIE » (côté joueur) : on devient « prêt » ou non
---------------------------------------------------------------------
-- DRIFT BATTLE (solo, instantané) : on clique dans le menu → petit titre
-- de 2 secondes → 3, 2, 1 → 1 minute pour faire le plus de points de drift.
-- Pas de police. À la fin : score, record, XP, et on continue en entraînement.
---------------------------------------------------------------------
local DUREE_BATTLE = P.DureeBattle or 60
local scoresBattle: { [Player]: Score } = {}

---------------------------------------------------------------------
-- LE CLASSEMENT MONDIAL DU DRIFT BATTLE (tous les joueurs qui ont joué au jeu)
-- Meilleur score de chaque joueur, enregistré par Roblox (OrderedDataStore).
-- Dans Studio sans accès aux services API : classement local de secours.
---------------------------------------------------------------------
local DataStoreService = game:GetService("DataStoreService")
local okDS, tableauRecords = pcall(function()
	return DataStoreService:GetOrderedDataStore("DriftBattle_Records_v1")
end)
if not okDS then
	tableauRecords = nil
end
local recordsLocaux: { [number]: number } = {} -- secours : userId → meilleur score
local cacheNoms: { [number]: string } = {}

local function nomDe(userId: number): string
	if cacheNoms[userId] then
		return cacheNoms[userId]
	end
	local present = Players:GetPlayerByUserId(userId)
	local nom = present and present.DisplayName or nil
	if not nom then
		local ok, resultat = pcall(function()
			return Players:GetNameFromUserIdAsync(userId)
		end)
		nom = if ok and resultat then resultat else ("Joueur " .. userId)
	end
	cacheNoms[userId] = nom
	return nom
end

-- Enregistre le score s'il bat le record du joueur ; renvoie le record
local function enregistrerRecord(joueur: Player, score: number): number
	local id = joueur.UserId
	recordsLocaux[id] = math.max(recordsLocaux[id] or 0, score)
	local record = recordsLocaux[id]
	if tableauRecords then
		local ok, valeur = pcall(function()
			return tableauRecords:UpdateAsync(tostring(id), function(ancien)
				if ancien == nil or score > ancien then
					return score
				end
				return nil -- (on garde l'ancien record)
			end)
		end)
		if ok and type(valeur) == "number" then
			record = math.max(record, valeur)
		elseif ok then
			local ok2, actuel = pcall(function()
				return tableauRecords:GetAsync(tostring(id))
			end)
			if ok2 and type(actuel) == "number" then
				record = math.max(record, actuel)
			end
		end
	end
	return record
end

type Ligne = { rang: number, nom: string, score: number, moi: boolean? }

-- Le top 3 + ta place avec les 2 joueurs juste devant et les 2 juste derrière
local function classementAutour(joueur: Player, record: number): ({ Ligne }, { Ligne }, number)
	local top, autour = {}, {}
	local rang = 1
	if tableauRecords then
		local ok = pcall(function()
			-- Top 3
			local pages = tableauRecords:GetSortedAsync(false, 3)
			for i, entree in ipairs(pages:GetCurrentPage()) do
				table.insert(top, { rang = i, nom = nomDe(tonumber(entree.key) or 0), score = entree.value })
			end
			-- Ta place : on compte les joueurs qui ont un meilleur score que toi
			local plusHauts = {}
			local nombreDevant = 0
			local pagesHaut = tableauRecords:GetSortedAsync(true, 100, record + 1)
			for _ = 1, 50 do -- (jusqu'à 5 000 joueurs devant toi)
				local page = pagesHaut:GetCurrentPage()
				for _, entree in ipairs(page) do
					nombreDevant += 1
					if #plusHauts < 2 then
						table.insert(plusHauts, entree) -- les plus proches juste au-dessus
					end
				end
				if pagesHaut.IsFinished then
					break
				end
				pagesHaut:AdvanceToNextPageAsync()
			end
			rang = nombreDevant + 1
			for i = #plusHauts, 1, -1 do
				local entree = plusHauts[i]
				table.insert(autour, { rang = rang - i, nom = nomDe(tonumber(entree.key) or 0), score = entree.value })
			end
			table.insert(autour, { rang = rang, nom = joueur.DisplayName, score = record, moi = true })
			if record > 0 then
				local pagesBas = tableauRecords:GetSortedAsync(false, 2, nil, record - 1)
				for i, entree in ipairs(pagesBas:GetCurrentPage()) do
					table.insert(autour, { rang = rang + i, nom = nomDe(tonumber(entree.key) or 0), score = entree.value })
				end
			end
		end)
		if ok then
			return top, autour, rang
		end
		top, autour, rang = {}, {}, 1
	end
	-- Classement local de secours
	local liste = {}
	for id, score in pairs(recordsLocaux) do
		table.insert(liste, { id = id, score = score })
	end
	table.sort(liste, function(a, b)
		return a.score > b.score
	end)
	for i, ligne in ipairs(liste) do
		if ligne.id == joueur.UserId then
			rang = i
		end
	end
	for i, ligne in ipairs(liste) do
		local l = { rang = i, nom = nomDe(ligne.id), score = ligne.score, moi = ligne.id == joueur.UserId }
		if i <= 3 then
			table.insert(top, l)
		end
		if math.abs(i - rang) <= 2 then
			table.insert(autour, l)
		end
	end
	return top, autour, rang
end

-- À l'arrivée : on récupère le record du joueur
Players.PlayerAdded:Connect(function(joueur: Player)
	if not tableauRecords then
		return
	end
	local ok, valeur = pcall(function()
		return tableauRecords:GetAsync(tostring(joueur.UserId))
	end)
	if ok and type(valeur) == "number" then
		recordsLocaux[joueur.UserId] = valeur
		joueur:SetAttribute("RecordBattle", valeur)
	end
end)

local function lancerBattle(joueur: Player)
	if joueur:GetAttribute("Role") ~= nil or joueur:GetAttribute("EnSalle") then
		return
	end
	joueur:SetAttribute("Pret", false)
	joueur:SetAttribute("Role", "Battle")
	joueur.Team = EQUIPE_BATTLE
	scoresBattle[joueur] = { total = 0, meilleur = 0 }
	-- Directement sur la ligne de départ (pas de passage par le garage) :
	-- le titre « DRIFT BATTLE » s'affiche pendant le 3, 2, 1
	RetirerKart:Invoke(joueur)
	PlacerKart:Invoke(joueur, true, true) -- départ court : juste 3, 2, 1
	Partie:FireClient(joueur, { type = "battle", duree = DUREE_BATTLE })
	local fin = os.clock() + DUREE_BATTLE + 3.5 -- (titre + 3, 2, 1)
	while os.clock() < fin and joueur.Parent and joueur:GetAttribute("Role") == "Battle" do
		task.wait(0.5)
		local sc = scoresBattle[joueur]
		Partie:FireClient(joueur, {
			type = "etat", etat = "battle",
			temps = math.max(0, math.ceil(fin - os.clock())),
			monScore = sc and sc.total or 0,
			record = joueur:GetAttribute("RecordBattle") or 0,
		})
	end
	local sc = scoresBattle[joueur]
	scoresBattle[joueur] = nil
	if not joueur.Parent or not sc then
		return
	end
	local ancienRecord = joueur:GetAttribute("RecordBattle") or 0
	local nouveauRecord = sc.total > ancienRecord
	AjouterXP:Fire(joueur, (P.XPParticipation or 50) + math.floor(sc.total / 20))
	-- Fin du défi : retour au garage, puis le menu s'ouvre (côté joueur)
	joueur:SetAttribute("Role", nil)
	joueur.Team = EQUIPE_VISITEURS
	RetirerKart:Invoke(joueur)
	local cf = apparitionGarage()
	task.delay(0.2, function()
		if cf and joueur.Character then
			joueur.Character:PivotTo(cf)
		end
	end)
	Partie:FireClient(joueur, { type = "finBattle", total = sc.total, meilleur = sc.meilleur, record = math.max(ancienRecord, sc.total), nouveauRecord = nouveauRecord })
	-- Le classement mondial (enregistrement + ta place)
	local record = enregistrerRecord(joueur, sc.total)
	-- Classement de la semaine (ModesServer)
	local semaine = ServerStorage:FindFirstChild("ScoreBattleSemaine") :: BindableEvent?
	if semaine then
		semaine:Fire(joueur, sc.total)
	end
	joueur:SetAttribute("RecordBattle", record)
	local top, autour, rang = classementAutour(joueur, record)
	Partie:FireClient(joueur, { type = "classementMondial", top = top, autour = autour, rang = rang, record = record })
	if TYPE == "DriftBattle" then
		task.delay(9, function() -- (le temps de voir son score et le classement)
			if joueur.Parent then
				retourAuLobby({ joueur })
			end
		end)
	end
end

DriftEnregistre.Event:Connect(function(joueur: Player, points: number)
	local sc = scoresBattle[joueur]
	if sc and joueur:GetAttribute("Role") == "Battle" then
		sc.total += points
		if points > sc.meilleur then
			sc.meilleur = points
		end
	end
end)

---------------------------------------------------------------------
-- La file d'attente (choisie dans le menu) : « Pret » = Police contre Fugitifs
-- (le Drift Battle, lui, se lance tout de suite, en solo)
---------------------------------------------------------------------
Partie.OnServerEvent:Connect(function(joueur: Player, info)
	-- Pendant la manche : le choix après avoir perdu une vie
	if type(info) == "table" and info.type == "reapparaitre" then
		local p = participantDe(joueur)
		if p then
			reapparaitre(p)
		end
		return
	elseif type(info) == "table" and info.type == "vengeance" then
		-- (dans le vrai jeu, ça passe par l'achat Robux ; ici seulement le test gratuit dans Studio)
		if game:GetService("RunService"):IsStudio() and (P.ProduitVengeance or 0) == 0 then
			vengeance(joueur)
		end
		return
	end
	if type(info) ~= "table" or joueur:GetAttribute("Role") ~= nil then
		return -- (pendant sa manche, le joueur ne peut rien changer)
	end
	if info.type == "pret" then
		joueur:SetAttribute("Pret", info.valeur == true)
	elseif info.type == "battle" then
		task.spawn(lancerBattle, joueur)
	elseif info.type == "garage" then
		-- Bouton « GARAGE VIP » du menu : retour au garage
		RetirerKart:Invoke(joueur)
		local garage = carte:FindFirstChild("GarageVIP")
		local apparition = garage and garage:FindFirstChild("ApparitionGarage") :: BasePart?
		task.delay(0.2, function()
			if apparition and joueur.Character then
				joueur.Character:PivotTo(apparition.CFrame + Vector3.new(0, 4, 0))
			end
		end)
	end
end)

local function joueursPrets(attribut: string): { Player }
	local liste = {}
	for _, j in ipairs(Players:GetPlayers()) do
		if j:GetAttribute(attribut) and j.Character then
			table.insert(liste, j)
		end
	end
	return liste
end

-- Combien de bots faut-il pour compléter une partie Police contre Fugitifs ?
local function botsNecessaires(): number
	local n = #joueursPrets("Pret")
	if n == 0 or n >= JOUEURS_MIN then
		return 0
	end
	return math.min(BOTS_TEST, JOUEURS_MIN - n)
end

-- Peut-on lancer une partie Police contre Fugitifs ?
local function modeDisponible(): string?
	local n = #joueursPrets("Pret")
	if n > 0 and n + botsNecessaires() >= JOUEURS_MIN then
		return "police"
	end
	return nil
end

