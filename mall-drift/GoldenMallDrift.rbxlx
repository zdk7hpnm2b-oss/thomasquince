end -- (bloc : garde le nombre de variables du script sous la limite de Roblox)

---------------------------------------------------------------------
-- QUALITÉ DE LA CARTE : rayons de lumière sous les verrières, écrans géants
-- animés au-dessus de l'atrium, grandes bannières suspendues
---------------------------------------------------------------------
do
	local decor = Instance.new("Folder")
	decor.Name = "DecorPlus"
	decor.Parent = carte
	local rayonSol = RaycastParams.new()
	rayonSol.FilterType = Enum.RaycastFilterType.Exclude

	-- 0) LE MALL EST FERMÉ : on ne voit plus le parking ni le garage depuis l'intérieur.
	--    Les portes vitrées ouvertes sont remplacées par de grandes portes teintées, fermées.
	for _, d in ipairs(carte:GetChildren()) do
		if d:IsA("BasePart") and (d.Name == "PorteOuverte" or d.Name == "BarriereManche") then
			d:Destroy() -- (l'entrée est fermée pour de bon : plus besoin de la barrière des manches)
		end
	end
	local zPorte = DZ + 1
	-- Fond opaque (rien ne se voit au travers) + deux grands battants de verre fumé
	local fond = bloc("FondPortes", Vector3.new(largeurPortes, 16, 0.6), CFrame.new(0, SOL + 8, zPorte + 0.6), Color3.fromRGB(18, 20, 26), Enum.Material.SmoothPlastic, decor)
	fond.CastShadow = false
	for _, cote in ipairs({ -1, 1 }) do
		local battant = bloc("PorteFermee", Vector3.new(largeurPortes / 2 - 0.6, 15.4, 0.5), CFrame.new(cote * largeurPortes / 4, SOL + 7.7, zPorte), Color3.fromRGB(45, 60, 82), Enum.Material.Glass, decor)
		battant.Transparency = 0.1
		battant.Reflectance = 0.35
		-- Poignée dorée verticale, près du centre
		deco(bloc("Poignee", Vector3.new(0.4, 5, 0.6), CFrame.new(cote * 2.2, SOL + 7.5, zPorte - 0.5), OR, Enum.Material.Foil, decor))
		-- Lettres dorées sur chaque battant
		local plaque = deco(bloc("LettresPorte", Vector3.new(largeurPortes / 2 - 6, 3, 0.1), CFrame.new(cote * largeurPortes / 4, SOL + 11.5, zPorte - 0.32), Color3.new(0, 0, 0), Enum.Material.SmoothPlastic, decor))
		plaque.Transparency = 1
		texte(plaque, Enum.NormalId.Front, if cote < 0 then "GOLDEN" else "MALL", OR)
	end
	-- Cadre doré autour de l'entrée
	deco(bloc("CadrePorte", Vector3.new(largeurPortes + 1.2, 0.8, 1), CFrame.new(0, SOL + 15.8, zPorte - 0.4), OR, Enum.Material.Foil, decor))
	deco(bloc("CadrePorte", Vector3.new(0.6, 16, 1), CFrame.new(0, SOL + 8, zPorte - 0.4), OR, Enum.Material.Foil, decor))
	for _, cote in ipairs({ -1, 1 }) do
		deco(bloc("CadrePorte", Vector3.new(0.8, 16, 1), CFrame.new(cote * (largeurPortes / 2 + 0.2), SOL + 8, zPorte - 0.4), OR, Enum.Material.Foil, decor))
	end

	-- 1) Rayons de lumière (lumière du jour qui tombe des verrières)
	local dossierPuits = carte:FindFirstChild("PuitsDeLumiere")
	if dossierPuits then
		rayonSol.FilterDescendantsInstances = { dossierPuits }
		for _, panneau in ipairs(dossierPuits:GetChildren()) do
			if panneau:IsA("BasePart") and panneau.Name == "PuitsDeLumiere" then
				local haut = panneau.Position - Vector3.new(0, 0.2, 0)
				local sol = workspace:Raycast(haut, Vector3.new(0, -60, 0), rayonSol)
				local bas = if sol then sol.Position.Y else SOL
				local hauteur = haut.Y - bas
				if hauteur > 4 then
					local rayon = bloc("RayonLumiere", Vector3.new(panneau.Size.X * 0.85, hauteur, panneau.Size.Z * 0.85), CFrame.new(haut.X, bas + hauteur / 2, haut.Z), Color3.fromRGB(255, 246, 228), Enum.Material.Neon, decor)
					deco(rayon)
					rayon.Transparency = 0.955
					rayon.CastShadow = false
				end
			end
		end
	end

	-- 2) Écrans géants suspendus au-dessus de l'atrium (messages qui défilent)
	local MESSAGES = {
		{ "GOLDEN MALL DRIFT", Color3.fromRGB(255, 205, 70) },
		{ "⏱ NOUVEAU : COURSE CHRONO", Color3.fromRGB(90, 200, 255) },
		{ "🏆 TOP 10 DE LA SEMAINE", Color3.fromRGB(255, 120, 200) },
		{ "🔥 DRIFT BATTLE : BATS LE RECORD", Color3.fromRGB(255, 120, 60) },
		{ "🚓 ATTENTION : POLICE DU MALL", Color3.fromRGB(110, 160, 255) },
	}
	local textesEcrans = {}
	for _, z in ipairs({ -80, 80 }) do
		local y = SOL + HAUT_PLAFOND_2 - 13
		local ecran = bloc("EcranGeant", Vector3.new(30, 12, 1.2), CFrame.new(0, y, z), Color3.fromRGB(12, 12, 16), Enum.Material.SmoothPlastic, decor)
		deco(ecran)
		local cadre = bloc("CadreEcran", Vector3.new(31.2, 13.2, 0.8), CFrame.new(0, y, z), OR, Enum.Material.Foil, decor)
		deco(cadre)
		for _, x in ipairs({ -13, 13 }) do
			deco(bloc("CableEcran", Vector3.new(0.15, HAUT_PLAFOND_2 - (y - SOL) - 6, 0.15), CFrame.new(x, (y + 6 + SOL + HAUT_PLAFOND_2) / 2, z), Color3.fromRGB(40, 40, 45), Enum.Material.Metal, decor))
		end
		for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
			local l = texte(ecran, face, MESSAGES[1][1], MESSAGES[1][2], Color3.fromRGB(10, 10, 14))
			table.insert(textesEcrans, l)
		end
	end
	task.spawn(function()
		local i = 1
		while true do
			task.wait(4)
			i = i % #MESSAGES + 1
			for _, l in ipairs(textesEcrans) do
				l.Text = MESSAGES[i][1]
				l.TextColor3 = MESSAGES[i][2]
			end
		end
	end)

	-- 2 bis) LUSTRES GÉANTS DORÉS au-dessus de l'atrium (la pièce maîtresse du mall)
	for _, zL in ipairs({ -50, 50 }) do
		local centre = Vector3.new(0, SOL + HAUT_PLAFOND_2 - 11, zL)
		local lustre = Instance.new("Model")
		lustre.Name = "LustreGeant"
		lustre.Parent = decor
		-- Tige qui descend du plafond
		deco(bloc("TigeLustre", Vector3.new(0.5, 8, 0.5), CFrame.new(centre + Vector3.new(0, 7, 0)), OR, Enum.Material.Foil, lustre))
		-- Trois couronnes dorées de tailles différentes, l'une sous l'autre
		for etage, info in ipairs({ { 9, 2 }, { 6.5, 0 }, { 4, -2 } }) do
			local rayonC, hauteurC = info[1], info[2]
			local nb = math.floor(rayonC * 4)
			for k = 1, nb do
				local a1 = (k / nb) * math.pi * 2
				local a2 = ((k + 1) / nb) * math.pi * 2
				local p1 = centre + Vector3.new(math.cos(a1) * rayonC, hauteurC, math.sin(a1) * rayonC)
				local p2 = centre + Vector3.new(math.cos(a2) * rayonC, hauteurC, math.sin(a2) * rayonC)
				local segment = bloc("CouronneLustre", Vector3.new(0.35, 0.35, (p2 - p1).Magnitude + 0.1), CFrame.lookAt((p1 + p2) / 2, p2), OR, Enum.Material.Foil, lustre)
				deco(segment)
				segment.CastShadow = false
				-- Pampilles de cristal qui pendent (et brillent)
				if k % 2 == 0 then
					local cristal = bloc("Cristal", Vector3.new(0.45, 1.6 + etage * 0.3, 0.45), CFrame.new(p1 - Vector3.new(0, 1.1, 0)) * CFrame.Angles(0, math.rad(45), 0), Color3.fromRGB(230, 245, 255), Enum.Material.Neon, lustre)
					deco(cristal)
					cristal.Transparency = 0.25
					cristal.CastShadow = false
				end
			end
		end
		-- Le cœur lumineux du lustre + sa lumière
		local coeur = bloc("CoeurLustre", Vector3.new(2.6, 2.6, 2.6), CFrame.new(centre), Color3.fromRGB(255, 235, 190), Enum.Material.Neon, lustre)
		deco(coeur)
		coeur.Shape = Enum.PartType.Ball
		coeur.CastShadow = false
		local lumiereLustre = Instance.new("PointLight")
		lumiereLustre.Range = 40
		lumiereLustre.Brightness = 2.2
		lumiereLustre.Color = Color3.fromRGB(255, 225, 170)
		lumiereLustre.Shadows = true
		lumiereLustre.Parent = coeur
	end

	-- 2 ter) DÉCOR DE COURSE dans les virages du circuit (pneus, bordures, chevrons)
	local NOIR_PNEU = Color3.fromRGB(28, 28, 30)
	local ROUGE_COURSE = Color3.fromRGB(215, 30, 35)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			local coin = Vector3.new(sx * 173, SOL, sz * 137)
			-- Piles de pneus dans l'angle extérieur du virage
			for i = 0, 2 do
				for j = 0, 2 - i do
					local pos = coin + Vector3.new(sx * (10 + i * 2.6), 0.6 + j * 1.2, sz * (9 + 0.6 * j))
					local pneu = bloc("PilePneus", Vector3.new(1.1, 2.4, 2.4), CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)), NOIR_PNEU, Enum.Material.Rubber, decor)
					pneu.Shape = Enum.PartType.Cylinder
					pneu.CanCollide = false
				end
			end
			-- Bordure rouge et blanc à l'intérieur du virage (deux branches)
			for k = 0, 7 do
				local couleur = if k % 2 == 0 then ROUGE_COURSE else Color3.fromRGB(245, 245, 245)
				deco(bloc("BordureVirage", Vector3.new(3, 0.12, 1.4), CFrame.new(coin + Vector3.new(-sx * (9 + k * 3), 0.06, -sz * 11)), couleur, Enum.Material.SmoothPlastic, decor))
				deco(bloc("BordureVirage", Vector3.new(1.4, 0.12, 3), CFrame.new(coin + Vector3.new(-sx * 11, 0.06, -sz * (9 + k * 3))), couleur, Enum.Material.SmoothPlastic, decor))
			end
			-- Panneau à chevrons (sens du virage)
			local panneauV = bloc("Chevrons", Vector3.new(8, 3, 0.3), CFrame.lookAt(coin + Vector3.new(sx * 13, 3, sz * 13), coin + Vector3.new(0, 3, 0)), Color3.fromRGB(245, 245, 245), Enum.Material.SmoothPlastic, decor)
			deco(panneauV)
			texte(panneauV, Enum.NormalId.Front, if sx * sz > 0 then "❯❯❯" else "❮❮❮", ROUGE_COURSE)
		end
	end
	-- Banderoles de sponsors (marques inventées) au-dessus des allées
	local SPONSORS = {
		{ "TURBO COLA", Color3.fromRGB(215, 30, 35) }, { "DRIFT FUEL", Color3.fromRGB(255, 150, 20) },
		{ "NEON TIRES", Color3.fromRGB(40, 140, 255) }, { "DUNE ENERGY", Color3.fromRGB(240, 190, 30) },
		{ "SKY KARTS", Color3.fromRGB(150, 70, 230) }, { "GOLDEN MALL", OR },
	}
	local numero = 0
	local function banderole(position: Vector3, largeur: number, versX: boolean)
		numero += 1
		local sponsor = SPONSORS[(numero - 1) % #SPONSORS + 1]
		local taille = if versX then Vector3.new(0.4, 3.2, largeur) else Vector3.new(largeur, 3.2, 0.4)
		local b = bloc("Banderole", taille, CFrame.new(position), Color3.fromRGB(20, 20, 24), Enum.Material.Fabric, decor)
		deco(b)
		b.CastShadow = false
		for _, face in ipairs(if versX then { Enum.NormalId.Left, Enum.NormalId.Right } else { Enum.NormalId.Front, Enum.NormalId.Back }) do
			texte(b, face, sponsor[1], sponsor[2])
		end
	end
	for _, z in ipairs({ -137, 137 }) do
		for _, x in ipairs({ -100, 0, 100 }) do
			banderole(Vector3.new(x, SOL + 19.5, z), 22, true) -- (on la voit en roulant le long de l'allée)
		end
	end
	for _, x in ipairs({ -173, 173 }) do
		for _, z in ipairs({ -60, 60 }) do
			banderole(Vector3.new(x, SOL + 19.5, z), 18, false)
		end
	end

	-- 2 quater) SOL DE LUXE : lignes dorées le long des grandes allées + rosaces aux croisements
	local MARBRE_BLANC = Color3.fromRGB(246, 243, 236)
	for _, z in ipairs({ -137, 137 }) do
		for _, cote in ipairs({ -1, 1 }) do
			local ligne = deco(bloc("IncrustationOr", Vector3.new(LARGEUR - 20, 0.05, 0.5), CFrame.new(0, SOL + 0.035, z + cote * 10.5), OR, Enum.Material.Foil, decor))
			ligne.CastShadow = false
		end
	end
	for _, x in ipairs({ -173, -99, 0, 99, 173 }) do
		for _, z in ipairs({ -137, 137 }) do
			local centre = Vector3.new(x, SOL + 0.04, z)
			local disque = deco(bloc("Rosace", Vector3.new(0.06, 15, 15), CFrame.new(centre) * CFrame.Angles(0, 0, math.rad(90)), MARBRE_BLANC, Enum.Material.Marble, decor))
			disque.Shape = Enum.PartType.Cylinder
			disque.CastShadow = false
			local anneau = deco(bloc("RosaceAnneau", Vector3.new(0.07, 13, 13), CFrame.new(centre + Vector3.new(0, 0.005, 0)) * CFrame.Angles(0, 0, math.rad(90)), OR, Enum.Material.Foil, decor))
			anneau.Shape = Enum.PartType.Cylinder
			anneau.CastShadow = false
			local interieur = deco(bloc("RosaceCentre", Vector3.new(0.08, 11.5, 11.5), CFrame.new(centre + Vector3.new(0, 0.01, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(30, 30, 36), Enum.Material.Marble, decor))
			interieur.Shape = Enum.PartType.Cylinder
			interieur.CastShadow = false
			-- Étoile dorée à 8 branches
			for k = 0, 3 do
				local branche = deco(bloc("RosaceEtoile", Vector3.new(10, 0.1, 0.6), CFrame.new(centre + Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, math.rad(k * 45), 0), OR, Enum.Material.Foil, decor))
				branche.CastShadow = false
			end
		end
	end

	-- 2 quinquies) JARDINIÈRES FLEURIES sur les balustrades de verre de l'étage (autour de l'atrium)
	local FLEURS = { Color3.fromRGB(255, 80, 140), Color3.fromRGB(255, 200, 40), Color3.fromRGB(170, 90, 255), Color3.fromRGB(255, 120, 60), Color3.fromRGB(80, 170, 255) }
	local nbFleurs = 0
	for _, x in ipairs({ -ATRIUM_X, ATRIUM_X }) do
		for _, z in ipairs({ -115, -95, -75, -55, -35, 35, 55, 75, 95, 115 }) do
			local base = Vector3.new(x, SOL + ETAGE + 3.85, z)
			deco(bloc("Jardiniere", Vector3.new(1.1, 0.7, 4), CFrame.new(base), Color3.fromRGB(240, 236, 228), Enum.Material.Marble, decor))
			deco(bloc("Feuillage", Vector3.new(1.3, 0.6, 4.2), CFrame.new(base + Vector3.new(0, 0.55, 0)), Color3.fromRGB(60, 150, 70), Enum.Material.Grass, decor))
			for f = -1, 1 do
				nbFleurs += 1
				local fleur = deco(bloc("Fleur", Vector3.new(0.7, 0.7, 0.7), CFrame.new(base + Vector3.new(0, 1, f * 1.3)), FLEURS[nbFleurs % #FLEURS + 1], Enum.Material.SmoothPlastic, decor))
				fleur.Shape = Enum.PartType.Ball
				fleur.CastShadow = false
			end
		end
	end

	-- 2 sexies) GRAPPES DE BALLONS autour de la place centrale (elles flottent, côté joueur)
	local COULEURS_BALLONS = { Color3.fromRGB(255, 60, 90), Color3.fromRGB(255, 200, 40), Color3.fromRGB(60, 170, 255), Color3.fromRGB(170, 80, 255), Color3.fromRGB(60, 220, 120), Color3.fromRGB(255, 255, 255) }
	local nbBallons = 0
	-- (x ±13, z ±38 : atrium ouvert, loin des rampes x 17..27, des flaques, des panneaux et de la fontaine)
	for _, x in ipairs({ -13, 13 }) do
		for _, z in ipairs({ -38, 38 }) do
			local pied = Vector3.new(x, SOL, z)
			deco(bloc("PoidsBallons", Vector3.new(1.2, 1, 1.2), CFrame.new(pied + Vector3.new(0, 0.5, 0)), OR, Enum.Material.Foil, decor))
			for k = 1, 7 do
				nbBallons += 1
				local angle = k * 0.9
				local tete = pied + Vector3.new(math.cos(angle) * 1.6, 9 + (k % 3) * 1.3, math.sin(angle) * 1.6)
				local ballon = deco(bloc("Ballon", Vector3.new(2.1, 2.5, 2.1), CFrame.new(tete), COULEURS_BALLONS[nbBallons % #COULEURS_BALLONS + 1], Enum.Material.SmoothPlastic, decor))
				local mesh = Instance.new("SpecialMesh")
				mesh.MeshType = Enum.MeshType.Sphere
				mesh.Parent = ballon
				ballon.Reflectance = 0.15
				ballon.CastShadow = false
				local fil = deco(bloc("FilBallon", Vector3.new(0.05, (tete - pied).Magnitude, 0.05), CFrame.lookAt((tete + pied) / 2, tete) * CFrame.Angles(math.rad(90), 0, 0), Color3.fromRGB(240, 240, 240), Enum.Material.SmoothPlastic, decor))
				fil.CastShadow = false
			end
		end
	end

	-- 2 septies) AFFICHES « SOLDES » sur une vitrine sur trois (vitrines « vivantes »)
	local AFFICHES = {
		{ "SOLDES\n-50%", Color3.fromRGB(230, 30, 40), Color3.fromRGB(255, 230, 60) },
		{ "NOUVELLE\nCOLLECTION", Color3.fromRGB(20, 20, 24), Color3.new(1, 1, 1) },
		{ "-30%\nSUR TOUT", Color3.fromRGB(255, 200, 30), Color3.fromRGB(200, 20, 30) },
		{ "PROMO\nDU JOUR", Color3.fromRGB(40, 120, 255), Color3.new(1, 1, 1) },
	}
	local nbVitrines = 0
	for _, d in ipairs(carte:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "Vitrine" and d.Size.X > 6 and d.Size.Y > 6 then
			nbVitrines += 1
			if nbVitrines % 3 == 0 then
				local affiche = AFFICHES[(nbVitrines // 3) % #AFFICHES + 1]
				local cadre = deco(bloc("AfficheVitrine", Vector3.new(4.5, 3.2, 0.06), d.CFrame * CFrame.new(0, -d.Size.Y / 2 + 3.2, -d.Size.Z / 2 - 0.05), affiche[2], Enum.Material.SmoothPlastic, decor))
				cadre.CastShadow = false
				texte(cadre, Enum.NormalId.Front, affiche[1], affiche[3])
			end
		end
	end

	-- 2 octies) LE 1er ÉTAGE PREND VIE
	local Y1 = SOL + ETAGE -- sol du 1er étage
	-- a) Vitrines lumineuses sur les murs nord et sud (comme au rez-de-chaussée)
	local NOMS_NORD = { "CINÉMA 4D", "GOLD ROOM", "ARCADE ZONE", "TEA HOUSE", "BEAUTY DUBAI", "KIDS PLANET" }
	for i, x in ipairs({ -185, -145, -105, 105, 145, 185 }) do
		facade(Vector3.new(x, ETAGE, -DZ), Vector3.new(0, 0, 1), 36, NOMS_NORD[i], Color3.fromRGB(255, 170, 230))
	end
	local NOMS_SUD = { "SPORT ARENA", "VR WORLD", "SUSHI BAR", "TOY CASTLE", "MUSIC BOX", "SNEAKER LAB", "CANDY LAND", "PHOTO STUDIO" }
	for i, x in ipairs({ -185, -145, -105, -65, 65, 105, 145, 185 }) do
		facade(Vector3.new(x, ETAGE, DZ), Vector3.new(0, 0, -1), 36, NOMS_SUD[i], Color3.fromRGB(150, 220, 255))
	end
	-- b) Sol de luxe aussi à l'étage : lignes dorées + rosaces
	for _, z in ipairs({ -137, 137 }) do
		for _, cote in ipairs({ -1, 1 }) do
			deco(bloc("IncrustationOr", Vector3.new(LARGEUR - 20, 0.05, 0.5), CFrame.new(0, Y1 + 0.035, z + cote * 10.5), OR, Enum.Material.Foil, decor)).CastShadow = false
		end
		for _, x in ipairs({ -173, -99, 99, 173 }) do
			local centre = Vector3.new(x, Y1 + 0.04, z)
			for k, info in ipairs({ { 15, MARBRE_BLANC, Enum.Material.Marble }, { 13, OR, Enum.Material.Foil }, { 11.5, Color3.fromRGB(30, 30, 36), Enum.Material.Marble } }) do
				local disque = deco(bloc("Rosace", Vector3.new(0.06 + k * 0.01, info[1], info[1]), CFrame.new(centre + Vector3.new(0, k * 0.005, 0)) * CFrame.Angles(0, 0, math.rad(90)), info[2], info[3], decor))
				disque.Shape = Enum.PartType.Cylinder
				disque.CastShadow = false
			end
			for k = 0, 3 do
				deco(bloc("RosaceEtoile", Vector3.new(10, 0.1, 0.6), CFrame.new(centre + Vector3.new(0, 0.02, 0)) * CFrame.Angles(0, math.rad(k * 45), 0), OR, Enum.Material.Foil, decor)).CastShadow = false
			end
		end
	end
	-- c) Suspensions lumineuses (globes dorés), ALIGNÉES sur la grille du mall :
	--    au-dessus de chaque rosace et au milieu de chaque bloc de boutiques
	local function suspension(position: Vector3)
		deco(bloc("TigeSuspension", Vector3.new(0.15, 5, 0.15), CFrame.new(position + Vector3.new(0, 3.5, 0)), OR, Enum.Material.Foil, decor))
		local globe = deco(bloc("GlobeSuspension", Vector3.new(2.2, 2.2, 2.2), CFrame.new(position), Color3.fromRGB(255, 236, 200), Enum.Material.Neon, decor))
		globe.Shape = Enum.PartType.Ball
		globe.CastShadow = false
		deco(bloc("ChapeauSuspension", Vector3.new(2.6, 0.5, 2.6), CFrame.new(position + Vector3.new(0, 1.2, 0)), OR, Enum.Material.Foil, decor)).CastShadow = false
	end
	local yGlobe = SOL + HAUT_PLAFOND_2 - 7
	local X_GRILLE = { -173, -136, -99, -62, 62, 99, 136, 173 } -- allées et milieux des blocs
	for _, x in ipairs(X_GRILLE) do
		suspension(Vector3.new(x, yGlobe, -137))
		suspension(Vector3.new(x, yGlobe, 137))
	end
	for _, x in ipairs({ -173, -99, 99, 173 }) do -- allées transversales
		for _, z in ipairs({ -90, -50, 50, 90 }) do
			suspension(Vector3.new(x, yGlobe, z))
		end
	end
	-- d) Guirlandes de fanions, bien DROITES en travers des allées nord et sud,
	--    à mi-chemin entre deux suspensions
	local COULEURS_FANIONS = { Color3.fromRGB(255, 60, 90), Color3.fromRGB(255, 200, 40), Color3.fromRGB(60, 170, 255), Color3.fromRGB(80, 220, 120), Color3.fromRGB(190, 90, 255) }
	local function guirlande(a: Vector3, b: Vector3)
		local longueur = (b - a).Magnitude
		local cordon = deco(bloc("CordonFanions", Vector3.new(0.08, 0.08, longueur), CFrame.lookAt((a + b) / 2, b), Color3.fromRGB(240, 240, 240), Enum.Material.SmoothPlastic, decor))
		cordon.CastShadow = false
		local nb = math.floor(longueur / 2.2)
		for k = 1, nb - 1 do
			local pos = a:Lerp(b, k / nb)
			local fanion = deco(bloc("Fanion", Vector3.new(0.05, 1.2, 1.2), CFrame.lookAt(pos, pos + (b - a).Unit) * CFrame.new(0, -0.7, 0) * CFrame.Angles(0, math.rad(90), math.rad(45)), COULEURS_FANIONS[k % #COULEURS_FANIONS + 1], Enum.Material.Fabric, decor))
			fanion.CastShadow = false
		end
	end
	local yFanions = SOL + HAUT_PLAFOND_2 - 3.5
	for _, x in ipairs({ -154.5, -117.5, -80.5, 0, 80.5, 117.5, 154.5 }) do
		guirlande(Vector3.new(x, yFanions, -159), Vector3.new(x, yFanions, -124))
		guirlande(Vector3.new(x, yFanions, 124), Vector3.new(x, yFanions, 159))
	end
	-- e) Contre les murs nord et sud : un banc doré DEVANT chaque vitrine (centré),
	--    et un palmier en pot dans chaque espace entre deux vitrines
	local function palmierEnPot(position: Vector3)
		deco(bloc("Pot", Vector3.new(3, 2.2, 3), CFrame.new(position + Vector3.new(0, 1.1, 0)), Color3.fromRGB(240, 236, 228), Enum.Material.Marble, decor))
		deco(bloc("BordPot", Vector3.new(3.3, 0.3, 3.3), CFrame.new(position + Vector3.new(0, 2.25, 0)), OR, Enum.Material.Foil, decor))
		local tronc = deco(bloc("Tronc", Vector3.new(0.6, 6, 0.6), CFrame.new(position + Vector3.new(0, 5.2, 0)), Color3.fromRGB(120, 85, 50), Enum.Material.Wood, decor))
		tronc.CastShadow = false
		for k = 0, 5 do
			local feuille = deco(bloc("Palme", Vector3.new(0.2, 0.6, 4.5), CFrame.new(position + Vector3.new(0, 8.2, 0)) * CFrame.Angles(0, math.rad(k * 60), 0) * CFrame.new(0, 0, 2) * CFrame.Angles(math.rad(-25), 0, 0), Color3.fromRGB(50, 150, 70), Enum.Material.Grass, decor))
			feuille.CastShadow = false
		end
	end
	local function banc(position: Vector3, versInterieur: number)
		deco(bloc("AssiseBanc", Vector3.new(7, 0.5, 2), CFrame.new(position + Vector3.new(0, 1.6, 0)), Color3.fromRGB(110, 70, 40), Enum.Material.WoodPlanks, decor))
		-- Dossier côté mur (le banc regarde l'allée)
		deco(bloc("DossierBanc", Vector3.new(7, 1.4, 0.3), CFrame.new(position + Vector3.new(0, 2.5, -versInterieur * 0.85)), Color3.fromRGB(110, 70, 40), Enum.Material.WoodPlanks, decor))
		for _, dx in ipairs({ -3, 3 }) do
			deco(bloc("PiedBanc", Vector3.new(0.4, 1.4, 1.8), CFrame.new(position + Vector3.new(dx, 0.7, 0)), OR, Enum.Material.Foil, decor))
		end
	end
	for _, info in ipairs({
		{ z = -DZ, vitrines = { -185, -145, -105, 105, 145, 185 }, pots = { -165, -125, -85, 85, 125, 165 } },
		{ z = DZ, vitrines = { -185, -145, -105, -65, 65, 105, 145, 185 }, pots = { -165, -125, -85, 85, 125, 165 } },
	}) do
		local versInterieur = if info.z < 0 then 1 else -1
		for _, x in ipairs(info.vitrines) do
			banc(Vector3.new(x, Y1, info.z + versInterieur * 4.5), versInterieur)
		end
		for _, x in ipairs(info.pots) do
			palmierEnPot(Vector3.new(x, Y1, info.z + versInterieur * 3))
		end
	end
	-- f) Grands écrans publicitaires au bout de chaque bloc de boutiques (face aux allées)
	local PUBS = {
		{ "TURBO COLA", Color3.fromRGB(215, 30, 35) }, { "NEON TIRES", Color3.fromRGB(40, 140, 255) },
		{ "DRIFT FUEL", Color3.fromRGB(255, 150, 20) }, { "SKY KARTS", Color3.fromRGB(150, 70, 230) },
		{ "DUNE ENERGY", Color3.fromRGB(240, 190, 30) }, { "GOLDEN MALL", OR },
	}
	local numeroPub = 0
	for _, cx in ipairs(ILOTS_X) do
		for _, sz in ipairs({ -1, 1 }) do
			numeroPub += 1
			local pub = PUBS[(numeroPub - 1) % #PUBS + 1]
			local cf = CFrame.lookAt(Vector3.new(cx, Y1 + 9, sz * 124.4), Vector3.new(cx, Y1 + 9, sz * 200))
			deco(bloc("CadrePub", Vector3.new(38, 9, 0.4), cf, OR, Enum.Material.Foil, decor))
			local ecran = deco(bloc("EcranPub", Vector3.new(37, 8, 0.2), cf * CFrame.new(0, 0, -0.25), Color3.fromRGB(12, 12, 16), Enum.Material.SmoothPlastic, decor))
			texte(ecran, Enum.NormalId.Front, pub[1], pub[2], Color3.fromRGB(12, 12, 16))
		end
	end
	-- g) Lignes dorées aussi le long des allées transversales de l'étage
	for _, x in ipairs({ -173, -99, 99, 173 }) do
		for _, cote in ipairs({ -1, 1 }) do
			for _, segment in ipairs({ { -124, -13 }, { 13, 124 } }) do
				local longueur = segment[2] - segment[1]
				deco(bloc("IncrustationOr", Vector3.new(0.5, 0.05, longueur), CFrame.new(x + cote * 10.5, Y1 + 0.035, (segment[1] + segment[2]) / 2), OR, Enum.Material.Foil, decor)).CastShadow = false
			end
		end
	end

	-- 3) Grandes bannières suspendues dans l'atrium (rouge et or, aux couleurs du mall)
	local n = 0
	for _, z in ipairs({ -110, -70, -35, 35, 70, 110 }) do
		for _, x in ipairs({ -22, 22 }) do
			n += 1
			local couleur = if n % 2 == 0 then Color3.fromRGB(190, 25, 35) else Color3.fromRGB(25, 25, 30)
			local hautB = SOL + HAUT_PLAFOND_2 - 0.5
			deco(bloc("TringleBanniere", Vector3.new(0.4, 0.4, 7), CFrame.new(x, hautB, z), OR, Enum.Material.Foil, decor))
			local banniere = bloc("Banniere", Vector3.new(0.2, 13, 6), CFrame.new(x, hautB - 6.8, z), couleur, Enum.Material.Fabric, decor)
			deco(banniere)
			banniere.CastShadow = false
			for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
				local l = texte(banniere, face, "✦\nGOLDEN\nMALL\n✦", OR)
				l.TextScaled = true
			end
		end
	end
end

