<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX3"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">KartConfig</string><ProtectedString name="Source"><![CDATA[--[[
	KartConfig  (ModuleScript)
	À placer dans : ReplicatedStorage   — nom exact : KartConfig

	Le fichier des RÉGLAGES. Change les chiffres ici pour modifier le jeu
	sans toucher au reste du code.
]]

local Lighting = game:GetService("Lighting")

local Config = {}

Config.NomDuJeu = "Golden Mall Drift"
Config.Lieu = "Dubaï"

---------------------------------------------------------------------
-- LES KARTS  (Niveau = niveau du joueur nécessaire pour le débloquer)
-- VitesseMax     : vitesse de pointe (≈ km/h affichés)
-- Acceleration   : vitesse pour atteindre la vitesse max
-- Freinage       : puissance du frein
-- Rotation       : vitesse de rotation en conduite normale
-- RotationDrift  : multiplicateur de rotation en drift (360 !)
-- Adherence      : plus c'est haut, moins ça glisse (conduite normale)
-- AdherenceDrift : adhérence en drift (bas = grosse glissade)
-- Boost          : vitesse gagnée après un beau drift (2 étoiles ou +)
---------------------------------------------------------------------
Config.Karts = {
	Basique = {
		Nom = "Kart Basique", Niveau = 1, Ordre = 1,
		Description = "Équilibré, parfait pour apprendre.",
		VitesseMax = 50, Acceleration = 32, Freinage = 70,
		Rotation = 2.4, RotationDrift = 1.7, Adherence = 9, AdherenceDrift = 1.4, Boost = 16,
	},
	Chariot = {
		Nom = "Chariot Turbo", Niveau = 3, Ordre = 2,
		Description = "Un caddie motorisé. Glisse énormément !",
		VitesseMax = 46, Acceleration = 30, Freinage = 60,
		Rotation = 3.1, RotationDrift = 2.1, Adherence = 6, AdherenceDrift = 0.9, Boost = 15,
	},
	Bolide = {
		Nom = "Bolide Sport", Niveau = 6, Ordre = 3,
		Description = "Rapide et précis, avec un aileron.",
		VitesseMax = 66, Acceleration = 42, Freinage = 80,
		Rotation = 2.5, RotationDrift = 1.9, Adherence = 10, AdherenceDrift = 1.1, Boost = 22,
	},
	ProDubai = {
		Nom = "Kart Pro Dubaï", Niveau = 10, Ordre = 4,
		Description = "Le kart des champions. Finitions dorées.",
		VitesseMax = 74, Acceleration = 48, Freinage = 85,
		Rotation = 2.7, RotationDrift = 2.0, Adherence = 11, AdherenceDrift = 1.0, Boost = 26,
	},
}

---------------------------------------------------------------------
-- PERSONNALISATION (le garage VIP)
---------------------------------------------------------------------
Config.Couleurs = {
	{ Nom = "Blanc", Couleur = Color3.fromRGB(240, 240, 240), Niveau = 1 },
	{ Nom = "Noir", Couleur = Color3.fromRGB(25, 25, 28), Niveau = 1 },
	{ Nom = "Rouge", Couleur = Color3.fromRGB(215, 35, 40), Niveau = 1 },
	{ Nom = "Bleu", Couleur = Color3.fromRGB(35, 105, 215), Niveau = 1 },
	{ Nom = "Gris", Couleur = Color3.fromRGB(140, 145, 155), Niveau = 1 },
	{ Nom = "Jaune", Couleur = Color3.fromRGB(250, 205, 30), Niveau = 2 },
	{ Nom = "Vert", Couleur = Color3.fromRGB(40, 170, 80), Niveau = 2 },
	{ Nom = "Orange", Couleur = Color3.fromRGB(245, 130, 30), Niveau = 2 },
	{ Nom = "Rose", Couleur = Color3.fromRGB(245, 120, 180), Niveau = 4 },
	{ Nom = "Violet", Couleur = Color3.fromRGB(130, 70, 200), Niveau = 4 },
	{ Nom = "Turquoise", Couleur = Color3.fromRGB(30, 200, 200), Niveau = 4 },
	{ Nom = "Bleu nuit", Couleur = Color3.fromRGB(20, 35, 90), Niveau = 5 },
	{ Nom = "Bordeaux", Couleur = Color3.fromRGB(110, 20, 40), Niveau = 5 },
	{ Nom = "Sable", Couleur = Color3.fromRGB(215, 190, 140), Niveau = 7 },
	{ Nom = "Vert menthe", Couleur = Color3.fromRGB(150, 230, 190), Niveau = 7 },
	{ Nom = "Or", Couleur = Color3.fromRGB(225, 175, 45), Niveau = 10 },
}

-- Finition de la peinture (aspect réaliste)
Config.Finitions = {
	{ Nom = "Brillant", Materiau = Enum.Material.SmoothPlastic, Reflet = 0.12, Niveau = 1 },
	{ Nom = "Mat", Materiau = Enum.Material.SmoothPlastic, Reflet = 0, Niveau = 2 },
	{ Nom = "Métallisé", Materiau = Enum.Material.Metal, Reflet = 0.1, Niveau = 4 },
	{ Nom = "Nacré", Materiau = Enum.Material.SmoothPlastic, Reflet = 0.35, Niveau = 8 },
	{ Nom = "Chrome", Materiau = Enum.Material.Foil, Reflet = 0.55, Niveau = 12 },
}

-- Autocollants sur les flancs du kart
Config.Autocollants = {
	{ Nom = "Aucun", Texte = "", Niveau = 1 },
	{ Nom = "Étoile", Texte = "⭐", Niveau = 1 },
	{ Nom = "Lunettes", Texte = "😎", Niveau = 2 },
	{ Nom = "Chat", Texte = "🐱", Niveau = 3 },
	{ Nom = "Donut", Texte = "🍩", Niveau = 5 },
	{ Nom = "Éclair", Texte = "⚡", Niveau = 7 },
	{ Nom = "Couronne", Texte = "👑", Niveau = 9 },
	{ Nom = "Diamant", Texte = "💎", Niveau = 12 },
}

-- Le kart d'un nouveau joueur
Config.PersoParDefaut = {
	Kart = "Basique",
	Carrosserie = "Bleu",
	Finition = "Brillant",
	Jantes = "Blanc",
	Siege = "Noir",
	Bandes = "Blanc",
	BandesActives = true,
	Autocollant = "Étoile",
	Numero = 7,
}

-- Petites fonctions pour retrouver un élément par son nom
local function chercher(liste, nom)
	for _, element in ipairs(liste) do
		if element.Nom == nom then
			return element
		end
	end
	return nil
end
function Config.Couleur(nom: string) return chercher(Config.Couleurs, nom) end
function Config.Finition(nom: string) return chercher(Config.Finitions, nom) end
function Config.Autocollant(nom: string) return chercher(Config.Autocollants, nom) end

---------------------------------------------------------------------
-- PROGRESSION : les drifts donnent de l'XP → le niveau du joueur monte
-- → débloque karts, couleurs, finitions, autocollants
---------------------------------------------------------------------
Config.NiveauMax = 30
function Config.XPPourNiveauSuivant(niveau: number): number
	return 800 + 400 * (niveau - 1) -- niv.1→2 : 800 XP, niv.2→3 : 1200 XP, etc.
end
function Config.NiveauDepuisXP(xp: number): (number, number, number)
	local niveau = 1
	local reste = xp
	while niveau < Config.NiveauMax and reste >= Config.XPPourNiveauSuivant(niveau) do
		reste -= Config.XPPourNiveauSuivant(niveau)
		niveau += 1
	end
	return niveau, reste, Config.XPPourNiveauSuivant(niveau)
end

---------------------------------------------------------------------
-- LE SOL MOUILLÉ
---------------------------------------------------------------------
Config.Mouille = {
	Adherence = 0.25, -- adhérence x0.25 = 4x plus glissant
	Acceleration = 0.5, -- on accélère 2x moins bien sur l'eau
	BonusPoints = 1.5, -- un drift sur l'eau rapporte x1,5
}

---------------------------------------------------------------------
-- LE SCORE DE DRIFT
---------------------------------------------------------------------
Config.Score = {
	VitesseMin = 10, -- en dessous, pas de points
	AngleMin = 12, -- angle de glisse minimum (degrés)
	Tolerance = 0.35, -- secondes sans glisser avant d'encaisser le drift
	ComboParSeconde = 0.6, -- le multiplicateur monte de 0.6 par seconde
	ComboMax = 5,
	PointsParStud = 0.5,
	Bonus360 = 150, -- bonus par 360° (x combo)
	SeuilChoc = 22, -- perte de vitesse brutale = choc = drift perdu
	Minimum = 20,
	Etoiles = { 150, 500, 1200 }, -- points pour 1, 2, 3 étoiles
	DureeBoost = 1.5,
	MaxParDrift = 8000, -- sécurité anti-triche côté serveur
}

---------------------------------------------------------------------
-- SONS (optionnel) : colle un identifiant de la Boîte à outils > Audio
-- ex. "rbxassetid://1234567". Vide = pas de son.
---------------------------------------------------------------------
Config.Sons = {
	Moteur = "",
	Drift = "",
	Eclaboussure = "",
}

---------------------------------------------------------------------
-- JOUR / NUIT
---------------------------------------------------------------------
Config.NuitParDefaut = true

function Config.AppliquerAmbiance(nuit: boolean)
	if nuit then
		Lighting.ClockTime = 0
		Lighting.Brightness = 1
		Lighting.Ambient = Color3.fromRGB(75, 70, 95)
		Lighting.OutdoorAmbient = Color3.fromRGB(50, 45, 70)
	else
		Lighting.ClockTime = 13
		Lighting.Brightness = 2.5
		Lighting.Ambient = Color3.fromRGB(145, 140, 130)
		Lighting.OutdoorAmbient = Color3.fromRGB(155, 150, 140)
	end
	Lighting:SetAttribute("Nuit", nuit)
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">KartBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	KartBuilder  (ModuleScript)
	À placer dans : ReplicatedStorage   — nom exact : KartBuilder

	Construit un kart à partir de sa personnalisation (type, couleurs, finition,
	bandes, autocollant, numéro). Utilisé :
	  • par le serveur, pour le vrai kart du joueur
	  • par le garage, pour l'aperçu sur le plateau tournant
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))

local KartBuilder = {}

local NOIR = Color3.fromRGB(25, 25, 25)
local GRIS = Color3.fromRGB(120, 125, 135)
local OR = Color3.fromRGB(225, 175, 45)

---------------------------------------------------------------------
-- Vérifie une personnalisation : tout ce qui est inconnu ou pas encore
-- débloqué au niveau du joueur est remplacé par la valeur par défaut.
---------------------------------------------------------------------
function KartBuilder.Nettoyer(perso: any, niveau: number): { [string]: any }
	local defaut = Config.PersoParDefaut
	local propre = table.clone(defaut)
	if type(perso) ~= "table" then
		return propre
	end

	local function couleurOk(nom)
		local c = type(nom) == "string" and Config.Couleur(nom)
		return c and c.Niveau <= niveau
	end

	local kart = Config.Karts[perso.Kart]
	if kart and kart.Niveau <= niveau then
		propre.Kart = perso.Kart
	end
	for _, champ in ipairs({ "Carrosserie", "Jantes", "Siege", "Bandes" }) do
		if couleurOk(perso[champ]) then
			propre[champ] = perso[champ]
		end
	end
	local finition = type(perso.Finition) == "string" and Config.Finition(perso.Finition)
	if finition and finition.Niveau <= niveau then
		propre.Finition = perso.Finition
	end
	local autocollant = type(perso.Autocollant) == "string" and Config.Autocollant(perso.Autocollant)
	if autocollant and autocollant.Niveau <= niveau then
		propre.Autocollant = perso.Autocollant
	end
	if type(perso.BandesActives) == "boolean" then
		propre.BandesActives = perso.BandesActives
	end
	if type(perso.Numero) == "number" and perso.Numero == perso.Numero then
		propre.Numero = math.clamp(math.floor(perso.Numero), 0, 99)
	end
	return propre
end

---------------------------------------------------------------------
-- Applique les couleurs / finition / déco sur un kart déjà construit
---------------------------------------------------------------------
function KartBuilder.Peindre(modele: Model, perso: { [string]: any })
	local function couleur(nom: string): Color3
		local c = Config.Couleur(nom)
		return c and c.Couleur or Color3.new(1, 1, 1)
	end
	local finition = Config.Finition(perso.Finition) or Config.Finitions[1]

	for _, p in ipairs(modele:GetDescendants()) do
		if p:IsA("BasePart") then
			local role = p:GetAttribute("Peinture")
			if role == "Carrosserie" then
				p.Color = couleur(perso.Carrosserie)
				p.Material = finition.Materiau
				p.Reflectance = finition.Reflet
			elseif role == "Jantes" then
				p.Color = couleur(perso.Jantes)
			elseif role == "Siege" then
				p.Color = couleur(perso.Siege)
			elseif role == "Bandes" then
				p.Color = couleur(perso.Bandes)
				p.Transparency = perso.BandesActives and 0 or 1
			end
		elseif p:IsA("TextLabel") and p.Name == "Deco" then
			local autocollant = Config.Autocollant(perso.Autocollant)
			local symbole = autocollant and autocollant.Texte or ""
			p.Text = (symbole ~= "" and (symbole .. " ") or "") .. tostring(perso.Numero)
		end
	end
	modele:SetAttribute("KartType", perso.Kart)
end

---------------------------------------------------------------------
-- Construit le kart
--   perso  : la personnalisation (voir Config.PersoParDefaut)
--   cf     : position / orientation
--   apercu : true = kart de vitrine (fixe, sans physique ni effets)
---------------------------------------------------------------------
function KartBuilder.Construire(perso: { [string]: any }, cf: CFrame, apercu: boolean?): Model
	local typeKart = Config.Karts[perso.Kart] and perso.Kart or "Basique"
	local modele = Instance.new("Model")
	modele.Name = "Kart_" .. typeKart

	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(4, 0.8, 6)
	chassis.CFrame = cf
	chassis.TopSurface = Enum.SurfaceType.Smooth
	chassis.BottomSurface = Enum.SurfaceType.Smooth
	-- Friction 0 : c'est le script de conduite qui gère la glisse
	chassis.CustomPhysicalProperties = PhysicalProperties.new(1, 0, 0, 100, 100)
	chassis.Anchored = apercu == true
	chassis:SetAttribute("Peinture", "Carrosserie")
	chassis.Parent = modele
	modele.PrimaryPart = chassis

	local function piece(nom: string, taille: Vector3, decalage: CFrame, couleur: Color3, peinture: string?, matiere: Enum.Material?, forme: Enum.PartType?): Part
		local p = Instance.new("Part")
		p.Name = nom
		p.Size = taille
		p.CFrame = chassis.CFrame * decalage
		p.Color = couleur
		p.Material = matiere or Enum.Material.SmoothPlastic
		p.Shape = forme or Enum.PartType.Block
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if peinture then
			p:SetAttribute("Peinture", peinture)
		end
		if apercu then
			p.Anchored = true
		else
			local w = Instance.new("WeldConstraint")
			w.Part0 = chassis
			w.Part1 = p
			w.Parent = p
		end
		p.Parent = modele
		return p
	end

	local CYL = Enum.PartType.Cylinder -- les cylindres Roblox sont couchés sur l'axe X : parfait pour des roues

	-- Roues avant + roues arrière pivotantes (plus petites, comme les vrais karts de drift)
	for _, r in ipairs({
		{ x = -2.2, y = 0.2, z = -2.3, d = 1.6, l = 0.8 },
		{ x = 2.2, y = 0.2, z = -2.3, d = 1.6, l = 0.8 },
		{ x = -1.9, y = -0.05, z = 2.5, d = 1.1, l = 0.6 },
		{ x = 1.9, y = -0.05, z = 2.5, d = 1.1, l = 0.6 },
	}) do
		piece("Roue", Vector3.new(r.l, r.d, r.d), CFrame.new(r.x, r.y, r.z), NOIR, nil, Enum.Material.SmoothPlastic, CYL)
		local dehors = math.sign(r.x) * (math.abs(r.x) + r.l / 2 + 0.03)
		piece("Jante", Vector3.new(0.06, r.d * 0.6, r.d * 0.6), CFrame.new(dehors, r.y, r.z), Color3.new(1, 1, 1), "Jantes", Enum.Material.Metal, CYL)
	end

	piece("PareChoc", Vector3.new(4.6, 0.5, 0.6), CFrame.new(0, 0, -3.2), NOIR)
	piece("Colonne", Vector3.new(0.3, 0.3, 2), CFrame.new(0, 1.1, -1.6) * CFrame.Angles(math.rad(35), 0, 0), GRIS)
	piece("Volant", Vector3.new(0.2, 1.7, 1.7), CFrame.new(0, 1.7, -0.9) * CFrame.Angles(math.rad(-35), math.rad(90), 0), OR, nil, Enum.Material.Metal, CYL)
	piece("Dossier", Vector3.new(2.4, 2, 0.4), CFrame.new(0, 1.6, 2.2) * CFrame.Angles(math.rad(-10), 0, 0), NOIR, "Siege", Enum.Material.Fabric)

	-- Bandes de course sur le capot
	piece("Bande", Vector3.new(0.45, 0.05, 3.6), CFrame.new(-0.6, 0.42, -1.2), Color3.new(1, 1, 1), "Bandes")
	piece("Bande", Vector3.new(0.45, 0.05, 3.6), CFrame.new(0.6, 0.42, -1.2), Color3.new(1, 1, 1), "Bandes")

	-- Flancs avec autocollant + numéro
	for _, cote in ipairs({ -1, 1 }) do
		local flanc = piece("Flanc", Vector3.new(0.05, 0.7, 3), CFrame.new(cote * 2.03, 0, -0.6), Color3.new(1, 1, 1), nil)
		flanc.Transparency = 1
		local sg = Instance.new("SurfaceGui")
		sg.Face = cote < 0 and Enum.NormalId.Left or Enum.NormalId.Right
		sg.LightInfluence = 0.5
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 60
		sg.Parent = flanc
		local deco = Instance.new("TextLabel")
		deco.Name = "Deco"
		deco.Size = UDim2.fromScale(1, 1)
		deco.BackgroundTransparency = 1
		deco.TextScaled = true
		deco.Font = Enum.Font.GothamBlack
		deco.TextColor3 = Color3.new(1, 1, 1)
		local contour = Instance.new("UIStroke")
		contour.Thickness = 2
		contour.Parent = deco
		deco.Parent = sg
	end

	-- Éléments propres à chaque modèle de kart
	if typeKart == "Chariot" then
		local panier = piece("Panier", Vector3.new(3.6, 2, 2.2), CFrame.new(0, 1.4, -2.1), GRIS, nil, Enum.Material.DiamondPlate)
		panier.Transparency = 0.35
		piece("Poignee", Vector3.new(3.4, 0.25, 0.25), CFrame.new(0, 2.6, -1), Color3.fromRGB(220, 40, 40))
	elseif typeKart == "Bolide" or typeKart == "ProDubai" then
		local dore = typeKart == "ProDubai"
		piece("Aileron", Vector3.new(4.2, 0.2, 1), CFrame.new(0, 2.5, 3), NOIR, (not dore) and "Carrosserie" or nil, dore and Enum.Material.Foil or nil).Color = dore and OR or NOIR
		piece("SupportAileron", Vector3.new(0.2, 1.4, 0.4), CFrame.new(-1.3, 1.8, 2.9), NOIR)
		piece("SupportAileron", Vector3.new(0.2, 1.4, 0.4), CFrame.new(1.3, 1.8, 2.9), NOIR)
		piece("Nez", Vector3.new(3, 0.6, 1.6), CFrame.new(0, 0.6, -2.4) * CFrame.Angles(math.rad(-12), 0, 0), Color3.new(1, 1, 1), "Carrosserie")
		if dore then
			for _, cote in ipairs({ -1, 1 }) do
				piece("LiseretOr", Vector3.new(0.1, 0.15, 5.6), CFrame.new(cote * 2.05, 0.35, 0), OR, nil, Enum.Material.Foil)
			end
		end
	end

	-- Le siège (on s'assoit dedans)
	local siege = Instance.new("Seat")
	siege.Name = "Siege"
	siege.Size = Vector3.new(2.4, 0.6, 2.2)
	siege.CFrame = chassis.CFrame * CFrame.new(0, 0.7, 1)
	siege.Material = Enum.Material.Fabric
	siege.CanCollide = false
	siege.Massless = true
	siege.TopSurface = Enum.SurfaceType.Smooth
	siege:SetAttribute("Peinture", "Siege")
	if apercu then
		siege.Anchored = true
		siege.Disabled = true
	else
		local ws = Instance.new("WeldConstraint")
		ws.Part0 = chassis
		ws.Part1 = siege
		ws.Parent = siege
	end
	siege.Parent = modele

	if not apercu then
		-- Garde le kart à plat (il tourne sur lui-même mais ne se retourne pas)
		local attRedresse = Instance.new("Attachment")
		attRedresse.Name = "Redresse"
		attRedresse.CFrame = CFrame.Angles(0, 0, math.rad(90)) -- axe principal vers le haut
		attRedresse.Parent = chassis
		local align = Instance.new("AlignOrientation")
		align.Mode = Enum.OrientationAlignmentMode.OneAttachment
		align.Attachment0 = attRedresse
		align.AlignType = Enum.AlignType.PrimaryAxisParallel
		align.PrimaryAxis = Vector3.yAxis
		align.MaxTorque = 1e6
		align.Responsiveness = 30
		align.Parent = chassis

		-- Effets : traces de pneus, fumée de gomme, gerbes d'eau
		for _, cote in ipairs({ -1.9, 1.9 }) do
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(cote - 0.3, -0.38, 2.6)
			a0.Parent = chassis
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(cote + 0.3, -0.38, 2.6)
			a1.Parent = chassis
			local trace = Instance.new("Trail")
			trace.Name = "TracePneu"
			trace.Attachment0 = a0
			trace.Attachment1 = a1
			trace.Color = ColorSequence.new(Color3.fromRGB(30, 30, 30))
			trace.Transparency = NumberSequence.new(0.45, 1)
			trace.Lifetime = 4
			trace.LightInfluence = 1
			trace.Enabled = false
			trace.Parent = chassis

			local attEffet = Instance.new("Attachment")
			attEffet.Name = "EffetRoue"
			attEffet.Position = Vector3.new(cote, -0.3, 2.6)
			attEffet.Parent = chassis

			local fumee = Instance.new("ParticleEmitter")
			fumee.Name = "Fumee"
			fumee.Color = ColorSequence.new(Color3.fromRGB(215, 215, 215))
			fumee.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 3) })
			fumee.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
			fumee.Lifetime = NumberRange.new(0.6, 1.1)
			fumee.Speed = NumberRange.new(1, 3)
			fumee.SpreadAngle = Vector2.new(40, 40)
			fumee.Rate = 35
			fumee.Enabled = false
			fumee.Parent = attEffet

			local eau = Instance.new("ParticleEmitter")
			eau.Name = "Eclaboussures"
			eau.Color = ColorSequence.new(Color3.fromRGB(190, 225, 255))
			eau.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0.1) })
			eau.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
			eau.Lifetime = NumberRange.new(0.3, 0.6)
			eau.Speed = NumberRange.new(8, 14)
			eau.SpreadAngle = Vector2.new(50, 50)
			eau.Acceleration = Vector3.new(0, -60, 0)
			eau.EmissionDirection = Enum.NormalId.Top
			eau.Rate = 80
			eau.Enabled = false
			eau.Parent = attEffet
		end
	end

	KartBuilder.Peindre(modele, perso)
	modele:SetAttribute("KartType", typeKart)
	return modele
end

return KartBuilder
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX5"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX4"><Properties><string name="Name">MallDriftServer</string><ProtectedString name="Source"><![CDATA[--[[
	MallDriftServer  (Script)
	À placer dans : ServerScriptService   — nom conseillé : MallDriftServer

	Au lancement du jeu, ce script :
	  • construit le GOLDEN MALL de Dubaï : fontaine géante, aquarium avec poissons,
	    palmiers, colonnes dorées, boutiques de luxe, food court, piste de ski…
	  • crée le GARAGE VIP (plateau tournant, atelier de personnalisation)
	  • pose les zones de sol mouillé + panneaux jaunes « ATTENTION SOL GLISSANT »
	  • sauvegarde la progression de chaque joueur (XP, niveau, kart personnalisé)
	  • fait apparaître le kart personnel de chaque joueur
]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
local KartBuilder = require(ReplicatedStorage:WaitForChild("KartBuilder"))

Config.AppliquerAmbiance(Config.NuitParDefaut)

if not Lighting:FindFirstChildOfClass("BloomEffect") then
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.7
	bloom.Size = 28
	bloom.Threshold = 1.1
	bloom.Parent = Lighting
end
if not Lighting:FindFirstChild("CouleursMallDrift") then
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "CouleursMallDrift"
	cc.Saturation = 0.12
	cc.Contrast = 0.06
	cc.TintColor = Color3.fromRGB(255, 248, 235) -- ambiance chaude et dorée
	cc.Parent = Lighting
end

local carte = Instance.new("Folder")
carte.Name = "GoldenMall"
carte.Parent = workspace

local random = Random.new(2026) -- toujours le même décor

---------------------------------------------------------------------
-- Outils de construction
---------------------------------------------------------------------
local function bloc(nom: string, taille: Vector3, cf: CFrame, couleur: Color3, matiere: Enum.Material?, parent: Instance?): Part
	local p = Instance.new("Part")
	p.Name = nom
	p.Size = taille
	p.CFrame = cf
	p.Color = couleur
	p.Material = matiere or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or carte
	return p
end

local function deco(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function cylindreDebout(nom: string, hauteur: number, diametre: number, position: Vector3, couleur: Color3, matiere: Enum.Material?, parent: Instance?): Part
	local p = bloc(nom, Vector3.new(hauteur, diametre, diametre), CFrame.new(position) * CFrame.Angles(0, 0, math.rad(90)), couleur, matiere, parent)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function texte(part: BasePart, face: Enum.NormalId, txt: string, couleurTexte: Color3?, fond: Color3?): TextLabel
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.LightInfluence = 0
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.Parent = part
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = fond and 0 or 1
	l.BackgroundColor3 = fond or Color3.new(0, 0, 0)
	l.TextColor3 = couleurTexte or Color3.new(1, 1, 1)
	l.TextScaled = true
	l.Font = Enum.Font.GothamBlack
	l.Text = txt
	l.Parent = sg
	return l
end

-- Pancarte dont la face avant regarde dans la direction "versOu"
local function pancarte(nom: string, taille: Vector3, position: Vector3, versOu: Vector3, txt: string, couleur: Color3, couleurTexte: Color3?, matiere: Enum.Material?): Part
	local p = bloc(nom, taille, CFrame.lookAt(position, position + versOu), couleur, matiere or Enum.Material.SmoothPlastic)
	deco(p)
	texte(p, Enum.NormalId.Front, txt, couleurTexte)
	return p
end

local SOL = 1
local LARGEUR, PROFONDEUR, HAUTEUR = 420, 320, 40
local DX, DZ = LARGEUR / 2, PROFONDEUR / 2

local MARBRE = Color3.fromRGB(242, 235, 220)
local OR = Color3.fromRGB(225, 175, 45)
local OR_FONCE = Color3.fromRGB(180, 135, 30)
local NOIR_LUXE = Color3.fromRGB(22, 22, 26)

---------------------------------------------------------------------
-- SOL, MURS, VERRIÈRE, LUMIÈRES
---------------------------------------------------------------------
local sol = bloc("SolMarbre", Vector3.new(LARGEUR, 1, PROFONDEUR), CFrame.new(0, SOL - 0.5, 0), MARBRE, Enum.Material.Marble)
sol.Reflectance = 0.18

-- Incrustations dorées dans le marbre
deco(bloc("IncrustationOr", Vector3.new(LARGEUR, 0.05, 1.2), CFrame.new(0, SOL + 0.03, 0), OR, Enum.Material.Foil))
deco(bloc("IncrustationOr", Vector3.new(1.2, 0.05, PROFONDEUR), CFrame.new(0, SOL + 0.03, 0), OR, Enum.Material.Foil))
for _, z in ipairs({ -80, 80 }) do
	deco(bloc("IncrustationOr", Vector3.new(LARGEUR, 0.05, 0.6), CFrame.new(0, SOL + 0.03, z), OR, Enum.Material.Foil))
end

local yMur = SOL + HAUTEUR / 2
local couleurMur = Color3.fromRGB(246, 240, 228)
bloc("MurNord", Vector3.new(LARGEUR + 4, HAUTEUR, 2), CFrame.new(0, yMur, -DZ - 1), couleurMur, Enum.Material.Marble)
bloc("MurOuest", Vector3.new(2, HAUTEUR, PROFONDEUR), CFrame.new(-DX - 1, yMur, 0), couleurMur, Enum.Material.Marble)
bloc("MurEst", Vector3.new(2, HAUTEUR, PROFONDEUR), CFrame.new(DX + 1, yMur, 0), couleurMur, Enum.Material.Marble)
-- Façade sud avec les grandes portes vitrées de l'entrée
local largeurPortes = 40
local largeurCote = (LARGEUR + 4 - largeurPortes) / 2
bloc("MurSudOuest", Vector3.new(largeurCote, HAUTEUR, 2), CFrame.new(-(largeurPortes / 2 + largeurCote / 2), yMur, DZ + 1), couleurMur, Enum.Material.Marble)
bloc("MurSudEst", Vector3.new(largeurCote, HAUTEUR, 2), CFrame.new(largeurPortes / 2 + largeurCote / 2, yMur, DZ + 1), couleurMur, Enum.Material.Marble)
local portes = bloc("PortesEntree", Vector3.new(largeurPortes, HAUTEUR, 1), CFrame.new(0, yMur, DZ + 1), Color3.fromRGB(170, 205, 230), Enum.Material.Glass)
portes.Transparency = 0.55
pancarte("Enseigne", Vector3.new(70, 7, 0.5), Vector3.new(0, SOL + 31, DZ - 0.4), Vector3.new(0, 0, -1), "✦ GOLDEN MALL ✦", NOIR_LUXE, OR)

-- Verrière + poutres dorées
local verriere = bloc("Verriere", Vector3.new(LARGEUR + 4, 1, PROFONDEUR + 4), CFrame.new(0, SOL + HAUTEUR + 1.5, 0), Color3.fromRGB(200, 220, 235), Enum.Material.Glass)
verriere.Transparency = 0.85
verriere.CastShadow = false
deco(verriere)
for x = -180, 180, 60 do
	deco(bloc("Poutre", Vector3.new(1.5, 1.5, PROFONDEUR), CFrame.new(x, SOL + HAUTEUR + 0.5, 0), OR, Enum.Material.Foil))
end
for z = -120, 120, 60 do
	deco(bloc("Poutre", Vector3.new(LARGEUR, 1.5, 1.5), CFrame.new(0, SOL + HAUTEUR + 0.5, z), OR, Enum.Material.Foil))
end

local lampes = Instance.new("Folder")
lampes.Name = "Lampes"
lampes.Parent = carte
for x = -180, 180, 60 do
	for z = -120, 120, 60 do
		local l = bloc("Lampe", Vector3.new(6, 0.4, 6), CFrame.new(x, SOL + HAUTEUR - 2, z), Color3.fromRGB(255, 245, 220), Enum.Material.Neon, lampes)
		deco(l)
		l.CastShadow = false
		local pl = Instance.new("PointLight")
		pl.Range = 45
		pl.Brightness = 1.4
		pl.Color = Color3.fromRGB(255, 236, 200)
		pl.Parent = l
	end
end

---------------------------------------------------------------------
-- LA FONTAINE GÉANTE (au centre) + lustre + colonnes dorées
---------------------------------------------------------------------
local fontaine = Instance.new("Model")
fontaine.Name = "Fontaine"
fontaine.Parent = carte
cylindreDebout("Bassin", 3, 40, Vector3.new(0, SOL + 1.5, 0), Color3.fromRGB(250, 248, 242), Enum.Material.Marble, fontaine)
local eauFontaine = cylindreDebout("Eau", 0.3, 37, Vector3.new(0, SOL + 2.9, 0), Color3.fromRGB(60, 160, 230), Enum.Material.Glass, fontaine)
eauFontaine.Transparency = 0.3
deco(eauFontaine)
cylindreDebout("Colonne", 12, 4, Vector3.new(0, SOL + 7, 0), OR, Enum.Material.Foil, fontaine)
local vasque = cylindreDebout("Vasque", 1, 14, Vector3.new(0, SOL + 13, 0), OR, Enum.Material.Foil, fontaine)
local attJet = Instance.new("Attachment")
attJet.Position = Vector3.new(0.6, 0, 0) -- dessus de la vasque (axe X = vertical ici)
attJet.Parent = vasque
local jet = Instance.new("ParticleEmitter")
jet.Name = "JetDEau"
jet.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
jet.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0.3) })
jet.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
jet.Lifetime = NumberRange.new(1.2, 1.6)
jet.Speed = NumberRange.new(22, 28)
jet.SpreadAngle = Vector2.new(18, 18)
jet.Acceleration = Vector3.new(0, -35, 0)
jet.EmissionDirection = Enum.NormalId.Right -- = vers le haut pour ce cylindre couché
jet.Rate = 140
jet.Parent = attJet
local lumiereFontaine = Instance.new("PointLight")
lumiereFontaine.Color = Color3.fromRGB(90, 180, 255)
lumiereFontaine.Range = 30
lumiereFontaine.Brightness = 2
lumiereFontaine.Parent = eauFontaine

local lustre = cylindreDebout("Lustre", 1, 26, Vector3.new(0, SOL + 32, 0), Color3.fromRGB(255, 225, 150), Enum.Material.Neon)
deco(lustre)
local lumiereLustre = Instance.new("PointLight")
lumiereLustre.Range = 60
lumiereLustre.Brightness = 2
lumiereLustre.Color = Color3.fromRGB(255, 225, 170)
lumiereLustre.Parent = lustre

for i = 0, 7 do
	local angle = i * math.pi / 4 + math.pi / 8
	cylindreDebout("ColonneDoree", HAUTEUR, 5, Vector3.new(math.cos(angle) * 58, SOL + HAUTEUR / 2, math.sin(angle) * 58), OR_FONCE, Enum.Material.Foil)
end

---------------------------------------------------------------------
-- L'AQUARIUM GÉANT (mur nord) avec des poissons qui nagent
---------------------------------------------------------------------
local aquarium = Instance.new("Model")
aquarium.Name = "Aquarium"
aquarium.Parent = carte
local AQ_LARGEUR, AQ_HAUT = 160, 32
local eauAq = bloc("Eau", Vector3.new(AQ_LARGEUR, AQ_HAUT, 8), CFrame.new(0, SOL + AQ_HAUT / 2, -DZ + 5), Color3.fromRGB(25, 105, 185), Enum.Material.SmoothPlastic, aquarium)
eauAq.Transparency = 0.5
deco(eauAq)
local vitreAq = bloc("Vitre", Vector3.new(AQ_LARGEUR, AQ_HAUT, 0.6), CFrame.new(0, SOL + AQ_HAUT / 2, -DZ + 9.3), Color3.fromRGB(190, 225, 245), Enum.Material.Glass, aquarium)
vitreAq.Transparency = 0.75
deco(bloc("Sable", Vector3.new(AQ_LARGEUR, 2, 8), CFrame.new(0, SOL + 1, -DZ + 5), Color3.fromRGB(225, 200, 150), Enum.Material.Sand, aquarium))
bloc("CadreHaut", Vector3.new(AQ_LARGEUR + 2, 1.5, 1.5), CFrame.new(0, SOL + AQ_HAUT + 0.75, -DZ + 9.3), OR, Enum.Material.Foil, aquarium)
local lumiereAq = Instance.new("PointLight")
lumiereAq.Color = Color3.fromRGB(80, 170, 255)
lumiereAq.Range = 40
lumiereAq.Brightness = 1.5
lumiereAq.Parent = eauAq
pancarte("PanneauAquarium", Vector3.new(50, 4, 0.5), Vector3.new(0, SOL + 36, -DZ + 0.3), Vector3.new(0, 0, 1), "AQUARIUM GÉANT", NOIR_LUXE, Color3.fromRGB(120, 210, 255))

local CORAUX = { Color3.fromRGB(255, 110, 120), Color3.fromRGB(255, 170, 60), Color3.fromRGB(190, 90, 220), Color3.fromRGB(80, 220, 160) }
for _ = 1, 14 do
	local h = random:NextNumber(2, 6)
	deco(bloc("Corail", Vector3.new(random:NextNumber(1, 2.5), h, random:NextNumber(1, 2.5)), CFrame.new(random:NextNumber(-75, 75), SOL + 2 + h / 2, -DZ + random:NextNumber(2.5, 7.5)), CORAUX[random:NextInteger(1, #CORAUX)], Enum.Material.SmoothPlastic, aquarium))
end
local POISSONS = { Color3.fromRGB(255, 150, 30), Color3.fromRGB(255, 230, 60), Color3.fromRGB(60, 160, 255), Color3.fromRGB(255, 255, 255), Color3.fromRGB(240, 80, 120) }
for _ = 1, 18 do
	local y = SOL + random:NextNumber(5, AQ_HAUT - 3)
	local z = -DZ + random:NextNumber(2.5, 7.5)
	local depart = random:NextNumber(-75, -10)
	local taille = random:NextNumber(0.8, 1.6)
	local poisson = bloc("Poisson", Vector3.new(2.2, 1.1, 0.6) * taille, CFrame.new(depart, y, z), POISSONS[random:NextInteger(1, #POISSONS)], Enum.Material.SmoothPlastic, aquarium)
	deco(poisson)
	local info = TweenInfo.new(random:NextNumber(8, 16), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	TweenService:Create(poisson, info, { CFrame = CFrame.new(random:NextNumber(10, 75), y + random:NextNumber(-3, 3), z) }):Play()
end

---------------------------------------------------------------------
-- BOUTIQUES DE LUXE (vitrines + enseignes dorées)
---------------------------------------------------------------------
local BOUTIQUES = {
	"MAISON DORÉE", "OASIS PARFUMS", "SABLE & SOIE", "AURUM JOAILLERIE", "PERLE D'ORIENT",
	"SKY TECH", "DUNE SPORT", "ÉLÉGANCE", "PALMIER CAFÉ", "FALCON MONTRES", "DATTES ROYALES", "LUNE BLEUE",
}
local TEINTES = {
	Color3.fromRGB(255, 220, 160), Color3.fromRGB(200, 230, 255), Color3.fromRGB(255, 200, 220),
	Color3.fromRGB(210, 255, 220), Color3.fromRGB(235, 215, 255),
}
local numeroBoutique = 0

-- Vitrine collée contre un mur ; "versInterieur" = direction vers le centre du mall
local function vitrine(position: Vector3, versInterieur: Vector3, largeur: number, nom: string?)
	numeroBoutique += 1
	local nomBoutique = nom or BOUTIQUES[(numeroBoutique - 1) % #BOUTIQUES + 1]
	local base = CFrame.lookAt(position, position + versInterieur)
	local boutique = Instance.new("Model")
	boutique.Name = "Boutique_" .. nomBoutique
	boutique.Parent = carte

	local fond = bloc("FondLumineux", Vector3.new(largeur - 2, 14, 0.3), base * CFrame.new(0, SOL + 7, -0.2), TEINTES[numeroBoutique % #TEINTES + 1], Enum.Material.Neon, boutique)
	deco(fond)
	local verre = bloc("Vitrine", Vector3.new(largeur - 2, 14, 0.4), base * CFrame.new(0, SOL + 7, -1.2), Color3.fromRGB(200, 220, 235), Enum.Material.Glass, boutique)
	verre.Transparency = 0.6
	for _, cote in ipairs({ -1, 1 }) do
		bloc("Pilier", Vector3.new(1, 16, 1.6), base * CFrame.new(cote * largeur / 2, SOL + 8, -1), OR, Enum.Material.Foil, boutique)
	end
	local enseigne = bloc("Enseigne", Vector3.new(largeur - 4, 3.5, 0.5), base * CFrame.new(0, SOL + 17, -1), NOIR_LUXE, Enum.Material.SmoothPlastic, boutique)
	deco(enseigne)
	texte(enseigne, Enum.NormalId.Front, nomBoutique, OR)
end

-- Mur ouest
for _, z in ipairs({ -130, -80, -30, 20, 70 }) do
	vitrine(Vector3.new(-DX, 0, z), Vector3.new(1, 0, 0), 40)
end
-- Mur nord (de chaque côté de l'aquarium)
for _, x in ipairs({ -180, -130, 130, 180 }) do
	vitrine(Vector3.new(x, 0, -DZ), Vector3.new(0, 0, 1), 40)
end
-- Mur est
for _, z in ipairs({ -125, 55 }) do
	vitrine(Vector3.new(DX, 0, z), Vector3.new(-1, 0, 0), 40)
end
-- Mur sud (de chaque côté de l'entrée)
for _, x in ipairs({ -75, 75 }) do
	vitrine(Vector3.new(x, 0, DZ), Vector3.new(0, 0, -1), 40)
end

-- Fenêtre sur la piste de ski intérieure (mur est)
local ski = Instance.new("Model")
ski.Name = "PisteDeSki"
ski.Parent = carte
local baseSki = CFrame.lookAt(Vector3.new(DX, 0, -35), Vector3.new(DX - 1, 0, -35))
deco(bloc("Ciel", Vector3.new(80, 26, 0.2), baseSki * CFrame.new(0, SOL + 15, -0.2), Color3.fromRGB(170, 210, 245), Enum.Material.SmoothPlastic, ski))
deco(bloc("Neige", Vector3.new(90, 14, 0.25), baseSki * CFrame.new(-5, SOL + 7, -0.35) * CFrame.Angles(0, 0, math.rad(-12)), Color3.fromRGB(250, 252, 255), Enum.Material.Snow, ski))
for i = 1, 6 do
	cylindreDebout("Sapin", 6, 2.5, (baseSki * CFrame.new(-30 + i * 9, SOL + 6 + i * 1.6, -0.5)).Position, Color3.fromRGB(30, 100, 60), Enum.Material.SmoothPlastic, ski).CanCollide = false
end
local vitreSki = bloc("Vitre", Vector3.new(80, 26, 0.5), baseSki * CFrame.new(0, SOL + 15, -0.8), Color3.fromRGB(220, 235, 250), Enum.Material.Glass, ski)
vitreSki.Transparency = 0.7
pancarte("PanneauSki", Vector3.new(36, 4, 0.5), (baseSki * CFrame.new(0, SOL + 31, -0.6)).Position, Vector3.new(-1, 0, 0), "❄ PISTE DE SKI ❄", Color3.fromRGB(30, 90, 160), Color3.new(1, 1, 1))

---------------------------------------------------------------------
-- ÎLOTS DE BOUTIQUES autour de la fontaine (ils créent des circuits)
---------------------------------------------------------------------
for _, pos in ipairs({ Vector2.new(-115, -75), Vector2.new(115, -75), Vector2.new(-115, 70), Vector2.new(115, 70) }) do
	local ilot = Instance.new("Model")
	ilot.Name = "Ilot"
	ilot.Parent = carte
	bloc("Kiosque", Vector3.new(60, 16, 30), CFrame.new(pos.X, SOL + 8, pos.Y), Color3.fromRGB(250, 246, 238), Enum.Material.Marble, ilot)
	deco(bloc("BandeauOr", Vector3.new(61, 1.2, 31), CFrame.new(pos.X, SOL + 16.6, pos.Y), OR, Enum.Material.Foil, ilot))
	for _, cote in ipairs({ -1, 1 }) do
		numeroBoutique += 1
		local nomB = BOUTIQUES[(numeroBoutique - 1) % #BOUTIQUES + 1]
		pancarte("Enseigne", Vector3.new(44, 4, 0.4), Vector3.new(pos.X, SOL + 11, pos.Y + cote * 15.3), Vector3.new(0, 0, cote), nomB, NOIR_LUXE, OR).Parent = ilot
		local verre = bloc("Vitrine", Vector3.new(50, 7, 0.3), CFrame.new(pos.X, SOL + 4.5, pos.Y + cote * 15.2), TEINTES[numeroBoutique % #TEINTES + 1], Enum.Material.Neon, ilot)
		deco(verre)
	end
end

---------------------------------------------------------------------
-- PALMIERS
---------------------------------------------------------------------
local function palmier(x: number, z: number)
	local arbre = Instance.new("Model")
	arbre.Name = "Palmier"
	arbre.Parent = carte
	cylindreDebout("Bac", 2, 7, Vector3.new(x, SOL + 1, z), Color3.fromRGB(250, 246, 238), Enum.Material.Marble, arbre)
	deco(cylindreDebout("BordOr", 0.3, 7.4, Vector3.new(x, SOL + 2.1, z), OR, Enum.Material.Foil, arbre))
	deco(cylindreDebout("Tronc", 16, 1.4, Vector3.new(x, SOL + 10, z), Color3.fromRGB(140, 100, 60), Enum.Material.Wood, arbre))
	for i = 0, 6 do
		local feuille = bloc("Feuille", Vector3.new(8, 0.3, 2.2), CFrame.new(x, SOL + 18, z) * CFrame.Angles(0, i * math.pi * 2 / 7, 0) * CFrame.new(3.6, 0, 0) * CFrame.Angles(0, 0, math.rad(-28)), Color3.fromRGB(45, 140, 60), Enum.Material.Grass, arbre)
		deco(feuille)
	end
end
for _, x in ipairs({ -160, -100, -40, 40, 100, 160 }) do
	palmier(x, -120)
end
for _, x in ipairs({ -80, -30, 30, 80 }) do
	palmier(x, 125)
end

---------------------------------------------------------------------
-- FOOD COURT (coin sud-ouest) avec des chaises qu'on peut renverser
---------------------------------------------------------------------
local foodCourt = Instance.new("Model")
foodCourt.Name = "FoodCourt"
foodCourt.Parent = carte
deco(bloc("SolTerrasse", Vector3.new(95, 0.05, 62), CFrame.new(-162, SOL + 0.03, 128), Color3.fromRGB(200, 120, 80), Enum.Material.Slate, foodCourt))
vitrine(Vector3.new(-DX, 0, 125), Vector3.new(1, 0, 0), 40, "SHAWARMA STAR")
vitrine(Vector3.new(-185, 0, DZ), Vector3.new(0, 0, -1), 40, "BURGER DUNE")
vitrine(Vector3.new(-140, 0, DZ), Vector3.new(0, 0, -1), 40, "GLACES DU DÉSERT")
local COULEURS_CHAISES = { Color3.fromRGB(230, 70, 60), Color3.fromRGB(250, 200, 40), Color3.fromRGB(60, 170, 220) }
for _, x in ipairs({ -185, -160, -135 }) do
	for _, z in ipairs({ 110, 142 }) do
		local table_ = Instance.new("Model")
		table_.Name = "Table"
		table_.Parent = foodCourt
		local collision = cylindreDebout("Collision", 3.4, 6, Vector3.new(x, SOL + 1.7, z), Color3.new(1, 1, 1), nil, table_)
		collision.Transparency = 1
		deco(cylindreDebout("Plateau", 0.4, 6, Vector3.new(x, SOL + 3.2, z), Color3.new(1, 1, 1), Enum.Material.Marble, table_))
		deco(cylindreDebout("Pied", 3, 0.6, Vector3.new(x, SOL + 1.5, z), OR, Enum.Material.Foil, table_))
		for k, d in ipairs({ Vector3.new(4.5, 0, 0), Vector3.new(-4.5, 0, 0), Vector3.new(0, 0, 4.5), Vector3.new(0, 0, -4.5) }) do
			local chaise = bloc("Chaise", Vector3.new(2, 2.6, 2), CFrame.new(Vector3.new(x, SOL + 1.3, z) + d), COULEURS_CHAISES[(k % 3) + 1], Enum.Material.SmoothPlastic, table_)
			chaise.Anchored = false
			chaise.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0.5, 0.2)
		end
	end
end

---------------------------------------------------------------------
-- SOL MOUILLÉ + panneaux jaunes « ATTENTION SOL GLISSANT »
---------------------------------------------------------------------
local COULEUR_EAU = Color3.fromRGB(110, 170, 225)

local function flaque(centre: Vector2, tailleX: number, tailleZ: number)
	local zone = Instance.new("Model")
	zone.Name = "SolMouille"
	zone.Parent = carte
	local function morceau(p: BasePart)
		p.Transparency = 0.4
		p.Reflectance = 0.25
		p.CanCollide = false
		p.CanTouch = false
		p.CastShadow = false
		p:SetAttribute("Mouille", true) -- le kart détecte cet attribut
	end
	morceau(bloc("Eau", Vector3.new(tailleX, 0.1, tailleZ), CFrame.new(centre.X, SOL + 0.07, centre.Y), COULEUR_EAU, Enum.Material.Glass, zone))
	for _ = 1, 4 do
		local d = random:NextNumber(4, 8)
		local rond = cylindreDebout("EauRonde", 0.1, d, Vector3.new(centre.X + random:NextNumber(-tailleX / 2, tailleX / 2), SOL + 0.08, centre.Y + random:NextNumber(-tailleZ / 2, tailleZ / 2)), COULEUR_EAU, Enum.Material.Glass, zone)
		morceau(rond)
	end
end

local function panneauJaune(position: Vector2, versOu: Vector3)
	local modele = Instance.new("Model")
	modele.Name = "PanneauSolGlissant"
	local pos = Vector3.new(position.X, 0, position.Y)
	local base = CFrame.lookAt(pos, pos + versOu)
	local jaune = Color3.fromRGB(255, 205, 0)
	local devant = bloc("Devant", Vector3.new(2.4, 3.4, 0.15), base * CFrame.new(0, SOL + 1.7, -0.45) * CFrame.Angles(math.rad(15), 0, 0), jaune, Enum.Material.SmoothPlastic, modele)
	local derriere = bloc("Derriere", Vector3.new(2.4, 3.4, 0.15), base * CFrame.new(0, SOL + 1.7, 0.45) * CFrame.Angles(math.rad(-15), 0, 0), jaune, Enum.Material.SmoothPlastic, modele)
	texte(devant, Enum.NormalId.Front, "⚠\nATTENTION\nSOL GLISSANT", Color3.fromRGB(20, 20, 20))
	texte(derriere, Enum.NormalId.Back, "⚠\nATTENTION\nSOL GLISSANT", Color3.fromRGB(20, 20, 20))
	for _, p in ipairs({ devant, derriere }) do
		p.Anchored = false
		p.CustomPhysicalProperties = PhysicalProperties.new(0.4, 0.4, 0.3)
	end
	local soudure = Instance.new("WeldConstraint")
	soudure.Part0 = devant
	soudure.Part1 = derriere
	soudure.Parent = devant
	modele.PrimaryPart = devant
	modele.Parent = carte
end

local function seau(position: Vector2)
	local s = cylindreDebout("Seau", 1.8, 2, Vector3.new(position.X, SOL + 0.9, position.Y), Color3.fromRGB(255, 200, 0))
	s.Anchored = false
	deco(bloc("Serpilliere", Vector3.new(0.2, 6, 0.2), CFrame.new(position.X + 0.6, SOL + 3.5, position.Y) * CFrame.Angles(0, 0, math.rad(-12)), Color3.fromRGB(80, 140, 230)))
end

