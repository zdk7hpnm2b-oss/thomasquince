-- Messages qui apparaissent au milieu (« SUPER DRIFT ★★ », « 360° ! »…)
local function message(texte: string, couleur: Color3?, duree: number?)
	local m = label("Message", gui, UDim2.new(0, 600, 0, 60), UDim2.new(0.5, -300, 0.28, 0))
	m.Text = texte
	m.TextColor3 = couleur or Color3.new(1, 1, 1)
	m.ZIndex = 10
	local echelle = Instance.new("UIScale")
	echelle.Scale = 0.4
	echelle.Parent = m
	TweenService:Create(echelle, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(duree or 1.4, function()
		local info = TweenInfo.new(0.4)
		TweenService:Create(m, info, { TextTransparency = 1, Position = m.Position - UDim2.fromOffset(0, 30) }):Play()
		local contour = m:FindFirstChildOfClass("UIStroke")
		if contour then
			TweenService:Create(contour, info, { Transparency = 1 }):Play()
		end
		task.wait(0.45)
		m:Destroy()
	end)
end

---------------------------------------------------------------------
-- ÉCLABOUSSURES SUR L'ÉCRAN
---------------------------------------------------------------------
local function goutte()
	local taille = math.random(50, 170)
	local g = Instance.new("Frame")
	g.Size = UDim2.fromOffset(taille, taille)
	g.Position = UDim2.new(math.random(), -taille / 2, math.random() * 0.85, -taille / 2)
	g.BackgroundColor3 = Color3.fromRGB(190, 225, 255)
	g.BackgroundTransparency = 0.55
	g.ZIndex = 2
	local coin = Instance.new("UICorner")
	coin.CornerRadius = UDim.new(0.5, 0)
	coin.Parent = g
	local bord = Instance.new("UIStroke")
	bord.Color = Color3.new(1, 1, 1)
	bord.Thickness = 2
	bord.Transparency = 0.35
	bord.Parent = g
	-- petit reflet de lumière dans la goutte
	local reflet = Instance.new("Frame")
	reflet.Size = UDim2.fromScale(0.25, 0.25)
	reflet.Position = UDim2.fromScale(0.2, 0.18)
	reflet.BackgroundColor3 = Color3.new(1, 1, 1)
	reflet.BackgroundTransparency = 0.3
	reflet.ZIndex = 3
	local coin2 = Instance.new("UICorner")
	coin2.CornerRadius = UDim.new(0.5, 0)
	coin2.Parent = reflet
	reflet.Parent = g
	g.Parent = ecranEau

	-- la goutte coule vers le bas puis disparaît
	local duree = math.random(12, 22) / 10
	local info = TweenInfo.new(duree, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(g, info, { BackgroundTransparency = 1, Position = g.Position + UDim2.fromScale(0, 0.08) }):Play()
	TweenService:Create(bord, info, { Transparency = 1 }):Play()
	TweenService:Create(reflet, info, { BackgroundTransparency = 1 }):Play()
	task.delay(duree + 0.1, function()
		g:Destroy()
	end)
end

local function grosseEclaboussure()
	-- flash bleuté + plein de gouttes
	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.fromRGB(170, 215, 255)
	flash.BackgroundTransparency = 0.6
	flash.ZIndex = 1
	flash.Parent = ecranEau
	TweenService:Create(flash, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
	task.delay(0.4, function()
		flash:Destroy()
	end)
	for _ = 1, math.random(7, 11) do
		goutte()
	end
end

---------------------------------------------------------------------
-- ÉTAT DU JEU
---------------------------------------------------------------------
local kart = nil -- { modele, chassis, stats, trails, fumees, eaux, sons }
local driftAppuye = false
local vitesseRotation = 0
local tempsBoost = 0
local derniereVitesse = 0
local etaitMouille = false
local prochaineGoutte = 0
local nuit = Lighting:GetAttribute("Nuit")
if nuit == nil then
	nuit = Config.NuitParDefaut
end

local scoreTotal, meilleurDrift = 0, 0
local drift = { actif = false, points = 0, temps = 0, rotation = 0, horsDrift = 0, combo = 1, nb360 = 0 }

local parametresRayon = RaycastParams.new()
parametresRayon.FilterType = Enum.RaycastFilterType.Exclude

local function nombreEtoiles(points: number): number
	local n = 0
	for i, seuil in ipairs(Config.Score.Etoiles) do
		if points >= seuil then
			n = i
		end
	end
	return n
end

local function texteEtoiles(n: number): string
	return string.rep("★", n) .. string.rep("☆", #Config.Score.Etoiles - n)
end

local function majScore()
	scoreLabel.Text = ("SCORE  %d"):format(scoreTotal)
	meilleurLabel.Text = ("RECORD  %d"):format(meilleurDrift)
end
majScore()

-- Profil envoyé par le serveur (niveau, XP, record)
local function afficherProfil(profil, niveauGagne: number?)
	if type(profil) ~= "table" then
		return
	end
	niveauLabel.Text = ("NIV. %d"):format(profil.Niveau)
	local pleinNiveau = profil.Niveau >= Config.NiveauMax
	xpLabel.Text = if pleinNiveau then "NIVEAU MAX !" else ("%d / %d XP"):format(profil.XPDansNiveau, profil.XPRequis)
	local ratio = if pleinNiveau then 1 else math.clamp(profil.XPDansNiveau / profil.XPRequis, 0, 1)
	TweenService:Create(barreXP, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(ratio, 1) }):Play()
	meilleurDrift = math.max(meilleurDrift, profil.Record or 0)
	majScore()
	if niveauGagne then
		message(("NIVEAU %d ! 🎉"):format(niveauGagne), Color3.fromRGB(255, 215, 80), 2.5)
		task.delay(0.8, function()
			message("Nouveautés au GARAGE VIP !", Color3.fromRGB(200, 150, 255), 2)
		end)
	end
end
remotes:WaitForChild("ProfilMisAJour").OnClientEvent:Connect(afficherProfil)
task.spawn(function()
	afficherProfil(remotes:WaitForChild("ObtenirProfil"):InvokeServer())
	-- On attend la fin de l'intro cinématique avant d'afficher les conseils
	local debut = os.clock()
	while not joueur:GetAttribute("IntroFinie") and os.clock() - debut < 12 do
		task.wait(0.2)
	end
	message("Appuie sur F (ou le bouton 🏎️) pour conduire !", Color3.fromRGB(255, 215, 80), 3.5)
	task.wait(3.8)
	message("Borne de l'atelier : E = personnaliser ton kart", Color3.new(1, 1, 1), 3.5)
end)

local function vers(valeur: number, cible: number, pas: number): number
	if valeur < cible then
		return math.min(valeur + pas, cible)
	end
	return math.max(valeur - pas, cible)
end

---------------------------------------------------------------------
-- DRIFT : début / fin / score
---------------------------------------------------------------------
local function terminerDrift(reussi: boolean)
	local points = math.floor(drift.points)
	if reussi and points >= Config.Score.Minimum then
		local etoiles = nombreEtoiles(points)
		scoreTotal += points
		if points > meilleurDrift then
			meilleurDrift = points
		end
		remotes.DriftTermine:FireServer(points) -- le serveur transforme les points en XP
		local titres = { [0] = "PETIT DRIFT", "JOLI DRIFT", "SUPER DRIFT", "DRIFT DE LÉGENDE" }
		local couleurs = { [0] = Color3.new(1, 1, 1), Color3.fromRGB(150, 230, 255), Color3.fromRGB(255, 215, 60), Color3.fromRGB(255, 120, 220) }
		local titre = titres[math.min(etoiles, 3)]
		message(("%s %s  +%d"):format(titre, etoiles > 0 and texteEtoiles(etoiles) or "", points), couleurs[math.min(etoiles, 3)], 1.8)
		if etoiles >= 2 then
			tempsBoost = Config.Score.DureeBoost
			message("BOOST !", Color3.fromRGB(120, 255, 140), 0.9)
		end
		majScore()
	elseif not reussi and points > 0 then
		message(("OUPS ! DRIFT PERDU  -%d"):format(points), Color3.fromRGB(255, 90, 90), 1.4)
	end
	drift.actif = false
	drift.points, drift.temps, drift.rotation, drift.horsDrift, drift.combo, drift.nb360 = 0, 0, 0, 0, 1, 0
	blocDrift.Visible = false
end

---------------------------------------------------------------------
-- ENTRER / SORTIR DU KART
---------------------------------------------------------------------
local function effets(nomEffet: string): { Instance }
	local liste = {}
	for _, d in ipairs(kart.chassis:GetDescendants()) do
		if d.Name == nomEffet then
			table.insert(liste, d)
		end
	end
	return liste
end

local function creerSon(id: string, boucle: boolean): Sound?
	if id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = boucle
	s.Volume = 0.5
	s.Parent = kart.chassis
	return s
end

local function actionDrift(_, etat: Enum.UserInputState)
	driftAppuye = etat == Enum.UserInputState.Begin
	return Enum.ContextActionResult.Sink
end

---------------------------------------------------------------------
-- CAMÉRA AUTOMATIQUE : elle se place toute seule derrière le kart
-- et tourne avec lui (plus besoin du clic droit).
-- V = alterner entre la « GoPro » (sur la poitrine du pilote, comme les
-- vidéos TikTok) et la vue « derrière le kart »
---------------------------------------------------------------------
local modeCamera = Config.Camera.VueParDefaut or "gopro" -- "gopro" ou "derriere"
local directionCamera = Vector3.new(0, 0, -1)
local rayonCamera = RaycastParams.new()
rayonCamera.FilterType = Enum.RaycastFilterType.Exclude

-- En vue GoPro, on cache la tête et le buste (la caméra est dessus) mais on
-- garde les bras et les jambes visibles, comme dans les vraies vidéos.
local PARTIES_CACHEES = { Head = true, UpperTorso = true, Torso = true, HumanoidRootPart = true }
local function cacherPilote(cacher: boolean)
	local perso = joueur.Character
	if not perso then
		return
	end
	for _, p in ipairs(perso:GetDescendants()) do
		if p:IsA("BasePart") then
			local aCacher = PARTIES_CACHEES[p.Name] or p:FindFirstAncestorOfClass("Accessory") ~= nil
			p.LocalTransparencyModifier = (cacher and aCacher) and 1 or 0
		elseif p:IsA("Decal") then
			p.LocalTransparencyModifier = cacher and 1 or 0
		end
	end
end

local function mettreAJourCamera(dt: number)
	if not kart or not kart.chassis.Parent then
		return
	end
	local ch = kart.chassis
	local reglages = Config.Camera
	local avant = Vector3.new(ch.CFrame.LookVector.X, 0, ch.CFrame.LookVector.Z)
	if avant.Magnitude < 0.1 then
		return
	end
	avant = avant.Unit

	if modeCamera == "gopro" then
		cacherPilote(true)
		-- GoPro fixée sur la poitrine : on voit le volant, les mains, les jambes et le sol
		local vitesseG = Vector3.new(ch.AssemblyLinearVelocity.X, 0, ch.AssemblyLinearVelocity.Z)
		local glisse = vitesseG:Dot(Vector3.new(-avant.Z, 0, avant.X)) -- vitesse sur le côté
		local inclinaison = math.clamp(-glisse * 0.006, -0.12, 0.12) -- la caméra penche dans les drifts
		local tremble = math.clamp(vitesseG.Magnitude, 0, 80) * 0.0009
		local secousse = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * tremble
		local plat = CFrame.lookAt(ch.Position, ch.Position + avant)
		local oeil = plat * CFrame.new(0, 2.9, 0.15) + secousse
		camera.CFrame = CFrame.lookAt(oeil.Position, (plat * CFrame.new(0, 0.2, -7)).Position) * CFrame.Angles(0, 0, inclinaison)
		return
	end

	-- Direction suivie : surtout l'avant du kart, un peu le sens de la glisse (on voit le drift)
	local vel = Vector3.new(ch.AssemblyLinearVelocity.X, 0, ch.AssemblyLinearVelocity.Z)
	local cible = avant
	if vel.Magnitude > 8 then
		local sens = if vel:Dot(avant) < 0 then avant else vel.Unit
		cible = (avant * (1 - reglages.SuiviGlisse) + sens * reglages.SuiviGlisse)
		if cible.Magnitude < 0.1 then
			cible = avant
		end
		cible = cible.Unit
	end
	local lissage = 1 - math.exp(-reglages.Souplesse * dt)
	local nouvelle = directionCamera:Lerp(cible, lissage)
	if nouvelle.Magnitude > 0.1 then
		directionCamera = nouvelle.Unit
	end

	local vitesse = vel.Magnitude
	local distance = reglages.Distance + math.clamp(vitesse, 0, 70) * 0.04
	local pivot = ch.Position + Vector3.new(0, 2.5, 0)
	local voulu = ch.Position - directionCamera * distance + Vector3.new(0, reglages.Hauteur, 0)
	-- Si un mur est entre le kart et la caméra, on rapproche la caméra
	rayonCamera.FilterDescendantsInstances = { kart.modele, joueur.Character }
	local obstacle = workspace:Raycast(pivot, voulu - pivot, rayonCamera)
	if obstacle and obstacle.Instance.CanCollide then
		voulu = obstacle.Position + (pivot - voulu).Unit * 1
	end
	camera.CFrame = CFrame.lookAt(voulu, ch.Position + directionCamera * 6 + Vector3.new(0, 2, 0))
end

local function demarrerCamera()
	if kart then
		local lv = kart.chassis.CFrame.LookVector
		directionCamera = Vector3.new(lv.X, 0, lv.Z).Unit
	end
	camera.CameraType = Enum.CameraType.Scriptable
	RunService:UnbindFromRenderStep("MallDriftCamera")
	RunService:BindToRenderStep("MallDriftCamera", Enum.RenderPriority.Camera.Value + 1, mettreAJourCamera)
end

local function arreterCamera()
	RunService:UnbindFromRenderStep("MallDriftCamera")
	cacherPilote(false)
	camera.CameraType = Enum.CameraType.Custom
end

local function actionCamera(_, etat: Enum.UserInputState)
	if etat == Enum.UserInputState.Begin then
		modeCamera = if modeCamera == "derriere" then "gopro" else "derriere"
		if modeCamera == "derriere" then
			cacherPilote(false)
		end
		message(if modeCamera == "gopro" then "*CAMÉRA GOPRO* 🎥" else "*VUE ARRIÈRE* 🎥", Color3.new(1, 1, 1), 0.8)
	end
	return Enum.ContextActionResult.Sink
end

local function actionNuit(_, etat: Enum.UserInputState)
	if etat == Enum.UserInputState.Begin then
		nuit = not nuit
		Config.AppliquerAmbiance(nuit)
		message(nuit and "MODE NUIT 🌙" or "MODE JOUR ☀️", Color3.new(1, 1, 1), 1)
	end
	return Enum.ContextActionResult.Sink
end

local function actionRedresser(_, etat: Enum.UserInputState)
	if etat == Enum.UserInputState.Begin and kart then
		local ch = kart.chassis
		local regard = Vector3.new(ch.CFrame.LookVector.X, 0, ch.CFrame.LookVector.Z)
		if regard.Magnitude < 0.1 then
			regard = Vector3.new(0, 0, -1)
		end
		local pos = ch.Position + Vector3.new(0, 3, 0)
		ch.AssemblyLinearVelocity = Vector3.zero
		ch.AssemblyAngularVelocity = Vector3.zero
		ch.CFrame = CFrame.lookAt(pos, pos + regard.Unit)
	end
	return Enum.ContextActionResult.Sink
end

---------------------------------------------------------------------
-- BOUTON « CONDUIRE » : toujours visible quand on est à pied.
-- Le kart apparaît sous toi et tu es assis dedans automatiquement.
---------------------------------------------------------------------
local boutonConduire = Instance.new("TextButton")
boutonConduire.Name = "Conduire"
boutonConduire.AnchorPoint = Vector2.new(0.5, 1)
boutonConduire.Size = UDim2.new(0, 260, 0, 64)
boutonConduire.Position = UDim2.new(0.5, 0, 1, -40)
boutonConduire.BackgroundColor3 = Color3.fromRGB(255, 190, 40)
boutonConduire.TextColor3 = Color3.fromRGB(25, 25, 30)
boutonConduire.Font = Enum.Font.GothamBlack
boutonConduire.TextScaled = true
boutonConduire.Text = "🏎️ CONDUIRE  (F)"
boutonConduire.ZIndex = 8
boutonConduire.Parent = gui
Instance.new("UICorner", boutonConduire).CornerRadius = UDim.new(0, 14)
local contourBouton = Instance.new("UIStroke")
contourBouton.Thickness = 3
contourBouton.Color = Color3.new(1, 1, 1)
contourBouton.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
contourBouton.Parent = boutonConduire
local margeBouton = Instance.new("UIPadding")
margeBouton.PaddingTop = UDim.new(0, 10)
margeBouton.PaddingBottom = UDim.new(0, 10)
margeBouton.Parent = boutonConduire

local function demanderKart()
	if kart then
		return
	end
	boutonConduire.Text = "⏳ ..."
	remotes.SortirKart:FireServer()
	task.delay(1.5, function()
		boutonConduire.Text = "🏎️ CONDUIRE  (F)"
	end)
end
boutonConduire.Activated:Connect(demanderKart)

local function activerToucheConduire(actif: boolean)
	boutonConduire.Visible = actif
	if actif then
		ContextActionService:BindAction("MallDrift_Conduire", function(_, etat)
			if etat == Enum.UserInputState.Begin then
				demanderKart()
			end
			return Enum.ContextActionResult.Pass
		end, false, Enum.KeyCode.F, Enum.KeyCode.ButtonY)
	else
		ContextActionService:UnbindAction("MallDrift_Conduire")
	end
end
activerToucheConduire(true)

local function sortirDuKart()
	if not kart then
		return
	end
	if drift.actif then
		terminerDrift(true)
	end
	for _, nom in ipairs({ "TracePneu", "Fumee", "Eclaboussures" }) do
		for _, e in ipairs(effets(nom)) do
			(e :: any).Enabled = false
		end
	end
	for _, s in pairs(kart.sons) do
		s:Destroy()
	end
	ContextActionService:UnbindAction("MallDrift_Drift")
	ContextActionService:UnbindAction("MallDrift_Camera")
	ContextActionService:UnbindAction("MallDrift_Nuit")
	ContextActionService:UnbindAction("MallDrift_Redresser")
	arreterCamera()
	camera.FieldOfView = 70
	driftAppuye = false
	hud.Visible = false
	kart = nil
	activerToucheConduire(true)
end

local function entrerDansKart(siege: Seat)
	local modele = siege.Parent
	local typeKart = modele and modele:GetAttribute("KartType")
	if not typeKart then
		return
	end
	local chassis = modele:WaitForChild("Chassis", 3)
	if not chassis then
		return
	end
	kart = {
		modele = modele,
		chassis = chassis,
		stats = Config.Karts[typeKart],
		sons = {},
	}
	kart.trails = effets("TracePneu")
	kart.fumees = effets("Fumee")
	kart.eaux = effets("Eclaboussures")
	kart.sons.moteur = creerSon(Config.Sons.Moteur, true)
	kart.sons.drift = creerSon(Config.Sons.Drift, true)
	kart.sons.eau = creerSon(Config.Sons.Eclaboussure, false)
	if kart.sons.moteur then
		kart.sons.moteur:Play()
	end

	parametresRayon.FilterDescendantsInstances = { modele, joueur.Character }
	vitesseRotation = 0
	derniereVitesse = 0
	tempsBoost = 0

	ContextActionService:BindActionAtPriority("MallDrift_Drift", actionDrift, true, Enum.ContextActionPriority.High.Value, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonL2)
	ContextActionService:SetTitle("MallDrift_Drift", "DRIFT")
	ContextActionService:SetPosition("MallDrift_Drift", UDim2.new(1, -170, 1, -150))
	ContextActionService:BindAction("MallDrift_Camera", actionCamera, true, Enum.KeyCode.V, Enum.KeyCode.ButtonY)
	ContextActionService:SetTitle("MallDrift_Camera", "CAM")
	ContextActionService:SetPosition("MallDrift_Camera", UDim2.new(1, -230, 1, -230))
	ContextActionService:BindAction("MallDrift_Nuit", actionNuit, false, Enum.KeyCode.N)
	ContextActionService:BindAction("MallDrift_Redresser", actionRedresser, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
	ContextActionService:SetTitle("MallDrift_Redresser", "R")
	ContextActionService:SetPosition("MallDrift_Redresser", UDim2.new(1, -290, 1, -150))

	hud.Visible = true
	activerToucheConduire(false)
	demarrerCamera()
	message(("%s · c'est parti !"):format(kart.stats.Nom), Color3.new(1, 1, 1), 1.5)
end

local function brancherPersonnage(perso: Model)
	local humanoide = perso:WaitForChild("Humanoid") :: Humanoid
	humanoide.Seated:Connect(function(assis: boolean, siege: BasePart?)
		if assis and siege and siege:IsA("Seat") then
			entrerDansKart(siege)
		else
			sortirDuKart()
		end
	end)
	humanoide.Died:Connect(sortirDuKart)
end

if joueur.Character then
	brancherPersonnage(joueur.Character)
end
joueur.CharacterAdded:Connect(brancherPersonnage)

---------------------------------------------------------------------
-- LA CONDUITE (exécutée à chaque image)
---------------------------------------------------------------------
local function surfaceSous(chassis: BasePart): string?
	local resultat = workspace:Raycast(chassis.Position, Vector3.new(0, -3, 0), parametresRayon)
	if not resultat then
		return nil -- en l'air
	end
	if resultat.Instance:GetAttribute("Mouille") then
		return "mouille"
	end
	return "normal"
end

RunService.Heartbeat:Connect(function(dt: number)
	if not kart then
		return
	end
	local ch = kart.chassis
	if not ch.Parent then
		sortirDuKart()
		return
	end
	local s = kart.stats
	local cf = ch.CFrame

	-- Direction du kart (à plat)
	local avant = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
	if avant.Magnitude < 0.1 then
		return
	end
	avant = avant.Unit
	local droite = Vector3.new(-avant.Z, 0, avant.X)

	-- Vitesse actuelle découpée en "vers l'avant" et "sur le côté"
	local vel = ch.AssemblyLinearVelocity
	local vAvant = vel:Dot(avant)
	local vCote = vel:Dot(droite)
	local vitesse = Vector3.new(vel.X, 0, vel.Z).Magnitude
	local rotationReelle = ch.AssemblyAngularVelocity.Y

	-- Commandes du joueur (clavier, manette ou joystick mobile)
	local mv = controles:GetMoveVector()
	local gaz = math.clamp(-mv.Z, -1, 1)
	local volant = math.clamp(mv.X, -1, 1)

	local surface = surfaceSous(ch)
	local auSol = surface ~= nil
	local mouille = surface == "mouille"

	tempsBoost = math.max(tempsBoost - dt, 0)

	-- 1) Accélérer / freiner
	local vMax = s.VitesseMax + (tempsBoost > 0 and s.Boost or 0)
	local cible = if gaz >= 0 then gaz * vMax else gaz * s.VitesseMax * 0.5
	local taux
	if math.abs(gaz) < 0.05 then
		taux = s.Freinage * 0.25 -- roue libre
	elseif math.sign(gaz) ~= math.sign(vAvant) and math.abs(vAvant) > 1 then
		taux = s.Freinage
	else
		taux = s.Acceleration * (tempsBoost > 0 and 2 or 1)
	end
	if mouille then
		taux *= Config.Mouille.Acceleration
	end
	if auSol then
		vAvant = vers(vAvant, cible, taux * dt)
	end

	-- 2) Adhérence : on "efface" plus ou moins vite la glisse sur le côté
	local adherence = if driftAppuye then s.AdherenceDrift else s.Adherence
	if mouille then
		adherence *= Config.Mouille.Adherence
	end
	if auSol then
		vCote *= math.exp(-adherence * dt)
	end

	-- 3) Tourner (en drift, on tourne beaucoup plus : 360 possibles !)
	local facteur = math.clamp(math.abs(vAvant) / 12, 0, 1)
	if driftAppuye then
		facteur = math.max(facteur, 0.7) -- on peut tourner sur place en drift
	end
	local puissance = s.Rotation * (if driftAppuye then s.RotationDrift else 1)
	local sens = if vAvant < -1 then -1 else 1
	local rotationCible = -volant * puissance * facteur * sens
	vitesseRotation += (rotationCible - vitesseRotation) * math.clamp(dt * 8, 0, 1)

	ch.AssemblyLinearVelocity = avant * vAvant + droite * vCote + Vector3.new(0, vel.Y, 0)
	ch.AssemblyAngularVelocity = Vector3.new(0, vitesseRotation, 0)

	-----------------------------------------------------------------
	-- SCORE DE DRIFT
	-----------------------------------------------------------------
	local angleGlisse = math.deg(math.atan2(math.abs(vCote), math.max(math.abs(vAvant), 0.01)))
	local enDrift = auSol and vitesse > Config.Score.VitesseMin and angleGlisse > Config.Score.AngleMin

	-- Choc contre un mur pendant un drift = drift perdu
	if drift.actif and derniereVitesse - vitesse > Config.Score.SeuilChoc then
		terminerDrift(false)
		enDrift = false
	end
	derniereVitesse = vitesse

	if enDrift then
		if not drift.actif then
			drift.actif = true
			blocDrift.Visible = true
		end
		drift.horsDrift = 0
		drift.temps += dt
		drift.combo = math.min(1 + drift.temps * Config.Score.ComboParSeconde, Config.Score.ComboMax)
		-- plus l'angle est beau (jusqu'à ~60°), plus ça rapporte
		local beaute = math.clamp(angleGlisse / 45, 0.3, 1.5)
		local gain = vitesse * beaute * drift.combo * Config.Score.PointsParStud * dt
		if mouille then
			gain *= Config.Mouille.BonusPoints
		end
		drift.points += gain
	elseif drift.actif then
		drift.horsDrift += dt
		if drift.horsDrift > Config.Score.Tolerance then
			terminerDrift(true)
		end
	end

	if drift.actif then
		-- Compter les tours complets (360°)
		drift.rotation += rotationReelle * dt
		if math.abs(drift.rotation) >= 2 * math.pi then
			drift.rotation -= math.sign(drift.rotation) * 2 * math.pi
			drift.nb360 += 1
			local bonus = math.floor(Config.Score.Bonus360 * drift.combo)
			drift.points += bonus
			message(("360° !  +%d"):format(bonus), Color3.fromRGB(255, 150, 60), 1)
		end
		local pts = math.floor(drift.points)
		pointsLabel.Text = ("+%d"):format(pts)
		comboLabel.Text = ("x%.1f%s"):format(drift.combo, mouille and "  💧 BONUS EAU" or "")
		etoilesLabel.Text = texteEtoiles(nombreEtoiles(pts))
	end

	-----------------------------------------------------------------
	-- EFFETS : traces, fumée, eau, éclaboussures sur l'écran, caméra
	-----------------------------------------------------------------
	local traces = drift.actif and auSol and not mouille
	for _, t in ipairs(kart.trails) do
		t.Enabled = traces
	end
	for _, f in ipairs(kart.fumees) do
		f.Enabled = traces and vitesse > 15
	end
	local gerbes = mouille and vitesse > 8
	for _, e in ipairs(kart.eaux) do
		e.Enabled = gerbes
	end

	local maintenant = os.clock()
	if mouille and vitesse > 10 then
		if not etaitMouille then
			grosseEclaboussure()
			if kart.sons.eau then
				kart.sons.eau:Play()
			end
		elseif maintenant > prochaineGoutte then
			goutte()
			prochaineGoutte = maintenant + 0.25
		end
	end
	etaitMouille = mouille

	if kart.sons.moteur then
		kart.sons.moteur.PlaybackSpeed = 0.8 + vitesse / s.VitesseMax * 0.8
	end
	if kart.sons.drift then
		if drift.actif and not kart.sons.drift.IsPlaying then
			kart.sons.drift:Play()
		elseif not drift.actif and kart.sons.drift.IsPlaying then
			kart.sons.drift:Stop()
		end
	end

	-- Sensation de vitesse : le champ de vision s'élargit quand on va vite
	local fovBase = if modeCamera == "gopro" then Config.Camera.ChampGoPro else 70
	local fovCible = fovBase + math.clamp(vitesse, 0, 80) * (if modeCamera == "gopro" then 0.12 else 0.3) + (tempsBoost > 0 and 6 or 0)
	camera.FieldOfView += (fovCible - camera.FieldOfView) * math.clamp(dt * 5, 0, 1)

	vitesseLabel.Text = ("%d km/h"):format(math.floor(vitesse + 0.5))
end)

---------------------------------------------------------------------
-- NÉONS ARC-EN-CIEL : ils changent de couleur en continu
---------------------------------------------------------------------
local kartsArcEnCiel: { { parties: { BasePart }, lumieres: { PointLight } } } = {}
local prochainScan = 0

local function scannerArcEnCiel()
	kartsArcEnCiel = {}
	local candidats = {}
	local dossier = workspace:FindFirstChild("KartsJoueurs")
	if dossier then
		for _, m in ipairs(dossier:GetChildren()) do
			table.insert(candidats, m)
		end
	end
	local apercuGarage = workspace:FindFirstChild("ApercuGarage")
	if apercuGarage then
		table.insert(candidats, apercuGarage)
	end
	for _, m in ipairs(candidats) do
		if m:GetAttribute("NeonArcEnCiel") then
			local entree = { parties = {}, lumieres = {} }
			for _, d in ipairs(m:GetDescendants()) do
				if d:IsA("BasePart") and d:GetAttribute("Peinture") == "Neon" then
					table.insert(entree.parties, d)
				elseif d:IsA("PointLight") and d.Name == "LumiereNeon" then
					table.insert(entree.lumieres, d)
				end
			end
			table.insert(kartsArcEnCiel, entree)
		end
	end
end

RunService.Heartbeat:Connect(function()
	local maintenant = os.clock()
	if maintenant > prochainScan then
		prochainScan = maintenant + 1
		scannerArcEnCiel()
	end
	if #kartsArcEnCiel == 0 then
		return
	end
	local couleur = Color3.fromHSV((maintenant * 0.25) % 1, 0.9, 1)
	for _, k in ipairs(kartsArcEnCiel) do
		for _, p in ipairs(k.parties) do
			p.Color = couleur
		end
		for _, l in ipairs(k.lumieres) do
			l.Color = couleur
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX8"><Properties><string name="Name">GarageUI</string><ProtectedString name="Source"><![CDATA[--[[
	GarageUI  (LocalScript)
	À placer dans : StarterPlayer > StarterPlayerScripts   — nom conseillé : GarageUI

	Le menu du GARAGE VIP :
	  • ton kart tourne sur le plateau (on le voit sous tous les angles)
	  • choisir le modèle de kart, la couleur de carrosserie, la finition
	    (brillant, mat, métallisé, nacré, chrome), les jantes, le siège,
	    les bandes de course, l'autocollant et le numéro
	  • ce qui n'est pas encore débloqué affiche un cadenas 🔒 + le niveau requis
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
local KartBuilder = require(ReplicatedStorage:WaitForChild("KartBuilder"))
local remotes = ReplicatedStorage:WaitForChild("MallDriftRemotes")

local joueur = Players.LocalPlayer
local camera = workspace.CurrentCamera
local controles = require(joueur:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()

local profil = nil -- infos envoyées par le serveur (niveau, XP, kart enregistré)
local persoEdite = table.clone(Config.PersoParDefaut) -- ce que le joueur est en train de modifier
local menuOuvert = false

local function niveau(): number
	return profil and profil.Niveau or 1
end

---------------------------------------------------------------------
-- LE KART SUR LE PLATEAU TOURNANT (visible seulement par toi)
---------------------------------------------------------------------
local apercu: Model? = nil
local typeApercu: string? = nil
local angleApercu = 0

local function trouverPlateau(): BasePart?
	local carte = workspace:FindFirstChild("GoldenMall")
	local garage = carte and carte:FindFirstChild("GarageVIP")
	return garage and garage:FindFirstChild("PlateauTournant") :: BasePart?
end

local function majApercu(perso)
	local plateau = trouverPlateau()
	if not plateau then
		return
	end
	if apercu and typeApercu ~= perso.Kart then
		apercu:Destroy()
		apercu = nil
	end
	if not apercu then
		apercu = KartBuilder.Construire(perso, CFrame.new(plateau.Position + Vector3.new(0, 1.1, 0)), true)
		apercu.Name = "ApercuGarage"
		apercu.Parent = workspace
		typeApercu = perso.Kart
	else
		KartBuilder.Peindre(apercu, perso)
	end
end

RunService.RenderStepped:Connect(function(dt: number)
	local plateau = trouverPlateau()
	if not plateau then
		return
	end
	if not apercu and profil then
		majApercu(if menuOuvert then persoEdite else profil.Perso)
	end
	if apercu then
		angleApercu += dt * (if menuOuvert then 0.5 else 0.3)
		apercu:PivotTo(CFrame.new(plateau.Position + Vector3.new(0, 1.1, 0)) * CFrame.Angles(0, angleApercu, 0))
	end
	if menuOuvert then
		-- Caméra de showroom : le kart apparaît à droite du menu
		local cible = plateau.Position + Vector3.new(0, 1.5, -4)
		camera.CFrame = CFrame.lookAt(plateau.Position + Vector3.new(-17, 7, 4), cible)
	end
end)

---------------------------------------------------------------------
-- INTERFACE
---------------------------------------------------------------------
local OR = Color3.fromRGB(255, 205, 80)
local FOND = Color3.fromRGB(14, 14, 20)

local gui = Instance.new("ScreenGui")
gui.Name = "GarageVIP"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 10
gui.Enabled = false
gui.Parent = joueur:WaitForChild("PlayerGui")

local function coins(objet: GuiObject, rayon: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, rayon or 8)
	c.Parent = objet
end

local function contour(objet: GuiObject, couleur: Color3, epaisseur: number): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = couleur
	s.Thickness = epaisseur
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = objet
	return s
end

local function bouton(parent: Instance, texte: string, couleur: Color3, taille: UDim2, position: UDim2?): TextButton
	local b = Instance.new("TextButton")
	b.Size = taille
	if position then
		b.Position = position
	end
	b.BackgroundColor3 = couleur
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.GothamBlack
	b.TextScaled = true
	b.Text = texte
	b.AutoButtonColor = true
	coins(b)
	local marge = Instance.new("UIPadding")
	marge.PaddingTop = UDim.new(0, 6)
	marge.PaddingBottom = UDim.new(0, 6)
	marge.PaddingLeft = UDim.new(0, 6)
	marge.PaddingRight = UDim.new(0, 6)
	marge.Parent = b
	b.Parent = parent
	return b
end

local panneau = Instance.new("Frame")
panneau.Name = "Panneau"
panneau.Size = UDim2.new(0, 400, 1, -40)
panneau.Position = UDim2.new(0, 20, 0, 20)
panneau.BackgroundColor3 = FOND
panneau.BackgroundTransparency = 0.08
panneau.Parent = gui
coins(panneau, 14)
contour(panneau, OR, 2)
local tailleMax = Instance.new("UISizeConstraint")
tailleMax.MaxSize = Vector2.new(400, 900)
tailleMax.Parent = panneau

local titre = Instance.new("TextLabel")
titre.Size = UDim2.new(1, -70, 0, 40)
titre.Position = UDim2.new(0, 16, 0, 12)
titre.BackgroundTransparency = 1
titre.Font = Enum.Font.GothamBlack
titre.TextScaled = true
titre.TextXAlignment = Enum.TextXAlignment.Left
titre.TextColor3 = OR
titre.Text = "★ GARAGE VIP"
titre.Parent = panneau

local sousTitre = Instance.new("TextLabel")
sousTitre.Size = UDim2.new(1, -32, 0, 18)
sousTitre.Position = UDim2.new(0, 16, 0, 54)
sousTitre.BackgroundTransparency = 1
sousTitre.Font = Enum.Font.Gotham
sousTitre.TextScaled = true
sousTitre.TextXAlignment = Enum.TextXAlignment.Left
sousTitre.TextColor3 = Color3.fromRGB(200, 200, 210)
sousTitre.Parent = panneau

local boutonFermer = bouton(panneau, "✕", Color3.fromRGB(60, 60, 70), UDim2.new(0, 40, 0, 40), UDim2.new(1, -52, 0, 12))

local liste = Instance.new("ScrollingFrame")
liste.Size = UDim2.new(1, -24, 1, -200)
liste.Position = UDim2.new(0, 12, 0, 84)
liste.BackgroundTransparency = 1
liste.BorderSizePixel = 0
liste.ScrollBarThickness = 6
liste.ScrollBarImageColor3 = OR
liste.CanvasSize = UDim2.new()
liste.AutomaticCanvasSize = Enum.AutomaticSize.Y
liste.Parent = panneau
local disposition = Instance.new("UIListLayout")
disposition.Padding = UDim.new(0, 8)
disposition.SortOrder = Enum.SortOrder.LayoutOrder
disposition.Parent = liste

local statut = Instance.new("TextLabel")
statut.Size = UDim2.new(1, -24, 0, 20)
statut.Position = UDim2.new(0, 12, 1, -108)
statut.BackgroundTransparency = 1
statut.Font = Enum.Font.GothamBold
statut.TextScaled = true
statut.TextColor3 = Color3.fromRGB(255, 160, 160)
statut.Text = ""
statut.Parent = panneau

local boutonEnregistrer = bouton(panneau, "ENREGISTRER", Color3.fromRGB(40, 150, 80), UDim2.new(0.5, -18, 0, 50), UDim2.new(0, 12, 1, -80))
local boutonSortir = bouton(panneau, "SORTIR MON KART 🏁", Color3.fromRGB(200, 140, 20), UDim2.new(0.5, -18, 0, 50), UDim2.new(0.5, 6, 1, -80))

local function afficherStatut(texte: string, couleur: Color3?)
	statut.Text = texte
	statut.TextColor3 = couleur or Color3.fromRGB(255, 160, 160)
	statut.TextTransparency = 0
	task.delay(2.5, function()
		if statut.Text == texte then
			TweenService:Create(statut, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
		end
	end)
end

---------------------------------------------------------------------
-- Contenu du menu (les boutons se mettent à jour à chaque changement)
---------------------------------------------------------------------
local miseAJour: { () -> () } = {}
local ordre = 0

local function suivant(): number
	ordre += 1
	return ordre
end

local function rafraichir()
	for _, f in ipairs(miseAJour) do
		f()
	end
	sousTitre.Text = ("Niveau %d · drifte pour débloquer plus de styles !"):format(niveau())
	if menuOuvert then
		majApercu(persoEdite)
	end
end

local function verrouille(niveauRequis: number): boolean
	if niveauRequis > niveau() then
		afficherStatut(("🔒 Débloqué au niveau %d (continue à drifter !)"):format(niveauRequis))
		return true
	end
	return false
end

local function section(nom: string): TextLabel
	local l = Instance.new("TextLabel")
	l.LayoutOrder = suivant()
	l.Size = UDim2.new(1, -10, 0, 24)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBlack
	l.TextScaled = true
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextColor3 = OR
	l.Text = nom
	l.Parent = liste
	return l
end

local function grille(taille: Vector2): Frame
	local f = Instance.new("Frame")
	f.LayoutOrder = suivant()
	f.Size = UDim2.new(1, -10, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.BackgroundTransparency = 1
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(taille.X, taille.Y)
	g.CellPadding = UDim2.fromOffset(6, 6)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = f
	f.Parent = liste
	return f
end

-- 1) LE MODÈLE DE KART
section("🏎️  MODÈLE")
local kartsTries = {}
for id, k in pairs(Config.Karts) do
	table.insert(kartsTries, { id = id, k = k })
end
table.sort(kartsTries, function(a, b)
	return a.k.Ordre < b.k.Ordre
end)
for _, e in ipairs(kartsTries) do
	local b = Instance.new("TextButton")
	b.LayoutOrder = suivant()
	b.Size = UDim2.new(1, -10, 0, 58)
	b.BackgroundColor3 = Color3.fromRGB(32, 32, 42)
	b.Text = ""
	b.AutoButtonColor = true
	coins(b)
	local trait = contour(b, OR, 0)
	local nom = Instance.new("TextLabel")
	nom.Size = UDim2.new(1, -20, 0, 24)
	nom.Position = UDim2.new(0, 10, 0, 6)
	nom.BackgroundTransparency = 1
	nom.Font = Enum.Font.GothamBlack
	nom.TextScaled = true
	nom.TextXAlignment = Enum.TextXAlignment.Left
	nom.TextColor3 = Color3.new(1, 1, 1)
	nom.Parent = b
	local desc = Instance.new("TextLabel")
	desc.Size = UDim2.new(1, -20, 0, 18)
	desc.Position = UDim2.new(0, 10, 0, 33)
	desc.BackgroundTransparency = 1
	desc.Font = Enum.Font.Gotham
	desc.TextScaled = true
	desc.TextXAlignment = Enum.TextXAlignment.Left
	desc.TextColor3 = Color3.fromRGB(190, 190, 200)
	desc.Parent = b
	b.Parent = liste

	table.insert(miseAJour, function()
		local bloque = e.k.Niveau > niveau()
		nom.Text = (bloque and "🔒 " or "") .. e.k.Nom .. ("   ·   %d km/h"):format(e.k.VitesseMax)
		desc.Text = if bloque then ("Débloqué au niveau %d"):format(e.k.Niveau) else e.k.Description
		b.BackgroundTransparency = bloque and 0.5 or 0
		trait.Thickness = persoEdite.Kart == e.id and 3 or 0
	end)
	b.Activated:Connect(function()
		if not verrouille(e.k.Niveau) then
			persoEdite.Kart = e.id
			rafraichir()
		end
	end)
end

-- 2) LES COULEURS (carrosserie, jantes, siège, bandes)
local function choixCouleur(titreSection: string, champ: string, liste: { any }?)
	local entete = section(titreSection)
	local g = grille(Vector2.new(40, 40))
	for i, c in ipairs(liste or Config.Couleurs) do
		local b = Instance.new("TextButton")
		b.LayoutOrder = i
		b.BackgroundColor3 = c.Couleur
		b.Font = Enum.Font.GothamBold
		b.TextScaled = true
		b.TextColor3 = Color3.new(1, 1, 1)
		b.Text = ""
		coins(b, 20)
		local trait = contour(b, Color3.new(1, 1, 1), 0)
		if c.Nom == "Aucun" then
			b.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
		elseif c.Nom == "Arc-en-ciel" then
			local degrade = Instance.new("UIGradient")
			degrade.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(60, 255, 100)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(60, 120, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 220)),
			})
			degrade.Parent = b
		end
		b.Parent = g
		table.insert(miseAJour, function()
			local bloque = c.Niveau > niveau()
			b.Text = if bloque then "🔒" elseif c.Nom == "Aucun" then "∅" else ""
			b.BackgroundTransparency = bloque and 0.55 or 0
			trait.Thickness = persoEdite[champ] == c.Nom and 3 or 0
		end)
		b.Activated:Connect(function()
			if not verrouille(c.Niveau) then
				persoEdite[champ] = c.Nom
				rafraichir()
			end
		end)
	end
	table.insert(miseAJour, function()
		entete.Text = ("%s  ·  %s"):format(titreSection, persoEdite[champ])
	end)
end

choixCouleur("🎨  CARROSSERIE", "Carrosserie")

-- 3) LA FINITION
local enteteFinition = section("✨  FINITION")
local grilleFinition = grille(Vector2.new(112, 34))
for i, f in ipairs(Config.Finitions) do
	local b = bouton(grilleFinition, f.Nom, Color3.fromRGB(45, 45, 58), UDim2.new())
	b.LayoutOrder = i
	local trait = contour(b, OR, 0)
	table.insert(miseAJour, function()
		local bloque = f.Niveau > niveau()
		b.Text = (bloque and "🔒 " or "") .. f.Nom
		b.BackgroundTransparency = bloque and 0.5 or 0
		trait.Thickness = persoEdite.Finition == f.Nom and 3 or 0
	end)
	b.Activated:Connect(function()
		if not verrouille(f.Niveau) then
			persoEdite.Finition = f.Nom
			rafraichir()
		end
	end)
end
table.insert(miseAJour, function()
	enteteFinition.Text = "✨  FINITION  ·  " .. persoEdite.Finition
end)

choixCouleur("💡  NÉONS SOUS LE KART", "Neon", Config.Neons)
choixCouleur("🛞  JANTES", "Jantes")
choixCouleur("💺  SIÈGE", "Siege")

-- 4) LES BANDES DE COURSE
section("🏁  BANDES DE COURSE")
local boutonBandes = bouton(liste, "", Color3.fromRGB(45, 45, 58), UDim2.new(1, -10, 0, 36))
boutonBandes.LayoutOrder = suivant()
table.insert(miseAJour, function()
	boutonBandes.Text = persoEdite.BandesActives and "Bandes : OUI ✔" or "Bandes : NON ✕"
end)
boutonBandes.Activated:Connect(function()
	persoEdite.BandesActives = not persoEdite.BandesActives
	rafraichir()
end)
choixCouleur("     Couleur des bandes", "Bandes")

-- 5) L'AUTOCOLLANT
local enteteAutocollant = section("⭐  AUTOCOLLANT")
local grilleAutocollant = grille(Vector2.new(46, 46))
for i, a in ipairs(Config.Autocollants) do
	local b = bouton(grilleAutocollant, a.Texte ~= "" and a.Texte or "∅", Color3.fromRGB(45, 45, 58), UDim2.new())
	b.LayoutOrder = i
	local trait = contour(b, OR, 0)
	table.insert(miseAJour, function()
		local bloque = a.Niveau > niveau()
		b.Text = bloque and "🔒" or (a.Texte ~= "" and a.Texte or "∅")
		b.BackgroundTransparency = bloque and 0.5 or 0
		trait.Thickness = persoEdite.Autocollant == a.Nom and 3 or 0
	end)
	b.Activated:Connect(function()
		if not verrouille(a.Niveau) then
			persoEdite.Autocollant = a.Nom
			rafraichir()
		end
	end)
end
table.insert(miseAJour, function()
	enteteAutocollant.Text = "⭐  AUTOCOLLANT  ·  " .. persoEdite.Autocollant
end)

-- 6) LE NUMÉRO
section("#️⃣  NUMÉRO")
local ligneNumero = Instance.new("Frame")
ligneNumero.LayoutOrder = suivant()
ligneNumero.Size = UDim2.new(1, -10, 0, 40)
ligneNumero.BackgroundTransparency = 1
ligneNumero.Parent = liste
local moins = bouton(ligneNumero, "−", Color3.fromRGB(45, 45, 58), UDim2.new(0, 50, 1, 0), UDim2.new(0, 0, 0, 0))
local plus = bouton(ligneNumero, "+", Color3.fromRGB(45, 45, 58), UDim2.new(0, 50, 1, 0), UDim2.new(0, 160, 0, 0))
local valeurNumero = Instance.new("TextLabel")
valeurNumero.Size = UDim2.new(0, 90, 1, 0)
valeurNumero.Position = UDim2.new(0, 60, 0, 0)
valeurNumero.BackgroundTransparency = 1
valeurNumero.Font = Enum.Font.GothamBlack
valeurNumero.TextScaled = true
valeurNumero.TextColor3 = Color3.new(1, 1, 1)
valeurNumero.Parent = ligneNumero
table.insert(miseAJour, function()
	valeurNumero.Text = tostring(persoEdite.Numero)
end)
moins.Activated:Connect(function()
	persoEdite.Numero = (persoEdite.Numero - 1) % 100
	rafraichir()
end)
plus.Activated:Connect(function()
	persoEdite.Numero = (persoEdite.Numero + 1) % 100
	rafraichir()
end)

-- Un peu d'espace en bas de la liste
local espace = Instance.new("Frame")
espace.LayoutOrder = suivant()
espace.Size = UDim2.new(1, 0, 0, 10)
espace.BackgroundTransparency = 1
espace.Parent = liste

---------------------------------------------------------------------
-- OUVRIR / FERMER / ENREGISTRER
---------------------------------------------------------------------
local function ouvrir()
	if menuOuvert then
		return
	end
	if not profil then
		profil = remotes:WaitForChild("ObtenirProfil"):InvokeServer()
	end
	persoEdite = table.clone(profil and profil.Perso or Config.PersoParDefaut)
	menuOuvert = true
	controles:Disable()
	camera.CameraType = Enum.CameraType.Scriptable
	gui.Enabled = true
	statut.Text = ""
	rafraichir()
end

local function fermer()
	if not menuOuvert then
		return
	end
	menuOuvert = false
	gui.Enabled = false
	controles:Enable()
	camera.CameraType = Enum.CameraType.Custom
	if profil then
		majApercu(profil.Perso) -- on remet le kart enregistré sur le plateau
	end
end

boutonFermer.Activated:Connect(fermer)

boutonEnregistrer.Activated:Connect(function()
	remotes.Personnaliser:FireServer(persoEdite)
	afficherStatut("✔ Kart enregistré !", Color3.fromRGB(140, 255, 160))
end)

boutonSortir.Activated:Connect(function()
	remotes.Personnaliser:FireServer(persoEdite)
	fermer()
	task.wait(0.35) -- laisse le serveur enregistrer avant de sortir le kart
	remotes.SortirKart:FireServer()
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
	if prompt.Name == "PromptGarage" then
		ouvrir()
	end
end)

remotes:WaitForChild("ProfilMisAJour").OnClientEvent:Connect(function(nouveauProfil)
	if type(nouveauProfil) ~= "table" then
		return
	end
	profil = nouveauProfil
	if menuOuvert then
		rafraichir() -- de nouveaux éléments ont peut-être été débloqués
	else
		persoEdite = table.clone(profil.Perso)
		majApercu(profil.Perso)
	end
end)

task.spawn(function()
	local p = remotes:WaitForChild("ObtenirProfil"):InvokeServer()
	if type(p) == "table" and not profil then
		profil = p
		majApercu(p.Perso)
	end
end)

-- Si le joueur meurt / réapparaît avec le menu ouvert, on le ferme proprement
joueur.CharacterAdded:Connect(fermer)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX9"><Properties><string name="Name">Intro</string><ProtectedString name="Source"><![CDATA[--[[
	Intro  (LocalScript)
	À placer dans : StarterPlayer > StarterPlayerScripts   — nom conseillé : Intro

	La petite séquence d'ouverture (environ 6 secondes) quand on rejoint le jeu :
	  1. fondu depuis le noir, bandes « cinéma » en haut et en bas
	  2. la caméra tourne autour de la fontaine du Golden Mall
	  3. elle survole le parking jusqu'au Garage VIP
	  4. le titre du jeu apparaît, puis on rend la main au joueur
	Un bouton « Passer » permet de la sauter.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))

local joueur = Players.LocalPlayer
local camera = workspace.CurrentCamera
local controles = require(joueur:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()

local SOL = 1
local DUREE_FONTAINE = 2.8 -- secondes autour de la fontaine
local DUREE_SURVOL = 3.2 -- secondes pour aller du mall au garage

---------------------------------------------------------------------
-- L'écran de l'intro
---------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "IntroGoldenMall"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
gui.Parent = joueur:WaitForChild("PlayerGui")

local noir = Instance.new("Frame")
noir.Size = UDim2.fromScale(1, 1)
noir.BackgroundColor3 = Color3.new(0, 0, 0)
noir.ZIndex = 1
noir.Parent = gui

local function bande(position: UDim2): Frame
	local b = Instance.new("Frame")
	b.Size = UDim2.new(1, 0, 0.11, 0)
	b.Position = position
	b.BackgroundColor3 = Color3.new(0, 0, 0)
	b.BorderSizePixel = 0
	b.ZIndex = 2
	b.Parent = gui
	return b
end
local bandeHaut = bande(UDim2.fromScale(0, 0))
local bandeBas = bande(UDim2.fromScale(0, 0.89))

local function texte(taille: UDim2, position: UDim2, couleur: Color3, police: Enum.Font): TextLabel
	local t = Instance.new("TextLabel")
	t.AnchorPoint = Vector2.new(0.5, 0.5)
	t.Size = taille
	t.Position = position
	t.BackgroundTransparency = 1
	t.TextColor3 = couleur
	t.Font = police
	t.TextScaled = true
	t.TextTransparency = 1
	t.ZIndex = 3
	local contour = Instance.new("UIStroke")
	contour.Thickness = 3
	contour.Color = Color3.fromRGB(20, 15, 5)
	contour.Transparency = 1
	contour.Parent = t
	t.Parent = gui
	return t
end

local titre = texte(UDim2.fromScale(0.8, 0.13), UDim2.fromScale(0.5, 0.44), Color3.fromRGB(255, 205, 70), Enum.Font.GothamBlack)
titre.Text = string.upper(Config.NomDuJeu)
local echelleTitre = Instance.new("UIScale")
echelleTitre.Scale = 0.6
echelleTitre.Parent = titre
local degrade = Instance.new("UIGradient")
degrade.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 240, 170)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 190, 40)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 170)),
})
degrade.Rotation = 90
degrade.Parent = titre

local sousTitre = texte(UDim2.fromScale(0.5, 0.05), UDim2.fromScale(0.5, 0.54), Color3.new(1, 1, 1), Enum.Font.GothamBold)
sousTitre.Text = "✦  " .. Config.Lieu .. "  ✦"
local slogan = texte(UDim2.fromScale(0.6, 0.04), UDim2.fromScale(0.5, 0.95), Color3.fromRGB(220, 220, 230), Enum.Font.GothamMedium)
slogan.Text = "Drifte. Personnalise. Deviens une légende."
slogan.ZIndex = 4

local boutonPasser = Instance.new("TextButton")
boutonPasser.AnchorPoint = Vector2.new(1, 0)
boutonPasser.Size = UDim2.new(0, 130, 0, 40)
boutonPasser.Position = UDim2.new(1, -20, 0, 14)
boutonPasser.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
boutonPasser.BackgroundTransparency = 0.2
boutonPasser.TextColor3 = Color3.new(1, 1, 1)
boutonPasser.Font = Enum.Font.GothamBold
boutonPasser.TextScaled = true
boutonPasser.Text = "Passer ▶"
boutonPasser.ZIndex = 5
boutonPasser.Parent = gui
Instance.new("UICorner", boutonPasser).CornerRadius = UDim.new(0, 10)
local margePasser = Instance.new("UIPadding")
margePasser.PaddingTop = UDim.new(0, 8)
margePasser.PaddingBottom = UDim.new(0, 8)
margePasser.Parent = boutonPasser

local function apparaitre(t: TextLabel, duree: number)
	TweenService:Create(t, TweenInfo.new(duree), { TextTransparency = 0 }):Play()
	local c = t:FindFirstChildOfClass("UIStroke")
	if c then
		TweenService:Create(c, TweenInfo.new(duree), { Transparency = 0 }):Play()
	end
end

local function disparaitre(t: TextLabel, duree: number)
	TweenService:Create(t, TweenInfo.new(duree), { TextTransparency = 1 }):Play()
	local c = t:FindFirstChildOfClass("UIStroke")
	if c then
		TweenService:Create(c, TweenInfo.new(duree), { Transparency = 1 }):Play()
	end
end

---------------------------------------------------------------------
-- La séquence
---------------------------------------------------------------------
local termine = false

local function finir()
	if termine then
		return
	end
	termine = true
	RunService:UnbindFromRenderStep("IntroCamera")
	-- Les bandes « cinéma » s'écartent, tout s'efface
	TweenService:Create(bandeHaut, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Position = UDim2.fromScale(0, -0.12) }):Play()
	TweenService:Create(bandeBas, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Position = UDim2.fromScale(0, 1.01) }):Play()
	TweenService:Create(noir, TweenInfo.new(0.4), { BackgroundTransparency = 1 }):Play()
	for _, t in ipairs({ titre, sousTitre, slogan }) do
		disparaitre(t, 0.5)
	end
	boutonPasser.Visible = false
	camera.CameraType = Enum.CameraType.Custom
	controles:Enable()
	joueur:SetAttribute("IntroFinie", true)
	task.delay(0.8, function()
		gui:Destroy()
	end)
end
boutonPasser.Activated:Connect(finir)

task.spawn(function()
	-- On attend le personnage et la carte
	local perso = joueur.Character or joueur.CharacterAdded:Wait()
	local racine = perso:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	local carte = workspace:WaitForChild("GoldenMall", 15)
	if termine then
		return
	end
	if not carte or not racine then
		finir()
		return
	end
	controles:Disable()
	-- Charge le décor autour de la fontaine (utile si le "streaming" est activé)
	pcall(function()
		joueur:RequestStreamAroundAsync(Vector3.new(0, SOL, 0))
		joueur:RequestStreamAroundAsync(Vector3.new(0, SOL, 250))
	end)

	camera.CameraType = Enum.CameraType.Scriptable
	local debut = os.clock()
	local garage = carte:FindFirstChild("GarageVIP")
	local porteGarage = if garage then (garage:GetPivot().Position) else racine.Position
	-- On termine dehors, face à l'entrée du garage (on voit l'enseigne et l'intérieur)
	local finSurvol = Vector3.new(racine.Position.X * 0.3, SOL + 9, porteGarage.Z - 68)

	RunService:BindToRenderStep("IntroCamera", Enum.RenderPriority.Camera.Value + 2, function()
		local t = os.clock() - debut
		if t < DUREE_FONTAINE then
			-- 1) On tourne autour de la fontaine, sous le plafond
			local a = t / DUREE_FONTAINE
			local angle = math.rad(-40 + 110 * a)
			local rayon = 44 - 8 * a
			local pos = Vector3.new(math.cos(angle) * rayon, SOL + 9 + 3 * a, math.sin(angle) * rayon)
			camera.CFrame = CFrame.lookAt(pos, Vector3.new(0, SOL + 6, 0))
		elseif t < DUREE_FONTAINE + DUREE_SURVOL then
			-- 2) On sort par l'entrée et on survole le parking jusqu'au garage
			local a = (t - DUREE_FONTAINE) / DUREE_SURVOL
			local doux = a * a * (3 - 2 * a)
			local depart = Vector3.new(0, SOL + 14, 120)
			local milieu = Vector3.new(0, SOL + 40, 200)
			local p1 = depart:Lerp(milieu, doux)
			local p2 = milieu:Lerp(finSurvol, doux)
			local pos = p1:Lerp(p2, doux)
			local regard = Vector3.new(0, SOL + 8, 175):Lerp(porteGarage + Vector3.new(0, 4, 0), doux)
			camera.CFrame = CFrame.lookAt(pos, regard)
		else
			finir()
		end
	end)

	-- Les textes
	TweenService:Create(noir, TweenInfo.new(0.9), { BackgroundTransparency = 1 }):Play()
	task.wait(0.6)
	apparaitre(titre, 0.6)
	TweenService:Create(echelleTitre, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.wait(0.4)
	apparaitre(sousTitre, 0.5)
	task.wait(0.3)
	apparaitre(slogan, 0.5)
	task.wait(DUREE_FONTAINE - 0.2)
	if not termine then
		disparaitre(titre, 0.6)
		disparaitre(sousTitre, 0.6)
	end
end)
]]></ProtectedString></Properties></Item></Item></Item></roblox>