local POSITION_BORNE = Vector3.new(-26, SOL, G_CZ - 6)
local borne = bloc("Atelier", Vector3.new(2.5, 4, 2.5), CFrame.new(POSITION_BORNE + Vector3.new(0, 2, 0)), Color3.fromRGB(30, 30, 36), Enum.Material.Metal, garage)
