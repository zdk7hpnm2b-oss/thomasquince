pancarte("PanneauFoodCourt", Vector3.new(30, 4, 0.4), Vector3.new(-136, SOL + 14, 14), Vector3.new(0, 0, -1), "🍔 FOOD COURT 🍕", NOIR_LUXE, Color3.fromRGB(255, 200, 80), foodCourt)
