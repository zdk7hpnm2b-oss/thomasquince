end)

etiquette(panneau, "Garage", UDim2.new(0.5, 0, 0, 16), UDim2.new(0, 18, 0, 16), GRIS_TEXTE, Enum.Font.GothamMedium)
local titre = etiquette(panneau, "PERSONNALISER", UDim2.new(1, -90, 0, 40), UDim2.new(0, 18, 0, 32), Color3.new(1, 1, 1))
titre.FontFace = Font.fromEnum(Enum.Font.FredokaOne) -- gras italique, style course
local sousTitre = etiquette(panneau, "", UDim2.new(0.6, 0, 0, 18), UDim2.new(0, 18, 0, 76), Color3.fromRGB(230, 230, 235))
local soldePieces = etiquette(panneau, "💰 0", UDim2.new(0.35, 0, 0, 18), UDim2.new(0.65, -18, 0, 76), OR)
soldePieces.TextXAlignment = Enum.TextXAlignment.Right
local sousTitreNiveau = sousTitre -- (compatibilité)

local boutonFermer = bouton(panneau, "X", Color3.fromRGB(32, 32, 38), UDim2.new(0, 42, 0, 42), UDim2.new(1, -58, 0, 18))
boutonFermer.TextColor3 = Color3.fromRGB(220, 220, 225)

local statut = Instance.new("TextLabel") -- (ligne d'info, placée en bas)

local function afficherStatut(texte: string, couleur: Color3?)
	statut.Text = texte
	statut.TextColor3 = couleur or Color3.fromRGB(255, 160, 160)
	statut.TextTransparency = 1
	TweenService:Create(statut, TweenInfo.new(0.25), { TextTransparency = 0 }):Play()
end

---------------------------------------------------------------------
-- Les « slots » : un onglet par modèle de kart (comme SLOT 1, 2, 3...)
---------------------------------------------------------------------
local miseAJour: { () -> () } = {}

local function possede(liste: string, nom: string): boolean
	local p = profil and profil.Possessions
	return p ~= nil and type(p[liste]) == "table" and p[liste][nom] == true
end

local MarketplaceService = game:GetService("MarketplaceService")
-- Achat en Robux (ou gratuit dans Studio tant que le produit n'est pas configuré)
local function acheterRobux(produitId: number?, nomTest: string, quandOk: (() -> ())?)
	if (produitId or 0) ~= 0 then
		MarketplaceService:PromptProductPurchase(joueur, produitId :: number)
		return
	end
	local resultat = remotes:WaitForChild("Acheter"):InvokeServer({ type = "test", nom = nomTest })
	if type(resultat) == "table" then
		if resultat.profil then
			profil = resultat.profil
			if quandOk then
				quandOk()
			end
		end
		afficherStatut(resultat.message or "", if resultat.ok then Color3.fromRGB(140, 255, 160) else Color3.fromRGB(255, 140, 140))
	end
end

local rangeeSlots = Instance.new("Frame")
rangeeSlots.Size = UDim2.new(1, -32, 0, 50)
rangeeSlots.Position = UDim2.new(0, 16, 0, 104)
rangeeSlots.BackgroundTransparency = 1
rangeeSlots.Parent = panneau
local dispoSlots = Instance.new("UIListLayout")
dispoSlots.FillDirection = Enum.FillDirection.Horizontal
dispoSlots.Padding = UDim.new(0, 5)
dispoSlots.SortOrder = Enum.SortOrder.LayoutOrder
dispoSlots.Parent = rangeeSlots

local kartsTries = {}
for id, k in pairs(Config.Karts) do
	table.insert(kartsTries, { id = id, k = k })
end
table.sort(kartsTries, function(a, b)
	return a.k.Ordre < b.k.Ordre
end)
local largeurSlot = 1 / #kartsTries

local rafraichir: () -> ()
for i, e in ipairs(kartsTries) do
	local b = Instance.new("TextButton")
	b.LayoutOrder = i
	b.Size = UDim2.new(largeurSlot, -5, 1, 0)
	b.BackgroundColor3 = CASE
	b.Text = ""
	b.AutoButtonColor = true
	b.Parent = rangeeSlots
	coins(b, 5)
	animer(b)
	local nomSlot = etiquette(b, "", UDim2.new(1, -8, 0.48, 0), UDim2.new(0, 4, 0.08, 0), Color3.new(1, 1, 1))
	nomSlot.TextXAlignment = Enum.TextXAlignment.Center
	local infoSlot = etiquette(b, "", UDim2.new(1, -8, 0.3, 0), UDim2.new(0, 4, 0.58, 0), GRIS_TEXTE, Enum.Font.FredokaOne)
	infoSlot.TextXAlignment = Enum.TextXAlignment.Center
	local souligne = Instance.new("Frame")
	souligne.AnchorPoint = Vector2.new(0, 1)
	souligne.Size = UDim2.new(1, 0, 0, 3)
	souligne.Position = UDim2.new(0, 0, 1, 0)
	souligne.BackgroundColor3 = ROUGE
	souligne.BorderSizePixel = 0
	souligne.Parent = b
	local bordExclusif: UIStroke? = nil
	if e.k.Exclusif then
		-- Le kart exclusif : cadre arc-en-ciel qui tourne
		bordExclusif = contour(b, Color3.new(1, 1, 1), 2)
		local degrade = Instance.new("UIGradient")
		degrade.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 200)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(120, 200, 255)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(255, 230, 90)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 200)),
		})
		degrade.Parent = bordExclusif
		task.spawn(function()
			while b.Parent do
				degrade.Rotation = (degrade.Rotation + 4) % 360
				task.wait(0.03)
			end
		end)
	end
	table.insert(miseAJour, function()
		local bloqueNiveau = e.k.Niveau > niveau()
		local aAcheter = e.k.Exclusif and not possede("Karts", e.id)
		nomSlot.Text = if e.k.Exclusif then "🦄 " .. string.upper(e.k.Nom) else string.upper(e.k.Nom)
		infoSlot.Text = if aAcheter then "🔒 " .. (e.k.PrixAffiche or "R$")
			elseif bloqueNiveau then ("🔒 NIV %d"):format(e.k.Niveau)
			elseif e.id == (profil and profil.Perso and profil.Perso.Kart) then "ACTUEL"
			else ("%d km/h"):format(e.k.VitesseMax)
		infoSlot.TextColor3 = if aAcheter then Color3.fromRGB(255, 200, 90) elseif bloqueNiveau then Color3.fromRGB(255, 120, 120) else GRIS_TEXTE
		local actif = persoEdite.Kart == e.id
		souligne.Visible = actif
		b.BackgroundColor3 = if actif then Color3.fromRGB(44, 30, 36) else CASE
	end)
	b.Activated:Connect(function()
		if e.k.Exclusif and not possede("Karts", e.id) and persoEdite.Kart ~= e.id then
			-- 1er clic : on ESSAIE le kart exclusif (aperçu sur le plateau)
			persoEdite.Kart = e.id
			afficherStatut(("👀 Aperçu %s · reclique pour l'acheter (%s)"):format(e.k.Nom, e.k.PrixAffiche or "R$"), VIOLET)
			rafraichir()
			return
		end
		if e.k.Exclusif and not possede("Karts", e.id) then
			afficherStatut(("🦄 %s : %s"):format(e.k.Nom, e.k.Description), VIOLET)
			acheterRobux(e.k.ProduitId, e.id, function()
				persoEdite.Kart = e.id
			end)
			rafraichir()
			return
		end
		if e.k.Niveau > niveau() then
			afficherStatut(("🔒 %s : débloqué au niveau %d (continue à drifter !)"):format(e.k.Nom, e.k.Niveau))
			return
		end
		persoEdite.Kart = e.id
		afficherStatut(("%s · %s"):format(e.k.Nom, e.k.Description), Color3.fromRGB(220, 220, 230))
		rafraichir()
	end)
end

---------------------------------------------------------------------
-- Onglets : PEINTURE / FINITIONS / DÉCO, et sous-onglets de la peinture
---------------------------------------------------------------------
local function rangeeOnglets(y: number, hauteur: number, noms: { string }, sombre: boolean?): ({ TextButton }, Frame)
	local f = Instance.new("Frame")
	f.Size = UDim2.new(1, -32, 0, hauteur)
	f.Position = UDim2.new(0, 16, 0, y)
	f.BackgroundTransparency = 1
	f.Parent = panneau
	local l = Instance.new("UIListLayout")
	l.FillDirection = Enum.FillDirection.Horizontal
	l.Padding = UDim.new(0, 6)
	l.Parent = f
	local boutons = {}
	for i, nom in ipairs(noms) do
		local b = bouton(f, nom, CASE, UDim2.new(1 / #noms, -6, 1, 0))
		b.LayoutOrder = i
		b.TextColor3 = Color3.fromRGB(225, 225, 230)
		if sombre then
			b.Font = Enum.Font.FredokaOne
		end
		boutons[i] = b
	end
	return boutons, f
end

local ongletsPrincipaux = rangeeOnglets(162, 42, { "PEINTURE", "FINITIONS", "DÉCO", "⭐ OFFRES" })
local sousOnglets, rangeeSous = rangeeOnglets(212, 32, { "CARROSSERIE", "JANTES", "SIÈGE", "BANDES" }, true)
local ongletActif, sousOngletActif = 1, 1

-- La zone qui défile (une page par onglet)
local zone = Instance.new("ScrollingFrame")
zone.Size = UDim2.new(1, -24, 1, -250 - 128)
zone.Position = UDim2.new(0, 12, 0, 252)
zone.BackgroundTransparency = 1
zone.BorderSizePixel = 0
zone.ScrollBarThickness = 5
zone.ScrollBarImageColor3 = ROUGE
zone.CanvasSize = UDim2.new()
zone.AutomaticCanvasSize = Enum.AutomaticSize.Y
zone.Parent = panneau

local function page(): Frame
	local p = Instance.new("Frame")
	p.Size = UDim2.new(1, -8, 0, 0)
	p.Position = UDim2.new(0, 4, 0, 0)
	p.AutomaticSize = Enum.AutomaticSize.Y
	p.BackgroundTransparency = 1
	p.Visible = false
	p.Parent = zone
	local l = Instance.new("UIListLayout")
	l.Padding = UDim.new(0, 8)
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.Parent = p
	return p
end

local ordre = 0
local function suivant(): number
	ordre += 1
	return ordre
end

local function section(parent: Instance, nom: string, couleur: Color3?): TextLabel
	local l = etiquette(parent, nom, UDim2.new(1, 0, 0, 18), UDim2.new(), couleur or Color3.fromRGB(205, 205, 212), Enum.Font.FredokaOne)
	l.LayoutOrder = suivant()
	return l
end

local function grille(parent: Instance, taille: Vector2): Frame
	local f = Instance.new("Frame")
	f.LayoutOrder = suivant()
	f.Size = UDim2.new(1, 0, 0, 0)
	f.AutomaticSize = Enum.AutomaticSize.Y
	f.BackgroundTransparency = 1
	local g = Instance.new("UIGridLayout")
	g.CellSize = UDim2.fromOffset(taille.X, taille.Y)
	g.CellPadding = UDim2.fromOffset(7, 7)
	g.SortOrder = Enum.SortOrder.LayoutOrder
	g.Parent = f
	f.Parent = parent
	return f
end

local DEGRADE_ARC_EN_CIEL = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)),
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(60, 255, 100)),
	ColorSequenceKeypoint.new(0.66, Color3.fromRGB(60, 120, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 60, 220)),
})
local DEGRADE_PASTEL = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 180, 230)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(180, 220, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 240, 170)),
})

-- Une case de couleur, avec sa pastille de prix en bas (comme sur la photo)
local function caseCouleur(parent: Instance, ordreCase: number, couleur: Color3): (TextButton, TextLabel, UIStroke)
	local b = Instance.new("TextButton")
	b.LayoutOrder = ordreCase
	b.BackgroundColor3 = couleur
	b.Text = ""
	b.AutoButtonColor = true
	coins(b, 6)
	local trait = contour(b, Color3.new(1, 1, 1), 0)
	-- Petit reflet en haut de la case
	local brillance = Instance.new("Frame")
	brillance.Size = UDim2.new(1, -6, 0.32, 0)
	brillance.Position = UDim2.new(0, 3, 0, 3)
	brillance.BackgroundColor3 = Color3.new(1, 1, 1)
	brillance.BackgroundTransparency = 0.82
	brillance.BorderSizePixel = 0
	brillance.Parent = b
	coins(brillance, 4)
	local prix = Instance.new("TextLabel")
	prix.AnchorPoint = Vector2.new(0.5, 1)
	prix.Size = UDim2.new(0.86, 0, 0.3, 0)
	prix.Position = UDim2.new(0.5, 0, 1, -4)
	prix.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
	prix.BackgroundTransparency = 0.25
	prix.Font = Enum.Font.FredokaOne
	prix.TextScaled = true
	prix.TextColor3 = Color3.new(1, 1, 1)
	prix.Text = ""
	prix.Parent = b
	coins(prix, 4)
	b.Parent = parent
	animer(b)
	return b, prix, trait
end

-- Acheter une couleur avec des pièces (2 clics : le 1er demande confirmation)
local achatEnAttente: string? = nil
local function acheterCouleur(c): boolean
	if achatEnAttente ~= c.Nom then
		achatEnAttente = c.Nom
		afficherStatut(("Acheter « %s » pour %d 💰 ? Clique encore pour confirmer"):format(c.Nom, c.Prix), Color3.fromRGB(255, 220, 90))
		task.delay(4, function()
			if achatEnAttente == c.Nom then
				achatEnAttente = nil
			end
		end)
		return false
	end
	achatEnAttente = nil
	local resultat = remotes:WaitForChild("Acheter"):InvokeServer({ type = "couleur", nom = c.Nom })
	if type(resultat) == "table" then
		if resultat.profil then
			profil = resultat.profil
		end
		afficherStatut(resultat.message or "", if resultat.ok then Color3.fromRGB(140, 255, 160) else Color3.fromRGB(255, 140, 140))
		return resultat.ok == true
	end
	return false
end

local function grilleCouleurs(parent: Instance, champ: string, liste: { any }?)
	local g = grille(parent, Vector2.new(58, 58))
	for i, c in ipairs(liste or Config.Couleurs) do
		local b, prix, trait = caseCouleur(g, i, c.Couleur)
		if c.Nom == "Aucun" then
			b.BackgroundColor3 = Color3.fromRGB(45, 45, 58)
		elseif c.Nom == "Arc-en-ciel" then
			local degrade = Instance.new("UIGradient")
			degrade.Color = DEGRADE_ARC_EN_CIEL
			degrade.Parent = b
		end
		local payante = (c.Prix or 0) > 0
		table.insert(miseAJour, function()
			local bloque = (c.Niveau or 1) > niveau()
			local aAcheter = payante and not possede("Couleurs", c.Nom)
			prix.Text = if bloque then ("🔒 NIV %d"):format(c.Niveau) elseif aAcheter then (tostring(c.Prix) .. " 💰") elseif c.Nom == "Aucun" then "AUCUN" else ""
			prix.Visible = prix.Text ~= ""
			local choisi = persoEdite[champ] == c.Nom and not (champ == "Carrosserie" and persoEdite.Premium)
			trait.Thickness = if choisi then 3 else 0
			b.BackgroundTransparency = if bloque then 0.5 else 0
		end)
		b.Activated:Connect(function()
			if (c.Niveau or 1) > niveau() then
				afficherStatut(("🔒 Débloqué au niveau %d (continue à drifter !)"):format(c.Niveau))
				return
			end
			if payante and not possede("Couleurs", c.Nom) and not acheterCouleur(c) then
				rafraichir()
				return
			end
			persoEdite[champ] = c.Nom
			if champ == "Carrosserie" then
				persoEdite.Premium = nil -- une couleur normale remplace la peinture premium
			end
			afficherStatut(c.Nom, Color3.fromRGB(220, 220, 230))
			rafraichir()
		end)
	end
end

-- Les peintures Robux (premium, puis exclusives)
local function grillePremium(parent: Instance, exclusives: boolean)
	local g = grille(parent, Vector2.new(58, 58))
	for i, pp in ipairs(Config.PeinturesPremium or {}) do
		if (pp.Exclusive == true) ~= exclusives then
			continue
		end
		local b, prix, trait = caseCouleur(g, i, pp.Couleur)
		if pp.ArcEnCiel then
			local degrade = Instance.new("UIGradient")
			degrade.Color = if pp.Pastel then DEGRADE_PASTEL else DEGRADE_ARC_EN_CIEL
			degrade.Rotation = 35
			degrade.Parent = b
		elseif pp.Materiau == Enum.Material.Foil or pp.Materiau == Enum.Material.Ice or pp.Materiau == Enum.Material.Glass then
			local degrade = Instance.new("UIGradient") -- effet métal / glace / galaxie
			degrade.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, pp.Couleur:Lerp(Color3.new(1, 1, 1), 0.6)),
				ColorSequenceKeypoint.new(0.5, pp.Couleur),
				ColorSequenceKeypoint.new(1, pp.Couleur:Lerp(Color3.new(0, 0, 0), 0.4)),
			})
			degrade.Rotation = 45
			degrade.Parent = b
		end
		local bordCouleur = contour(b, if exclusives then VIOLET else OR, 1)
		table.insert(miseAJour, function()
			local achete = possede("Premium", pp.Nom)
			prix.Text = if achete then "" else "R$"
			prix.TextColor3 = if exclusives then Color3.fromRGB(230, 190, 255) else Color3.fromRGB(120, 255, 140)
			prix.Visible = not achete
			local choisi = persoEdite.Premium == pp.Nom
			trait.Thickness = if choisi then 3 else 0
			bordCouleur.Thickness = if choisi then 0 else 1
		end)
		b.Activated:Connect(function()
			if possede("Premium", pp.Nom) then
				persoEdite.Premium = if persoEdite.Premium == pp.Nom then nil else pp.Nom
				afficherStatut(pp.Nom, Color3.fromRGB(220, 220, 230))
				rafraichir()
				return
			end
			if persoEdite.Premium ~= pp.Nom then
				-- 1er clic : on ESSAIE la peinture sur le kart (aperçu)
				persoEdite.Premium = pp.Nom
				afficherStatut(("👀 Aperçu %s · reclique pour l'acheter (%s)"):format(pp.Nom, pp.PrixAffiche or "R$"), if exclusives then VIOLET else OR)
				rafraichir()
				return
			end
			afficherStatut(("%s %s · %s"):format(if exclusives then "✦" else "💎", pp.Nom, pp.PrixAffiche or "R$"), if exclusives then VIOLET else OR)
			acheterRobux(pp.ProduitId, pp.Nom, function()
				persoEdite.Premium = pp.Nom
			end)
			rafraichir()
		end)
	end
end

-- PAGE PEINTURE (un contenu par sous-onglet)
local pagesPeinture = {}
for i, champ in ipairs({ "Carrosserie", "Jantes", "Siege", "Bandes" }) do
	local p = page()
	section(p, "COULEURS")
	grilleCouleurs(p, champ)
	if champ == "Carrosserie" then
		section(p, "PEINTURE PREMIUM", OR)
		grillePremium(p, false)
		section(p, "✦ COULEURS EXCLUSIVES", VIOLET)
		grillePremium(p, true)
	elseif champ == "Bandes" then
		local b = bouton(p, "", CASE, UDim2.new(1, 0, 0, 38))
		b.LayoutOrder = 0 -- (en haut de la page)
		table.insert(miseAJour, function()
			b.Text = if persoEdite.BandesActives then "BANDES DE COURSE : OUI ✔" else "BANDES DE COURSE : NON ✕"
			b.BackgroundColor3 = if persoEdite.BandesActives then ROUGE_SOMBRE else CASE
		end)
		b.Activated:Connect(function()
			persoEdite.BandesActives = not persoEdite.BandesActives
			rafraichir()
		end)
	end
	pagesPeinture[i] = p
end

-- PAGE FINITIONS
local pageFinitions = page()
section(pageFinitions, "FINITION DE LA PEINTURE")
local grilleFinition = grille(pageFinitions, Vector2.new(124, 44))
for i, f in ipairs(Config.Finitions) do
	local b = bouton(grilleFinition, f.Nom, CASE, UDim2.new())
	b.LayoutOrder = i
	local trait = contour(b, ROUGE, 0)
	table.insert(miseAJour, function()
		local bloque = f.Niveau > niveau()
		b.Text = if bloque then ("🔒 %s · NIV %d"):format(f.Nom, f.Niveau) else f.Nom
		b.BackgroundTransparency = if bloque then 0.5 else 0
		b.BackgroundColor3 = if persoEdite.Finition == f.Nom then ROUGE_SOMBRE else CASE
		trait.Thickness = if persoEdite.Finition == f.Nom then 2 else 0
	end)
	b.Activated:Connect(function()
		if f.Niveau > niveau() then
			afficherStatut(("🔒 Débloqué au niveau %d (continue à drifter !)"):format(f.Niveau))
			return
		end
		persoEdite.Finition = f.Nom
		afficherStatut("Finition : " .. f.Nom, Color3.fromRGB(220, 220, 230))
		rafraichir()
	end)
end
local noteFinition = etiquette(pageFinitions, "(Une peinture premium a sa propre finition.)", UDim2.new(1, 0, 0, 14), UDim2.new(), GRIS_TEXTE, Enum.Font.GothamMedium)
noteFinition.LayoutOrder = suivant()

-- PAGE DÉCO : néons, autocollant, numéro
local pageDeco = page()
section(pageDeco, "NÉONS SOUS LE KART")
grilleCouleurs(pageDeco, "Neon", Config.Neons)
section(pageDeco, "🌈 TRAÎNÉES (derrière ton kart)", VIOLET)
local grilleTrainees = grille(pageDeco, Vector2.new(58, 58))
for i, t in ipairs(Config.Trainees or {}) do
	local b, prix, trait = caseCouleur(grilleTrainees, i, Color3.fromRGB(45, 45, 58))
	if t.Couleurs then
		b.BackgroundColor3 = Color3.new(1, 1, 1)
		local degrade = Instance.new("UIGradient")
		degrade.Color = t.Couleurs
		degrade.Rotation = 45
		degrade.Parent = b
	end
	local icone = etiquette(b, t.Icone or "", UDim2.new(0.6, 0, 0.45, 0), UDim2.new(0.2, 0, 0.08, 0), Color3.new(1, 1, 1))
	icone.TextXAlignment = Enum.TextXAlignment.Center
	local offre = Config.OffreTrainee(t.Nom)
	table.insert(miseAJour, function()
		local achetee = t.Nom == "Aucune" or possede("Trainees", t.Nom)
		prix.Text = if achetee then (if t.Nom == "Aucune" then "AUCUNE" else "") else (offre and offre.PrixAffiche or "R$")
		prix.Visible = prix.Text ~= ""
		trait.Thickness = if (persoEdite.Trainee or "Aucune") == t.Nom then 3 else 0
	end)
	b.Activated:Connect(function()
		if t.Nom == "Aucune" or possede("Trainees", t.Nom) then
			persoEdite.Trainee = t.Nom
			afficherStatut("Traînée : " .. t.Nom, Color3.fromRGB(220, 220, 230))
			rafraichir()
			return
		end
		if not offre then
			afficherStatut("Gagne-la à la 🎡 ROUE DU JOUR !", VIOLET)
			return
		end
		afficherStatut(("%s %s · %s"):format(t.Icone or "", offre.Nom, offre.PrixAffiche), VIOLET)
		acheterRobux(offre.ProduitId, offre.Id, function()
			persoEdite.Trainee = t.Nom
		end)
		rafraichir()
	end)
end
section(pageDeco, "AUTOCOLLANT")
local grilleAutocollant = grille(pageDeco, Vector2.new(58, 58))
for i, a in ipairs(Config.Autocollants) do
	local b = bouton(grilleAutocollant, a.Texte ~= "" and a.Texte or "∅", CASE, UDim2.new())
	b.LayoutOrder = i
	local trait = contour(b, Color3.new(1, 1, 1), 0)
	table.insert(miseAJour, function()
		local bloque = a.Niveau > niveau()
		b.Text = if bloque then "🔒" else (a.Texte ~= "" and a.Texte or "∅")
		b.BackgroundTransparency = if bloque then 0.5 else 0
		trait.Thickness = if persoEdite.Autocollant == a.Nom then 3 else 0
	end)
	b.Activated:Connect(function()
		if a.Niveau > niveau() then
			afficherStatut(("🔒 Débloqué au niveau %d (continue à drifter !)"):format(a.Niveau))
			return
		end
		persoEdite.Autocollant = a.Nom
		rafraichir()
	end)
end
section(pageDeco, "NUMÉRO")
local ligneNumero = Instance.new("Frame")
ligneNumero.LayoutOrder = suivant()
ligneNumero.Size = UDim2.new(1, 0, 0, 44)
ligneNumero.BackgroundTransparency = 1
ligneNumero.Parent = pageDeco
local moins = bouton(ligneNumero, "−", CASE, UDim2.new(0, 54, 1, 0), UDim2.new(0, 0, 0, 0))
local plus = bouton(ligneNumero, "+", CASE, UDim2.new(0, 54, 1, 0), UDim2.new(0, 160, 0, 0))
local valeurNumero = etiquette(ligneNumero, "", UDim2.new(0, 90, 1, 0), UDim2.new(0, 62, 0, 0), Color3.new(1, 1, 1))
valeurNumero.TextXAlignment = Enum.TextXAlignment.Center
table.insert(miseAJour, function()
	valeurNumero.Text = tostring(persoEdite.Numero)
end)
moins.Activated:Connect(function()
	persoEdite.Numero = (persoEdite.Numero - 1) % 100
	rafraichir()
end)
plus.Activated:Connect(function()
	persoEdite.Numero = (persoEdite.Numero + 1) % 100
	rafraichir()
end)

-- PAGE OFFRES : les objets à acheter, à ESSAYER directement sur ton kart (1er clic),
-- puis à acheter (2e clic). Kart exclusif, packs, VIP, traînées…
local pageOffres = page()
section(pageOffres, "⭐ OFFRES : clique pour ESSAYER sur ton kart", OR)
local essaiEnCours: string? = nil
local function offreDejaAchetee(offre): boolean
	if offre.Kart then
		return possede("Karts", offre.Kart)
	end
	if offre.Categorie == "Traînées" and offre.Trainee then
		return possede("Trainees", offre.Trainee)
	end
	local p = profil and profil.Possessions
	return p ~= nil and p.Produits ~= nil and p.Produits[offre.Id] == true
end
for _, offre in ipairs(Config.Boutique or {}) do
	if offre.Categorie ~= "Offres" and offre.Categorie ~= "Traînées" then
		continue
	end
	local couleur: Color3 = offre.Couleur or Color3.fromRGB(120, 120, 140)
	local carte = Instance.new("TextButton")
	carte.LayoutOrder = suivant()
	carte.Size = UDim2.new(1, 0, 0, 92)
	carte.BackgroundColor3 = Color3.fromRGB(26, 26, 32):Lerp(couleur, 0.14)
	carte.AutoButtonColor = false
	carte.Text = ""
	carte.Parent = pageOffres
	coins(carte, 10)
	local bord = contour(carte, couleur, 1)
	animer(carte)
	-- Grosse icône sur une pastille colorée
	local tuile = Instance.new("Frame")
	tuile.AnchorPoint = Vector2.new(0, 0.5)
	tuile.Size = UDim2.fromOffset(74, 74)
	tuile.Position = UDim2.new(0, 9, 0.5, 0)
	tuile.BackgroundColor3 = Color3.new(1, 1, 1)
	tuile.Parent = carte
	coins(tuile, 14)
	local degradeTuile = Instance.new("UIGradient")
	local trainee = offre.Trainee and Config.Trainee(offre.Trainee)
	if offre.Categorie == "Traînées" and trainee and trainee.Couleurs then
		degradeTuile.Color = trainee.Couleurs
		degradeTuile.Rotation = 45
	else
		degradeTuile.Color = ColorSequence.new(couleur:Lerp(Color3.new(1, 1, 1), 0.4), couleur:Lerp(Color3.new(0, 0, 0), 0.2))
		degradeTuile.Rotation = 90
	end
	degradeTuile.Parent = tuile
	contour(tuile, Color3.new(1, 1, 1), 3)
	local image = Config.ImageIcone(offre.Icone or "")
	if image then
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.new(1, -20, 1, -20)
		img.Position = UDim2.fromOffset(10, 10)
		img.BackgroundTransparency = 1
		img.Image = image
		img.Parent = tuile
	else
		local icone = etiquette(tuile, offre.Icone or "⭐", UDim2.new(1, -18, 1, -18), UDim2.fromOffset(9, 9), Color3.new(1, 1, 1))
		icone.TextXAlignment = Enum.TextXAlignment.Center
	end
	local nom = etiquette(carte, (offre.Nom:gsub("^[^%w%s]+%s*", "")), UDim2.new(1, -230, 0, 22), UDim2.new(0, 94, 0, 12), Color3.new(1, 1, 1))
	nom.TextWrapped = true
	local desc = etiquette(carte, offre.Description or "", UDim2.new(1, -110, 0, 30), UDim2.new(0, 94, 0, 38), Color3.fromRGB(200, 200, 210), Enum.Font.GothamMedium)
	desc.TextWrapped = true
	desc.TextYAlignment = Enum.TextYAlignment.Top
	local prix = Instance.new("TextLabel")
	prix.AnchorPoint = Vector2.new(1, 0)
	prix.Size = UDim2.fromOffset(110, 28)
	prix.Position = UDim2.new(1, -10, 0, 10)
	prix.BackgroundColor3 = ROUGE
	prix.TextColor3 = Color3.new(1, 1, 1)
	prix.Font = Enum.Font.FredokaOne
	prix.TextScaled = true
	prix.Parent = carte
	coins(prix, 8)
	local margePrix = Instance.new("UIPadding")
	margePrix.PaddingTop = UDim.new(0, 5)
	margePrix.PaddingBottom = UDim.new(0, 5)
	margePrix.Parent = prix
	table.insert(miseAJour, function()
		local achete = offreDejaAchetee(offre)
		local enEssai = essaiEnCours == offre.Id
		prix.Text = if achete then "✔ À TOI" elseif enEssai then "ACHETER " .. (offre.PrixAffiche or "") else (offre.PrixAffiche or "R$")
		prix.BackgroundColor3 = if achete then Color3.fromRGB(40, 140, 70) elseif enEssai then Color3.fromRGB(255, 140, 0) else ROUGE
		bord.Thickness = if enEssai then 3 else 1
	end)
	carte.Activated:Connect(function()
		local achete = offreDejaAchetee(offre)
		if not achete and essaiEnCours == offre.Id then
			-- 2e clic : on achète
			acheterRobux(offre.ProduitId, offre.Id, function()
				essaiEnCours = nil
			end)
			rafraichir()
			return
		end
		-- 1er clic (ou objet déjà à toi) : on l'ESSAIE / on l'équipe sur le kart
		if offre.Kart then
			persoEdite.Kart = offre.Kart
		end
		local premium = offre.Premium or (offre.Premiums and offre.Premiums[1])
		if premium then
			persoEdite.Premium = premium
		end
		if offre.Trainee then
			persoEdite.Trainee = offre.Trainee
		end
		if achete then
			essaiEnCours = nil
			afficherStatut(("✔ %s : équipé !"):format(nom.Text), Color3.fromRGB(140, 255, 160))
		else
			essaiEnCours = offre.Id
			local visible = offre.Kart or premium or offre.Trainee
			afficherStatut(if visible then ("👀 Regarde ton kart ! Reclique pour acheter (%s)"):format(offre.PrixAffiche or "R$") else ("%s · reclique pour acheter (%s)"):format(offre.Description or "", offre.PrixAffiche or "R$"), OR)
		end
		rafraichir()
	end)
end

-- Affichage des onglets
local function majOnglets()
	for i, b in ipairs(ongletsPrincipaux) do
		b.BackgroundColor3 = if i == ongletActif then ROUGE else CASE
	end
	for i, b in ipairs(sousOnglets) do
		b.BackgroundColor3 = if i == sousOngletActif then ROUGE_SOMBRE else CASE
	end
	rangeeSous.Visible = ongletActif == 1
	for i, p in ipairs(pagesPeinture) do
		p.Visible = ongletActif == 1 and i == sousOngletActif
	end
	pageFinitions.Visible = ongletActif == 2
	pageDeco.Visible = ongletActif == 3
	pageOffres.Visible = ongletActif == 4
	ongletsPrincipaux[4].BackgroundColor3 = if ongletActif == 4 then ROUGE else Color3.fromRGB(150, 100, 10) -- (l'onglet OFFRES attire l'œil)
	-- sans sous-onglets, la zone remonte un peu
	zone.Position = UDim2.new(0, 12, 0, if ongletActif == 1 then 252 else 214)
	zone.Size = UDim2.new(1, -24, 1, if ongletActif == 1 then -378 else -340)
	zone.CanvasPosition = Vector2.zero
end
for i, b in ipairs(ongletsPrincipaux) do
	b.Activated:Connect(function()
		ongletActif = i
		majOnglets()
	end)
end
for i, b in ipairs(sousOnglets) do
	b.Activated:Connect(function()
		sousOngletActif = i
		majOnglets()
	end)
end
majOnglets()

-- Ligne d'info + boutons du bas (RÉINITIALISER / ENREGISTRER / SORTIR)
local barreStatut = Instance.new("Frame")
barreStatut.Size = UDim2.new(1, -32, 0, 38)
barreStatut.Position = UDim2.new(0, 16, 1, -120)
barreStatut.BackgroundColor3 = Color3.fromRGB(28, 28, 34)
barreStatut.Parent = panneau
coins(barreStatut, 5)
statut.Size = UDim2.new(1, -24, 0.56, 0)
statut.Position = UDim2.new(0, 12, 0.22, 0)
statut.BackgroundTransparency = 1
statut.Font = Enum.Font.FredokaOne
statut.TextScaled = true
statut.TextXAlignment = Enum.TextXAlignment.Left
statut.TextColor3 = Color3.fromRGB(220, 220, 230)
statut.Parent = barreStatut

local boutonReinit = bouton(panneau, "RÉINIT.", Color3.fromRGB(32, 32, 38), UDim2.new(0.26, -8, 0, 52), UDim2.new(0, 16, 1, -70))
local boutonEnregistrer = bouton(panneau, "ENREGISTRER", ROUGE_SOMBRE, UDim2.new(0.37, -8, 0, 52), UDim2.new(0.26, 14, 1, -70))
local boutonSortir = bouton(panneau, "ROULER 🏁", ROUGE, UDim2.new(0.37, -14, 0, 52), UDim2.new(0.63, 12, 1, -70))
contour(boutonEnregistrer, ROUGE, 1)

boutonReinit.Activated:Connect(function()
	persoEdite = table.clone(profil and profil.Perso or Config.PersoParDefaut)
	afficherStatut("Retour au look enregistré", Color3.fromRGB(220, 220, 230))
	rafraichir()
end)

rafraichir = function()
	for _, f in ipairs(miseAJour) do
		f()
	end
	local k = Config.Karts[persoEdite.Kart]
	sousTitre.Text = string.upper(k and k.Nom or "") .. ("  ·  NIV %d"):format(niveau())
	soldePieces.Text = ("💰 %d"):format(profil and profil.Pieces or 0)
	if menuOuvert then
		majApercu(persoEdite)
	end
end
local _ = sousTitreNiveau

---------------------------------------------------------------------
-- OUVRIR / FERMER / ENREGISTRER
---------------------------------------------------------------------
local function ouvrir()
	if menuOuvert then
		return
	end
	if not profil then
		profil = remotes:WaitForChild("ObtenirProfil"):InvokeServer()
	end
	persoEdite = table.clone(profil and profil.Perso or Config.PersoParDefaut)
	camDepart = camera.CFrame
	debutTransition = os.clock()
	transitionRetour = false
	menuOuvert = true
	joueur:SetAttribute("MenuGarage", true)
	controles:Disable()
	camera.CameraType = Enum.CameraType.Scriptable
	gui.Enabled = true
	local k = Config.Karts[persoEdite.Kart]
	statut.Text = ("%s · look actuel"):format(k and k.Nom or "Kart")
	statut.TextColor3 = Color3.fromRGB(220, 220, 230)
	-- Le panneau arrive en glissant depuis la droite
	panneau.Position = UDim2.new(1, 480, 0.5, 0)
	TweenService:Create(panneau, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.new(1, -24, 0.5, 0) }):Play()
	rafraichir()
end

local function fermer(sansTransition: boolean?)
	if not menuOuvert then
		return
	end
	menuOuvert = false
	joueur:SetAttribute("MenuGarage", false)
	gui.Enabled = false
	controles:Enable()
	if sansTransition then
		camera.CameraType = Enum.CameraType.Custom
	else
		transitionRetour = true
		debutTransition = os.clock()
		joueur:SetAttribute("CameraGarage", true)
		task.delay(0.8, function()
			joueur:SetAttribute("CameraGarage", false)
		end)
	end
	if profil then
		majApercu(profil.Perso) -- on remet le kart enregistré sur le plateau
	end
end

boutonFermer.Activated:Connect(function()
	fermer(false)
	joueur:SetAttribute("RetourMenu", true) -- on revient au menu
end)

-- Bouton GARAGE du menu : on ouvre la personnalisation directement
joueur:GetAttributeChangedSignal("OuvrirGarage"):Connect(function()
	if joueur:GetAttribute("OuvrirGarage") then
		joueur:SetAttribute("OuvrirGarage", false)
		task.wait(0.05)
		ouvrir()
	end
end)

-- Ce qui n'est qu'un ESSAI (pas encore acheté) n'est pas enregistré
local function retirerEssais(): boolean
	local retire = false
	if persoEdite.Premium and not possede("Premium", persoEdite.Premium) then
		persoEdite.Premium = nil
		retire = true
	end
	local k = Config.Karts[persoEdite.Kart]
	if k and k.Exclusif and not possede("Karts", persoEdite.Kart) then
		persoEdite.Kart = (profil and profil.Perso and profil.Perso.Kart) or "Basique"
		retire = true
	end
	if persoEdite.Trainee and persoEdite.Trainee ~= "Aucune" and not possede("Trainees", persoEdite.Trainee) then
		persoEdite.Trainee = "Aucune"
		retire = true
	end
	return retire
end

boutonEnregistrer.Activated:Connect(function()
	if retirerEssais() then
		rafraichir()
		afficherStatut("(Les objets en aperçu non achetés ont été retirés)", Color3.fromRGB(255, 200, 90))
		task.wait(1.2)
	end
	remotes.Personnaliser:FireServer(persoEdite)
	afficherStatut("✔ Kart enregistré !", Color3.fromRGB(140, 255, 160))
end)

boutonSortir.Activated:Connect(function()
	retirerEssais()
	remotes.Personnaliser:FireServer(persoEdite)
	fermer(true) -- la cinématique de départ prend le relais
	task.wait(0.35) -- laisse le serveur enregistrer avant de sortir le kart
	if Config.TypeDePlace() == "Lobby" then
		joueur:SetAttribute("ModeDemande", "Entrainement") -- au lobby : direction l'entraînement
	else
		remotes.SortirKart:FireServer()
	end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt: ProximityPrompt)
	if prompt.Name == "PromptGarage" then
		ouvrir()
	end
end)

remotes:WaitForChild("ProfilMisAJour").OnClientEvent:Connect(function(nouveauProfil)
	if type(nouveauProfil) ~= "table" then
		return
	end
	profil = nouveauProfil
	if menuOuvert then
		rafraichir() -- de nouveaux éléments ont peut-être été débloqués
	else
		persoEdite = table.clone(profil.Perso)
		majApercu(profil.Perso)
	end
end)

task.spawn(function()
	local p = remotes:WaitForChild("ObtenirProfil"):InvokeServer()
	if type(p) == "table" and not profil then
		profil = p
		majApercu(p.Perso)
	end
end)

-- Si le joueur meurt / réapparaît avec le menu ouvert, on le ferme proprement
joueur.CharacterAdded:Connect(function()
	fermer(true)
end)

---------------------------------------------------------------------
-- BANNIÈRE « GARAGE VIP » quand on entre dans le garage
-- (mêmes limites que le bâtiment construit par MallDriftServer)
---------------------------------------------------------------------
local GARAGE_X, GARAGE_Z1, GARAGE_Z2 = 90, 250, 330
local banniere = Instance.new("ScreenGui")
banniere.Name = "BanniereGarage"
banniere.ResetOnSpawn = false
banniere.IgnoreGuiInset = true
banniere.DisplayOrder = 5
banniere.Parent = joueur:WaitForChild("PlayerGui")

local function montrerBanniere()
	local cadre = Instance.new("Frame")
	cadre.AnchorPoint = Vector2.new(0.5, 0.5)
	cadre.Size = UDim2.new(0, 520, 0, 110)
	cadre.Position = UDim2.fromScale(0.5, 0.3)
	cadre.BackgroundColor3 = FOND
	cadre.BackgroundTransparency = 0.15
	cadre.Parent = banniere
	coins(cadre, 14)
	local trait = contour(cadre, Color3.fromRGB(190, 120, 255), 3)
	local t1 = Instance.new("TextLabel")
	t1.Size = UDim2.new(1, -20, 0, 56)
	t1.Position = UDim2.new(0, 10, 0, 8)
	t1.BackgroundTransparency = 1
	t1.Font = Enum.Font.FredokaOne
	t1.TextScaled = true
	t1.TextColor3 = OR
	t1.Text = "★ GARAGE VIP ★"
	t1.Parent = cadre
	local t2 = Instance.new("TextLabel")
	t2.Size = UDim2.new(1, -20, 0, 28)
	t2.Position = UDim2.new(0, 10, 0, 70)
	t2.BackgroundTransparency = 1
	t2.Font = Enum.Font.FredokaOne
	t2.TextScaled = true
	t2.TextColor3 = Color3.fromRGB(220, 220, 230)
	t2.Text = "Borne violette : E = personnaliser  ·  F = prendre ton kart"
	t2.Parent = cadre
	local echelle = Instance.new("UIScale")
	echelle.Scale = 0.2
	echelle.Parent = cadre
	TweenService:Create(echelle, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(2.6, function()
		local info = TweenInfo.new(0.5)
		TweenService:Create(cadre, info, { BackgroundTransparency = 1, Position = UDim2.fromScale(0.5, 0.24) }):Play()
		TweenService:Create(t1, info, { TextTransparency = 1 }):Play()
		TweenService:Create(t2, info, { TextTransparency = 1 }):Play()
		TweenService:Create(trait, info, { Transparency = 1 }):Play()
		task.wait(0.55)
		cadre:Destroy()
	end)
end

task.spawn(function()
	local dedans = false
	while true do
		task.wait(0.3)
		local perso = joueur.Character
		local racine = perso and perso:FindFirstChild("HumanoidRootPart") :: BasePart?
		if racine and joueur:GetAttribute("IntroFinie") then
			local p = racine.Position
			local maintenantDedans = math.abs(p.X) < GARAGE_X and p.Z > GARAGE_Z1 and p.Z < GARAGE_Z2
			local hud = joueur.PlayerGui:FindFirstChild("PartieHUD")
			local menuDuJeu = hud and hud:FindFirstChild("Menu")
			local menuOuvertAilleurs = (menuDuJeu and (menuDuJeu :: Frame).Visible) or menuOuvert or joueur:GetAttribute("EnTuto")
			if maintenantDedans and not dedans and not menuOuvertAilleurs then
				montrerBanniere()
			end
			dedans = maintenantDedans
		end
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX11"><Properties><string name="Name">Graphismes</string><ProtectedString name="Source"><![CDATA[--[[
	Graphismes  (LocalScript)
	À placer dans : StarterPlayer > StarterPlayerScripts   — nom conseillé : Graphismes

	Adapte les graphismes à l'appareil, pour que le jeu reste FLUIDE partout
	(la majorité des joueurs Roblox sont sur téléphone : un jeu qui rame, ils partent) :
	  • PC / console / graphismes élevés : rendu complet (ombres, profondeur de champ,
	    rayons du soleil, flou de vitesse)
	  • Téléphone / graphismes bas : mode LÉGER (pas d'ombres des lampes, pas de flou,
	    moins de particules) — l'image reste belle, mais tourne bien mieux
	Ça se réajuste tout seul si le joueur change ses réglages graphiques Roblox.
]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local joueur = Players.LocalPlayer
local reglagesRoblox = UserSettings():GetService("UserGameSettings")

local function modeLeger(): boolean
	local telephone = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	local niveau = reglagesRoblox.SavedQualityLevel.Value -- 0 = automatique, 1 à 10 sinon
	if niveau == 0 then
		return telephone
	end
	return niveau <= 4
end

local debitsParticules: { [ParticleEmitter]: number } = {}

local function appliquer()
	local leger = modeLeger()
	joueur:SetAttribute("GraphismesLegers", leger)
	for _, nom in ipairs({ "ProfondeurMallDrift", "RayonsMallDrift" }) do
		local e = Lighting:FindFirstChild(nom)
		if e and e:IsA("PostEffect") then
			e.Enabled = not leger
		end
	end
	local halo = Lighting:FindFirstChild("HaloMallDrift")
	if halo and halo:IsA("BloomEffect") then
		halo.Size = if leger then 14 else 28
	end
	local carte = workspace:FindFirstChild("GoldenMall")
	if not carte then
		return
	end
	for _, d in ipairs(carte:GetDescendants()) do
		if d:IsA("SpotLight") or d:IsA("PointLight") then
			if leger then
				d.Shadows = false
			end
		elseif d:IsA("SurfaceLight") then
			d.Enabled = not leger -- (les halos colorés des enseignes)
		elseif d:IsA("ParticleEmitter") then
			if not debitsParticules[d] then
				debitsParticules[d] = d.Rate
			end
			d.Rate = if leger then debitsParticules[d] * 0.5 else debitsParticules[d]
		end
	end
end

task.spawn(function()
	workspace:WaitForChild("GoldenMall", 30)
	task.wait(2) -- (le temps que la carte soit construite)
	appliquer()
end)
reglagesRoblox:GetPropertyChangedSignal("SavedQualityLevel"):Connect(appliquer)

---------------------------------------------------------------------
-- ✨ ENSEIGNES NÉON ANIMÉES (chez chaque joueur : fluide, sans charger le serveur)
--   1 enseigne sur 3 « respire », 1 sur 3 change doucement de couleur,
--   quelques-unes grésillent comme un vieux néon, et les vitrines lumineuses pulsent
---------------------------------------------------------------------
task.spawn(function()
	local carte = workspace:WaitForChild("GoldenMall", 30)
	if not carte then
		return
	end
	task.wait(3) -- (le temps que la carte soit construite)
	local enseignes: { { texte: TextLabel, mode: number, phase: number, couleur: Color3 } } = {}
	local fonds: { { part: BasePart, phase: number, base: number } } = {}
	local ballons: { { part: BasePart, phase: number, cf: CFrame } } = {}
	local hasard = Random.new(7)
	for _, d in ipairs(carte:GetDescendants()) do
		if d:IsA("TextLabel") and d.Parent and d.Parent:IsA("SurfaceGui") then
			local support = d.Parent.Parent
			if support and support:IsA("BasePart") and (support.Name == "Enseigne" or support.Name == "EnseigneExterieure") then
				local tirage = hasard:NextInteger(1, 10)
				local mode = if tirage <= 4 then 1 elseif tirage <= 8 then 2 else 3 -- 1 respire, 2 couleur, 3 grésille
				table.insert(enseignes, { texte = d, mode = mode, phase = hasard:NextNumber(0, 6), couleur = d.TextColor3 })
			end
		elseif d:IsA("BasePart") and d.Name == "FondLumineux" then
			table.insert(fonds, { part = d, phase = hasard:NextNumber(0, 6), base = d.Transparency })
		elseif d:IsA("BasePart") and d.Name == "Ballon" then
			table.insert(ballons, { part = d, phase = hasard:NextNumber(0, 6), cf = d.CFrame })
		end
	end
	while true do
		local leger = joueur:GetAttribute("GraphismesLegers") == true
		local t = os.clock()
		for _, e in ipairs(enseignes) do
			if e.mode == 1 then
				e.texte.TextTransparency = 0.25 * (0.5 + 0.5 * math.sin(t * 2 + e.phase))
			elseif e.mode == 2 then
				local h, sat, v = e.couleur:ToHSV()
				e.texte.TextColor3 = Color3.fromHSV((h + 0.08 * math.sin(t * 0.6 + e.phase)) % 1, math.max(sat, 0.5), math.max(v, 0.9))
			else
				-- Vieux néon qui grésille : il s'éteint brièvement de temps en temps
				local coupure = math.sin(t * 13 + e.phase) > 0.93 or math.sin(t * 7.3 + e.phase * 2) > 0.97
				e.texte.TextTransparency = if coupure then 0.85 else 0
			end
		end
		for _, f in ipairs(fonds) do
			f.part.Transparency = math.clamp(f.base + 0.15 * math.sin(t * 1.5 + f.phase), 0, 0.9)
		end
		-- Les ballons flottent et se balancent doucement
		for _, b in ipairs(ballons) do
			b.part.CFrame = b.cf * CFrame.new(0, 0.35 * math.sin(t * 1.3 + b.phase), 0) * CFrame.Angles(0.06 * math.sin(t * 0.9 + b.phase), 0, 0.06 * math.cos(t * 1.1 + b.phase))
		end
		task.wait(if leger then 0.15 else 0.05) -- (moins souvent sur téléphone)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX12"><Properties><string name="Name">KartController</string><ProtectedString name="Source"><![CDATA[--[[
	KartController  (LocalScript)
	À placer dans : StarterPlayer > StarterPlayerScripts   — nom conseillé : KartController

	Gère tout ce que le joueur ressent quand il conduit :
	  • la conduite et le DRIFT (glisse, 360°)
	  • le SCORE de drift : plus il est long et beau, plus il rapporte (avec étoiles ★)
	  • le SOL MOUILLÉ : ça glisse énormément + éclaboussures sur l'écran
	  • la caméra 1re personne (V), jour/nuit (N), remettre le kart droit (R)

	Commandes :
	  Avancer / reculer / tourner : flèches, ZQSD (ou WASD), manette, joystick mobile
	  Drift : Maj (Shift) — gâchette R2/L2 — bouton DRIFT sur mobile
	  Descendre du kart : Espace (saut)
	Les points de drift deviennent de l'XP : en montant de niveau, on débloque
	des karts, des couleurs et des décos au GARAGE VIP.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
local remotes = ReplicatedStorage:WaitForChild("MallDriftRemotes")
local TYPE_PLACE = Config.TypeDePlace() -- rôle de cette place (lobby, entraînement…)

local joueur = Players.LocalPlayer
local camera = workspace.CurrentCamera
local controles = require(joueur:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()

---------------------------------------------------------------------
-- INTERFACE (créée par le code, rien à dessiner)
---------------------------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "MallDriftHUD"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = joueur:WaitForChild("PlayerGui")

local function label(nom: string, parent: Instance, taille: UDim2, position: UDim2, texteTaille: number?): TextLabel
	local l = Instance.new("TextLabel")
	l.Name = nom
	l.Size = taille
	l.Position = position
	l.BackgroundTransparency = 1
	l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.FredokaOne
	l.TextScaled = texteTaille == nil
	if texteTaille then
		l.TextSize = texteTaille
	end
	l.Text = ""
	local contour = Instance.new("UIStroke")
	contour.Thickness = 2
	contour.Color = Color3.fromRGB(20, 20, 30)
	contour.Parent = l
	l.Parent = parent
	return l
end

-- Lignes de vitesse sur les bords de l'écran (quand on va vite / en boost)
local lignesVitesse = Instance.new("Frame")
lignesVitesse.Name = "LignesVitesse"
lignesVitesse.Size = UDim2.fromScale(1, 1)
lignesVitesse.BackgroundTransparency = 1
lignesVitesse.ZIndex = 1
lignesVitesse.Parent = gui
local lignes = {}
do
	local alea = Random.new(7)
	for i = 1, 28 do
		local angle = (i / 28) * math.pi * 2 + alea:NextNumber(-0.08, 0.08)
		local l = Instance.new("Frame")
		l.AnchorPoint = Vector2.new(0.5, 0.5)
		l.BackgroundColor3 = Color3.new(1, 1, 1)
		l.BorderSizePixel = 0
		l.Rotation = math.deg(angle)
		l.BackgroundTransparency = 1
		l.Parent = lignesVitesse
		local degradeLigne = Instance.new("UIGradient")
		degradeLigne.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
		degradeLigne.Parent = l
		table.insert(lignes, { cadre = l, angle = angle, phase = alea:NextNumber(0, 1), vitesse = alea:NextNumber(1.5, 3) })
	end
end
local function majLignesVitesse(force: number, dt: number)
	lignesVitesse.Visible = force > 0.02
	if not lignesVitesse.Visible then
		return
	end
	for _, l in ipairs(lignes) do
		l.phase = (l.phase + dt * l.vitesse * (0.6 + force)) % 1
		local rayon = 0.42 + l.phase * 0.35
		local cadre = l.cadre
		cadre.Position = UDim2.fromScale(0.5 + math.cos(l.angle) * rayon * 0.75, 0.5 + math.sin(l.angle) * rayon)
		cadre.Size = UDim2.new(0, 60 + 160 * force, 0, 2)
		cadre.BackgroundTransparency = 1 - force * 0.55 * math.sin(l.phase * math.pi)
	end
end

-- Flash orange au déclenchement du boost
local flashBoost = Instance.new("Frame")
flashBoost.Name = "FlashBoost"
flashBoost.Size = UDim2.fromScale(1, 1)
flashBoost.BackgroundColor3 = Color3.fromRGB(255, 180, 80)
flashBoost.BackgroundTransparency = 1
flashBoost.BorderSizePixel = 0
flashBoost.ZIndex = 2
flashBoost.Parent = gui

-- Flou de vitesse (léger, surtout pendant le boost)
local flouVitesse = Instance.new("BlurEffect")
flouVitesse.Name = "FlouVitesse"
flouVitesse.Size = 0
flouVitesse.Parent = camera

-- Écran des éclaboussures (en dessous du reste)
local ecranEau = Instance.new("Frame")
ecranEau.Name = "Eclaboussures"
ecranEau.Size = UDim2.fromScale(1, 1)
ecranEau.BackgroundTransparency = 1
ecranEau.ZIndex = 1
ecranEau.Parent = gui

local hud = Instance.new("Frame")
hud.Name = "HUD"
hud.Size = UDim2.fromScale(1, 1)
hud.BackgroundTransparency = 1
hud.ZIndex = 5
hud.Visible = false
hud.Parent = gui

-- Niveau du joueur + barre d'XP (toujours visible, en haut à gauche)
local blocNiveau = Instance.new("Frame")
blocNiveau.Name = "NiveauJoueur"
blocNiveau.Size = UDim2.new(0, 300, 0, 64)
blocNiveau.Position = UDim2.new(0, 16, 0, 56)
blocNiveau.BackgroundTransparency = 1
blocNiveau.ZIndex = 5
blocNiveau.Parent = gui
local niveauLabel = label("Niveau", blocNiveau, UDim2.new(1, 0, 0, 28), UDim2.new(0, 0, 0, 0))
niveauLabel.TextXAlignment = Enum.TextXAlignment.Left
niveauLabel.TextColor3 = Color3.fromRGB(255, 215, 80)
niveauLabel.Text = "NIV. 1"
local fondBarre = Instance.new("Frame")
fondBarre.Size = UDim2.new(1, 0, 0, 12)
fondBarre.Position = UDim2.new(0, 0, 0, 32)
fondBarre.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
fondBarre.BackgroundTransparency = 0.3
fondBarre.Parent = blocNiveau
Instance.new("UICorner", fondBarre).CornerRadius = UDim.new(0.5, 0)
local barreXP = Instance.new("Frame")
barreXP.Size = UDim2.fromScale(0, 1)
barreXP.BackgroundColor3 = Color3.fromRGB(255, 200, 50)
barreXP.Parent = fondBarre
Instance.new("UICorner", barreXP).CornerRadius = UDim.new(0.5, 0)
local xpLabel = label("XP", blocNiveau, UDim2.new(1, 0, 0, 16), UDim2.new(0, 0, 0, 47))
xpLabel.TextXAlignment = Enum.TextXAlignment.Left
xpLabel.TextTransparency = 0.2
-- Les pièces 💰 (la monnaie du jeu)
local piecesLabel = label("Pieces", blocNiveau, UDim2.new(1, 0, 0, 24), UDim2.new(0, 0, 0, 68))
piecesLabel.TextXAlignment = Enum.TextXAlignment.Left
piecesLabel.TextColor3 = Color3.fromRGB(255, 220, 90)
piecesLabel.Text = "💰 0"

local scoreLabel = label("Score", hud, UDim2.new(0, 250, 0, 40), UDim2.new(1, -266, 0, 56)) -- (étroit : ne touche pas le chrono)
scoreLabel.TextXAlignment = Enum.TextXAlignment.Right
local meilleurLabel = label("Meilleur", hud, UDim2.new(0, 250, 0, 22), UDim2.new(1, -266, 0, 98))
meilleurLabel.TextXAlignment = Enum.TextXAlignment.Right
meilleurLabel.TextColor3 = Color3.fromRGB(255, 215, 80)

local vitesseLabel = label("Vitesse", hud, UDim2.new(0, 220, 0, 48), UDim2.new(0, 16, 1, -120))
vitesseLabel.TextXAlignment = Enum.TextXAlignment.Left

local aide = label("Aide", hud, UDim2.new(1, -32, 0, 18), UDim2.new(0, 16, 1, -30))
aide.TextXAlignment = Enum.TextXAlignment.Left
aide.TextTransparency = 0.25
aide.Text = "Maj : drift  ·  V : caméra  ·  R : redresser  ·  P : photo  ·  MENU en haut à droite"

-- Le compteur de drift (au centre, en bas)
local blocDrift = Instance.new("Frame")
blocDrift.Name = "Drift"
blocDrift.AnchorPoint = Vector2.new(0.5, 1)
blocDrift.Size = UDim2.new(0, 360, 0, 130)
blocDrift.Position = UDim2.new(0.5, 0, 1, -70)
blocDrift.BackgroundTransparency = 1
blocDrift.Visible = false
blocDrift.Parent = hud
local etoilesLabel = label("Etoiles", blocDrift, UDim2.new(1, 0, 0, 40), UDim2.new(0, 0, 0, 0))
etoilesLabel.TextColor3 = Color3.fromRGB(255, 210, 40)
local pointsLabel = label("Points", blocDrift, UDim2.new(1, 0, 0, 56), UDim2.new(0, 0, 0, 40))
local comboLabel = label("Combo", blocDrift, UDim2.new(1, 0, 0, 28), UDim2.new(0, 0, 0, 98))
comboLabel.TextColor3 = Color3.fromRGB(120, 220, 255)

-- Messages qui apparaissent au milieu (« SUPER DRIFT ★★ », « 360° ! »…)
local emplacementsMessages: { [number]: TextLabel } = {} -- 3 lignes, l'une sous l'autre
local function message(texte: string, couleur: Color3?, duree: number?)
	-- Première ligne libre ; si les 3 sont prises, la 1re est remplacée : jamais deux textes l'un sur l'autre
	local ligne = nil
	for i = 1, 3 do
		local occupe = emplacementsMessages[i]
		if not (occupe and occupe.Parent) then
			ligne = i
			break
		end
	end
	if not ligne then
		ligne = 1
		emplacementsMessages[1]:Destroy()
	end
	local m = label("Message", gui, UDim2.new(0, 600, 0, 46), UDim2.new(0.5, -300, 0.3, (ligne - 1) * 50)) -- (sous les feux et la carte du tuto)
	emplacementsMessages[ligne] = m
	m.Text = texte
	m.TextColor3 = couleur or Color3.new(1, 1, 1)
	m.ZIndex = 10
	local echelle = Instance.new("UIScale")
	echelle.Scale = 0.4
	echelle.Parent = m
	TweenService:Create(echelle, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(duree or 1.4, function()
		local info = TweenInfo.new(0.4)
		TweenService:Create(m, info, { TextTransparency = 1, Position = m.Position - UDim2.fromOffset(0, 30) }):Play()
		local contour = m:FindFirstChildOfClass("UIStroke")
		if contour then
			TweenService:Create(contour, info, { Transparency = 1 }):Play()
		end
		task.wait(0.45)
		m:Destroy()
	end)
end

---------------------------------------------------------------------
-- ÉCLABOUSSURES SUR L'ÉCRAN
---------------------------------------------------------------------
local function goutte()
	local taille = math.random(50, 170)
	local g = Instance.new("Frame")
	g.Size = UDim2.fromOffset(taille, taille)
	g.Position = UDim2.new(math.random(), -taille / 2, math.random() * 0.85, -taille / 2)
	g.BackgroundColor3 = Color3.fromRGB(190, 225, 255)
	g.BackgroundTransparency = 0.55
	g.ZIndex = 2
	local coin = Instance.new("UICorner")
	coin.CornerRadius = UDim.new(0.5, 0)
	coin.Parent = g
	local bord = Instance.new("UIStroke")
	bord.Color = Color3.new(1, 1, 1)
	bord.Thickness = 2
	bord.Transparency = 0.35
	bord.Parent = g
	-- petit reflet de lumière dans la goutte
	local reflet = Instance.new("Frame")
	reflet.Size = UDim2.fromScale(0.25, 0.25)
	reflet.Position = UDim2.fromScale(0.2, 0.18)
	reflet.BackgroundColor3 = Color3.new(1, 1, 1)
	reflet.BackgroundTransparency = 0.3
	reflet.ZIndex = 3
	local coin2 = Instance.new("UICorner")
	coin2.CornerRadius = UDim.new(0.5, 0)
	coin2.Parent = reflet
	reflet.Parent = g
	g.Parent = ecranEau

	-- la goutte coule vers le bas puis disparaît
	local duree = math.random(12, 22) / 10
	local info = TweenInfo.new(duree, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(g, info, { BackgroundTransparency = 1, Position = g.Position + UDim2.fromScale(0, 0.08) }):Play()
	TweenService:Create(bord, info, { Transparency = 1 }):Play()
	TweenService:Create(reflet, info, { BackgroundTransparency = 1 }):Play()
	task.delay(duree + 0.1, function()
		g:Destroy()
	end)
end

local function grosseEclaboussure()
	-- flash bleuté + plein de gouttes
	local flash = Instance.new("Frame")
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = Color3.fromRGB(170, 215, 255)
	flash.BackgroundTransparency = 0.6
	flash.ZIndex = 1
	flash.Parent = ecranEau
	TweenService:Create(flash, TweenInfo.new(0.35), { BackgroundTransparency = 1 }):Play()
	task.delay(0.4, function()
		flash:Destroy()
	end)
	for _ = 1, math.random(7, 11) do
		goutte()
	end
end

---------------------------------------------------------------------
-- ÉTAT DU JEU
---------------------------------------------------------------------
local kart = nil -- { modele, chassis, stats, trails, fumees, eaux, sons }
local driftAppuye = false
local driftAppuyeAvant = false
local vitesseRotation = 0
local tempsBoost = 0
local poussee = 0 -- vitesse ajoutée d'un coup quand le boost se déclenche
local volantLisse = 0 -- le volant monte en douceur (au clavier, sinon le kart braque d'un coup)
local driftSens = 0 -- sens du drift en cours (-1 / 1), verrouillé jusqu'à la fin du drift
local driftDebut = 0 -- moment où le drift a commencé (pour une entrée progressive)
local secousseImpact = 0 -- secousse de caméra (choc, boost), qui retombe toute seule
local vitessePrecCam = 0
local accelLisse = 0
local forceBoost = 1 -- puissance du boost en cours (selon les étoiles du drift)
local derniereVitesse = 0
local etaitMouille = false
local prochaineGoutte = 0
local nuit = Lighting:GetAttribute("Nuit")
if nuit == nil then
	nuit = Config.NuitParDefaut
end

local scoreTotal, meilleurDrift = 0, 0
local drift = { actif = false, points = 0, temps = 0, rotation = 0, horsDrift = 0, combo = 1, nb360 = 0 }

local parametresRayon = RaycastParams.new()
parametresRayon.FilterType = Enum.RaycastFilterType.Exclude

local function nombreEtoiles(points: number): number
	local n = 0
	for i, seuil in ipairs(Config.Score.Etoiles) do
		if points >= seuil then
			n = i
		end
	end
	return n
end

local function texteEtoiles(n: number): string
	return string.rep("★", n) .. string.rep("☆", #Config.Score.Etoiles - n)
end

local function majScore()
	scoreLabel.Text = ("SCORE  %d"):format(scoreTotal)
	meilleurLabel.Text = ("RECORD  %d"):format(meilleurDrift)
end
majScore()

-- Profil envoyé par le serveur (niveau, XP, record)
local function afficherProfil(profil, niveauGagne: number?)
	if type(profil) ~= "table" then
		return
	end
	niveauLabel.Text = ("NIV. %d"):format(profil.Niveau)
	local avant = tonumber((piecesLabel.Text:gsub("[^%d]", ""))) or 0
	piecesLabel.Text = ("💰 %d"):format(profil.Pieces or 0)
	if (profil.Pieces or 0) > avant then
		-- petite animation quand on gagne des pièces
		local echelle = piecesLabel:FindFirstChildOfClass("UIScale") or Instance.new("UIScale")
		echelle.Parent = piecesLabel
		echelle.Scale = 1.3
		TweenService:Create(echelle, TweenInfo.new(0.3, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end
	local pleinNiveau = profil.Niveau >= Config.NiveauMax
	xpLabel.Text = if pleinNiveau then "NIVEAU MAX !" else ("%d / %d XP"):format(profil.XPDansNiveau, profil.XPRequis)
	local ratio = if pleinNiveau then 1 else math.clamp(profil.XPDansNiveau / profil.XPRequis, 0, 1)
	TweenService:Create(barreXP, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(ratio, 1) }):Play()
	meilleurDrift = math.max(meilleurDrift, profil.Record or 0)
	majScore()
	if niveauGagne then
		message(("NIVEAU %d ! 🎉"):format(niveauGagne), Color3.fromRGB(255, 215, 80), 2.5)
		task.delay(0.8, function()
			message("Nouveautés au GARAGE VIP !", Color3.fromRGB(200, 150, 255), 2)
		end)
	end
end
remotes:WaitForChild("ProfilMisAJour").OnClientEvent:Connect(afficherProfil)
task.spawn(function()
	afficherProfil(remotes:WaitForChild("ObtenirProfil"):InvokeServer())
	-- (au lobby, c'est le menu qui accueille le joueur : pas de conseils en plus)
end)

local function vers(valeur: number, cible: number, pas: number): number
	if valeur < cible then
		return math.min(valeur + pas, cible)
	end
	return math.max(valeur - pas, cible)
end

---------------------------------------------------------------------
-- DRIFT : début / fin / score
---------------------------------------------------------------------
local function terminerDrift(reussi: boolean)
	local points = math.floor(drift.points)
	if reussi and points >= Config.Score.Minimum then
		local etoiles = nombreEtoiles(points)
		scoreTotal += points
		if points > meilleurDrift then
			meilleurDrift = points
		end
		remotes.DriftTermine:FireServer(points) -- le serveur transforme les points en XP
		local titres = { [0] = "PETIT DRIFT", "JOLI DRIFT", "SUPER DRIFT", "DRIFT DE LÉGENDE" }
		local couleurs = { [0] = Color3.new(1, 1, 1), Color3.fromRGB(150, 230, 255), Color3.fromRGB(255, 215, 60), Color3.fromRGB(255, 120, 220) }
		local titre = titres[math.min(etoiles, 3)]
		message(("%s %s  +%d"):format(titre, etoiles > 0 and texteEtoiles(etoiles) or "", points), couleurs[math.min(etoiles, 3)], 1.8)
		-- Un beau drift = un BOOST (plus il y a d'étoiles, plus il est fort)
		-- BOOST PROGRESSIF : plus le drift est puissant, plus le boost est long et fort
		local bp = Config.Score.BoostProgressif or {}
		local puissance = math.clamp(points / Config.Score.Etoiles[3], 0.05, bp.PuissanceMax or 2)
		local reglageBoost = {
			Duree = (bp.DureeMin or 0.5) + (bp.DureeParPuissance or 1.9) * puissance,
			Force = (bp.ForceMin or 0.4) + (bp.ForceParPuissance or 1) * puissance,
		}
		if reglageBoost then
			-- La police te poursuit ? Boost d'évasion !
			local poursuivi = joueur:GetAttribute("Poursuivi") == true or joueur:GetAttribute("Role") == "Fugitif"
			local multiplicateur = if poursuivi then (Config.Score.BoostEvasion or 1.5) else 1
			tempsBoost = reglageBoost.Duree * (if poursuivi then 1.2 else 1)
			poussee = (bp.PousseeMin or 4) + (bp.PousseeParPuissance or 10) * puissance -- (coup de pied, selon la puissance)
			-- Flammes et lumière plus grosses avec un boost puissant
			local taille = 0.6 + 0.6 * puissance
			for _, f in ipairs(kart.flammes or {}) do
				(f :: ParticleEmitter).Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, taille), NumberSequenceKeypoint.new(1, 0.1) })
			end
			for _, l in ipairs(kart.lumieresBoost or {}) do
				(l :: PointLight).Brightness = 2 + 2 * puissance
			end
			secousseImpact = math.max(secousseImpact, 0.2 + 0.2 * puissance) -- (secousse selon la puissance)
			-- FLASH : l'écran s'illumine d'un coup, puis s'efface
			flashBoost.BackgroundTransparency = math.clamp(0.88 - 0.1 * puissance, 0.68, 0.88)
			TweenService:Create(flashBoost, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { BackgroundTransparency = 1 }):Play()
			flouVitesse.Size = 6 + 3 * puissance -- (coup de flou, qui retombe tout seul)
			camera.FieldOfView += 3 + 3 * puissance -- (le champ de vision « claque »)
			joueur:SetAttribute("TutoBoost", os.clock()) -- (pour le tuto)
			forceBoost = reglageBoost.Force * multiplicateur
			message(if poursuivi then ("🚨 BOOST D'ÉVASION x%.1f !"):format(forceBoost) else ("BOOST x%.1f %s"):format(forceBoost, string.rep("🔥", math.clamp(math.ceil(puissance * 1.5), 1, 3))),
				if poursuivi then Color3.fromRGB(255, 140, 60) else Color3.fromRGB(120, 255, 140), 0.9)
		end
		majScore()
	elseif not reussi and points > 0 then
		message(("OUPS ! DRIFT PERDU  -%d"):format(points), Color3.fromRGB(255, 90, 90), 1.4)
	end
	drift.actif = false
	drift.points, drift.temps, drift.rotation, drift.horsDrift, drift.combo, drift.nb360 = 0, 0, 0, 0, 1, 0
	blocDrift.Visible = false
	joueur:SetAttribute("TutoDriftPoints", 0)
end

---------------------------------------------------------------------
-- ENTRER / SORTIR DU KART
---------------------------------------------------------------------
local function effets(nomEffet: string): { Instance }
	local liste = {}
	for _, d in ipairs(kart.chassis:GetDescendants()) do
		if d.Name == nomEffet then
			table.insert(liste, d)
		end
	end
	return liste
end

local function creerSon(id: string, boucle: boolean): Sound?
	if id == "" then
		return nil
	end
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Looped = boucle
	s.Volume = 0.5
	s.Parent = kart.chassis
	return s
end

local function actionDrift(_, etat: Enum.UserInputState)
	driftAppuye = etat == Enum.UserInputState.Begin
	return Enum.ContextActionResult.Sink
end

---------------------------------------------------------------------
-- CAMÉRA AUTOMATIQUE : elle se place toute seule derrière le kart
-- et tourne avec lui (plus besoin du clic droit).
-- V = alterner entre la « GoPro » (sur la poitrine du pilote, comme les
-- vidéos TikTok) et la vue « derrière le kart »
---------------------------------------------------------------------
local modeCamera = Config.Camera.VueParDefaut or "gopro" -- "gopro" ou "derriere"

-- Séquence de départ : survol de la map (~3 s), la caméra plonge derrière ton
-- kart sur la ligne de départ, puis feux 3, 2, 1, PARTEZ !
local DUREE_SURVOL = 3
local DUREE_PLONGEE = 0.9
local DUREE_ANIM_DEPART = DUREE_SURVOL + DUREE_PLONGEE
-- Les survols possibles (un au hasard à chaque départ) : de -> vers, en regardant "cible"
local SURVOLS = {
	{ nom = "LA FONTAINE", de = Vector3.new(-34, 13, -62), vers = Vector3.new(32, 9, -22), cible = Vector3.new(0, 6, 0) },
	{ nom = "L'AQUARIUM GÉANT", de = Vector3.new(-45, 10, -137), vers = Vector3.new(45, 10, -137), cible = Vector3.new(0, 9, -158) },
	{ nom = "LES BOUTIQUES", de = Vector3.new(-195, 8, 0), vers = Vector3.new(-90, 6, 0), cible = Vector3.new(-40, 4, 0) },
	{ nom = "LE FOOD COURT", de = Vector3.new(-118, 11, 30), vers = Vector3.new(-150, 8, 108), cible = Vector3.new(-136, 3, 72) },
	{ nom = "LES SOLDES", de = Vector3.new(190, 9, -8), vers = Vector3.new(95, 6, 6), cible = Vector3.new(40, 4, 0) },
}
type Depart = { debut: number, etape: number, survol: { [string]: any }, finSurvol: CFrame?, court: boolean }
local depart: Depart? = nil
local departsJoues: { [Instance]: boolean } = {}
local dernierRestePolice = -1

