-- Place Drift Battle : le défi démarre dès qu'on arrive
if TYPE == "DriftBattle" then
	local function arrivee(joueur: Player)
		task.spawn(function()
			local debut = os.clock()
			while not joueur.Character and os.clock() - debut < 15 do
				task.wait(0.3)
			end
			task.wait(2.5) -- le temps que le profil du joueur soit chargé
			if joueur.Parent then
				lancerBattle(joueur)
			end
		end)
	end
	Players.PlayerAdded:Connect(arrivee)
	for _, j in ipairs(Players:GetPlayers()) do
		arrivee(j)
	end
end

-- Place Police contre Fugitifs : tous les arrivants jouent, on attend le groupe
local attendus = 1
local premiereArrivee: number? = nil
if TYPE == "PoliceFugitifs" then
	local function arrivee(joueur: Player)
		joueur:SetAttribute("Pret", true)
		premiereArrivee = premiereArrivee or os.clock()
		local donnees = joueur:GetJoinData().TeleportData
		if type(donnees) == "table" and type(donnees.attendus) == "number" then
			attendus = math.max(attendus, donnees.attendus)
		end
	end
	Players.PlayerAdded:Connect(arrivee)
	for _, j in ipairs(Players:GetPlayers()) do
		arrivee(j)
	end
end

-- Les manches ne tournent que dans la place « tout en un » et la place Police contre Fugitifs
if TYPE ~= "ToutEnUn" and TYPE ~= "PoliceFugitifs" then
	print(("[Golden Mall] Place « %s » : pas de manches ici."):format(TYPE))
	return
end

task.spawn(function()
	-- Place Police contre Fugitifs : on attend que tout le groupe soit arrivé (15 s max)
	if TYPE == "PoliceFugitifs" then
		while not premiereArrivee do
			task.wait(0.5)
		end
		while #Players:GetPlayers() < attendus and os.clock() - (premiereArrivee :: number) < 15 do
			task.wait(0.5)
		end
	end
	while true do
		-- Attente : chacun est libre (entraînement, garage...)
		while not modeDisponible() do
			for _, j in ipairs(Players:GetPlayers()) do
				mettreEnSalle(j, false)
			end
			envoyerATous({ type = "etat", etat = "attente", joueurs = #joueursPrets("Pret"), min = JOUEURS_MIN })
			task.wait(1)
		end
		local mode = modeDisponible()
		local attribut = "Pret"

		-- Page d'attente : seuls les joueurs de la file vont dessus
		local annule = false
		for t = INTERMISSION, 1, -1 do
			if modeDisponible() ~= mode then
				annule = true
				break
			end
			for _, j in ipairs(Players:GetPlayers()) do
				mettreEnSalle(j, j:GetAttribute(attribut) == true)
			end
			envoyerATous({ type = "etat", etat = "intermission", temps = t, mode = mode, bots = botsNecessaires() })
			task.wait(1)
		end
		if annule then
			for _, j in ipairs(Players:GetPlayers()) do
				mettreEnSalle(j, false)
			end
		else
			local participants: { Participant } = {}
			for _, j in ipairs(joueursPrets("Pret")) do
				table.insert(participants, { nom = j.DisplayName, joueur = j, bot = nil, role = nil, arrete = false })
				mettreEnSalle(j, true)
			end
			for k = 1, botsNecessaires() do
				table.insert(participants, { nom = NOMS_BOTS[(k - 1) % #NOMS_BOTS + 1], joueur = nil, bot = nil, role = nil, arrete = false })
			end
			local ok, erreur = pcall(jouerManche, participants)
			if not ok then
				warn("[Manches] " .. tostring(erreur))
				workspace:SetAttribute("MancheEnCours", false)
				fermerEntree(false)
				dossierBots:ClearAllChildren()
				scoresDrift = {}
				for _, j in ipairs(Players:GetPlayers()) do
					remettreAZero(j)
					mettreEnSalle(j, false)
				end
			end
		end
	end
end)

print(("[Golden Mall] Modes prêts : Police contre Fugitifs en ligne (bots de test : %d) et Drift Battle solo."):format(BOTS_TEST))
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX5"><Properties><string name="Name">MatchmakingServer</string><ProtectedString name="Source"><![CDATA[--[[
	MatchmakingServer  (Script)
	À placer dans : ServerScriptService   — nom conseillé : MatchmakingServer

	LE MATCHMAKING ENTRE LES PLACES DE L'EXPÉRIENCE
	  • Dans le LOBBY (place de départ, publique) :
	      - 🏁 Entraînement : on part tout de suite vers la place Entraînement
	      - 🔥 Drift Battle : on part tout de suite vers la place Drift Battle
	      - 🌐 Police contre Fugitifs : on entre dans une FILE D'ATTENTE. Dès qu'il y
	        a assez de joueurs (ou avec les bots de test), le matchmaking crée un
	        serveur privé et y envoie le groupe (jusqu'à 20 joueurs) ENSEMBLE.
	  • Dans les PLACES DE JEU : le bouton « Retour au lobby ».
	Rien ne se passe en mode « ToutEnUn » (KartConfig > Config.Places pas rempli).
	Les téléportations ne marchent que dans le jeu publié (pas dans Studio).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
local remotes = ReplicatedStorage:WaitForChild("MallDriftRemotes")

local TYPE = Config.TypeDePlace()
local P = Config.Partie or {}
local JOUEURS_MIN = P.JoueursMin or 2
local MAX_PAR_PARTIE = 20
local ATTENTE_BOTS = 8 -- seul dans la file avec les bots de test : départ au bout de 8 s

local Voyage = Instance.new("RemoteEvent")
Voyage.Name = "Voyage"
Voyage.Parent = remotes

if TYPE == "ToutEnUn" then
	return -- tout se joue dans cette place : pas de téléportation
end

---------------------------------------------------------------------
-- Téléporter des joueurs vers une place
---------------------------------------------------------------------
local function teleporter(joueurs: { Player }, placeId: number, donnees: { [string]: any }, codeServeurPrive: string?): boolean
	if placeId == 0 or #joueurs == 0 then
		return false
	end
	local options = Instance.new("TeleportOptions")
	if codeServeurPrive then
		options.ReservedServerAccessCode = codeServeurPrive
	end
	options:SetTeleportData(donnees)
	local ok, erreur = pcall(function()
		TeleportService:TeleportAsync(placeId, joueurs, options)
	end)
	if not ok then
		warn("[Matchmaking] Téléportation impossible : " .. tostring(erreur))
		for _, j in ipairs(joueurs) do
			Voyage:FireClient(j, { type = "erreur", texte = "Impossible de rejoindre la partie. Réessaie !" })
		end
	end
	return ok
end

TeleportService.TeleportInitFailed:Connect(function(joueur: Player)
	joueur:SetAttribute("Pret", false)
	Voyage:FireClient(joueur, { type = "erreur", texte = "Le voyage a échoué. Réessaie !" })
end)

---------------------------------------------------------------------
-- Dans une PLACE DE JEU : retour au lobby
---------------------------------------------------------------------
if TYPE ~= "Lobby" then
	Voyage.OnServerEvent:Connect(function(joueur: Player, info)
		if type(info) ~= "table" then
			return
		end
		if info.mode == "Lobby" then
			Voyage:FireClient(joueur, { type = "depart", texte = "Retour au lobby…" })
			teleporter({ joueur }, Config.Places.Lobby, { ouvrirMenu = true })
		elseif (info.mode == "Entrainement" or info.mode == "DriftBattle") and info.mode ~= TYPE then
			-- Le menu d'accueil marche aussi ici : on part directement vers l'autre mode
			Voyage:FireClient(joueur, { type = "depart", texte = if info.mode == "Entrainement" then "Direction l'entraînement…" else "Direction le Drift Battle…" })
			teleporter({ joueur }, Config.Places[info.mode] or 0, { mode = info.mode, chrono = info.chrono == true })
		elseif info.mode == "PoliceFugitifs" then
			-- La file d'attente est au lobby : on y va, et on entre dans la file tout seul
			Voyage:FireClient(joueur, { type = "depart", texte = "Recherche d'une partie en ligne…" })
			teleporter({ joueur }, Config.Places.Lobby, { fileAuto = true })
		end
	end)
	print(("[Matchmaking] Place de jeu « %s » : retour au lobby prêt."):format(TYPE))
	return
end

---------------------------------------------------------------------
-- Dans le LOBBY : départs directs + file d'attente Police contre Fugitifs
---------------------------------------------------------------------
local file: { Player } = {}
local entreeDansLaFile: { [Player]: number } = {}

local function retirerDeLaFile(joueur: Player)
	for i, j in ipairs(file) do
		if j == joueur then
			table.remove(file, i)
			break
		end
	end
	entreeDansLaFile[joueur] = nil
	joueur:SetAttribute("Pret", false)
end

Voyage.OnServerEvent:Connect(function(joueur: Player, info)
	if type(info) ~= "table" then
		return
	end
	if info.mode == "Entrainement" or info.mode == "DriftBattle" then
		retirerDeLaFile(joueur)
		Voyage:FireClient(joueur, { type = "depart", texte = if info.mode == "Entrainement" then "Direction l'entraînement…" else "Direction le Drift Battle…" })
		teleporter({ joueur }, Config.Places[info.mode], { mode = info.mode, chrono = info.chrono == true })
	elseif info.mode == "PoliceFugitifs" then
		if joueur:GetAttribute("Pret") then
			retirerDeLaFile(joueur) -- (recliquer = quitter la file)
		else
			table.insert(file, joueur)
			entreeDansLaFile[joueur] = os.clock()
			joueur:SetAttribute("Pret", true)
		end
	end
end)

Players.PlayerRemoving:Connect(retirerDeLaFile)

task.spawn(function()
	while true do
		task.wait(1)
		-- On retire les joueurs partis
		for i = #file, 1, -1 do
			if not file[i].Parent then
				table.remove(file, i)
			end
		end
		-- Assez de monde ? (ou un joueur seul depuis 8 s, avec les bots de test)
		local plusAncien = file[1] and entreeDansLaFile[file[1]] or os.clock()
		-- (bots de test seulement dans Studio : en ligne, que des vraies personnes)
		local avecBots = game:GetService("RunService"):IsStudio() and (P.BotsTest or 0) > 0 and #file >= 1 and os.clock() - plusAncien >= ATTENTE_BOTS
		if #file >= JOUEURS_MIN or avecBots then
			local groupe = {}
			for i = 1, math.min(#file, MAX_PAR_PARTIE) do
				table.insert(groupe, file[i])
			end
			for _, j in ipairs(groupe) do
				retirerDeLaFile(j)
				Voyage:FireClient(j, { type = "depart", texte = ("🚓 Partie trouvée ! %d joueur%s, c'est parti…"):format(#groupe, if #groupe > 1 then "s" else "") })
			end
			local ok, code = pcall(function()
				return TeleportService:ReserveServer(Config.Places.PoliceFugitifs)
			end)
			if ok and code then
				teleporter(groupe, Config.Places.PoliceFugitifs, { mode = "PoliceFugitifs", attendus = #groupe }, code)
			else
				warn("[Matchmaking] Impossible de créer le serveur privé : " .. tostring(code))
				for _, j in ipairs(groupe) do
					Voyage:FireClient(j, { type = "erreur", texte = "Impossible de créer la partie. Réessaie !" })
				end
			end
		end
		Voyage:FireAllClients({ type = "file", n = #file, min = JOUEURS_MIN })
	end
end)

print("[Matchmaking] Lobby prêt : Entraînement, Drift Battle, file Police contre Fugitifs.")
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX6"><Properties><string name="Name">ModesServer</string><ProtectedString name="Source"><![CDATA[--[[
	ModesServer  (Script)
	À placer dans : ServerScriptService   — nom conseillé : ModesServer

	  ⏱ COURSE CHRONO : 3 tours du mall en passant par les portes lumineuses,
	    meilleur tour enregistré (classement mondial des meilleurs tours).
	  🏆 CLASSEMENT DE LA SEMAINE (Drift Battle) : chaque semaine repart à zéro.
	    Le top 10 de la semaine passée reçoit des pièces à sa prochaine connexion.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local DataStoreService = game:GetService("DataStoreService")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
local remotes = ReplicatedStorage:WaitForChild("MallDriftRemotes")
local TYPE = Config.TypeDePlace()
local C = Config.Chrono or {}
local SOL = 1

---------------------------------------------------------------------
-- Les données (classements)
---------------------------------------------------------------------
local function store(nom: string): OrderedDataStore?
	local ok, s = pcall(function()
		return DataStoreService:GetOrderedDataStore(nom)
	end)
	return if ok then s else nil
end
local function semaine(): number
	return os.time() // 604800
end
local function storeSemaine(n: number): OrderedDataStore?
	return store("DriftBattle_Semaine_" .. n)
end
local storeChrono = store("Chrono_MeilleurTour_v1") -- (en millisecondes : plus petit = mieux)
local paiements = (function()
	local ok, s = pcall(function()
		return DataStoreService:GetDataStore("Recompenses_Semaine_v1")
	end)
	return if ok then s else nil
end)()

local nomsCache: { [number]: string } = {}
local function nomDe(id: number): string
	if nomsCache[id] then
		return nomsCache[id]
	end
	local j = Players:GetPlayerByUserId(id)
	local nom = if j then j.DisplayName else nil
	if not nom then
		local ok, n = pcall(function()
			return Players:GetNameFromUserIdAsync(id)
		end)
		nom = if ok then n else ("Joueur " .. id)
	end
	nomsCache[id] = nom :: string
	return nom :: string
end

-- Le Drift Battle signale chaque score de fin de défi (ManchesServer)
local ScoreBattleSemaine = Instance.new("BindableEvent")
ScoreBattleSemaine.Name = "ScoreBattleSemaine"
ScoreBattleSemaine.Parent = ServerStorage
ScoreBattleSemaine.Event:Connect(function(joueur: Player, score: number)
	local s = storeSemaine(semaine())
	if not s or type(score) ~= "number" or score <= 0 then
		return
	end
	pcall(function()
		s:UpdateAsync(tostring(joueur.UserId), function(ancien)
			return math.max(tonumber(ancien) or 0, math.floor(score))
		end)
	end)
end)

-- Récompenses du top 10 de la semaine passée (versées à la connexion suivante)
local RECOMPENSES = C.RecompensesSemaine or { 5000, 3000, 2000, 1000, 1000, 1000, 1000, 1000, 1000, 1000 }
Players.PlayerAdded:Connect(function(joueur: Player)
	task.wait(6) -- (le temps que le profil soit chargé)
	local passee = semaine() - 1
	local s = storeSemaine(passee)
	if not s or not paiements or not joueur.Parent then
		return
	end
	local ok, page = pcall(function()
		return s:GetSortedAsync(false, 10):GetCurrentPage()
	end)
	if not ok then
		return
	end
	for rang, entree in ipairs(page) do
		if tonumber(entree.key) == joueur.UserId then
			local dejaPaye = false
			pcall(function()
				paiements:UpdateAsync("u_" .. joueur.UserId, function(ancien)
					if ancien == passee then
						dejaPaye = true
						return nil
					end
					return passee
				end)
			end)
			if not dejaPaye then
				local gain = RECOMPENSES[rang] or 0
				local donner = ServerStorage:FindFirstChild("AjouterPieces") :: BindableEvent?
				if donner and gain > 0 then
					donner:Fire(joueur, gain, ("🏆 %de DE LA SEMAINE ! +%d 💰"):format(rang, gain))
				end
			end
			break
		end
	end
end)

-- Le client demande les classements (page 🏆 du menu)
local Classements = Instance.new("RemoteFunction")
Classements.Name = "Classements"
Classements.Parent = remotes
local cache: { [string]: { temps: number, top: { any } } } = {}
local function top10(nom: string, s: OrderedDataStore?, croissant: boolean): { any }
	local c = cache[nom]
	if c and os.clock() - c.temps < 30 then
		return c.top
	end
	local liste = {}
	if s then
		pcall(function()
			for rang, entree in ipairs(s:GetSortedAsync(croissant, 10):GetCurrentPage()) do
				table.insert(liste, { rang = rang, nom = nomDe(tonumber(entree.key) or 0), score = entree.value, id = tonumber(entree.key) })
			end
		end)
	end
	cache[nom] = { temps = os.clock(), top = liste }
	return liste
end
Classements.OnServerInvoke = function(joueur: Player)
	local n = semaine()
	local s = storeSemaine(n)
	local monScore, monTour = 0, nil
	pcall(function()
		if s then
			monScore = s:GetAsync(tostring(joueur.UserId)) or 0
		end
		if storeChrono then
			monTour = storeChrono:GetAsync(tostring(joueur.UserId))
		end
	end)
	return {
		semaine = { top = top10("semaine" .. n, s, false), monScore = monScore, finDans = (n + 1) * 604800 - os.time(), recompenses = RECOMPENSES },
		chrono = { top = top10("chrono", storeChrono, true), monTour = monTour },
	}
end

---------------------------------------------------------------------
-- ⏱ LA COURSE CHRONO
---------------------------------------------------------------------
if TYPE == "Lobby" then
	return -- (au lobby, on ne roule pas : la course se lance dans la place Entraînement)
end

-- Les portes lumineuses, dans l'ordre (tour du mall par les allées)
local PORTES = C.Portes or {
	Vector3.new(60, 0, 137), Vector3.new(160, 0, 137), Vector3.new(173, 0, 40), Vector3.new(173, 0, -60),
	Vector3.new(120, 0, -137), Vector3.new(0, 0, -137), Vector3.new(-120, 0, -137), Vector3.new(-173, 0, -60),
	Vector3.new(-173, 0, 40), Vector3.new(-160, 0, 137), Vector3.new(-40, 0, 137),
}
local dossierPortes = Instance.new("Folder")
dossierPortes.Name = "ChronoPortes"
dossierPortes.Parent = workspace
local OR = Color3.fromRGB(255, 200, 60)
for i, pos in ipairs(PORTES) do
	local suivante = PORTES[i % #PORTES + 1]
	local sens = Vector3.new(suivante.X - pos.X, 0, suivante.Z - pos.Z).Unit
	local cf = CFrame.lookAt(pos + Vector3.new(0, SOL, 0), pos + Vector3.new(0, SOL, 0) + sens)
	local porte = Instance.new("Model")
	porte.Name = "Porte" .. i
	porte:SetAttribute("Ordre", i)
	local function piece(nom: string, taille: Vector3, decalage: CFrame)
		local p = Instance.new("Part")
		p.Name = nom
		p.Size = taille
		p.CFrame = cf * decalage
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Material = Enum.Material.Neon
		p.Color = OR
		p.Transparency = 1 -- (le client les montre seulement pendant une course)
		p.CastShadow = false
		p.Parent = porte
		return p
	end
	-- Une arche : deux piliers + une barre en haut (assez large pour passer en drift)
	piece("Pilier", Vector3.new(1, 12, 1), CFrame.new(-11, 6, 0))
	piece("Pilier", Vector3.new(1, 12, 1), CFrame.new(11, 6, 0))
	piece("Barre", Vector3.new(23, 1, 1), CFrame.new(0, 12, 0))
	porte.PrimaryPart = porte:FindFirstChild("Barre") :: BasePart
	porte.Parent = dossierPortes
end

local Chrono = Instance.new("RemoteEvent")
Chrono.Name = "Chrono"
Chrono.Parent = remotes
local PlacerKart = ServerStorage:WaitForChild("PlacerKart") :: BindableFunction
local RetirerKart = ServerStorage:WaitForChild("RetirerKart") :: BindableFunction
local AjouterXP = ServerStorage:WaitForChild("AjouterXP") :: BindableEvent
local TOURS = C.Tours or 3
local DUREE_MAX = C.DureeMax or 240
local TOUR_MIN = C.TourMinimum or 14 -- (un tour plus rapide que ça = triche)

local enCourse: { [Player]: { debut: number, tours: number, meilleur: number? } } = {}

local function finCourse(joueur: Player, abandon: boolean)
	local c = enCourse[joueur]
	if not c then
		return
	end
	enCourse[joueur] = nil
	if joueur.Parent then
		joueur:SetAttribute("Role", nil)
		RetirerKart:Invoke(joueur)
		local garage = workspace:FindFirstChild("GoldenMall") and workspace.GoldenMall:FindFirstChild("GarageVIP")
		local apparition = garage and garage:FindFirstChild("ApparitionGarage") :: BasePart?
		task.delay(0.2, function()
			if apparition and joueur.Character then
				joueur.Character:PivotTo(apparition.CFrame + Vector3.new(0, 4, 0))
			end
		end)
		local medaille = nil
		if not abandon then
			AjouterXP:Fire(joueur, 100 + c.tours * 40)
			-- Médaille selon le meilleur tour (et des pièces)
			for _, m in ipairs(C.Medailles or {}) do
				if c.meilleur and c.meilleur <= m.Temps * 1000 then
					medaille = m
					break
				end
			end
			local donner = ServerStorage:FindFirstChild("AjouterPieces") :: BindableEvent?
			if medaille and donner then
				donner:Fire(joueur, medaille.Pieces)
			end
		end
		Chrono:FireClient(joueur, { type = "fin", meilleur = c.meilleur, abandon = abandon, medaille = medaille and medaille.Nom or nil })
	end
end

Chrono.OnServerEvent:Connect(function(joueur: Player, action: any, valeur: any)
	if action == "lancer" then
		if enCourse[joueur] or joueur:GetAttribute("Role") ~= nil or joueur:GetAttribute("EnSalle") then
			return
		end
		joueur:SetAttribute("Pret", false)
		joueur:SetAttribute("Role", "Chrono")
		RetirerKart:Invoke(joueur)
		local kart = PlacerKart:Invoke(joueur, true, true) -- (3, 2, 1)
		-- Départ lancé : juste avant la ligne, face à la première porte
		local premiere = PORTES[1]
		local depart = Vector3.new(premiere.X - 55, SOL + 0.6, premiere.Z)
		local cfDepart = CFrame.lookAt(depart, Vector3.new(premiere.X, depart.Y, premiere.Z))
		if kart then
			task.wait(0.1)
			kart:PivotTo(cfDepart)
		end
		enCourse[joueur] = { debut = os.clock(), tours = 0, meilleur = nil }
		local record = nil
		pcall(function()
			if storeChrono then
				record = storeChrono:GetAsync(tostring(joueur.UserId))
			end
		end)
		Chrono:FireClient(joueur, { type = "debut", tours = TOURS, portes = #PORTES, record = record, depart = cfDepart })
		task.delay(DUREE_MAX, function()
			if enCourse[joueur] then
				finCourse(joueur, true)
			end
		end)
	elseif action == "tour" and type(valeur) == "number" then
		local c = enCourse[joueur]
		if not c or valeur ~= valeur or valeur < TOUR_MIN then
			return -- (temps impossible : ignoré)
		end
		c.tours += 1
		local ms = math.floor(valeur * 1000)
		if not c.meilleur or ms < c.meilleur then
			c.meilleur = ms
		end
		if storeChrono then
			pcall(function()
				storeChrono:UpdateAsync(tostring(joueur.UserId), function(ancien)
					local a = tonumber(ancien)
					return if a and a <= ms then nil else ms
				end)
			end)
		end
		if c.tours >= TOURS then
			finCourse(joueur, false)
		end
	elseif action == "quitter" then
		finCourse(joueur, true)
	end
end)
Players.PlayerRemoving:Connect(function(joueur)
	enCourse[joueur] = nil
end)

print("[Golden Mall] Course chrono et classement de la semaine prêts.")
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX7"><Properties><string name="Name">PNJServer</string><ProtectedString name="Source"><![CDATA[--[[
	PNJServer  (Script)
	À placer dans : ServerScriptService   — nom conseillé : PNJServer

	Met du MONDE dans le mall : un vendeur à la caisse de chaque boutique,
	des clients qui font leurs courses, des gens assis sur les bancs.
	Le script MallDriftServer prépare des emplacements invisibles « PostePNJ »
	(rôle : vendeur, client ou assis) ; ce script y place des personnages.

	Les personnages sont immobiles (ancrés) et ne bloquent pas les karts.
	Réglages : KartConfig > Config.PNJ (nombre maximum, chance d'avoir un client).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
ReplicatedStorage:WaitForChild("MallDriftRemotes") -- = la carte est construite
local carte = workspace:WaitForChild("GoldenMall")

local REGLAGES = Config.PNJ or { Max = 220, ChanceClient = 0.75 }
if Config.TypeDePlace() == "Lobby" then
	-- Dans le lobby, on reste au garage : pas besoin de remplir les boutiques (plus léger)
	return
end
local random = Random.new(7)

local dossier = Instance.new("Folder")
dossier.Name = "PNJ"
dossier.Parent = workspace

local ANIM_REPOS = "rbxassetid://507766388"
local ANIM_ASSIS = "rbxassetid://2506281703"

local PEAUX = {
	Color3.fromRGB(255, 224, 189), Color3.fromRGB(241, 194, 150), Color3.fromRGB(224, 172, 125),
	Color3.fromRGB(198, 134, 90), Color3.fromRGB(141, 85, 55), Color3.fromRGB(95, 60, 40),
}
local HAUTS = {
	Color3.fromRGB(240, 240, 240), Color3.fromRGB(30, 30, 35), Color3.fromRGB(200, 50, 60), Color3.fromRGB(50, 90, 170),
	Color3.fromRGB(70, 140, 80), Color3.fromRGB(240, 190, 60), Color3.fromRGB(150, 90, 170), Color3.fromRGB(240, 140, 170),
	Color3.fromRGB(130, 130, 135), Color3.fromRGB(100, 70, 50),
}
local BAS = {
	Color3.fromRGB(40, 55, 95), Color3.fromRGB(30, 30, 35), Color3.fromRGB(110, 110, 115), Color3.fromRGB(190, 170, 130),
	Color3.fromRGB(70, 60, 50), Color3.fromRGB(240, 240, 240),
}
local CHEVEUX = {
	Color3.fromRGB(25, 20, 15), Color3.fromRGB(60, 40, 25), Color3.fromRGB(110, 70, 40),
	Color3.fromRGB(200, 160, 90), Color3.fromRGB(150, 50, 30), Color3.fromRGB(180, 180, 180),
}

local function auHasard(liste)
	return liste[random:NextInteger(1, #liste)]
end

local function souder(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

local function ajouterCheveux(modele: Model, tete: BasePart)
	local couleur = auHasard(CHEVEUX)
	local style = random:NextInteger(1, 3)
	local function meche(taille: Vector3, decalage: CFrame)
		local p = Instance.new("Part")
		p.Name = "Cheveux"
		p.Size = taille
		p.CFrame = tete.CFrame * decalage
		p.Color = couleur
		p.Material = Enum.Material.SmoothPlastic
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		souder(tete, p)
		p.Parent = modele
	end
	meche(Vector3.new(1.25, 0.4, 1.3), CFrame.new(0, 0.55, 0.05)) -- dessus
	if style >= 2 then
		meche(Vector3.new(1.25, 0.9, 0.3), CFrame.new(0, 0.2, 0.6)) -- arrière
	end
	if style == 3 then
		meche(Vector3.new(1.25, 1.6, 0.35), CFrame.new(0, -0.2, 0.62)) -- cheveux longs
	end
end

local function creerPersonne(poste: BasePart): Model?
	local role = poste:GetAttribute("Role") or "client"
	local description = Instance.new("HumanoidDescription")
	local peau = auHasard(PEAUX)
	local haut = if role == "vendeur" then (poste:GetAttribute("Couleur") or auHasard(HAUTS)) else auHasard(HAUTS)
	description.HeadColor = peau
	description.LeftArmColor = peau
	description.RightArmColor = peau
	description.TorsoColor = haut
	description.LeftLegColor = auHasard(BAS)
	description.RightLegColor = description.LeftLegColor
	description.HeightScale = random:NextNumber(0.92, 1.05)
	local ok, modele = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not modele then
		return nil
	end
	modele.Name = if role == "vendeur" then "Vendeur" else "Client"
	local hum = modele:FindFirstChildOfClass("Humanoid") :: Humanoid
	local racine = modele:FindFirstChild("HumanoidRootPart") :: BasePart
	local tete = modele:FindFirstChild("Head") :: BasePart?
	local animate = modele:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	if tete then
		ajouterCheveux(modele, tete)
	end

	-- Position : debout sur le poste, ou assis sur le siège
	local hauteurRacine = hum.HipHeight + racine.Size.Y / 2
	if role == "assis" then
		hauteurRacine = (poste:GetAttribute("HauteurSiege") or 2.6) + 1.1
	end
	modele:PivotTo(poste.CFrame + Vector3.new(0, hauteurRacine, 0))

	-- Personnages immobiles et « fantômes » pour les karts
	for _, p in ipairs(modele:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
		end
	end
	racine.Anchored = true
	modele.Parent = dossier

	-- Animation : repos (il respire, bouge un peu) ou assis
	local animateur = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animateur.Parent = hum
	local anim = Instance.new("Animation")
	anim.AnimationId = if role == "assis" then ANIM_ASSIS else ANIM_REPOS
	pcall(function()
		local piste = animateur:LoadAnimation(anim)
		piste.Looped = true
		piste:Play()
		piste:AdjustSpeed(random:NextNumber(0.85, 1.15))
	end)
	return modele
end

-- On récupère tous les emplacements : d'abord les vendeurs, puis les clients
-- mélangés au hasard (pour qu'il y ait du monde aux deux étages)
local vendeurs, clients = {}, {}
for _, d in ipairs(carte:GetDescendants()) do
	if d:IsA("BasePart") and d.Name == "PostePNJ" then
		table.insert(if d:GetAttribute("Role") == "vendeur" then vendeurs else clients, d)
	end
end
for i = #clients, 2, -1 do
	local j = random:NextInteger(1, i)
	clients[i], clients[j] = clients[j], clients[i]
end
local postes = vendeurs
for _, c in ipairs(clients) do
	table.insert(postes, c)
end

local nombre = 0
for _, poste in ipairs(postes) do
	if nombre >= REGLAGES.Max then
		break
	end
	local role = poste:GetAttribute("Role")
	if role == "vendeur" or random:NextNumber() < REGLAGES.ChanceClient then
		if creerPersonne(poste) then
			nombre += 1
		end
		task.wait() -- on étale la création pour ne pas faire ramer le serveur
	end
end

print(("[Golden Mall] %d personnes dans le mall."):format(nombre))
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX8"><Properties><string name="Name">SecuriteServer</string><ProtectedString name="Source"><![CDATA[--[[
	SecuriteServer  (Script)
	À placer dans : ServerScriptService   — nom conseillé : SecuriteServer

	LA POLICE DU GOLDEN MALL
	  • 3 policiers patrouillent À PIED dans les allées. Quand l'un d'eux te voit,
	    il saute dans son KART DE POLICE et te prend en chasse
	  • chaque policier a un champ de vision : s'il voit ton kart, il te poursuit (❗),
	    allume son gyrophare et appelle ses collègues en renfort. Il vise l'endroit où
	    tu vas, et garde ta trace par radio quelques secondes s'il te perd de vue
	  • s'il arrive tout près de ton kart : ATTRAPÉ ! Il te raccompagne au garage
	  • si personne ne te voit pendant quelques secondes : tu les as SEMÉS (+XP)
	  • un garde qui court sur le sol mouillé glisse et tombe (+XP pour toi) 😂
	  • à pied, tu es un client normal. Dehors (parking, garage), tu es en sécurité.

	Pas de violence : les gardes sifflent, lèvent la main et te ramènent au garage.
	Tous les réglages sont dans KartConfig > Config.Securite.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local PathfindingService = game:GetService("PathfindingService")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
-- Le dossier des remotes est créé après la construction de la carte : on l'attend
local remotes = ReplicatedStorage:WaitForChild("MallDriftRemotes")
local Alerte = remotes:WaitForChild("Alerte") :: RemoteEvent
local AjouterXP = ServerStorage:WaitForChild("AjouterXP") :: BindableEvent
local carte = workspace:WaitForChild("GoldenMall")
local dossierKarts = workspace:WaitForChild("KartsJoueurs")

local R = Config.Securite
local TYPE = Config.TypeDePlace()
if TYPE == "Lobby" or TYPE == "PoliceFugitifs" or TYPE == "DriftBattle" then
	-- Pas de police bot ici (lobby, ou les vrais joueurs font la police / défi sans police)
	print(("[Golden Mall] Place « %s » : pas de police bot."):format(TYPE))
	return
end
local SOL = 1
local random = Random.new()

local dossierGardes = Instance.new("Folder")
dossierGardes.Name = "Securite"
dossierGardes.Parent = workspace
-- Pas d'agents de sécurité pendant une manche en ligne (que des vraies personnes)
-- ni pendant un DRIFT BATTLE (un défi de drift pur, sans police)
local function majPresenceGardes()
	local cacher = workspace:GetAttribute("MancheEnCours") == true
	for _, j in ipairs(Players:GetPlayers()) do
		local role = j:GetAttribute("Role")
		if role == "Battle" or role == "Chrono" then
			cacher = true
		end
	end
	local parent = if cacher then game:GetService("ServerStorage") else workspace
	if dossierGardes.Parent == parent then
		return
	end
	dossierGardes.Parent = parent
	if parent == workspace then
		-- (de retour : le serveur reprend le contrôle des gardes)
		for _, d in ipairs(dossierGardes:GetDescendants()) do
			if d:IsA("BasePart") and d.Name == "HumanoidRootPart" then
				pcall(function()
					d:SetNetworkOwner(nil)
				end)
			end
		end
	end
end
workspace:GetAttributeChangedSignal("MancheEnCours"):Connect(majPresenceGardes)
local function suivreRole(j: Player)
	j:GetAttributeChangedSignal("Role"):Connect(majPresenceGardes)
end
Players.PlayerAdded:Connect(suivreRole)
Players.PlayerRemoving:Connect(function()
	task.defer(majPresenceGardes)
end)
for _, j in ipairs(Players:GetPlayers()) do
	suivreRole(j)
end

-- Animations Roblox par défaut (R15)
local ANIMATIONS = {
	Marche = "rbxassetid://507777826",
	Course = "rbxassetid://507767714",
	Repos = "rbxassetid://507766388",
	Assis = "rbxassetid://2506281703", -- assis au volant du kart de police
}

-- Les rondes des policiers (points x, z dans les allées du mall)
local RONDES_A_PIED = { -- (non utilisées pour l'instant : garde-les pour ajouter des gardes à pied)
	{ Vector2.new(-190, -137), Vector2.new(-25, -137) }, -- allée nord, ouest
	{ Vector2.new(25, -137), Vector2.new(190, -137) }, -- allée nord, est
	{ Vector2.new(-190, 0), Vector2.new(-45, 0) }, -- allée centrale, ouest
	{ Vector2.new(45, 0), Vector2.new(190, 0) }, -- allée centrale, est
	{ Vector2.new(-99, -115), Vector2.new(-99, 115) }, -- allée étroite ouest
	{ Vector2.new(99, -115), Vector2.new(99, 115) }, -- allée étroite est
	{ Vector2.new(-20, -36), Vector2.new(20, -36), Vector2.new(20, 36), Vector2.new(-20, 36) }, -- tour de la fontaine
	{ Vector2.new(-136, 28), Vector2.new(-136, 112) }, -- food court
	{ Vector2.new(-173, -115), Vector2.new(-173, 115) },
	{ Vector2.new(173, -115), Vector2.new(173, 115) },
}
local RONDES_SEGWAY = {
	{ Vector2.new(-195, 137), Vector2.new(195, 137) }, -- allée sud (devant l'entrée)
	{ Vector2.new(-190, -137), Vector2.new(173, -137), Vector2.new(173, 0), Vector2.new(36, 0), Vector2.new(36, -128) }, -- allée nord + allée centrale (boucle)
	{ Vector2.new(-34.5, -110), Vector2.new(-34.5, 110), Vector2.new(34.5, 110), Vector2.new(34.5, -110) }, -- place centrale (entre palmiers et boutiques)
}

-- Rondes du 1er étage (x, hauteur du plancher, z)
local HAUTEUR_ETAGE = SOL + 25
local RONDES_ETAGE = {
	{ Vector3.new(-190, HAUTEUR_ETAGE, -137), Vector3.new(190, HAUTEUR_ETAGE, -137) }, -- allée nord
	{ Vector3.new(-190, HAUTEUR_ETAGE, 130), Vector3.new(190, HAUTEUR_ETAGE, 130) }, -- allée sud
	{ Vector3.new(-190, HAUTEUR_ETAGE, -8), Vector3.new(-45, HAUTEUR_ETAGE, -8) }, -- allée centrale
}

local PEAUX = { Color3.fromRGB(255, 220, 185), Color3.fromRGB(225, 175, 130), Color3.fromRGB(165, 115, 80), Color3.fromRGB(100, 70, 50) }
local BLEU_UNIFORME = Color3.fromRGB(28, 42, 92)
local NOIR_PANTALON = Color3.fromRGB(28, 28, 34)
local JAUNE = Color3.fromRGB(255, 210, 40)

---------------------------------------------------------------------
-- Construction d'un garde
---------------------------------------------------------------------
local function souder(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

local function accessoire(modele: Model, support: BasePart, nom: string, taille: Vector3, decalage: CFrame, couleur: Color3, matiere: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = nom
	p.Size = taille
	p.CFrame = support.CFrame * decalage
	p.Color = couleur
	p.Material = matiere or Enum.Material.SmoothPlastic
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	souder(support, p)
	p.Parent = modele
	return p
end

-- Si le modèle Roblox complet ne peut pas être créé, on fabrique un garde simple
local function gardeSimple(peau: Color3): Model
	local m = Instance.new("Model")
	local racine = Instance.new("Part")
	racine.Name = "HumanoidRootPart"
	racine.Size = Vector3.new(2, 2, 1)
	racine.Transparency = 1
	racine.Parent = m
	m.PrimaryPart = racine
	local function morceau(nom: string, taille: Vector3, y: number, couleur: Color3)
		local p = Instance.new("Part")
		p.Name = nom
		p.Size = taille
		p.CFrame = racine.CFrame * CFrame.new(0, y, 0)
		p.Color = couleur
		p.CanCollide = false
		p.Massless = true
		souder(racine, p)
		p.Parent = m
		return p
	end
	morceau("UpperTorso", Vector3.new(2, 2, 1), 0, BLEU_UNIFORME)
	morceau("Head", Vector3.new(1.2, 1.2, 1.2), 1.6, peau)
	morceau("Jambes", Vector3.new(1.8, 2, 0.9), -2, NOIR_PANTALON)
	local h = Instance.new("Humanoid")
	h.RigType = Enum.HumanoidRigType.R15
	h.HipHeight = 2
	h.Parent = m
	return m
end

type Garde = {
	modele: Model,
	hum: Humanoid,
	racine: BasePart,
	tete: BasePart,
	bulle: TextLabel,
	segway: boolean,
	ronde: { Vector3 },
	indexRonde: number,
	etat: string, -- "patrouille" | "poursuite" | "recherche" | "glisse" | "arrestation"
	cible: Player?,
	derniereVue: number,
	dernierePos: Vector3?,
	finEtat: number,
	prochaineGlissade: number,
	chemin: { Vector3 }?,
	indexChemin: number,
	destinationChemin: Vector3?,
	prochainCalcul: number,
	pistes: { [string]: AnimationTrack },
	animEnCours: string?,
	enKart: boolean,
	hanchesBase: number,
}

local gardes: { Garde } = {}

local function creerGarde(ronde: { any }, segway: boolean, numero: number): Garde
	local peau = PEAUX[random:NextInteger(1, #PEAUX)]
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = peau
	description.TorsoColor = BLEU_UNIFORME
	description.LeftArmColor = BLEU_UNIFORME
	description.RightArmColor = BLEU_UNIFORME
	description.LeftLegColor = NOIR_PANTALON
	description.RightLegColor = NOIR_PANTALON
	local ok, modele = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not modele then
		modele = gardeSimple(peau)
	end
	modele.Name = (segway and "Policier_" or "Garde_") .. numero
	local hum = modele:FindFirstChildOfClass("Humanoid") :: Humanoid
	local racine = modele:FindFirstChild("HumanoidRootPart") :: BasePart
	local tete = (modele:FindFirstChild("Head") or racine) :: BasePart
	local torse = (modele:FindFirstChild("UpperTorso") or modele:FindFirstChild("Torso") or racine) :: BasePart
	local animate = modele:FindFirstChild("Animate")
	if animate then
		animate:Destroy() -- on gère les animations nous-mêmes
	end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.BreakJointsOnDeath = false

	-- Uniforme : casquette, insigne, « SÉCURITÉ » dans le dos
	accessoire(modele, tete, "Casquette", Vector3.new(1.3, 0.35, 1.35), CFrame.new(0, 0.6, 0.05), BLEU_UNIFORME, Enum.Material.Fabric)
	accessoire(modele, tete, "Visiere", Vector3.new(1.1, 0.1, 0.6), CFrame.new(0, 0.45, -0.8), Color3.fromRGB(15, 15, 20))
	accessoire(modele, torse, "Insigne", Vector3.new(0.35, 0.35, 0.05), CFrame.new(-0.45, 0.35, -0.53), JAUNE, Enum.Material.Foil)
	local dos = accessoire(modele, torse, "Dos", Vector3.new(1.8, 0.55, 0.05), CFrame.new(0, 0.3, 0.53), BLEU_UNIFORME)
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Back
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 50
	sg.Parent = dos
	local mot = Instance.new("TextLabel")
	mot.Size = UDim2.fromScale(1, 1)
	mot.BackgroundTransparency = 1
	mot.TextScaled = true
	mot.Font = Enum.Font.GothamBlack
	mot.TextColor3 = JAUNE
	mot.Text = "POLICE"
	mot.TextColor3 = Color3.new(1, 1, 1)
	mot.Parent = sg

	-- Gyropode
	if segway then
		hum.HipHeight += 0.7
		local pieds = -(hum.HipHeight + racine.Size.Y / 2) + 0.15
		accessoire(modele, racine, "Plateforme", Vector3.new(2.3, 0.3, 1.3), CFrame.new(0, pieds, 0), Color3.fromRGB(35, 35, 40))
		for _, cote in ipairs({ -1, 1 }) do
			local roue = accessoire(modele, racine, "Roue", Vector3.new(0.5, 1.4, 1.4), CFrame.new(cote * 1.35, pieds, 0), Color3.fromRGB(20, 20, 20), Enum.Material.Rubber)
			roue.Shape = Enum.PartType.Cylinder
		end
		accessoire(modele, racine, "Colonne", Vector3.new(0.2, 3.3, 0.2), CFrame.new(0, pieds + 1.7, -0.75), Color3.fromRGB(60, 60, 65), Enum.Material.Metal)
		accessoire(modele, racine, "Guidon", Vector3.new(1.6, 0.2, 0.2), CFrame.new(0, pieds + 3.3, -0.75), Color3.fromRGB(60, 60, 65), Enum.Material.Metal)
		accessoire(modele, racine, "Gyrophare", Vector3.new(0.6, 0.35, 0.4), CFrame.new(0, pieds + 3.55, -0.75), Color3.fromRGB(40, 90, 255), Enum.Material.Neon)
	end

	-- La bulle au-dessus de la tête (❗ = il te voit, ❓ = il te cherche)
	local panneau = Instance.new("BillboardGui")
	panneau.Name = "Bulle"
	panneau.Size = UDim2.new(4, 0, 2, 0)
	panneau.StudsOffset = Vector3.new(0, 2.6, 0)
	panneau.AlwaysOnTop = true
	panneau.MaxDistance = 150
	panneau.Parent = tete
	local bulle = Instance.new("TextLabel")
	bulle.Size = UDim2.fromScale(1, 1)
	bulle.BackgroundTransparency = 1
	bulle.TextScaled = true
	bulle.Font = Enum.Font.GothamBlack
	bulle.TextColor3 = Color3.fromRGB(255, 60, 60)
	bulle.Text = ""
	local contour = Instance.new("UIStroke")
	contour.Thickness = 2
	contour.Parent = bulle
	bulle.Parent = panneau

	for _, p in ipairs(modele:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CollisionGroup = "Gardes"
		end
	end

	local points = {}
	for _, v in ipairs(ronde) do
		if typeof(v) == "Vector3" then
			table.insert(points, v + Vector3.new(0, 3, 0)) -- point avec sa hauteur (1er étage)
		else
			table.insert(points, Vector3.new(v.X, SOL + 3, v.Y))
		end
	end
	modele:PivotTo(CFrame.new(points[1] + Vector3.new(0, 1, 0)))
	modele.Parent = dossierGardes
	pcall(function()
		racine:SetNetworkOwner(nil) -- le serveur pilote les gardes (pas de saccades)
	end)

	-- Animations
	local animateur = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animateur.Parent = hum
	local pistes = {}
	for nom, id in pairs(ANIMATIONS) do
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local okAnim, piste = pcall(function()
			return animateur:LoadAnimation(anim)
		end)
		if okAnim and piste then
			piste.Looped = true
			pistes[nom] = piste
		end
	end

	local g: Garde = {
		modele = modele,
		hum = hum,
		racine = racine,
		tete = tete,
		bulle = bulle,
		segway = segway,
		ronde = points,
		indexRonde = 2,
		etat = "patrouille",
		cible = nil,
		derniereVue = 0,
		dernierePos = nil,
		finEtat = 0,
		prochaineGlissade = 0,
		chemin = nil,
		indexChemin = 1,
		destinationChemin = nil,
		prochainCalcul = 0,
		pistes = pistes,
		animEnCours = nil,
		enKart = false,
		hanchesBase = hum.HipHeight,
	}
	table.insert(gardes, g)
	return g
end

---------------------------------------------------------------------
-- Outils
---------------------------------------------------------------------
local function aplat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function dansLeMall(pos: Vector3): boolean
	return pos.Z < 159 and pos.Z > -160 and math.abs(pos.X) < 210
end

local function animer(g: Garde)
	local vitesse = aplat(g.racine.AssemblyLinearVelocity).Magnitude
	local voulue = "Repos"
	if g.etat == "glisse" then
		voulue = "Aucune"
	elseif g.enKart then
		voulue = "Assis"
	elseif not g.segway and vitesse > 16 then
		voulue = "Course"
	elseif not g.segway and vitesse > 1 then
		voulue = "Marche"
	end
	if voulue ~= g.animEnCours then
		for _, piste in pairs(g.pistes) do
			piste:Stop(0.2)
		end
		local piste = g.pistes[voulue]
		if piste then
			piste:Play(0.2)
		end
		g.animEnCours = voulue
	end
end

-- Les karts conduits en ce moment (un par joueur)
type KartConduit = { joueur: Player, kart: Model, chassis: BasePart }
local kartsConduits: { KartConduit } = {}

local function mettreAJourKarts()
	local liste = {}

	for _, kart in ipairs(dossierKarts:GetChildren()) do
		local proprietaire = Players:GetPlayerByUserId(kart:GetAttribute("Proprietaire") or 0)
		local siege = kart:FindFirstChild("Siege") :: Seat?
		local chassis = (kart :: Model).PrimaryPart
		local protege = (kart:GetAttribute("ProtegeJusqua") or 0) > workspace:GetServerTimeNow()
		-- Les joueurs d'une manche en ligne : ce sont les vrais joueurs qui font la police
		if proprietaire and (proprietaire:GetAttribute("Role") ~= nil or proprietaire:GetAttribute("EnTuto")) then
			protege = true
		end
		if proprietaire and siege and chassis and not protege and siege.Occupant and siege.Occupant.Parent == proprietaire.Character then
			table.insert(liste, { joueur = proprietaire, kart = kart :: Model, chassis = chassis })
		end
	end
	kartsConduits = liste
end

local function kartDe(joueur: Player?): KartConduit?
	for _, k in ipairs(kartsConduits) do
		if k.joueur == joueur then
			return k
		end
	end
	return nil
end

local parametresVue = RaycastParams.new()
parametresVue.FilterType = Enum.RaycastFilterType.Exclude
parametresVue.RespectCanCollide = true

local function majFiltreVue()
	local exclus = { dossierGardes, dossierKarts }
	for _, j in ipairs(Players:GetPlayers()) do
		if j.Character then
			table.insert(exclus, j.Character)
		end
	end
	parametresVue.FilterDescendantsInstances = exclus
end

-- Le garde voit-il ce kart ? (distance, angle de vue, et pas de mur entre les deux)
local function voit(g: Garde, chassis: BasePart): boolean
	local vers = chassis.Position - g.tete.Position
	local distance = aplat(vers).Magnitude
	if distance > R.DistanceVue then
		return false
	end
	if distance > R.DistanceOuie then
		local regard = aplat(g.racine.CFrame.LookVector).Unit
		if regard:Dot(aplat(vers).Unit) < math.cos(math.rad(R.AngleVue)) then
			return false
		end
	end
	return workspace:Raycast(g.tete.Position, vers, parametresVue) == nil
end

local parametresSol = RaycastParams.new()
parametresSol.FilterType = Enum.RaycastFilterType.Exclude

local function surSolMouille(g: Garde): boolean
	parametresSol.FilterDescendantsInstances = { dossierGardes, dossierKarts }
	local r = workspace:Raycast(g.racine.Position, Vector3.new(0, -8, 0), parametresSol)
	return r ~= nil and r.Instance:GetAttribute("Mouille") == true
end

-- Se déplacer vers un point : tout droit si la voie est libre, sinon avec un chemin calculé
local function allerVers(g: Garde, destination: Vector3)
	local depart = g.racine.Position
	local direct = workspace:Raycast(depart, destination - depart, parametresVue)
	if direct == nil or (direct.Position - depart).Magnitude > (destination - depart).Magnitude - 2 then
		g.chemin = nil
		g.hum:MoveTo(destination)
		return
	end
	local maintenant = os.clock()
	local doitRecalculer = g.chemin == nil
		or maintenant > g.prochainCalcul
		or (g.destinationChemin and (g.destinationChemin - destination).Magnitude > 12)
	if doitRecalculer then
		g.prochainCalcul = maintenant + (if g.etat == "poursuite" then 0.35 else 0.6) -- (chemin recalculé plus souvent en poursuite)
		g.destinationChemin = destination
		local chemin = PathfindingService:CreatePath({ AgentRadius = 2.5, AgentHeight = 5, AgentCanJump = false, WaypointSpacing = 6 })
		local ok = pcall(function()
			chemin:ComputeAsync(depart, destination)
		end)
		if ok and chemin.Status == Enum.PathStatus.Success then
			local points = {}
			for _, w in ipairs(chemin:GetWaypoints()) do
				table.insert(points, w.Position)
			end
			g.chemin = points
			g.indexChemin = math.min(2, #points)
		else
			g.chemin = nil
			g.hum:MoveTo(destination)
			return
		end
	end
	local points = g.chemin
	if points and points[g.indexChemin] then
		if aplat(points[g.indexChemin] - g.racine.Position).Magnitude < 6 and g.indexChemin < #points then
			g.indexChemin += 1
		end
		g.hum:MoveTo(points[g.indexChemin])
	end
end

---------------------------------------------------------------------
-- Le kart de police : il apparaît sous le policier quand il te prend en chasse
---------------------------------------------------------------------
local BLANC_POLICE = Color3.fromRGB(240, 242, 248)
local BLEU_POLICE = Color3.fromRGB(25, 60, 170)

local function monterEnKart(g: Garde)
	if g.enKart then
		return
	end
	g.enKart = true
	g.hum.HipHeight = 0.7
	local r = g.racine
	-- Position du châssis : au ras du sol, sous les hanches du policier assis
	local base = r.CFrame * CFrame.new(0, -(0.7 + r.Size.Y / 2) + 0.45, 0.6)
	local kartPolice = Instance.new("Model")
	kartPolice.Name = "KartPolice"
	local function piece(nom: string, taille: Vector3, decalage: CFrame, couleur: Color3, matiere: Enum.Material?, forme: Enum.PartType?): Part
		local p = Instance.new("Part")
		p.Name = nom
		p.Size = taille
		p.CFrame = base * decalage
		p.Color = couleur
		p.Material = matiere or Enum.Material.SmoothPlastic
		p.Shape = forme or Enum.PartType.Block
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.CollisionGroup = "Gardes"
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		souder(r, p)
		p.Parent = kartPolice
		return p
	end
	piece("Chassis", Vector3.new(4, 0.8, 6), CFrame.new(), BLANC_POLICE)
	piece("Capot", Vector3.new(3.2, 0.6, 1.8), CFrame.new(0, 0.55, -2.2) * CFrame.Angles(math.rad(-12), 0, 0), BLEU_POLICE)
	piece("PareChoc", Vector3.new(4.6, 0.5, 0.6), CFrame.new(0, 0, -3.2), Color3.fromRGB(25, 25, 25))
	for _, cote in ipairs({ -1, 1 }) do
		piece("BandeBleue", Vector3.new(0.1, 0.45, 5.6), CFrame.new(cote * 2.02, 0.05, 0), BLEU_POLICE)
		piece("RoueAvant", Vector3.new(0.8, 1.6, 1.6), CFrame.new(cote * 2.2, 0.2, -2.3), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		piece("RoueArriere", Vector3.new(0.7, 1.3, 1.3), CFrame.new(cote * 2.1, 0.05, 2.4), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		local flanc = piece("Flanc", Vector3.new(0.05, 0.7, 3.4), CFrame.new(cote * 2.06, 0.05, -0.3), BLANC_POLICE)
		flanc.Transparency = 1
		local sg = Instance.new("SurfaceGui")
		sg.Face = if cote < 0 then Enum.NormalId.Left else Enum.NormalId.Right
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 60
		sg.Parent = flanc
		local mot = Instance.new("TextLabel")
		mot.Size = UDim2.fromScale(1, 1)
		mot.BackgroundTransparency = 1
		mot.TextScaled = true
		mot.Font = Enum.Font.GothamBlack
		mot.TextColor3 = BLEU_POLICE
		mot.Text = "POLICE"
		mot.Parent = sg
	end
	piece("Volant", Vector3.new(0.2, 1.5, 1.5), CFrame.new(0, 1.6, -1) * CFrame.Angles(math.rad(-35), math.rad(90), 0), Color3.fromRGB(25, 25, 25), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	piece("MatGyrophare", Vector3.new(0.2, 1.8, 0.2), CFrame.new(0, 1.3, 2.7), Color3.fromRGB(40, 40, 45), Enum.Material.Metal)
	local gyro = piece("Gyrophare", Vector3.new(2.2, 0.35, 0.6), CFrame.new(0, 2.25, 2.7), Color3.fromRGB(255, 40, 40), Enum.Material.Neon)
	local lumiere = Instance.new("PointLight")
	lumiere.Name = "LumiereGyro"
	lumiere.Range = 14
	lumiere.Brightness = 3
	lumiere.Parent = gyro
	kartPolice.Parent = g.modele
end

local function descendreDuKart(g: Garde)
	if not g.enKart then
		return
	end
	g.enKart = false
	local k = g.modele:FindFirstChild("KartPolice")
	if k then
		k:Destroy()
	end
	g.hum.HipHeight = g.hanchesBase
end

---------------------------------------------------------------------
-- Poursuites (qui poursuit qui) et messages envoyés aux joueurs
---------------------------------------------------------------------
local poursuivants: { [Player]: { [Garde]: boolean } } = {}
local enArrestation: { [Player]: boolean } = {}

local function nombrePoursuivants(joueur: Player): number
	local n = 0
	for _ in pairs(poursuivants[joueur] or {}) do
		n += 1
	end
	return n
end

local function commencerPoursuite(g: Garde, joueur: Player, position: Vector3, renfort: boolean)
	if enArrestation[joueur] then
		return
	end
	g.cible = joueur
	g.derniereVue = os.clock()
	g.dernierePos = position
	g.chemin = nil
	g.bulle.TextColor3 = Color3.fromRGB(255, 60, 60)
	if g.enKart then
		g.etat = "poursuite"
		g.hum.WalkSpeed = R.VitessePoursuite
		g.bulle.Text = "❗"
	else
		-- Il s'arrête une fraction de seconde... et saute dans son kart de police !
		g.etat = "monte"
		g.finEtat = os.clock() + R.TempsMonteeKart
		g.hum:MoveTo(g.racine.Position)
		g.bulle.Text = "❗🚓"
	end
	local liste = poursuivants[joueur]
	local premier = liste == nil or next(liste) == nil
	if not liste then
		liste = {}
		poursuivants[joueur] = liste
	end
	liste[g] = true
	local niveau = math.min(nombrePoursuivants(joueur), 3)
	Alerte:FireClient(joueur, { etat = if premier then "repere" else "niveau", niveau = niveau })

	-- Le garde appelle les collègues proches en renfort
	if not renfort then
		for _, autre in ipairs(gardes) do
			if autre ~= g and (autre.etat == "patrouille" or autre.etat == "recherche") and (autre.racine.Position - position).Magnitude < R.DistanceRenfort then
				commencerPoursuite(autre, joueur, position, true)
			end
		end
	end
end

local function finirPoursuite(g: Garde, nouvelEtat: string)
	local joueur = g.cible
	g.etat = nouvelEtat
	g.cible = nil
	g.chemin = nil
	descendreDuKart(g)
	g.hum.WalkSpeed = R.VitessePatrouille
	if nouvelEtat == "recherche" then
		g.bulle.Text = "❓"
		g.bulle.TextColor3 = Color3.fromRGB(255, 220, 80)
		g.finEtat = os.clock() + 2.5
		g.hum:MoveTo(g.racine.Position)
	else
		g.bulle.Text = ""
	end
	if joueur and poursuivants[joueur] then
		poursuivants[joueur][g] = nil
		if next(poursuivants[joueur]) == nil then
			poursuivants[joueur] = nil
			if not enArrestation[joueur] and joueur.Parent then
				-- Plus personne ne te poursuit : tu les as semés !
				Alerte:FireClient(joueur, { etat = "seme", bonus = R.BonusSemer })
				AjouterXP:Fire(joueur, R.BonusSemer)
			end
		else
			Alerte:FireClient(joueur, { etat = "niveau", niveau = math.min(nombrePoursuivants(joueur), 3) })
		end
	end
end

local function arreter(g: Garde, joueur: Player)
	if enArrestation[joueur] then
		return
	end
	enArrestation[joueur] = true
	local k = kartDe(joueur)
	-- Tous les gardes qui le poursuivaient arrêtent la poursuite
	for autre in pairs(poursuivants[joueur] or {}) do
		autre.etat = "patrouille"
		autre.cible = nil
		autre.chemin = nil
		autre.bulle.Text = ""
		if autre ~= g then
			descendreDuKart(autre)
		end
		autre.hum.WalkSpeed = R.VitessePatrouille
	end
	poursuivants[joueur] = nil
	g.etat = "arrestation"
	g.finEtat = os.clock() + 2.5
	g.bulle.Text = "STOP ✋"
	g.bulle.TextColor3 = Color3.new(1, 1, 1)
	g.hum:MoveTo(g.racine.Position)
	Alerte:FireClient(joueur, { etat = "attrape" })
	if k then
		k.chassis.Anchored = true -- le kart est immobilisé
	end
	task.delay(2.2, function()
		local perso = joueur.Character
		local humanoide = perso and perso:FindFirstChildOfClass("Humanoid")
		if humanoide then
			humanoide.Sit = false
		end
		if k and k.kart.Parent then
			k.kart:Destroy()
		end
		task.wait(0.15)
		local garage = carte:FindFirstChild("GarageVIP")
		local apparition = garage and garage:FindFirstChild("ApparitionGarage") :: BasePart?
		if perso and perso.Parent and apparition then
			perso:PivotTo(apparition.CFrame + Vector3.new(0, 4, 0))
		end
		enArrestation[joueur] = nil
	end)
end

local function glisser(g: Garde)
	local joueur = g.cible
	g.etat = "glisse"
	g.finEtat = os.clock() + R.DureeGlissade
	g.prochaineGlissade = os.clock() + R.DureeGlissade + 5
	g.bulle.Text = "😵"
	g.hum.PlatformStand = true
	local regard = aplat(g.racine.CFrame.LookVector)
	g.racine.AssemblyLinearVelocity = regard * 22 + Vector3.new(0, 6, 0)
	g.racine.AssemblyAngularVelocity = g.racine.CFrame.RightVector * 7 -- il part en arrière
	if joueur then
		g.cible = joueur -- il reprendra la poursuite en se relevant
		Alerte:FireClient(joueur, { etat = "glisse", bonus = R.BonusGlissade })
		AjouterXP:Fire(joueur, R.BonusGlissade)
	end
end

local function relever(g: Garde)
	g.hum.PlatformStand = false
	local regard = aplat(g.racine.CFrame.LookVector)
	if regard.Magnitude < 0.1 then
		regard = Vector3.new(0, 0, -1)
	end
	local pos = g.racine.Position + Vector3.new(0, 2.5, 0)
	g.racine.AssemblyLinearVelocity = Vector3.zero
	g.racine.AssemblyAngularVelocity = Vector3.zero
	g.racine.CFrame = CFrame.lookAt(pos, pos + regard.Unit)
	g.hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	if g.cible and kartDe(g.cible) and not enArrestation[g.cible] then
		g.etat = "poursuite"
		g.derniereVue = os.clock()
		g.bulle.Text = "❗"
		g.bulle.TextColor3 = Color3.fromRGB(255, 60, 60)
	else
		finirPoursuite(g, "patrouille")
	end
end

---------------------------------------------------------------------
-- Le cerveau d'un garde (tourne en boucle)
---------------------------------------------------------------------
local function cerveau(g: Garde)
	g.hum.WalkSpeed = R.VitessePatrouille
	while g.modele.Parent and g.hum.Health > 0 do
		task.wait(if g.etat == "poursuite" then 0.08 else 0.15) -- (réagit plus vite en poursuite)
		local maintenant = os.clock()

		if g.etat == "glisse" then
			if maintenant > g.finEtat then
				relever(g)
			end
		elseif g.etat == "arrestation" then
			if maintenant > g.finEtat then
				g.etat = "patrouille"
				g.bulle.Text = ""
				descendreDuKart(g)
				g.hum.WalkSpeed = R.VitessePatrouille
			end
		elseif g.etat == "monte" then
			-- Le temps de sauter dans le kart, puis c'est parti
			if not g.cible or enArrestation[g.cible] then
				finirPoursuite(g, "patrouille")
			elseif maintenant > g.finEtat then
				monterEnKart(g)
				g.etat = "poursuite"
				g.hum.WalkSpeed = R.VitessePoursuite
				g.derniereVue = maintenant
				g.bulle.Text = "❗"
			end
		elseif g.etat == "recherche" then
			-- Il regarde autour de lui... puis reprend sa ronde
			g.racine.CFrame *= CFrame.Angles(0, math.rad(25), 0)
			if maintenant > g.finEtat then
				g.etat = "patrouille"
				g.bulle.Text = ""
			end
		end

		-- En patrouille ou en recherche : il guette les karts
		if g.etat == "patrouille" or g.etat == "recherche" then
			for _, k in ipairs(kartsConduits) do
				if dansLeMall(k.chassis.Position) and not enArrestation[k.joueur] and voit(g, k.chassis) then
					commencerPoursuite(g, k.joueur, k.chassis.Position, false)
					break
				end
			end
		end

		if g.etat == "poursuite" then
			local k = kartDe(g.cible)
			if not k or not dansLeMall(k.chassis.Position) or enArrestation[k.joueur] then
				finirPoursuite(g, "recherche") -- il a perdu sa cible (dehors, descendu du kart...)
			else
				if voit(g, k.chassis) then
					g.derniereVue = maintenant
				end
				-- Tant qu'il te voit (ou que la radio le guide), il sait où tu es
				-- et vise un peu devant toi pour te couper la route
				local ecart = k.chassis.Position - g.racine.Position
				local distance = aplat(ecart).Magnitude
				if maintenant - g.derniereVue < R.Radio then
					-- Interception : loin, il vise là où tu SERAS (pour te couper la route) ;
					-- tout près, il fonce droit sur ton kart pour te toucher
					local vitesseKart = aplat(k.chassis.AssemblyLinearVelocity)
					local anticipation = if distance < 14 then 0 else math.clamp(distance / math.max(R.VitessePoursuite, 1), 0.2, 1.1)
					g.dernierePos = k.chassis.Position + vitesseKart * anticipation
				end
				-- Rattrapage quand il est loin, sprint dans les derniers mètres
				local bonus = math.clamp((distance - 25) * 0.25, 0, R.Rattrapage or 12)
				if distance < 16 then
					bonus = R.Sprint or 8
				end
				g.hum.WalkSpeed = R.VitessePoursuite + bonus
				if distance < R.DistanceArrestation and math.abs(ecart.Y) < 6 then
					arreter(g, k.joueur)
				elseif maintenant - g.derniereVue > R.TempsPourSemer then
					finirPoursuite(g, "recherche")
				else
					allerVers(g, g.dernierePos or k.chassis.Position)
					-- Il fonce sur le sol mouillé ? Il glisse !
					if maintenant > g.prochaineGlissade and aplat(g.racine.AssemblyLinearVelocity).Magnitude > 12 and surSolMouille(g) then
						glisser(g)
					end
				end
			end
		elseif g.etat == "patrouille" then
			local point = g.ronde[g.indexRonde]
			if aplat(point - g.racine.Position).Magnitude < 4 then
				g.indexRonde = g.indexRonde % #g.ronde + 1
				point = g.ronde[g.indexRonde]
			end
			allerVers(g, point)
		end

		-- Gyrophare du kart de police : bleu / rouge
		local gyrophare = g.modele:FindFirstChild("Gyrophare", true) :: BasePart?
		if gyrophare then
			local couleur = if math.floor(maintenant * 5) % 2 == 0 then Color3.fromRGB(40, 90, 255) else Color3.fromRGB(255, 40, 40)
			gyrophare.Color = couleur
			local lumiere = gyrophare:FindFirstChild("LumiereGyro") :: PointLight?
			if lumiere then
				lumiere.Color = couleur
			end
		end
		animer(g)
	end
end

---------------------------------------------------------------------
-- Démarrage
---------------------------------------------------------------------
for i = 1, R.Policiers do
	local ronde = RONDES_SEGWAY[(i - 1) % #RONDES_SEGWAY + 1]
	local g = creerGarde(ronde, false, i) -- à pied (il monte dans son kart en poursuite)
	task.spawn(cerveau, g)
end

-- Mise à jour régulière de la liste des karts conduits
task.spawn(function()
	while true do
		mettreAJourKarts()
		majFiltreVue()
		task.wait(0.15)
	end
end)

Players.PlayerRemoving:Connect(function(joueur: Player)
	for g in pairs(poursuivants[joueur] or {}) do
		g.cible = nil
		g.etat = "patrouille"
		g.bulle.Text = ""
	end
	poursuivants[joueur] = nil
	enArrestation[joueur] = nil
end)

for i = 1, (R.PoliciersEtage or 0) do
	local ronde = RONDES_ETAGE[(i - 1) % #RONDES_ETAGE + 1]
	local g = creerGarde(ronde, false, 100 + i)
	task.spawn(cerveau, g)
end

print(("[Golden Mall] Police en place : %d policiers en bas, %d à l'étage."):format(R.Policiers, R.PoliciersEtage or 0))
]]></ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX22"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX21"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX9"><Properties><string name="Name">Cadeaux</string><ProtectedString name="Source"><![CDATA[--[[
	Cadeaux  (LocalScript)
	À placer dans : StarterPlayer > StarterPlayerScripts   — nom conseillé : Cadeaux

	Ce qui fait revenir les joueurs (comme dans les gros jeux Roblox) :
	  🎁 CADEAU GRATUIT : des cadeaux selon le temps de jeu (3, 10, 20, 35, 60 min)
	  📅 SÉRIE DU JOUR  : 1 cadeau par jour, de plus en plus gros jusqu'au jour 7
	  👥 INVITER DES AMIS : invitation Roblox (bonus quand vous jouez ensemble)
	  🔔 M'AVERTIR : notifications Roblox quand il y a du nouveau
	  👪 GROUPE : bonus unique si on rejoint le groupe (si Config.Cadeaux.GroupeId est réglé)
	Les cartes s'affichent à droite du menu. Une pastille rouge « ! » = cadeau prêt.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
local remotes = ReplicatedStorage:WaitForChild("MallDriftRemotes")
local Cadeaux = remotes:WaitForChild("Cadeaux") :: RemoteFunction

local joueur = Players.LocalPlayer
local hud = joueur:WaitForChild("PlayerGui"):WaitForChild("PartieHUD")
local menu = hud:WaitForChild("Menu") :: Frame

local POLICE = Font.fromEnum(Enum.Font.FredokaOne)
local ROUGE = Color3.fromRGB(225, 30, 45)
local VERT = Color3.fromRGB(50, 170, 90)

local function coins(o: GuiObject, r: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = o
end

local function texte(parent: Instance, taille: UDim2, position: UDim2, couleur: Color3, police: Enum.Font?): TextLabel
	local t = Instance.new("TextLabel")
	t.Size = taille
	t.Position = position
	t.BackgroundTransparency = 1
	t.TextColor3 = couleur
	t.Font = police or Enum.Font.FredokaOne
	t.TextScaled = true
	t.TextXAlignment = Enum.TextXAlignment.Left
	t.ZIndex = 24
	t.Parent = parent
	return t
end

---------------------------------------------------------------------
-- Les cartes à droite du menu
---------------------------------------------------------------------
-- (rangées dans la colonne de droite du menu, entre « EN DIRECT » et l'offre exclusive)
local colonne = Instance.new("Frame")
colonne.Name = "Cadeaux"
colonne.LayoutOrder = 3
colonne.Size = UDim2.new(1, 0, 0, 0)
colonne.AutomaticSize = Enum.AutomaticSize.Y
colonne.BackgroundTransparency = 1
colonne.ZIndex = 22
colonne.Parent = menu:WaitForChild("ColonneDroite")
local dispo = Instance.new("UIListLayout")
dispo.Padding = UDim.new(0, 8)
dispo.SortOrder = Enum.SortOrder.LayoutOrder
dispo.Parent = colonne

local function carte(ordre: number, icone: string, titre: string, couleur: Color3?): (TextButton, TextLabel, Frame)
	local b = Instance.new("TextButton")
	b.LayoutOrder = ordre
	b.Size = UDim2.new(1, 0, 0, 60)
	b.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	b.BackgroundTransparency = 0.05
	b.AutoButtonColor = false
	b.Text = ""
	b.ZIndex = 23
	b.Parent = colonne
	coins(b, 4)
	local bord = Instance.new("UIStroke")
	bord.Color = Color3.fromRGB(60, 60, 70)
	bord.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	bord.Parent = b
	local fondIcone = Instance.new("Frame")
	fondIcone.Size = UDim2.fromOffset(44, 44)
	fondIcone.Position = UDim2.new(0, 8, 0.5, -22)
	fondIcone.BackgroundColor3 = Color3.new(1, 1, 1)
	local teinte = couleur or Color3.fromRGB(120, 120, 140)
	local degradeIcone = Instance.new("UIGradient") -- pastille colorée, style bonbon
	degradeIcone.Color = ColorSequence.new(teinte:Lerp(Color3.new(1, 1, 1), 0.35), teinte:Lerp(Color3.new(0, 0, 0), 0.15))
	degradeIcone.Rotation = 90
	degradeIcone.Parent = fondIcone
	local contourIcone = Instance.new("UIStroke")
	contourIcone.Color = Color3.new(1, 1, 1)
	contourIcone.Transparency = 0.55
	contourIcone.Thickness = 2
	contourIcone.Parent = fondIcone
	fondIcone.ZIndex = 24
	fondIcone.Parent = b
	coins(fondIcone, 4)
	local i = texte(fondIcone, UDim2.new(1, -10, 1, -10), UDim2.new(0, 5, 0, 5), Color3.new(1, 1, 1))
	i.TextXAlignment = Enum.TextXAlignment.Center
	i.Text = icone
	i.ZIndex = 25
	local image = Config.ImageIcone(icone)
	if image then
		i.Visible = false
		local img = Instance.new("ImageLabel")
		img.Size = UDim2.new(1, -14, 1, -14)
		img.Position = UDim2.fromOffset(7, 7)
		img.BackgroundTransparency = 1
		img.Image = image
		img.ZIndex = 25
		img.Parent = fondIcone
	end
	local t = texte(b, UDim2.new(1, -70, 0, 22), UDim2.new(0, 62, 0, 9), Color3.new(1, 1, 1))
	t.FontFace = POLICE
	t.Text = titre
	local sous = texte(b, UDim2.new(1, -70, 0, 16), UDim2.new(0, 62, 0, 34), Color3.fromRGB(190, 190, 200), Enum.Font.GothamMedium)
	-- Pastille rouge « ! »
	local pastille = Instance.new("Frame")
	pastille.AnchorPoint = Vector2.new(0.5, 0.5)
	pastille.Size = UDim2.fromOffset(16, 16)
	pastille.Position = UDim2.new(1, -4, 0, 4)
	pastille.BackgroundColor3 = Color3.fromRGB(240, 40, 50)
	pastille.Visible = false
	pastille.ZIndex = 26
	pastille.Parent = b
	coins(pastille, 8)
	local e = Instance.new("UIScale")
	e.Parent = b
	b.MouseEnter:Connect(function()
		TweenService:Create(e, TweenInfo.new(0.12), { Scale = 1.04 }):Play()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(38, 38, 46) }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(e, TweenInfo.new(0.12), { Scale = 1 }):Play()
		TweenService:Create(b, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(20, 20, 24) }):Play()
	end)
	-- La pastille « respire »
	task.spawn(function()
		while b.Parent do
			if pastille.Visible then
				TweenService:Create(pastille, TweenInfo.new(0.5, Enum.EasingStyle.Sine), { Size = UDim2.fromOffset(20, 20) }):Play()
				task.wait(0.5)
				TweenService:Create(pastille, TweenInfo.new(0.5, Enum.EasingStyle.Sine), { Size = UDim2.fromOffset(16, 16) }):Play()
			end
			task.wait(0.5)
		end
	end)
	return b, sous, pastille
end

local carteCadeau, sousCadeau, pastilleCadeau = carte(1, "🎁", "Cadeau gratuit", Color3.fromRGB(170, 70, 255))
local carteSerie, sousSerie, pastilleSerie = carte(2, "📅", "Série du jour", Color3.fromRGB(0, 200, 170))
local carteAmis, sousAmis = carte(3, "👥", "Inviter des amis", Color3.fromRGB(50, 140, 255))
sousAmis.Text = ("+%d pièces chacun"):format(Config.Cadeaux.BonusAmi or 150)
local carteNotif, sousNotif = carte(4, "🔔", "M'avertir", Color3.fromRGB(255, 190, 0))
sousNotif.Text = "Ne rate aucune mise à jour"
local carteGroupe, sousGroupe, pastilleGroupe = carte(5, "👪", "Rejoins le groupe", Color3.fromRGB(40, 210, 100))
sousGroupe.Text = ("+%d 💰 une seule fois"):format(Config.Cadeaux.BonusGroupe or 500)
carteGroupe.Visible = false

---------------------------------------------------------------------
-- Le panneau qui détaille les cadeaux
---------------------------------------------------------------------
local panneau = Instance.new("Frame")
panneau.Name = "PageCadeaux"
panneau.AnchorPoint = Vector2.new(0.5, 0.5)
panneau.Size = UDim2.fromScale(1, 1) -- page entière
panneau.Position = UDim2.fromScale(0.5, 0.5)
panneau.BackgroundColor3 = Color3.new(1, 1, 1)
panneau.BackgroundTransparency = 0.03
panneau.Visible = false
panneau.ZIndex = 40
panneau.Parent = menu
local degradePage = Instance.new("UIGradient")
degradePage.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(10, 10, 14)),
	ColorSequenceKeypoint.new(0.55, Color3.fromRGB(16, 14, 20)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(70, 12, 20)),
})
degradePage.Rotation = 25
degradePage.Parent = panneau
local margesPage = Instance.new("UIPadding")
margesPage.PaddingLeft = UDim.new(0.12, 0)
margesPage.PaddingRight = UDim.new(0.12, 0)
margesPage.PaddingTop = UDim.new(0, 40)
margesPage.PaddingBottom = UDim.new(0, 30)
margesPage.Parent = panneau
local lisere = Instance.new("Frame")
lisere.Size = UDim2.new(0, 140, 0, 5)
lisere.Position = UDim2.new(0, 20, 0, 62)
lisere.BackgroundColor3 = ROUGE
lisere.BorderSizePixel = 0
lisere.ZIndex = 41
lisere.Parent = panneau
local titrePanneau = texte(panneau, UDim2.new(1, -220, 0, 50), UDim2.new(0, 20, 0, 6), Color3.new(1, 1, 1))
titrePanneau.FontFace = POLICE
titrePanneau.ZIndex = 41
local fermer = Instance.new("TextButton")
fermer.AnchorPoint = Vector2.new(1, 0)
fermer.Size = UDim2.fromOffset(150, 46)
fermer.Position = UDim2.new(1, -10, 0, 8)
fermer.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
fermer.TextColor3 = Color3.new(1, 1, 1)
fermer.Font = Enum.Font.FredokaOne
fermer.TextSize = 20
fermer.Text = "← RETOUR"
fermer.ZIndex = 42
fermer.Parent = panneau
coins(fermer, 6)
fermer.Activated:Connect(function()
	panneau.Visible = false
end)
local liste = Instance.new("Frame")
liste.Size = UDim2.new(1, -40, 1, -110)
liste.Position = UDim2.new(0, 20, 0, 96)
liste.BackgroundTransparency = 1
liste.ZIndex = 41
liste.Parent = panneau
local dispoListe = Instance.new("UIGridLayout")
dispoListe.CellPadding = UDim2.fromOffset(8, 8)
dispoListe.SortOrder = Enum.SortOrder.LayoutOrder
dispoListe.Parent = liste

local etat: any = nil
local vue = "" -- "temps" ou "serie"

local function formatTemps(s: number): string
	return ("%d:%02d"):format(s // 60, s % 60)
end

local function remplir()
	for _, e in ipairs(liste:GetChildren()) do
		if e:IsA("GuiObject") then
			e:Destroy()
		end
	end
	if not etat then
		return
	end
	if vue == "temps" then
		titrePanneau.Text = "CADEAUX"
		dispoListe.CellSize = UDim2.new(1, 0, 0, 70)
		for i, c in ipairs(etat.temps or {}) do
			local b = Instance.new("TextButton")
			b.LayoutOrder = i
			b.BackgroundColor3 = if c.pret then VERT elseif c.pris then Color3.fromRGB(30, 30, 36) else Color3.fromRGB(26, 26, 32)
			b.AutoButtonColor = c.pret
			b.Text = ""
			b.ZIndex = 42
			b.Parent = liste
			coins(b, 4)
			local t = texte(b, UDim2.new(0.6, 0, 0, 24), UDim2.new(0, 14, 0, 8), Color3.new(1, 1, 1))
			t.FontFace = POLICE
			t.Text = c.texte
			t.ZIndex = 43
			local s = texte(b, UDim2.new(0.6, 0, 0, 16), UDim2.new(0, 14, 0, 34), Color3.fromRGB(200, 200, 210), Enum.Font.GothamMedium)
			s.Text = ("Après %d min de jeu"):format(c.minutes)
			s.ZIndex = 43
			local d = texte(b, UDim2.new(0.35, 0, 0, 26), UDim2.new(0.62, 0, 0, 16), Color3.new(1, 1, 1))
			d.TextXAlignment = Enum.TextXAlignment.Right
			d.Text = if c.pris then "✔ PRIS" elseif c.pret then "RÉCUPÉRER" else "⏳ " .. formatTemps(c.reste)
			d.ZIndex = 43
			if c.pret then
				b.Activated:Connect(function()
					etat = Cadeaux:InvokeServer("temps", i)
					remplir()
				end)
			end
		end
	else
		titrePanneau.Text = ("SÉRIE · JOUR %d"):format(etat.serieJour or 1)
		dispoListe.CellSize = UDim2.new(0.25, -6, 0, 170)
		for i, c in ipairs(Config.Cadeaux.Serie or {}) do
			local aujourdhui = i == etat.serieJour
			local passe = i < (etat.serieJour or 1) or (aujourdhui and not etat.seriePrete)
			local b = Instance.new("TextButton")
			b.LayoutOrder = i
			b.BackgroundColor3 = if aujourdhui and etat.seriePrete then ROUGE elseif passe then VERT else Color3.fromRGB(28, 28, 34)
			b.AutoButtonColor = aujourdhui and etat.seriePrete
			b.Text = ""
			b.ZIndex = 42
			b.Parent = liste
			coins(b, 4)
			local j = texte(b, UDim2.new(1, -10, 0, 20), UDim2.new(0, 5, 0, 8), Color3.new(1, 1, 1))
			j.TextXAlignment = Enum.TextXAlignment.Center
			j.FontFace = POLICE
			j.Text = "JOUR " .. i
			j.ZIndex = 43
			local ic = texte(b, UDim2.new(1, -10, 0, 34), UDim2.new(0, 5, 0, 32), Color3.new(1, 1, 1))
			ic.TextXAlignment = Enum.TextXAlignment.Center
			ic.Text = if passe then "✔" elseif c.Tours then "🎡" else "💰"
			ic.ZIndex = 43
			local t = texte(b, UDim2.new(1, -10, 0, 36), UDim2.new(0, 5, 0, 74), Color3.fromRGB(230, 230, 235), Enum.Font.FredokaOne)
			t.TextXAlignment = Enum.TextXAlignment.Center
			t.TextWrapped = true
			t.Text = Config.TexteCadeau(c)
			t.ZIndex = 43
			if aujourdhui and etat.seriePrete then
				b.Activated:Connect(function()
					etat = Cadeaux:InvokeServer("serie")
					remplir()
				end)
			end
		end
	end
end

local function ouvrir(v: string)
	vue = v
	-- Une seule page à la fois : on ferme le magasin, la roue, l'aperçu
	for _, nom in ipairs({ "Magasin", "RoueDuJour", "Apercu", "PageClassement" }) do
		local autre = menu:FindFirstChild(nom)
		if autre and autre:IsA("GuiObject") then
			autre.Visible = false
		end
	end
	panneau.Visible = true
	-- La page arrive en glissant depuis la droite
	panneau.Position = UDim2.fromScale(1.5, 0.5)
	TweenService:Create(panneau, TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0.5) }):Play()
	lisere.Size = UDim2.new(0, 0, 0, 5)
	TweenService:Create(lisere, TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = UDim2.new(0, 140, 0, 5) }):Play()
	task.spawn(function()
		etat = Cadeaux:InvokeServer("etat")
		remplir()
	end)
	remplir()
end
carteCadeau.Activated:Connect(function()
	ouvrir("temps")
end)
carteSerie.Activated:Connect(function()
	ouvrir("serie")
end)
carteAmis.Activated:Connect(function()
	pcall(function()
		SocialService:PromptGameInvite(joueur)
	end)
end)
carteNotif.Activated:Connect(function()
	local ok = pcall(function()
		local ens = game:GetService("ExperienceNotificationService")
		if ens:CanPromptOptInAsync() then
			ens:PromptOptIn()
		end
	end)
	sousNotif.Text = if ok then "✔ Merci ! Tu seras averti" else "Pas disponible ici"
end)
carteGroupe.Activated:Connect(function()
	if (Config.Cadeaux.GroupeId or 0) ~= 0 then
		pcall(function()
			game:GetService("GroupService"):PromptJoinAsync(Config.Cadeaux.GroupeId)
		end)
		task.wait(1)
		etat = Cadeaux:InvokeServer("groupe")
	end
end)

---------------------------------------------------------------------
-- Mise à jour toutes les secondes (compte à rebours, pastilles)
---------------------------------------------------------------------
task.spawn(function()
	local depuis = 0
	while true do
		if menu.Visible then
			depuis += 1
			if not etat or depuis >= 15 then
				depuis = 0
				local ok, r = pcall(function()
					return Cadeaux:InvokeServer("etat")
				end)
				if ok and r then
					etat = r
				end
			elseif etat then
				for _, c in ipairs(etat.temps or {}) do
					if c.reste > 0 then
						c.reste -= 1
						if c.reste == 0 and not c.pris then
							c.pret = true
						end
					end
				end
			end
			if etat then
				local prochain = nil
				local pret = false
				for _, c in ipairs(etat.temps or {}) do
					if c.pret then
						pret = true
					elseif not c.pris and not prochain then
						prochain = c
					end
				end
				pastilleCadeau.Visible = pret
				sousCadeau.Text = if pret then "Prêt à récupérer !" elseif prochain then ("Prochain dans %s"):format(formatTemps(prochain.reste)) else "Tout récupéré, bravo !"
				pastilleSerie.Visible = etat.seriePrete == true
				sousSerie.Text = if etat.seriePrete then ("Jour %d · cadeau prêt !"):format(etat.serieJour or 1) else ("Jour %d · reviens demain"):format(etat.serieJour or 1)
				carteGroupe.Visible = etat.groupe == true
				pastilleGroupe.Visible = etat.groupe == true
				if panneau.Visible and vue == "temps" then
					remplir()
				end
			end
		end
		task.wait(1)
	end
end)
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX10"><Properties><string name="Name">GarageUI</string><ProtectedString name="Source"><![CDATA[--[[
	GarageUI  (LocalScript)
	À placer dans : StarterPlayer > StarterPlayerScripts   — nom conseillé : GarageUI

	Le menu du GARAGE VIP :
	  • ton kart tourne sur le plateau (on le voit sous tous les angles)
	  • choisir le modèle de kart, la couleur de carrosserie, la finition
	    (brillant, mat, métallisé, nacré, chrome), les jantes, le siège,
	    les bandes de course, l'autocollant et le numéro
	  • ce qui n'est pas encore débloqué affiche un cadenas 🔒 + le niveau requis
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
local KartBuilder = require(ReplicatedStorage:WaitForChild("KartBuilder"))
local remotes = ReplicatedStorage:WaitForChild("MallDriftRemotes")

local joueur = Players.LocalPlayer
local camera = workspace.CurrentCamera
local controles = require(joueur:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()

local profil = nil -- infos envoyées par le serveur (niveau, XP, kart enregistré)
local persoEdite = table.clone(Config.PersoParDefaut) -- ce que le joueur est en train de modifier
local menuOuvert = false

local function niveau(): number
	return profil and profil.Niveau or 1
end

---------------------------------------------------------------------
-- LE KART SUR LE PLATEAU TOURNANT (visible seulement par toi)
---------------------------------------------------------------------
local apercu: Model? = nil
-- Transitions de caméra (aller vers le plateau / revenir derrière le joueur)
local debutTransition = 0
local camDepart = CFrame.new()
local transitionRetour = false
local DUREE_TRANSITION = 0.9

local function adoucir(a: number): number
	a = math.clamp(a, 0, 1)
	return a * a * (3 - 2 * a)
end

local function cameraDerriereJoueur(): CFrame?
	local perso = joueur.Character
	local racine = perso and perso:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not racine then
		return nil
	end
	local regard = racine.CFrame.LookVector
	return CFrame.lookAt(racine.Position - regard * 12 + Vector3.new(0, 5, 0), racine.Position + Vector3.new(0, 2, 0))
end
local typeApercu: string? = nil
local traineeApercu: string? = nil
local angleApercu = 0

local function trouverPlateau(): BasePart?
	local carte = workspace:FindFirstChild("GoldenMall")
	local garage = carte and carte:FindFirstChild("GarageVIP")
	return garage and garage:FindFirstChild("PlateauTournant") :: BasePart?
end

local function majApercu(perso)
	local plateau = trouverPlateau()
	if not plateau then
		return
	end
	if apercu and (typeApercu ~= perso.Kart or traineeApercu ~= perso.Trainee) then
		apercu:Destroy()
		apercu = nil
	end
	if not apercu then
		apercu = KartBuilder.Construire(perso, CFrame.new(plateau.Position + Vector3.new(0, 1.1, 0)), true)
		apercu.Name = "ApercuGarage"
		apercu.Parent = workspace
		typeApercu = perso.Kart
		traineeApercu = perso.Trainee
	else
		KartBuilder.Peindre(apercu, perso)
	end
end

RunService.RenderStepped:Connect(function(dt: number)
	local plateau = trouverPlateau()
	if not plateau then
		return
	end
	if not apercu and profil then
		majApercu(if menuOuvert then persoEdite else profil.Perso)
	end
	if apercu then
		angleApercu += dt * (if menuOuvert then 0.5 else 0.3)
		apercu:PivotTo(CFrame.new(plateau.Position + Vector3.new(0, 1.1, 0)) * CFrame.Angles(0, angleApercu, 0))
	end
	-- Caméra de showroom : le kart apparaît à gauche du menu (le panneau est à droite)
	local cfShowroom = CFrame.lookAt(plateau.Position + Vector3.new(-16, 6, 4), plateau.Position + Vector3.new(2, 1.5, 4))
	if menuOuvert then
		-- La caméra glisse en douceur jusqu'au plateau
		camera.CFrame = camDepart:Lerp(cfShowroom, adoucir((os.clock() - debutTransition) / DUREE_TRANSITION))
	elseif transitionRetour then
		-- Si le joueur vient de monter dans son kart, c'est la caméra du kart qui commande
		local humanoide = joueur.Character and joueur.Character:FindFirstChildOfClass("Humanoid")
		if humanoide and humanoide.SeatPart then
			transitionRetour = false
			return
		end
		-- ...puis revient en douceur derrière le joueur
		local a = adoucir((os.clock() - debutTransition) / 0.7)
		local cfFin = cameraDerriereJoueur() or cfShowroom
		camera.CFrame = cfShowroom:Lerp(cfFin, a)
		if a >= 1 then
			transitionRetour = false
			camera.CameraType = Enum.CameraType.Custom
		end
	end
end)

---------------------------------------------------------------------
-- INTERFACE  (style « atelier de course » : panneau sombre à droite,
-- liseré rouge, onglets, cases de couleur avec leur prix)
---------------------------------------------------------------------
local OR = Color3.fromRGB(255, 205, 80)
local FOND = Color3.fromRGB(17, 17, 21)
local ROUGE = Color3.fromRGB(225, 30, 45)
local ROUGE_SOMBRE = Color3.fromRGB(120, 22, 32)
local CASE = Color3.fromRGB(32, 32, 38)
local GRIS_TEXTE = Color3.fromRGB(170, 170, 180)
local VIOLET = Color3.fromRGB(190, 110, 255)

local gui = Instance.new("ScreenGui")
gui.Name = "GarageVIP"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 10
gui.Enabled = false
gui.Parent = joueur:WaitForChild("PlayerGui")

local function coins(objet: GuiObject, rayon: number?)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, rayon or 6)
	c.Parent = objet
end

local function contour(objet: GuiObject, couleur: Color3, epaisseur: number): UIStroke
	local s = Instance.new("UIStroke")
	s.Color = couleur
	s.Thickness = epaisseur
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = objet
	return s
end

local function etiquette(parent: Instance, texte: string, taille: UDim2, position: UDim2, couleur: Color3, police: Enum.Font?): TextLabel
	local l = Instance.new("TextLabel")
	l.Size = taille
	l.Position = position
	l.BackgroundTransparency = 1
	l.Font = police or Enum.Font.FredokaOne
	l.TextScaled = true
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextColor3 = couleur
	l.Text = texte
	l.Parent = parent
	return l
end

-- Animations : la case grossit au survol et « rebondit » quand on clique
local function animer(b: GuiButton)
	local echelle = Instance.new("UIScale")
	echelle.Parent = b
	local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad)
	b.MouseEnter:Connect(function()
		TweenService:Create(echelle, info, { Scale = 1.06 }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(echelle, info, { Scale = 1 }):Play()
	end)
	b.Activated:Connect(function()
		echelle.Scale = 0.9
		TweenService:Create(echelle, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end)
end

local function bouton(parent: Instance, texte: string, couleur: Color3, taille: UDim2, position: UDim2?): TextButton
	local b = Instance.new("TextButton")
	b.Size = taille
	if position then
		b.Position = position
	end
	b.BackgroundColor3 = couleur
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.FredokaOne
	b.TextScaled = true
	b.Text = texte
	b.AutoButtonColor = true
	coins(b)
	local marge = Instance.new("UIPadding")
	marge.PaddingTop = UDim.new(0, 9)
	marge.PaddingBottom = UDim.new(0, 9)
	marge.PaddingLeft = UDim.new(0, 8)
	marge.PaddingRight = UDim.new(0, 8)
	marge.Parent = b
	b.Parent = parent
	animer(b)
	return b
end

-- Le panneau (à droite de l'écran, le kart tourne à gauche)
local panneau = Instance.new("Frame")
panneau.Name = "Panneau"
panneau.AnchorPoint = Vector2.new(1, 0.5)
panneau.Size = UDim2.new(0.34, 0, 0.92, 0)
panneau.Position = UDim2.new(1, -24, 0.5, 0)
panneau.BackgroundColor3 = FOND
panneau.BackgroundTransparency = 0.04
panneau.ClipsDescendants = true
panneau.Parent = gui
coins(panneau, 8)
contour(panneau, Color3.fromRGB(45, 45, 52), 1)
local tailleMax = Instance.new("UISizeConstraint")
tailleMax.MinSize = Vector2.new(330, 420)
tailleMax.MaxSize = Vector2.new(470, 880)
tailleMax.Parent = panneau
-- Liseré rouge en haut (avec un reflet qui passe)
