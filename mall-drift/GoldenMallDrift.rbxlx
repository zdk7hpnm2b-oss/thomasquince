cylindreDebout("Colonne", 10, 3, Vector3.new(0, SOL + 6, 0), OR, Enum.Material.Foil, fontaine)
local vasque = cylindreDebout("Vasque", 1, 11, Vector3.new(0, SOL + 11, 0), OR, Enum.Material.Foil, fontaine)
