<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="ReplicatedStorage" referent="RBX3"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">KartConfig</string><ProtectedString name="Source"><![CDATA[--[[
	KartConfig  (ModuleScript)
	À placer dans : ReplicatedStorage   — nom exact : KartConfig

	Le fichier des RÉGLAGES. Change les chiffres ici pour modifier le jeu
	sans toucher au reste du code.
]]

local Lighting = game:GetService("Lighting")

local Config = {}

Config.NomDuJeu = "Golden Mall Drift"
Config.Lieu = "Dubaï"

---------------------------------------------------------------------
-- LES KARTS  (Niveau = niveau du joueur nécessaire pour le débloquer)
-- VitesseMax     : vitesse de pointe (≈ km/h affichés)
-- Acceleration   : vitesse pour atteindre la vitesse max
-- Freinage       : puissance du frein
-- Rotation       : vitesse de rotation en conduite normale
-- RotationDrift  : multiplicateur de rotation en drift (360 !)
-- Adherence      : plus c'est haut, moins ça glisse (conduite normale)
-- AdherenceDrift : adhérence en drift (bas = grosse glissade)
-- Boost          : vitesse gagnée après un beau drift (2 étoiles ou +)
---------------------------------------------------------------------
Config.Karts = {
	Basique = {
		Nom = "Kart Basique", Niveau = 1, Ordre = 1,
		Description = "Équilibré, parfait pour apprendre.",
		VitesseMax = 50, Acceleration = 32, Freinage = 70,
		Rotation = 2.5, RotationDrift = 1.9, Adherence = 4, AdherenceDrift = 0.6, Boost = 16,
	},
	Chariot = {
		Nom = "Chariot Turbo", Niveau = 3, Ordre = 2,
		Description = "Un caddie motorisé. Glisse énormément !",
		VitesseMax = 46, Acceleration = 30, Freinage = 60,
		Rotation = 3.1, RotationDrift = 2.2, Adherence = 2.8, AdherenceDrift = 0.35, Boost = 15,
	},
	Bolide = {
		Nom = "Bolide Sport", Niveau = 6, Ordre = 3,
		Description = "Rapide et précis, avec un aileron.",
		VitesseMax = 66, Acceleration = 42, Freinage = 80,
		Rotation = 2.6, RotationDrift = 2.0, Adherence = 4.5, AdherenceDrift = 0.5, Boost = 22,
	},
	ProDubai = {
		Nom = "Kart Pro Dubaï", Niveau = 10, Ordre = 4,
		Description = "Le kart des champions. Finitions dorées.",
		VitesseMax = 74, Acceleration = 48, Freinage = 85,
		Rotation = 2.8, RotationDrift = 2.1, Adherence = 5, AdherenceDrift = 0.45, Boost = 26,
	},
}

---------------------------------------------------------------------
-- PERSONNALISATION (le garage VIP)
---------------------------------------------------------------------
Config.Couleurs = {
	{ Nom = "Blanc", Couleur = Color3.fromRGB(240, 240, 240), Niveau = 1 },
	{ Nom = "Noir", Couleur = Color3.fromRGB(25, 25, 28), Niveau = 1 },
	{ Nom = "Rouge", Couleur = Color3.fromRGB(215, 35, 40), Niveau = 1 },
	{ Nom = "Bleu", Couleur = Color3.fromRGB(35, 105, 215), Niveau = 1 },
	{ Nom = "Gris", Couleur = Color3.fromRGB(140, 145, 155), Niveau = 1 },
	{ Nom = "Jaune", Couleur = Color3.fromRGB(250, 205, 30), Niveau = 2 },
	{ Nom = "Vert", Couleur = Color3.fromRGB(40, 170, 80), Niveau = 2 },
	{ Nom = "Orange", Couleur = Color3.fromRGB(245, 130, 30), Niveau = 2 },
	{ Nom = "Rose", Couleur = Color3.fromRGB(245, 120, 180), Niveau = 4 },
	{ Nom = "Violet", Couleur = Color3.fromRGB(130, 70, 200), Niveau = 4 },
	{ Nom = "Turquoise", Couleur = Color3.fromRGB(30, 200, 200), Niveau = 4 },
	{ Nom = "Bleu nuit", Couleur = Color3.fromRGB(20, 35, 90), Niveau = 5 },
	{ Nom = "Bordeaux", Couleur = Color3.fromRGB(110, 20, 40), Niveau = 5 },
	{ Nom = "Sable", Couleur = Color3.fromRGB(215, 190, 140), Niveau = 7 },
	{ Nom = "Vert menthe", Couleur = Color3.fromRGB(150, 230, 190), Niveau = 7 },
	{ Nom = "Or", Couleur = Color3.fromRGB(225, 175, 45), Niveau = 10 },
}

-- Finition de la peinture (aspect réaliste)
Config.Finitions = {
	{ Nom = "Brillant", Materiau = Enum.Material.SmoothPlastic, Reflet = 0.12, Niveau = 1 },
	{ Nom = "Mat", Materiau = Enum.Material.SmoothPlastic, Reflet = 0, Niveau = 2 },
	{ Nom = "Métallisé", Materiau = Enum.Material.Metal, Reflet = 0.1, Niveau = 4 },
	{ Nom = "Nacré", Materiau = Enum.Material.SmoothPlastic, Reflet = 0.35, Niveau = 8 },
	{ Nom = "Chrome", Materiau = Enum.Material.Foil, Reflet = 0.55, Niveau = 12 },
}

-- Néons sous le kart (ils éclairent le sol, comme dans les vidéos TikTok)
Config.Neons = {
	{ Nom = "Aucun", Couleur = Color3.new(0, 0, 0), Niveau = 1 },
	{ Nom = "Bleu", Couleur = Color3.fromRGB(40, 110, 255), Niveau = 1 },
	{ Nom = "Violet", Couleur = Color3.fromRGB(170, 60, 255), Niveau = 1 },
	{ Nom = "Rose", Couleur = Color3.fromRGB(255, 60, 200), Niveau = 2 },
	{ Nom = "Cyan", Couleur = Color3.fromRGB(40, 230, 255), Niveau = 3 },
	{ Nom = "Vert", Couleur = Color3.fromRGB(60, 255, 110), Niveau = 4 },
	{ Nom = "Rouge", Couleur = Color3.fromRGB(255, 40, 50), Niveau = 5 },
	{ Nom = "Blanc", Couleur = Color3.fromRGB(240, 245, 255), Niveau = 6 },
	{ Nom = "Or", Couleur = Color3.fromRGB(255, 190, 50), Niveau = 9 },
	{ Nom = "Arc-en-ciel", Couleur = Color3.fromRGB(255, 255, 255), Niveau = 12 }, -- change de couleur en continu
}

-- Autocollants sur les flancs du kart
Config.Autocollants = {
	{ Nom = "Aucun", Texte = "", Niveau = 1 },
	{ Nom = "Étoile", Texte = "⭐", Niveau = 1 },
	{ Nom = "Lunettes", Texte = "😎", Niveau = 2 },
	{ Nom = "Chat", Texte = "🐱", Niveau = 3 },
	{ Nom = "Donut", Texte = "🍩", Niveau = 5 },
	{ Nom = "Éclair", Texte = "⚡", Niveau = 7 },
	{ Nom = "Couronne", Texte = "👑", Niveau = 9 },
	{ Nom = "Diamant", Texte = "💎", Niveau = 12 },
}

-- Le kart d'un nouveau joueur
Config.PersoParDefaut = {
	Kart = "Basique",
	Carrosserie = "Bleu",
	Finition = "Brillant",
	Jantes = "Blanc",
	Siege = "Noir",
	Bandes = "Blanc",
	BandesActives = true,
	Autocollant = "Étoile",
	Numero = 7,
	Neon = "Bleu",
}

-- Petites fonctions pour retrouver un élément par son nom
local function chercher(liste, nom)
	for _, element in ipairs(liste) do
		if element.Nom == nom then
			return element
		end
	end
	return nil
end
function Config.Couleur(nom: string) return chercher(Config.Couleurs, nom) end
function Config.Finition(nom: string) return chercher(Config.Finitions, nom) end
function Config.Autocollant(nom: string) return chercher(Config.Autocollants, nom) end
function Config.Neon(nom: string) return chercher(Config.Neons, nom) end

---------------------------------------------------------------------
-- PROGRESSION : les drifts donnent de l'XP → le niveau du joueur monte
-- → débloque karts, couleurs, finitions, autocollants
---------------------------------------------------------------------
Config.NiveauMax = 30
function Config.XPPourNiveauSuivant(niveau: number): number
	return 800 + 400 * (niveau - 1) -- niv.1→2 : 800 XP, niv.2→3 : 1200 XP, etc.
end
function Config.NiveauDepuisXP(xp: number): (number, number, number)
	local niveau = 1
	local reste = xp
	while niveau < Config.NiveauMax and reste >= Config.XPPourNiveauSuivant(niveau) do
		reste -= Config.XPPourNiveauSuivant(niveau)
		niveau += 1
	end
	return niveau, reste, Config.XPPourNiveauSuivant(niveau)
end

---------------------------------------------------------------------
-- LE SOL MOUILLÉ
---------------------------------------------------------------------
Config.Mouille = {
	Adherence = 0.3, -- adhérence x0.3 = encore 3x plus glissant
	Acceleration = 0.5, -- on accélère 2x moins bien sur l'eau
	BonusPoints = 1.5, -- un drift sur l'eau rapporte x1,5
}

---------------------------------------------------------------------
-- LE SCORE DE DRIFT
---------------------------------------------------------------------
Config.Score = {
	VitesseMin = 10, -- en dessous, pas de points
	AngleMin = 12, -- angle de glisse minimum (degrés)
	Tolerance = 0.35, -- secondes sans glisser avant d'encaisser le drift
	ComboParSeconde = 0.6, -- le multiplicateur monte de 0.6 par seconde
	ComboMax = 5,
	PointsParStud = 0.5,
	Bonus360 = 150, -- bonus par 360° (x combo)
	SeuilChoc = 22, -- perte de vitesse brutale = choc = drift perdu
	Minimum = 20,
	Etoiles = { 150, 500, 1200 }, -- points pour 1, 2, 3 étoiles
	DureeBoost = 1.5,
	MaxParDrift = 8000, -- sécurité anti-triche côté serveur
}

---------------------------------------------------------------------
-- SONS (optionnel) : colle un identifiant de la Boîte à outils > Audio
-- ex. "rbxassetid://1234567". Vide = pas de son.
---------------------------------------------------------------------
Config.Sons = {
	Moteur = "",
	Drift = "",
	Eclaboussure = "",
}

---------------------------------------------------------------------
-- JOUR / NUIT
---------------------------------------------------------------------
Config.NuitParDefaut = false -- le jeu démarre de jour (touche N pour passer en nuit)

---------------------------------------------------------------------
-- CAMÉRA (elle suit le kart toute seule)
---------------------------------------------------------------------
Config.Camera = {
	VueParDefaut = "gopro", -- "gopro" (caméra sur la poitrine, comme les vidéos TikTok) ou "derriere"
	ChampGoPro = 100, -- grand angle de la GoPro (degrés)
	Distance = 13, -- distance derrière le kart
	Hauteur = 5.5, -- hauteur au-dessus du kart
	Souplesse = 5, -- plus c'est haut, plus la caméra suit vite (bas = plus "cinéma")
	SuiviGlisse = 0.35, -- 0 = regarde où pointe le kart, 1 = regarde où il glisse
}

function Config.AppliquerAmbiance(nuit: boolean)
	-- L'intérieur du mall reste bien éclairé dans les deux cas (comme un vrai
	-- centre commercial) : c'est surtout le ciel et le parking qui changent.
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 1 -- reflets sur le carrelage
	if nuit then
		Lighting.ClockTime = 21.5
		Lighting.Brightness = 1.5
		Lighting.Ambient = Color3.fromRGB(150, 148, 160)
		Lighting.OutdoorAmbient = Color3.fromRGB(95, 95, 120)
		Lighting.ExposureCompensation = 0.25
	else
		Lighting.ClockTime = 14
		Lighting.Brightness = 3
		Lighting.Ambient = Color3.fromRGB(190, 188, 182)
		Lighting.OutdoorAmbient = Color3.fromRGB(175, 175, 175)
		Lighting.ExposureCompensation = 0.3
	end
	Lighting:SetAttribute("Nuit", nuit)
end

return Config
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">KartBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	KartBuilder  (ModuleScript)
	À placer dans : ReplicatedStorage   — nom exact : KartBuilder

	Construit un kart à partir de sa personnalisation (type, couleurs, finition,
	bandes, autocollant, numéro). Utilisé :
	  • par le serveur, pour le vrai kart du joueur
	  • par le garage, pour l'aperçu sur le plateau tournant
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))

local KartBuilder = {}

local NOIR = Color3.fromRGB(25, 25, 25)
local GRIS = Color3.fromRGB(120, 125, 135)
local OR = Color3.fromRGB(225, 175, 45)

---------------------------------------------------------------------
-- Vérifie une personnalisation : tout ce qui est inconnu ou pas encore
-- débloqué au niveau du joueur est remplacé par la valeur par défaut.
---------------------------------------------------------------------
function KartBuilder.Nettoyer(perso: any, niveau: number): { [string]: any }
	local defaut = Config.PersoParDefaut
	local propre = table.clone(defaut)
	if type(perso) ~= "table" then
		return propre
	end

	local function couleurOk(nom)
		local c = type(nom) == "string" and Config.Couleur(nom)
		return c and c.Niveau <= niveau
	end

	local kart = Config.Karts[perso.Kart]
	if kart and kart.Niveau <= niveau then
		propre.Kart = perso.Kart
	end
	for _, champ in ipairs({ "Carrosserie", "Jantes", "Siege", "Bandes" }) do
		if couleurOk(perso[champ]) then
			propre[champ] = perso[champ]
		end
	end
	local finition = type(perso.Finition) == "string" and Config.Finition(perso.Finition)
	if finition and finition.Niveau <= niveau then
		propre.Finition = perso.Finition
	end
	local neon = type(perso.Neon) == "string" and Config.Neon(perso.Neon)
	if neon and neon.Niveau <= niveau then
		propre.Neon = perso.Neon
	end
	local autocollant = type(perso.Autocollant) == "string" and Config.Autocollant(perso.Autocollant)
	if autocollant and autocollant.Niveau <= niveau then
		propre.Autocollant = perso.Autocollant
	end
	if type(perso.BandesActives) == "boolean" then
		propre.BandesActives = perso.BandesActives
	end
	if type(perso.Numero) == "number" and perso.Numero == perso.Numero then
		propre.Numero = math.clamp(math.floor(perso.Numero), 0, 99)
	end
	return propre
end

---------------------------------------------------------------------
-- Applique les couleurs / finition / déco sur un kart déjà construit
---------------------------------------------------------------------
function KartBuilder.Peindre(modele: Model, perso: { [string]: any })
	local function couleur(nom: string): Color3
		local c = Config.Couleur(nom)
		return c and c.Couleur or Color3.new(1, 1, 1)
	end
	local finition = Config.Finition(perso.Finition) or Config.Finitions[1]
	local neon = Config.Neon(perso.Neon) or Config.Neons[2]
	local sansNeon = neon.Nom == "Aucun"
	modele:SetAttribute("NeonArcEnCiel", neon.Nom == "Arc-en-ciel")

	for _, p in ipairs(modele:GetDescendants()) do
		if p:IsA("BasePart") then
			local role = p:GetAttribute("Peinture")
			if role == "Carrosserie" then
				p.Color = couleur(perso.Carrosserie)
				p.Material = finition.Materiau
				p.Reflectance = finition.Reflet
			elseif role == "Jantes" then
				p.Color = couleur(perso.Jantes)
			elseif role == "Siege" then
				p.Color = couleur(perso.Siege)
			elseif role == "Bandes" then
				p.Color = couleur(perso.Bandes)
				p.Transparency = perso.BandesActives and 0 or 1
			elseif role == "Neon" then
				p.Color = neon.Couleur
				p.Transparency = sansNeon and 1 or 0
			end
		elseif p:IsA("PointLight") and p.Name == "LumiereNeon" then
			p.Color = neon.Couleur
			p.Enabled = not sansNeon
		elseif p:IsA("TextLabel") and p.Name == "Deco" then
			local autocollant = Config.Autocollant(perso.Autocollant)
			local symbole = autocollant and autocollant.Texte or ""
			p.Text = (symbole ~= "" and (symbole .. " ") or "") .. tostring(perso.Numero)
		end
	end
	modele:SetAttribute("KartType", perso.Kart)
end

---------------------------------------------------------------------
-- Construit le kart
--   perso  : la personnalisation (voir Config.PersoParDefaut)
--   cf     : position / orientation
--   apercu : true = kart de vitrine (fixe, sans physique ni effets)
---------------------------------------------------------------------
function KartBuilder.Construire(perso: { [string]: any }, cf: CFrame, apercu: boolean?): Model
	local typeKart = Config.Karts[perso.Kart] and perso.Kart or "Basique"
	local modele = Instance.new("Model")
	modele.Name = "Kart_" .. typeKart

	local chassis = Instance.new("Part")
	chassis.Name = "Chassis"
	chassis.Size = Vector3.new(4, 0.8, 6)
	chassis.CFrame = cf
	chassis.TopSurface = Enum.SurfaceType.Smooth
	chassis.BottomSurface = Enum.SurfaceType.Smooth
	-- Friction 0 : c'est le script de conduite qui gère la glisse
	chassis.CustomPhysicalProperties = PhysicalProperties.new(1, 0, 0, 100, 100)
	chassis.Anchored = apercu == true
	chassis:SetAttribute("Peinture", "Carrosserie")
	chassis.Parent = modele
	modele.PrimaryPart = chassis

	local function piece(nom: string, taille: Vector3, decalage: CFrame, couleur: Color3, peinture: string?, matiere: Enum.Material?, forme: Enum.PartType?): Part
		local p = Instance.new("Part")
		p.Name = nom
		p.Size = taille
		p.CFrame = chassis.CFrame * decalage
		p.Color = couleur
		p.Material = matiere or Enum.Material.SmoothPlastic
		p.Shape = forme or Enum.PartType.Block
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if peinture then
			p:SetAttribute("Peinture", peinture)
		end
		if apercu then
			p.Anchored = true
		else
			local w = Instance.new("WeldConstraint")
			w.Part0 = chassis
			w.Part1 = p
			w.Parent = p
		end
		p.Parent = modele
		return p
	end

	local CYL = Enum.PartType.Cylinder -- les cylindres Roblox sont couchés sur l'axe X : parfait pour des roues

	-- Roues avant + roues arrière pivotantes (plus petites, comme les vrais karts de drift)
	for _, r in ipairs({
		{ x = -2.2, y = 0.2, z = -2.3, d = 1.6, l = 0.8 },
		{ x = 2.2, y = 0.2, z = -2.3, d = 1.6, l = 0.8 },
		{ x = -1.9, y = -0.05, z = 2.5, d = 1.1, l = 0.6 },
		{ x = 1.9, y = -0.05, z = 2.5, d = 1.1, l = 0.6 },
	}) do
		piece("Roue", Vector3.new(r.l, r.d, r.d), CFrame.new(r.x, r.y, r.z), NOIR, nil, Enum.Material.SmoothPlastic, CYL)
		local dehors = math.sign(r.x) * (math.abs(r.x) + r.l / 2 + 0.03)
		piece("Jante", Vector3.new(0.06, r.d * 0.6, r.d * 0.6), CFrame.new(dehors, r.y, r.z), Color3.new(1, 1, 1), "Jantes", Enum.Material.Metal, CYL)
	end

	piece("PareChoc", Vector3.new(4.6, 0.5, 0.6), CFrame.new(0, 0, -3.2), NOIR)
	piece("Colonne", Vector3.new(0.3, 0.3, 2), CFrame.new(0, 1.1, -1.6) * CFrame.Angles(math.rad(35), 0, 0), GRIS)
	piece("Volant", Vector3.new(0.2, 1.7, 1.7), CFrame.new(0, 1.7, -0.9) * CFrame.Angles(math.rad(-35), math.rad(90), 0), OR, nil, Enum.Material.Metal, CYL)
	-- Petit écran sur la colonne de direction + gants du pilote posés sur le volant
	piece("EcranVolant", Vector3.new(0.7, 0.45, 0.1), CFrame.new(0, 1.3, -1.3) * CFrame.Angles(math.rad(-35), 0, 0), Color3.fromRGB(60, 170, 255), nil, Enum.Material.Neon)
	piece("Gant", Vector3.new(0.45, 0.45, 0.55), CFrame.new(-0.72, 1.85, -0.85) * CFrame.Angles(math.rad(-35), 0, 0), Color3.fromRGB(30, 30, 30), nil, Enum.Material.Fabric)
	piece("Gant", Vector3.new(0.45, 0.45, 0.55), CFrame.new(0.72, 1.85, -0.85) * CFrame.Angles(math.rad(-35), 0, 0), Color3.fromRGB(30, 30, 30), nil, Enum.Material.Fabric)

	-- Néons sous le kart (underglow) + la lumière qu'ils projettent sur le sol
	for _, cote in ipairs({ -1, 1 }) do
		piece("Neon", Vector3.new(0.25, 0.12, 5.4), CFrame.new(cote * 1.8, -0.43, 0), Color3.new(1, 1, 1), "Neon", Enum.Material.Neon)
		piece("Neon", Vector3.new(3.4, 0.12, 0.25), CFrame.new(0, -0.43, cote * 2.75), Color3.new(1, 1, 1), "Neon", Enum.Material.Neon)
	end
	local attLumiere = Instance.new("Attachment")
	attLumiere.Name = "SousLeKart"
	attLumiere.Position = Vector3.new(0, -0.7, 0)
	attLumiere.Parent = chassis
	local lumiereNeon = Instance.new("PointLight")
	lumiereNeon.Name = "LumiereNeon"
	lumiereNeon.Range = 11
	lumiereNeon.Brightness = 4
	lumiereNeon.Shadows = false
	lumiereNeon.Parent = attLumiere

	piece("Dossier", Vector3.new(2.4, 2, 0.4), CFrame.new(0, 1.6, 2.2) * CFrame.Angles(math.rad(-10), 0, 0), NOIR, "Siege", Enum.Material.Fabric)

	-- Bandes de course sur le capot
	piece("Bande", Vector3.new(0.45, 0.05, 3.6), CFrame.new(-0.6, 0.42, -1.2), Color3.new(1, 1, 1), "Bandes")
	piece("Bande", Vector3.new(0.45, 0.05, 3.6), CFrame.new(0.6, 0.42, -1.2), Color3.new(1, 1, 1), "Bandes")

	-- Flancs avec autocollant + numéro
	for _, cote in ipairs({ -1, 1 }) do
		local flanc = piece("Flanc", Vector3.new(0.05, 0.7, 3), CFrame.new(cote * 2.03, 0, -0.6), Color3.new(1, 1, 1), nil)
		flanc.Transparency = 1
		local sg = Instance.new("SurfaceGui")
		sg.Face = cote < 0 and Enum.NormalId.Left or Enum.NormalId.Right
		sg.LightInfluence = 0.5
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 60
		sg.Parent = flanc
		local deco = Instance.new("TextLabel")
		deco.Name = "Deco"
		deco.Size = UDim2.fromScale(1, 1)
		deco.BackgroundTransparency = 1
		deco.TextScaled = true
		deco.Font = Enum.Font.GothamBlack
		deco.TextColor3 = Color3.new(1, 1, 1)
		local contour = Instance.new("UIStroke")
		contour.Thickness = 2
		contour.Parent = deco
		deco.Parent = sg
	end

	-- Éléments propres à chaque modèle de kart
	if typeKart == "Chariot" then
		local panier = piece("Panier", Vector3.new(3.6, 2, 2.2), CFrame.new(0, 1.4, -2.1), GRIS, nil, Enum.Material.DiamondPlate)
		panier.Transparency = 0.35
		piece("Poignee", Vector3.new(3.4, 0.25, 0.25), CFrame.new(0, 2.6, -1), Color3.fromRGB(220, 40, 40))
	elseif typeKart == "Bolide" or typeKart == "ProDubai" then
		local dore = typeKart == "ProDubai"
		piece("Aileron", Vector3.new(4.2, 0.2, 1), CFrame.new(0, 2.5, 3), NOIR, (not dore) and "Carrosserie" or nil, dore and Enum.Material.Foil or nil).Color = dore and OR or NOIR
		piece("SupportAileron", Vector3.new(0.2, 1.4, 0.4), CFrame.new(-1.3, 1.8, 2.9), NOIR)
		piece("SupportAileron", Vector3.new(0.2, 1.4, 0.4), CFrame.new(1.3, 1.8, 2.9), NOIR)
		piece("Nez", Vector3.new(3, 0.6, 1.6), CFrame.new(0, 0.6, -2.4) * CFrame.Angles(math.rad(-12), 0, 0), Color3.new(1, 1, 1), "Carrosserie")
		if dore then
			for _, cote in ipairs({ -1, 1 }) do
				piece("LiseretOr", Vector3.new(0.1, 0.15, 5.6), CFrame.new(cote * 2.05, 0.35, 0), OR, nil, Enum.Material.Foil)
			end
		end
	end

	-- Le siège (on s'assoit dedans)
	local siege = Instance.new("Seat")
	siege.Name = "Siege"
	siege.Size = Vector3.new(2.4, 0.6, 2.2)
	siege.CFrame = chassis.CFrame * CFrame.new(0, 0.7, 1)
	siege.Material = Enum.Material.Fabric
	siege.CanCollide = false
	siege.Massless = true
	siege.TopSurface = Enum.SurfaceType.Smooth
	siege:SetAttribute("Peinture", "Siege")
	if apercu then
		siege.Anchored = true
		siege.Disabled = true
	else
		local ws = Instance.new("WeldConstraint")
		ws.Part0 = chassis
		ws.Part1 = siege
		ws.Parent = siege
	end
	siege.Parent = modele

	if not apercu then
		-- Garde le kart à plat (il tourne sur lui-même mais ne se retourne pas)
		local attRedresse = Instance.new("Attachment")
		attRedresse.Name = "Redresse"
		attRedresse.CFrame = CFrame.Angles(0, 0, math.rad(90)) -- axe principal vers le haut
		attRedresse.Parent = chassis
		local align = Instance.new("AlignOrientation")
		align.Mode = Enum.OrientationAlignmentMode.OneAttachment
		align.Attachment0 = attRedresse
		align.AlignType = Enum.AlignType.PrimaryAxisParallel
		align.PrimaryAxis = Vector3.yAxis
		align.MaxTorque = 1e6
		align.Responsiveness = 30
		align.Parent = chassis

		-- Effets : traces de pneus, fumée de gomme, gerbes d'eau
		for _, cote in ipairs({ -1.9, 1.9 }) do
			local a0 = Instance.new("Attachment")
			a0.Position = Vector3.new(cote - 0.3, -0.38, 2.6)
			a0.Parent = chassis
			local a1 = Instance.new("Attachment")
			a1.Position = Vector3.new(cote + 0.3, -0.38, 2.6)
			a1.Parent = chassis
			local trace = Instance.new("Trail")
			trace.Name = "TracePneu"
			trace.Attachment0 = a0
			trace.Attachment1 = a1
			trace.Color = ColorSequence.new(Color3.fromRGB(30, 30, 30))
			trace.Transparency = NumberSequence.new(0.45, 1)
			trace.Lifetime = 4
			trace.LightInfluence = 1
			trace.Enabled = false
			trace.Parent = chassis

			local attEffet = Instance.new("Attachment")
			attEffet.Name = "EffetRoue"
			attEffet.Position = Vector3.new(cote, -0.3, 2.6)
			attEffet.Parent = chassis

			local fumee = Instance.new("ParticleEmitter")
			fumee.Name = "Fumee"
			fumee.Color = ColorSequence.new(Color3.fromRGB(215, 215, 215))
			fumee.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 3) })
			fumee.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
			fumee.Lifetime = NumberRange.new(0.6, 1.1)
			fumee.Speed = NumberRange.new(1, 3)
			fumee.SpreadAngle = Vector2.new(40, 40)
			fumee.Rate = 35
			fumee.Enabled = false
			fumee.Parent = attEffet

			local eau = Instance.new("ParticleEmitter")
			eau.Name = "Eclaboussures"
			eau.Color = ColorSequence.new(Color3.fromRGB(190, 225, 255))
			eau.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0.1) })
			eau.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
			eau.Lifetime = NumberRange.new(0.3, 0.6)
			eau.Speed = NumberRange.new(8, 14)
			eau.SpreadAngle = Vector2.new(50, 50)
			eau.Acceleration = Vector3.new(0, -60, 0)
			eau.EmissionDirection = Enum.NormalId.Top
			eau.Rate = 80
			eau.Enabled = false
			eau.Parent = attEffet
		end
	end

	KartBuilder.Peindre(modele, perso)
	modele:SetAttribute("KartType", typeKart)
	return modele
end

return KartBuilder
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="RBX5"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX4"><Properties><string name="Name">MallDriftServer</string><ProtectedString name="Source"><![CDATA[--[[
	MallDriftServer  (Script)
	À placer dans : ServerScriptService   — nom conseillé : MallDriftServer

	Au lancement du jeu, ce script :
	  • construit le GOLDEN MALL de Dubaï : des allées bordées de 48 BOUTIQUES
	    où l'on peut entrer en kart (coiffeur, vêtements, fast-food, jeux vidéo,
	    téléphonie, sport, bijouterie, parfumerie, jouets, librairie, glacier, café),
	    une place centrale avec fontaine, palmiers et kiosques, un aquarium géant,
	    un food court
	  • crée le GARAGE VIP (plateau tournant, atelier de personnalisation)
	  • pose les zones de sol mouillé + panneaux jaunes « ATTENTION SOL GLISSANT »
	  • sauvegarde la progression de chaque joueur (XP, niveau, kart personnalisé)
	  • fait apparaître le kart personnel de chaque joueur

	Les noms de magasins sont inventés : les vraies marques (McDonald's, etc.)
	sont protégées et Roblox peut retirer un jeu qui les utilise sans autorisation.
]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("KartConfig"))
local KartBuilder = require(ReplicatedStorage:WaitForChild("KartBuilder"))

Config.AppliquerAmbiance(Config.NuitParDefaut)

if not Lighting:FindFirstChildOfClass("BloomEffect") then
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 26
	bloom.Threshold = 1.15
	bloom.Parent = Lighting
end
if not Lighting:FindFirstChild("CouleursMallDrift") then
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "CouleursMallDrift"
	cc.Saturation = 0.12
	cc.Contrast = 0.04
	cc.Brightness = 0.06 -- un peu plus lumineux
	cc.TintColor = Color3.fromRGB(255, 252, 245)
	cc.Parent = Lighting
end

local carte = Instance.new("Folder")
carte.Name = "GoldenMall"
carte.Parent = workspace

local random = Random.new(2026) -- toujours le même décor

---------------------------------------------------------------------
-- Outils de construction
---------------------------------------------------------------------
local function bloc(nom: string, taille: Vector3, cf: CFrame, couleur: Color3, matiere: Enum.Material?, parent: Instance?): Part
	local p = Instance.new("Part")
	p.Name = nom
	p.Size = taille
	p.CFrame = cf
	p.Color = couleur
	p.Material = matiere or Enum.Material.SmoothPlastic
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or carte
	return p
end

local function deco(p: BasePart): BasePart
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	return p
end

local function libre(p: BasePart): BasePart
	-- Objet qu'on peut renverser avec le kart
	p.Anchored = false
	p.CustomPhysicalProperties = PhysicalProperties.new(0.3, 0.5, 0.2)
	return p
end

local DEBOUT = CFrame.Angles(0, 0, math.rad(90)) -- couche un cylindre Roblox à la verticale

local function cylindreDebout(nom: string, hauteur: number, diametre: number, position: Vector3, couleur: Color3, matiere: Enum.Material?, parent: Instance?): Part
	local p = bloc(nom, Vector3.new(hauteur, diametre, diametre), CFrame.new(position) * DEBOUT, couleur, matiere, parent)
	p.Shape = Enum.PartType.Cylinder
	return p
end

local function texte(part: BasePart, face: Enum.NormalId, txt: string, couleurTexte: Color3?, fond: Color3?): TextLabel
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.LightInfluence = 0
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.Parent = part
	local l = Instance.new("TextLabel")
	l.Size = UDim2.fromScale(1, 1)
	l.BackgroundTransparency = fond and 0 or 1
	l.BackgroundColor3 = fond or Color3.new(0, 0, 0)
	l.TextColor3 = couleurTexte or Color3.new(1, 1, 1)
	l.TextScaled = true
	l.Font = Enum.Font.GothamBlack
	l.Text = txt
	l.Parent = sg
	return l
end

local function pancarte(nom: string, taille: Vector3, position: Vector3, versOu: Vector3, txt: string, couleur: Color3, couleurTexte: Color3?, parent: Instance?): Part
	local p = bloc(nom, taille, CFrame.lookAt(position, position + versOu), couleur, Enum.Material.SmoothPlastic, parent)
	deco(p)
	texte(p, Enum.NormalId.Front, txt, couleurTexte)
	return p
end

local SOL = 1
local LARGEUR, PROFONDEUR, HAUTEUR = 420, 320, 40
local DX, DZ = LARGEUR / 2, PROFONDEUR / 2

local MARBRE = Color3.fromRGB(242, 236, 224)
local MUR_MALL = Color3.fromRGB(246, 241, 231)
local OR = Color3.fromRGB(225, 175, 45)
local NOIR_LUXE = Color3.fromRGB(22, 22, 26)
local BLANC = Color3.fromRGB(248, 248, 246)
local NOIR = Color3.fromRGB(28, 28, 32)
local GRIS_METAL = Color3.fromRGB(150, 155, 165)

--[[ PLAN DU MALL (vu de dessus, nord en haut)

	   z=-160  ┌─────────── aquarium + façades ───────────┐
	           │   ALLÉE NORD (toute la largeur)           │
	  z=-124   │ ▓ │ ▓▓ │ ▓▓ │  PLACE   │ ▓▓ │ ▓▓ │ ▓ │   ▓ = boutiques (on entre dedans)
	           │ ▓ │ ▓▓ │ ▓▓ │ CENTRALE │ ▓▓ │ ▓▓ │ ▓ │
	   z=-13   │   ALLÉE CENTRALE  (fontaine)              │
	   z=+13   │ ▓ │food│ ▓▓ │  PLACE   │ ▓▓ │ ▓▓ │ ▓ │   food = food court
	           │ ▓ │crt │ ▓▓ │ CENTRALE │ ▓▓ │ ▓▓ │ ▓ │
	  z=+124   │   ALLÉE SUD (toute la largeur)            │
	   z=+160  └───────── ENTRÉE (grande ouverte) ────────┘
	                        PARKING (dehors)
	   z=+250            ┌─────────────────────┐
	                     │     GARAGE VIP      │  ← bâtiment à part, on y apparaît
	   z=+330            └─────────────────────┘
]]

-- Les îlots de boutiques (x = centre ; 48 de large : 2 rangées dos à dos)
local ILOTS_X = { -136, -62, 62, 136 }
local ALLEE_NORD = { -150, -124 }
local ALLEE_SUD = { 124, 150 }

---------------------------------------------------------------------
-- SOL, MURS, VERRIÈRE, LUMIÈRES
---------------------------------------------------------------------
-- Grand carrelage clair et brillant (comme dans les vidéos)
local sol = bloc("SolCarrelage", Vector3.new(LARGEUR, 1, PROFONDEUR), CFrame.new(0, SOL - 0.5, 0), Color3.fromRGB(226, 223, 216), Enum.Material.SmoothPlastic)
sol.Reflectance = 0.22
local joints = Instance.new("Folder")
joints.Name = "JointsCarrelage"
joints.Parent = carte
local COULEUR_JOINT = Color3.fromRGB(196, 192, 184)
local TAILLE_CARREAU = 8
for x = -DX + TAILLE_CARREAU, DX - TAILLE_CARREAU, TAILLE_CARREAU do
	deco(bloc("Joint", Vector3.new(0.15, 0.04, PROFONDEUR), CFrame.new(x, SOL + 0.02, 0), COULEUR_JOINT, Enum.Material.SmoothPlastic, joints))
end
for z = -DZ + TAILLE_CARREAU, DZ - TAILLE_CARREAU, TAILLE_CARREAU do
	deco(bloc("Joint", Vector3.new(LARGEUR, 0.04, 0.15), CFrame.new(0, SOL + 0.02, z), COULEUR_JOINT, Enum.Material.SmoothPlastic, joints))
end

local yMur = SOL + HAUTEUR / 2
bloc("MurNord", Vector3.new(LARGEUR + 4, HAUTEUR, 2), CFrame.new(0, yMur, -DZ - 1), MUR_MALL, Enum.Material.Marble)
bloc("MurOuest", Vector3.new(2, HAUTEUR, PROFONDEUR), CFrame.new(-DX - 1, yMur, 0), MUR_MALL, Enum.Material.Marble)
bloc("MurEst", Vector3.new(2, HAUTEUR, PROFONDEUR), CFrame.new(DX + 1, yMur, 0), MUR_MALL, Enum.Material.Marble)
local largeurPortes = 40
local largeurCote = (LARGEUR + 4 - largeurPortes) / 2
bloc("MurSudOuest", Vector3.new(largeurCote, HAUTEUR, 2), CFrame.new(-(largeurPortes / 2 + largeurCote / 2), yMur, DZ + 1), MUR_MALL, Enum.Material.Marble)
bloc("MurSudEst", Vector3.new(largeurCote, HAUTEUR, 2), CFrame.new(largeurPortes / 2 + largeurCote / 2, yMur, DZ + 1), MUR_MALL, Enum.Material.Marble)
-- Les portes vitrées sont ouvertes (coulissées sur les côtés) : on entre et sort en kart
for _, cote in ipairs({ -1, 1 }) do
	local porte = deco(bloc("PorteOuverte", Vector3.new(6, 16, 0.4), CFrame.new(cote * (largeurPortes / 2 + 3), SOL + 8, DZ + 2.4), Color3.fromRGB(170, 205, 230), Enum.Material.Glass))
	porte.Transparency = 0.55
end
pancarte("EnseigneExterieure", Vector3.new(60, 6, 0.5), Vector3.new(0, SOL + 22, DZ + 2.3), Vector3.new(0, 0, 1), "✦ GOLDEN MALL ✦", NOIR_LUXE, OR)
bloc("DessusPortes", Vector3.new(largeurPortes, HAUTEUR - 16, 2), CFrame.new(0, SOL + 16 + (HAUTEUR - 16) / 2, DZ + 1), MUR_MALL, Enum.Material.Marble)
pancarte("Enseigne", Vector3.new(60, 6, 0.5), Vector3.new(0, SOL + 22, DZ - 0.3), Vector3.new(0, 0, -1), "✦ GOLDEN MALL ✦", NOIR_LUXE, OR)

-- Plafond blanc (au ras du haut des boutiques) avec des puits de lumière
local HAUT_PLAFOND = 24
local plafond = bloc("Plafond", Vector3.new(LARGEUR + 4, 1, PROFONDEUR + 4), CFrame.new(0, SOL + HAUT_PLAFOND + 0.5, 0), Color3.fromRGB(245, 244, 240), Enum.Material.SmoothPlastic)
plafond.CastShadow = false
local puits = Instance.new("Folder")
puits.Name = "PuitsDeLumiere"
puits.Parent = carte
local function puitsDeLumiere(x: number, z: number, taille: Vector3)
	local p = deco(bloc("PuitsDeLumiere", taille, CFrame.new(x, SOL + HAUT_PLAFOND - 0.05, z), Color3.fromRGB(205, 232, 255), Enum.Material.Neon, puits))
	p.CastShadow = false
	deco(bloc("CadrePuits", taille + Vector3.new(1, -0.05, 1), CFrame.new(x, SOL + HAUT_PLAFOND - 0.02, z), Color3.fromRGB(225, 225, 228), Enum.Material.Metal, puits))
end
for x = -175, 175, 50 do
	puitsDeLumiere(x, 0, Vector3.new(18, 0.1, 7)) -- allée centrale
	puitsDeLumiere(x, -137, Vector3.new(18, 0.1, 7)) -- allée nord
	puitsDeLumiere(x, 137, Vector3.new(18, 0.1, 7)) -- allée sud
end
for _, z in ipairs({ -110, -60, 60, 110 }) do
	puitsDeLumiere(0, z, Vector3.new(10, 0.1, 22)) -- place centrale
end

-- Lumières des allées
local lampes = Instance.new("Folder")
lampes.Name = "Lampes"
lampes.Parent = carte
local nombreSpots = 0
local function lampe(x: number, z: number)
	nombreSpots += 1
	local l = bloc("Spot", Vector3.new(2.2, 0.2, 2.2), CFrame.new(x, SOL + HAUT_PLAFOND - 0.1, z), Color3.fromRGB(255, 248, 232), Enum.Material.Neon, lampes)
	deco(l)
	l.CastShadow = false
	if nombreSpots % 2 == 0 then
		return -- 1 spot sur 2 éclaire vraiment (bon pour les petits téléphones)
	end
	local pl = Instance.new("PointLight")
	pl.Range = 32
	pl.Brightness = 1.2
	pl.Color = Color3.fromRGB(255, 236, 200)
	pl.Parent = l
end
for x = -200, 200, 25 do
	lampe(x, -137)
	lampe(x, 0)
	lampe(x, 137)
end
for _, x in ipairs({ -173, -99, 99, 173 }) do
	for _, z in ipairs({ -70, 70 }) do
		lampe(x, z)
	end
end

---------------------------------------------------------------------
-- LES STYLES DE BOUTIQUES (couleurs du sol, des murs, de l'enseigne)
---------------------------------------------------------------------
local STYLES = {
	coiffeur = { Couleur = Color3.fromRGB(245, 130, 180), Sol = BLANC, SolMat = Enum.Material.Marble, Mur = BLANC },
	vetements = { Couleur = Color3.fromRGB(255, 255, 255), Sol = Color3.fromRGB(215, 185, 140), SolMat = Enum.Material.WoodPlanks, Mur = Color3.fromRGB(245, 243, 238) },
	burger = { Couleur = Color3.fromRGB(235, 55, 40), Sol = Color3.fromRGB(70, 70, 75), SolMat = Enum.Material.Slate, Mur = Color3.fromRGB(250, 215, 80) },
	pizza = { Couleur = Color3.fromRGB(60, 175, 80), Sol = Color3.fromRGB(190, 110, 75), SolMat = Enum.Material.Brick, Mur = Color3.fromRGB(250, 240, 225) },
	tacos = { Couleur = Color3.fromRGB(250, 165, 30), Sol = Color3.fromRGB(80, 60, 50), SolMat = Enum.Material.Slate, Mur = Color3.fromRGB(255, 235, 200) },
	cafe = { Couleur = Color3.fromRGB(200, 150, 100), Sol = Color3.fromRGB(120, 85, 55), SolMat = Enum.Material.WoodPlanks, Mur = Color3.fromRGB(240, 230, 215) },
	jeux = { Couleur = Color3.fromRGB(80, 200, 255), Sol = Color3.fromRGB(30, 30, 40), SolMat = Enum.Material.SmoothPlastic, Mur = Color3.fromRGB(38, 38, 52) },
	tech = { Couleur = Color3.fromRGB(110, 170, 255), Sol = Color3.fromRGB(235, 235, 240), SolMat = Enum.Material.SmoothPlastic, Mur = BLANC },
	sport = { Couleur = Color3.fromRGB(255, 95, 45), Sol = Color3.fromRGB(70, 70, 76), SolMat = Enum.Material.Rubber, Mur = Color3.fromRGB(235, 235, 235) },
	bijoux = { Couleur = OR, Sol = Color3.fromRGB(45, 25, 35), SolMat = Enum.Material.Fabric, Mur = Color3.fromRGB(32, 26, 32) },
	parfum = { Couleur = Color3.fromRGB(210, 160, 240), Sol = BLANC, SolMat = Enum.Material.Marble, Mur = Color3.fromRGB(252, 250, 248) },
	jouets = { Couleur = Color3.fromRGB(255, 205, 40), Sol = Color3.fromRGB(120, 200, 240), SolMat = Enum.Material.SmoothPlastic, Mur = Color3.fromRGB(255, 250, 240) },
	livres = { Couleur = Color3.fromRGB(130, 210, 150), Sol = Color3.fromRGB(150, 110, 75), SolMat = Enum.Material.WoodPlanks, Mur = Color3.fromRGB(245, 240, 230) },
	glaces = { Couleur = Color3.fromRGB(120, 220, 230), Sol = BLANC, SolMat = Enum.Material.Marble, Mur = Color3.fromRGB(255, 225, 235) },
}

-- Les enseignes (noms inventés). Elles sont réparties dans les allées dans cet ordre.
local CATALOGUE = {
	{ "vetements", "MODE URBAINE" }, { "coiffeur", "BELLE COUPE" }, { "jeux", "GAME ZONE" },
	{ "burger", "BIG BURGER" }, { "tech", "SKY TECH" }, { "sport", "SPORT ATTITUDE" },
	{ "parfum", "OASIS PARFUMS" }, { "cafe", "PALMIER CAFÉ" }, { "vetements", "STYLE & CO" },
	{ "jouets", "MÉGA JOUETS" }, { "bijoux", "AURUM JOAILLERIE" }, { "livres", "PAGE & PLUME" },
	{ "glaces", "GLACES POLAIRES" }, { "coiffeur", "BARBER CLUB" }, { "vetements", "DENIM STREET" },
	{ "jeux", "PIXEL PLAY" }, { "tech", "PHONE CENTER" }, { "pizza", "PIZZA ROMA" },
	{ "sport", "DUNE RUNNERS" }, { "vetements", "ÉLÉGANCE" }, { "cafe", "CAFÉ DES DUNES" },
	{ "tacos", "TACOS LOCO" }, { "vetements", "MAISON DORÉE" },
}
local prochaineEnseigne = 0
local function enseigneSuivante(): (string, string)
	prochaineEnseigne += 1
	local e = CATALOGUE[(prochaineEnseigne - 1) % #CATALOGUE + 1]
	return e[1], e[2]
end

local COULEURS_VIVES = {
	Color3.fromRGB(230, 60, 60), Color3.fromRGB(250, 170, 40), Color3.fromRGB(250, 220, 60),
	Color3.fromRGB(80, 180, 90), Color3.fromRGB(60, 130, 220), Color3.fromRGB(150, 90, 200),
	Color3.fromRGB(240, 120, 170), Color3.fromRGB(245, 245, 245), Color3.fromRGB(40, 40, 45),
}
local function couleurAuHasard(): Color3
	return COULEURS_VIVES[random:NextInteger(1, #COULEURS_VIVES)]
end

---------------------------------------------------------------------
-- LES AMÉNAGEMENTS INTÉRIEURS (minimalistes)
-- Coordonnées locales de la boutique : x de -16 à 16 (largeur),
-- z de 0 (vitrine) à 24 (mur du fond), y = hauteur au-dessus du sol.
-- La porte est au milieu (x de -7 à 7) : on garde ce passage libre.
---------------------------------------------------------------------
type Outils = {
	meuble: (nom: string, taille: Vector3, x: number, y: number, z: number, couleur: Color3, matiere: Enum.Material?) -> Part,
	cylindre: (nom: string, hauteur: number, diametre: number, x: number, y: number, z: number, couleur: Color3, matiere: Enum.Material?) -> Part,
	ecran: (x: number, y: number, z: number, largeur: number, hauteur: number, couleur: Color3, txt: string?) -> (),
	style: { [string]: any },
	nom: string,
}

local function chaise(o: Outils, x: number, z: number, couleur: Color3)
	libre(o.meuble("Chaise", Vector3.new(2, 2.4, 2), x, 1.2, z, couleur, Enum.Material.SmoothPlastic))
end

local function mannequin(o: Outils, x: number, z: number, tenue: Color3)
	local corps = libre(o.cylindre("Mannequin", 4.6, 1.6, x, 2.3, z, tenue, Enum.Material.Fabric))
	local tete = o.meuble("Tete", Vector3.new(1.3, 1.3, 1.3), x, 5.3, z, BLANC, Enum.Material.SmoothPlastic)
	tete.Shape = Enum.PartType.Ball
	tete.Anchored = false
	tete.Massless = true
	local w = Instance.new("WeldConstraint")
	w.Part0 = corps
	w.Part1 = tete
	w.Parent = tete
end

local AMENAGEMENTS: { [string]: (Outils) -> () } = {}

AMENAGEMENTS.coiffeur = function(o)
	for _, x in ipairs({ -11, 0, 11 }) do
		deco(o.meuble("Miroir", Vector3.new(5, 6, 0.2), x, 6, 22.8, Color3.fromRGB(210, 230, 240), Enum.Material.Glass)).Reflectance = 0.5
		deco(o.meuble("CadreMiroir", Vector3.new(5.6, 0.3, 0.3), x, 9.1, 22.8, o.style.Couleur, Enum.Material.Neon))
		o.cylindre("PiedFauteuil", 1.6, 1.2, x, 0.8, 19.5, NOIR, Enum.Material.Metal)
		o.meuble("Fauteuil", Vector3.new(3, 1.2, 3), x, 2.1, 19.5, NOIR, Enum.Material.Fabric)
		o.meuble("DossierFauteuil", Vector3.new(3, 3, 0.6), x, 3.6, 21, NOIR, Enum.Material.Fabric)
	end
	o.meuble("Accueil", Vector3.new(6, 3.5, 2.5), 11.5, 1.75, 6, o.style.Couleur, Enum.Material.SmoothPlastic)
	o.cylindre("Pot", 2, 2.2, -13.5, 1, 4, BLANC, Enum.Material.SmoothPlastic)
	local plante = o.meuble("Plante", Vector3.new(3, 3, 3), -13.5, 3.4, 4, Color3.fromRGB(60, 150, 70), Enum.Material.Grass)
	plante.Shape = Enum.PartType.Ball
end

AMENAGEMENTS.vetements = function(o)
	local teintes = { Color3.fromRGB(30, 30, 35), Color3.fromRGB(240, 240, 240), Color3.fromRGB(60, 90, 160), Color3.fromRGB(190, 60, 60), Color3.fromRGB(200, 180, 140), Color3.fromRGB(90, 130, 90) }
	for _, z in ipairs({ 11, 18 }) do
		deco(o.meuble("Portant", Vector3.new(13, 0.3, 0.3), -9, 6, z, GRIS_METAL, Enum.Material.Metal))
		o.meuble("PiedPortant", Vector3.new(0.3, 6, 0.3), -15, 3, z, GRIS_METAL, Enum.Material.Metal)
		o.meuble("PiedPortant", Vector3.new(0.3, 6, 0.3), -3, 3, z, GRIS_METAL, Enum.Material.Metal)
		for i = 0, 5 do
			deco(o.meuble("Vetement", Vector3.new(0.5, 4, 2.4), -14 + i * 2, 3.9, z, teintes[(i % #teintes) + 1], Enum.Material.Fabric))
		end
	end
	o.meuble("Table", Vector3.new(6, 2.5, 5), 10, 1.25, 14, Color3.fromRGB(225, 200, 160), Enum.Material.WoodPlanks)
	for i = 0, 2 do
		deco(o.meuble("PilePulls", Vector3.new(1.6, 0.9, 1.6), 8 + i * 2, 2.95, 14, teintes[i + 2], Enum.Material.Fabric))
	end
	deco(o.meuble("Miroir", Vector3.new(6, 9, 0.2), 10, 5.5, 22.8, Color3.fromRGB(210, 230, 240), Enum.Material.Glass)).Reflectance = 0.5
	mannequin(o, -12, 4, teintes[3])
	mannequin(o, 12, 4, teintes[4])
end

local MENUS = {
	burger = { "MENU MAXI 7€", "BURGERS", "FRITES · BOISSONS" },
	pizza = { "PIZZAS", "MENU 9€", "DESSERTS" },
	tacos = { "TACOS XXL", "MENU 8€", "SAUCES MAISON" },
	["CRISPY CHICKEN"] = { "POULET CROUSTI", "MENU 7€", "WINGS · FRITES" },
	["SHAWARMA STAR"] = { "SHAWARMA", "MENU 8€", "FALAFELS" },
}
local function fastFood(o: Outils, typeB: string)
	o.meuble("Comptoir", Vector3.new(26, 3.5, 3), 0, 1.75, 18, o.style.Couleur, Enum.Material.SmoothPlastic)
	deco(o.meuble("PlanComptoir", Vector3.new(27, 0.3, 3.4), 0, 3.65, 18, BLANC, Enum.Material.Marble))
	for i, x in ipairs({ -9, 0, 9 }) do
		o.ecran(x, 9, 22.8, 7.5, 3.5, NOIR, (MENUS[o.nom] or MENUS[typeB])[i])
	end
	for _, x in ipairs({ -6, 6 }) do
		deco(o.meuble("Caisse", Vector3.new(1.6, 1.2, 0.3), x, 4.4, 17.5, NOIR, Enum.Material.SmoothPlastic))
	end
	for _, x in ipairs({ -10, 10 }) do
		o.cylindre("Table", 3, 4, x, 1.5, 9, BLANC, Enum.Material.Marble)
		chaise(o, x - 3.4, 9, o.style.Couleur)
		chaise(o, x + 3.4, 9, o.style.Couleur)
	end
end
AMENAGEMENTS.burger = function(o) fastFood(o, "burger") end
AMENAGEMENTS.pizza = function(o) fastFood(o, "pizza") end
AMENAGEMENTS.tacos = function(o) fastFood(o, "tacos") end

