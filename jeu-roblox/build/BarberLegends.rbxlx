task.spawn(function()
	while true do
		task.wait(1)
		if state then
			local any = false
			for i, btn in giftButtons do
				local ready, left = giftReady(i)
				if state.Gifts[i] then
					btn.Text = "✅ Reçu"
					btn.BackgroundColor3 = C.Card
				elseif ready then
					btn.Text = "Ouvrir !"
					btn.BackgroundColor3 = C.Green
					any = true
				else
					btn.Text = "⏳ " .. Util.Time(left)
					btn.BackgroundColor3 = C.Card
				end
			end
			badges["Cadeaux"].Visible = any
		end
	end
end)

